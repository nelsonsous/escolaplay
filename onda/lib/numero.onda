# numero.onda — os números do JavaScript, ao bit: String(x), Number(texto), toFixed, toPrecision, Math.round,
# Math.max/min, e o Intl.NumberFormat('pt-PT') (simples, até d casas, compacto e moedas). Precisa de memoria.onda
# (e de texto.onda para o _nu_s2n e o _nu_simb).
#
# Escrever (imprime; vale 0)
#   _nu_ps x          String(x): o decimal mais curto que volta a dar x (dos mais curtos, o mais perto; empate: o
#                     par); NaN, Infinity, -Infinity; o -0 sai 0
#   _nu_pj x          um número no JSON.stringify (os não finitos saem null)
#   _nu_pnz v sep     v > 0 finito, como o String(v), com o byte sep no lugar do ponto (46 '.', 44 ',')
#   _nu_fixo x d      x.toFixed(d), 0 <= d <= 100;  _nu_fixos x d sep: com o byte sep no lugar do ponto (também no
#                     String(x) de 1e21 para cima)
#   _nu_prec x p      x.toPrecision(p), 1 <= p <= 100
#   _nu_pzk n k       o inteiro n >= 0 com k algarismos (zeros à esquerda)
# O Intl.NumberFormat('pt-PT') (o ICU arredonda o decimal MAIS CURTO do real, metades para longe do zero: 1.005 com 2
# casas dá 1,01; vírgula; milhares com U+00A0 só a partir de 10 000; "-" nos negativos, também no -0 e no que
# arredonda para 0). x finito:
#   _nu_intl x d      com d casas (minimum = maximumFractionDigits = d, 0 <= d <= 100)
#   _nu_intlm x d     com até d casas (maximumFractionDigits = d: sem os zeros à direita)
#   _nu_compacto x    { notation: 'compact', maximumFractionDigits: 1 }: mil, M, mM, Bi (e daí para cima Bi:
#                     10^16 dá "10 000 Bi"); o salto de escala quando o arredondamento chega à seguinte (999 950 → 1 M)
#   _nu_moeda x d t   { style: 'currency', currency: t } com d casas: o número, U+00A0 e o símbolo (_nu_simb t: o
#                     do pt-PT para um código de 3 letras, os 21 que não são o próprio código)
# Contas (reais)
#   _nu_round x       Math.round (empates para +∞; -0 em [-0.5, 0))
#   _nu_max a b / _nu_min a b / _nu_clamp x a b   Math.max/min (o NaN contamina, +0 > -0; o Mx/Mn da Onda não)
#   _nu_fin x         Number.isFinite;  _nu_toint x: o ToIntegerOrInfinity (NaN dá 0)
#   _nu_relidx x n    o índice relativo do slice do JS (início ou fim) para um comprimento n
#   _nu_at v n i      o v[i] do JS (v com n reais) para um índice real i: o valor, ou NaN (undefined)
#   _nu_rprec x p     Number(x.toPrecision(p)), 1 <= p <= 17, já como real
#   _nu_bits b        o real com estes 64 bits (o inteiro b)
# Ler
#   _nu_s2n t         Number(texto) do JS (o StringToNumber): sem os espaços do JS à volta; vazio dá 0; decimal (com
#                     sinal, ponto e expoente), Infinity, 0x 0o 0b; o resto NaN. Arredondamento certo sempre (até 780
#                     algarismos e o "há mais", como o V8)
#   _nu_d2f dg nd e   D × 10^e → o real mais perto (empate: par); D = nd algarismos (valores 0..9) em dg, D > 0
#   _nu_dig a         os algarismos do decimal mais curto de a > 0 finito: g = [k, n, d1..dk] (a = 0,d1…dk × 10^n)
#   _nu_exato a       os algarismos do valor EXATO de a > 0 finito (até 767): o endereço do 1.º; quantos em
#                     M[_me_lb + 13] e o expoente em M[_me_lb + 14] (a = 0,d1…dL × 10^E)
# Globais: o bloco da biblioteca (memoria.onda): a classe do arredondamento (b+0), b+12..14, os algarismos (b+16..63),
# o inteiro grande (b+64..363) e os algarismos lidos ou exatos (b+400..1299). Sem Lg nem outra função matemática.

# ---------- Math do JS ----------
: _nu_fin f>i x != & >> Bh x 20 2047 2047
: _nu_max ff>f a b ? > a b a ? > b a b ? && == a b != a 0. a + a b
: _nu_min ff>f a b ? < a b a ? < b a b ? && == a b != a 0. a * -1. + * -1. a * -1. b
: _nu_clamp fff>f x a b _nu_max a _nu_min b x
: _nu_round f>f x { = r Fl x = r ? >= - x r 0.5 + r 1. r ? == r 0. * x 0. r }
: _nu_toint f>f x ? != x x 0. ? ~ _nu_fin x x ? < x 0. * -1. Fl * -1. x Fl x
: _nu_relidx fi>i x len { = r _nu_toint x I ? < r 0. _nu_max + F len r 0. _nu_min r F len }
: _nu_at iif>f v len i ? && && == Fl i i >= i 0. < i F len @f + v I i Bw 2146959360 0
: _nu_bits i>f b Bw >> b 32 & b 4294967295
# 10^k como real (exato até 22) e como inteiro (k < 19)
: _nu_p10 i>f k { = r 1. W > k 0 { = r * r 10. = k - k 1 } r }
: _nu_p10i i>i k { = r 1 W > k 0 { = r * r 10 = k - k 1 } r }
: _nu_pzk ii>i n k { = p 1 = i 1 W < i k { = p * p 10 = i + i 1 } W > p 1 { ? < n p P '0 0 = p / p 10 } N n }

# ---------- inteiros grandes: M[b] = número de limbs; M[b+1..] em base 2^32, do menos significativo ----------
: _nu_bset ii>i b x { ! b 0 ? x { ! + b 1 & x 4294967295 ! b 1 = h >> x 32 ? h { ! + b 2 h ! b 2 0 } 0 } 0 }
: _nu_bmul ii>i b m {
  = n @ b = c 0 = i 1
  W <= i n { = t + * @ + b i m c ! + b i & t 4294967295 = c >> t 32 = i + i 1 }
  ? c { ! + + b n 1 c ! b + n 1 0 } 0 }
: _nu_badd ii>i b x { = n @ b = i 1 = c x W && c <= i n { = t + @ + b i c ! + b i & t 4294967295 = c >> t 32 = i + i 1 } ? c { ! + + b n 1 c ! b + n 1 0 } 0 0 }
: _nu_bp10 ii>i b s { W >= s 9 { _nu_bmul b 1000000000 = s - s 9 } = m 1 W > s 0 { = m * m 10 = s - s 1 } ? > m 1 _nu_bmul b m 0 }
: _nu_bshl ii>i b s {
  = w / s 32 = r % s 32 = n @ b
  ? r {
    = c 0 = i 1
    W <= i n { = t | << @ + b i r c ! + b i & t 4294967295 = c >> t 32 = i + i 1 }
    ? c { ! + + b n 1 c = n + n 1 0 } 0 } 0
  ? && w n { = i n W >= i 1 { ! + + b i w @ + b i = i - i 1 } = i 1 W <= i w { ! + b i 0 = i + i 1 } = n + n w 0 } 0
  ! b n 0 }
# divide por m (pequeno) no lugar; devolve o resto
: _nu_bdiv ii>i b m {
  = n @ b = r 0 = i n
  W >= i 1 { = c + << r 32 @ + b i ! + b i / c m = r % c m = i - i 1 }
  W && > n 0 == @ + b n 0 = n - n 1
  ! b n r }
: _nu_blimb ii>i b j ? && >= j 0 < j @ b @ + + b 1 j 0
: _nu_bget i>i b | _nu_blimb b 0 << _nu_blimb b 1 32
: _nu_bbits i>i b { = n @ b ? == n 0 0 { = t _nu_blimb b - n 1 = k 0 W > t 0 { = t >> t 1 = k + k 1 } + * 32 - n 1 k } }
# A / 2^k arredondado para baixo (cabe em 64 bits); a classe do resto face a meio fica em M[_me_lb]: 0 exato, 1 abaixo,
# 2 meio, 3 acima
: _nu_bext ii>i b k {
  = wi / k 32 = bo % k 32
  = d >> _nu_blimb b wi bo
  = d ? bo | | d << _nu_blimb b + wi 1 - 32 bo << _nu_blimb b + wi 2 - 64 bo | d << _nu_blimb b + wi 1 32
  = k1 - k 1 = w1 / k1 32 = b1 % k1 32
  = hb & >> _nu_blimb b w1 b1 1
  = st != & _nu_blimb b w1 - << 1 b1 1 0
  = j 0 W && ~ st < j w1 { = st != _nu_blimb b j 0 = j + j 1 }
  ! _me_lb + * 2 hb st
  d }
# A / 10^t arredondado para baixo, com a classe como no _nu_bext
: _nu_bd10 ii>i b t {
  = r 0 = st 0 = j 0
  W < j t { = st || st r = r _nu_bdiv b 10 = j + j 1 }
  ! _me_lb ? > r 5 3 ? == r 5 ? st 3 2 ? || r st 1 0
  _nu_bget b }
# divide por 10^k no lugar; devolve 1 se sobrou resto
: _nu_bd10k ii>i b k { = st 0 W >= k 9 { = r _nu_bdiv b 1000000000 = st || st r = k - k 9 } ? > k 0 { = r _nu_bdiv b _nu_p10i k = st || st r 0 } 0 st }
# floor(c · 10^s · 2^q / 4) (cabe em 64 bits), com a classe do resto
: _nu_bq iiii>i c s q b {
  _nu_bset b c
  ? > q 0 _nu_bshl b q 0
  ? > s 0 _nu_bp10 b s 0
  ? < s 0 {
      = y _nu_bd10 b - 0 s
      = c10 @ _me_lb = r2 & y 3
      ! _me_lb ? > r2 2 3 ? == r2 2 ? c10 3 2 ? || r2 c10 1 0
      >> y 2 }
    { _nu_bext b + 2 ? < q 0 - 0 q 0 } }
# floor(f · 2^q · 10^s) (f > 0), exato, com a classe do resto; o resultado tem de caber em 63 bits
: _nu_fq iii>i f q s {
  = b + _me_lb 64 _nu_bset b f
  ? > q 0 _nu_bshl b q 0
  ? > s 0 _nu_bp10 b s 0
  = c10 0
  ? < s 0 { _nu_bd10 b - 0 s = c10 @ _me_lb 0 } 0
  ? < q 0 { = m _nu_bext b - 0 q ? c10 ! _me_lb | @ _me_lb 1 0 m } { ! _me_lb c10 _nu_bget b } }

# ---------- o decimal mais curto ----------
# floor(log10 (f·2^q)) a menos de 1, pelos bits de f (f > 0): nb = quantos bits, log2 em [nb-1+q, nb+q)
: _nu_e10 ii>i f q { = nb 0 = t f W > t 0 { = t >> t 1 = nb + nb 1 } I Fl * F + q - nb 1 0.3010299956639812 }
# v > 0 finito (não inteiro abaixo de 2^53): V = v·10^(16-e) na grelha de 17 algarismos, em [10^16, 10^17): o decimal
# mais curto que o JSON.parse devolve como v (dos mais curtos, o mais perto de v; empate: o par). Contas exatas: o
# intervalo que volta a dar v vai a meio caminho dos vizinhos (incluído se a mantissa é par; abaixo de uma potência
# de 2 o vizinho está a meia distância). Devolve V e põe e em M[_me_lb + 12].
: _nu_grade f>i v {
  = hx Bh v
  = ex & >> hx 20 2047
  = f | << & hx 1048575 32 Bl v
  = f ? ex | f 4503599627370496 f
  = q ? ex - ex 1075 -1074
