# emissor x86-64 nativo (-x): executavel ELF escrito byte a byte pela Onda, sem C, assembler nem linker.
# memoria: M[-16] em 0x10000000, M[0] em 0x10000080 (r15), 64M palavras; area do sistema em 0x30000080.
# convencao propria: argumentos empilhados da direita para a esquerda, resultado em rax.
# 25 n de parametros 26 pilha de controlo 27 topo 28 chamadas a corrigir 29 n 30 rotina do sistema 31 inicio do codigo
: x4 i>i v { P & v 255 P & >> v 8 255 P & >> v 16 255 P & >> v 24 255 }
: x8 i>i v wword v 8
: xdisp i>i j ? < j @ 25 + 16 * 8 j * -8 + - j @ 25 1
: xdt i>i t * -8 + + - @ 9 @ 25 t 1
: xmr ii>i r d { P ? >= r 8 76 72 P 139 P + 133 * 8 & r 7 x4 d }
: xrm ii>i r d { P ? >= r 8 76 72 P 137 P + 133 * 8 & r 7 x4 d }
: xlt ii>i r t xmr r xdt t
: xst ii>i r t xrm r xdt t
: xlv ii>i r j xmr r xdisp j
: xsv ii>i r j xrm r xdisp j
: xi ii>i r v { P ? >= r 8 73 72 P + 184 & r 7 x8 v }
: xpush i>i d { P 255 P 181 x4 d }
: xadd i>i v ? v { P 72 P 129 P 196 x4 v } 0
: xtest >i { P 72 P 133 P 192 }
: xjcc i>i c { P 15 P c = p @ 16 x4 0 p }
: xjmp >i { P 233 = p @ 16 x4 0 p }
: xput4 ii>i p v { ! p & v 255 ! + p 1 & >> v 8 255 ! + p 2 & >> v 16 255 ! + p 3 & >> v 24 255 }
: xpat i>i p xput4 p - @ 16 + p 4
: xback i>i t { P 233 x4 - t + @ 16 4 }
: xpsh i>i v { ! + @ 26 @ 27 v ! 27 + @ 27 1 v }
: xpop >i { ! 27 - @ 27 1 @ + @ 26 @ 27 }
: xcall i>i k { P 232 = p @ 16 x4 0 = q + @ 28 * @ 29 2 ! q p ! + q 1 k ! 29 + @ 29 1 p }
: xrt i>i c xcall fby c
: xsy3 iii>i c a b { P 106 P b P 106 P a P 106 P c xcall -1 xadd 24 }
: xsetb i>i cc { P 15 P cc P 192 P 15 P 182 P 192 }
: xbop i>i o {
  ? == o '+ { P 72 P 1 P 200 }
  ? == o '- { P 72 P 41 P 200 }
  ? == o '* { P 72 P 15 P 175 P 193 }
  ? == o '/ { P 72 P 153 P 72 P 247 P 249 }
  ? == o '% { P 72 P 153 P 72 P 247 P 249 P 72 P 137 P 208 }
  ? == o '& { P 72 P 33 P 200 }
  ? == o '| { P 72 P 9 P 200 }
  ? == o '^ { P 72 P 49 P 200 }
  ? == o k2 '< '< { P 72 P 211 P 224 }
  { P 72 P 211 P 248 } }
: xcc i>i o ? == o '< 156 ? == o '> 159 ? == o k2 '< '= 158 ? == o k2 '> '= 157 ? == o k2 '= '= 148 149
: xins i>i p {
  = k @ p
  = d @ + p 1
  = a @ + p 2
  = b @ + p 3
  = c @ + p 4
  ? == k 1 { ? tty d { P 15 P 11 } { xi 0 tokval a xst 0 d } }
  ? == k 2 { xi 0 a xst 0 d }
  ? == k 3 { = n slen a = q sreg a P 104 x4 n P 104 x4 q xrt k3 '_ 'o 's xadd 16 }
  ? == k 4 { P 49 P 192 xst 0 d }
  ? == k 5 { xlv 0 floc a xst 0 d }
  ? == k 6 { xlt 0 b xsv 0 floc a }
  ? == k 7 { = j - c 1 W >= j 0 { xpush xdt @ + b j = j - j 1 } xcall a xadd * 8 c xst 0 d }
  ? == k 8 { ? tty d { P 15 P 11 } { xlt 0 b xlt 1 c xbop tcode a xst 0 d } }
  ? == k 9 { ? tty b { P 15 P 11 } { xlt 0 b xlt 1 c P 72 P 57 P 200 xsetb xcc tcode a xst 0 d } }
  ? == k 10 { P 49 P 192 xst 0 d xlt 0 a xtest xpsh xjcc 132 }
  ? || == k 11 == k 13 { xlt 0 a xtest xsetb 149 xst 0 d xpat xpop }
  ? == k 12 { xi 0 1 xst 0 d xlt 0 a xtest xpsh xjcc 133 }
  ? == k 14 { xlt 0 a xtest xsetb 148 xst 0 d }
  ? == k 17 { ? tty b { P 15 P 11 } { xlt 0 b xlt 1 c P 72 P 57 P 200 P 72 P 15 P ? a 78 77 P 193 xst 0 d } }
  ? == k 18 { xlt 0 a xtest xpsh xjcc 132 }
  ? == k 19 { xlt 0 a xst 0 d = j xjmp xpat xpop xpsh j }
  ? == k 20 { xlt 0 a xst 0 d xpat xpop }
  ? == k 21 { xpsh @ 16 }
  ? == k 22 { xlt 0 a xtest xpsh xjcc 132 }
  ? == k 23 { = j xpop xback xpop xpat j }
  ? == k 24 { xlt 0 a P 73 P 139 P 4 P 199 xst 0 d }
  ? == k 25 { xlt 0 a xlt 1 b P 73 P 137 P 12 P 199 }
  ? == k 28 { xpush xdt a xrt k3 '_ 'o 'a xadd 8 xst 0 d }
  ? == k 29 { xpush xdt a xrt k3 '_ 'o 'p xadd 8 }
  ? == k 30 { xsy3 1 0 0 xst 0 d }
  ? == k 31 { xpush xdt a xrt k3 '_ 'o 'n xadd 8 }
  ? == k 33 { xlt 0 a P 73 P 137 P 71 P 240 }
  ? == k 34 { xsy3 3 0 0 xst 0 d }
  ? == k 35 { xpush xdt b xpush xdt a P 106 P 4 xcall -1 xadd 24 xst 0 d }
  ? == k 36 { xpush xdt a xrt k3 '_ 'e 'x xadd 8 }
  ? == k 37 { xsy3 6 0 0 xst 0 d }
  ? == k 42 { xpush xdt c xpush xdt b xpush xdt a xcall -1 xadd 24 xst 0 d }
  ? == k 41 { xlt 0 a P 201 P 195 }
  { P 15 P 11 } }
: xfun i>i k {
  ! 25 @ fe k 2
  ! 27 0
  O 16
  ! fe k 8 @ 16
  P 85 P 72 P 137 P 229
  = s + + - @ 9 @ 25 @ 11 3
  P 72 P 129 P 236 x4 * 8 s
  P 72 P 141 P 189 x4 * -8 s
  P 185 x4 s
  P 49 P 192
  P 243 P 72 P 171
  = j 0
  W < j @ 19 { xins + @ 18 * j 8 = j + j 1 }
  ! fe k 9 @ 16
  O 0 }
