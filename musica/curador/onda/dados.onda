# Maestro em Onda — os dados da tarefa agendada (o que era o curador/dados.mjs; a versao em JavaScript fica em
# curador/js/dados.mjs, so como referencia do teste de paridade). Para cada pessoa da app: o que ouve (favoritas,
# artistas, playlists), os pedidos a espera, a playlist da semana, as novidades dos artistas que segue, as mixes do
# Tidal e o que o Maestro ja fez. Grava <dir>/dados.md e <dir>/<pessoa>/perfil.json (o do dono tambem em
# <dir>/perfil.json) e mostra o dados.md.
#   node musica/curador/dados.mjs [/tmp/musica]     (o correr.mjs corre isto com o anfitriao Node da Onda)
# Junta-se depois da biblioteca da Onda (onda/lib: textos, JSON em arvore, datas e as portas do anfitriao Node) e do
# motor (musica/onda/motor.onda); o musica/onda/compilar.mjs monta tudo. Os pedidos sao em serie: cada resposta chega a
# funcao «lido», que segue o passo (M[8]).
#
# Globais (a biblioteca so usa o M[63]): 1 pasta  2 Worker  3 chave do agente  4 agora (ms)  5 pessoas (JSON)
#   6 a pessoa atual (no)  7 seccoes (textos)  8 passo  9 perfil (texto)  10 perfil  11 pedidos  12 playlists
#   13 recentes (3)  14 quantas recentes  15 mixes  16 novidades  17 quantas seccoes  18 quantas pessoas
#   19 a recente a pedir  20 caminho do ultimo pedido  21 pasta musica/  22 cabecalhos do agente  24 tendencias
#   25 avaliacoes  26 uid da pessoa

# ---------- o que os dois scripts partilham ----------
# t tem bytes? (o «verdadeiro» do JavaScript para textos)
: cheio i>i t > _tx_len t 0
# a lista l tem o texto k? (o l.includes(k); 0 se l nao e uma lista)
: inclui ii>i l k { = c ? == tipo l 6 pri l 0 = r 0 W && c ~ r { = r eh c k = c seg c } r }
# o toLowerCase de um codigo: o ASCII, o Latim (ate U+017F), o grego e o cirilico basicos; as outras letras ficam como
# estao (o _tx_min da biblioteca so chega ao Latim-1). Serve para a /semana/i e para nao repetir candidatas.
: minuscula i>i c
  ? && >= c 'A <= c 'Z + c 32
  ? && && >= c 192 <= c 222 != c 215 + c 32
  ? && >= c 256 <= c 311 ? && ~ & c 1 != c 304 + c 1 c
  ? && >= c 313 <= c 328 ? & c 1 + c 1 c
  ? && >= c 330 <= c 375 ? ~ & c 1 + c 1 c
  ? == c 376 255
  ? && >= c 377 <= c 382 ? & c 1 + c 1 c
  ? && >= c 913 <= c 939 ? != c 930 + c 32 c
  ? && >= c 1040 <= c 1071 + c 32
  ? && >= c 1024 <= c 1039 + c 80
  c
# o toLowerCase de um texto
: minusc i>i t {
  = n _tx_len t = r _tx_abre + * n 2 4 = i 0
  W < i n { _tx_putf minuscula _tx_cpj t i = i + i _tx_nb }
  _tx_fecha r }
# o texto t contem p (sem ligar a maiusculas, como o /p/i)?
: contem ii>i t p >= _tx_acha minusc t minusc p 0 0
# os elementos de uma lista, separados por sep (o .join)
: pjunta ii>i l sep { = c pri l = p 1 W c { Se ~ p crut sep = p 0 cru c = c seg c } }

# ---------- datas (a hora de Lisboa e o ISO vem da biblioteca) ----------
: pmes i>i m ? == m 1 "janeiro" ? == m 2 "fevereiro" ? == m 3 "março" ? == m 4 "abril" ? == m 5 "maio" ? == m 6 "junho" ? == m 7 "julho" ? == m 8 "agosto" ? == m 9 "setembro" ? == m 10 "outubro" ? == m 11 "novembro" "dezembro"
# como o toLocaleString('pt-PT', { timeZone: 'Europe/Lisbon', weekday/day/month/year/hour/minute }): «sábado, 7 de novembro de 2026 às 17:18»
# (o dia da semana e a hora são os do _dt_pquando: «sábado, 17:18»)
: plisboa i>i t {
  = q texto`{ _dt_pquando t }`
  = z _dt_dia _dt_lisboa t
  _dt_civil z
  = c _dt_cv
  `{ crut _tx_campo q 0 44 }, { N @ + c 2 } de { pmes @ + c 1 } de { N @ c } às` crut _tx_campo q 1 44 }
# «AAAA-MM-DDTHH:MM:SS(.mmm)Z» -> milissegundos desde 1970 (0 se nao e uma data)
: iso_ms i>i t ? < _tx_len t 19 0 {
  = ms ? && > _tx_len t 22 == _tx_b t 19 '. _tx_dig t 20 3 0
  = s + + + * _dt_liso t 86400 * _tx_dig t 11 2 3600 * _tx_dig t 14 2 60 _tx_dig t 17 2
  + * s 1000 ms }

# ---------- pedidos ----------
# GET (cabecalhos «Nome: valor» por linha, ou 0), com 60 s de limite; a resposta vai para a funcao fn (um texto com o seu nome)
: pedir iii>i url cab fn { = p A 5 ! p 0 ! + p 1 url ! + p 2 cab ! + p 3 0 ! + p 4 60000 _an_pede p fn 0 }
# o caminho no Worker, para a pessoa atual (?u=<uid>; o dono e sem)
: wurl i>i c texto`{ crut @ 2 }{ crut c }{ Se && @ 26 ~ mesmo @ 26 $"dono" { ? >= _tx_acha c $"?" 0 0 "&u=" "?u=" crut @ 26 } }`
# a mensagem de erro como o api() do comum.mjs: a do Worker (message, error) ou «HTTP <estado> em <caminho>»
: perro iii>i t s c {
  = j ? > s 0 _ar_json t 0
  = m ? == tipo j 7 ? ha j.message txt j.message ? ha j.error txt j.error 0 0
  ? m crut m ? > s 0 `HTTP { N s } em { crut c }` crut t
  0 }
: pedir_w ii>i cam cab { ! 20 cam pedir wurl cam cab $"lido" }
: falha i>i t { _an_fd 2 `{ crut t }\n` _an_volta _an_sair 1 }

# ---------- o fio: estado -> chave -> pessoas -> (perfil, pedidos, playlists, recentes, mixes, novidades) por pessoa ----------
: dados_main >i {
  # a pasta (o 1.º argumento depois do nome do script; sem ele, ou com uma opcao, /tmp/musica)
  = a _an_arg 1
  ! 1 ? && cheio a != _tx_b a 0 '- a $"/tmp/musica"
  _an_pasta @ 1
  = w _an_env $"MUSICA_WORKER"
  ! 2 ? cheio w w $"https://musica.mercados-proxy.workers.dev"
  = ag _an_env $"MUSICA_AGORA"
  ! 4 ? cheio ag iso_ms ag _an_agora
  ! 21 _an_env $"MUSICA_DIR"
  ! 7 A 64
  # o estado nao precisa de chave: antes da primeira ligacao ao Tidal ainda nao ha chave do agente
  ! 8 0 ! 26 0
  pedir_w $"/api/estado" 0 }

: lido ii>i t s {
  = p @ 8
  Se == p 0 s_estado t s
  Se == p 1 s_kv t s
  Se == p 2 s_pessoas t s
  Se == p 3 s_perfil t s
  Se == p 4 s_pedidos t s
  Se == p 5 s_playlists t s
  Se == p 6 s_recente t s
  Se == p 7 { ! 15 ? == s 200 _ar_json t 0 ! 8 8 pedir_w $"/api/novidades?dias=7" @ 22 }
  Se == p 8 { ! 16 ? == s 200 _ar_json t 0 ! 8 9 pedir_w $"/api/tendencias" @ 22 }
  Se == p 9 { ! 24 ? == s 200 _ar_json t 0 ! 8 10 pedir_w $"/api/avaliacoes" @ 22 }
  Se == p 10 { ! 25 ? == s 200 _ar_json t 0 seccao proxima } }

: s_estado ii>i t s {
  Se != s 200 { _an_fd 2 `{ perro t s $"/api/estado" }\n` _an_volta _an_sair 1 }
  = e _ar_json t
  ? ha e.ligado { chave 0 } {
    = f texto`{ crut @ 1 }/dados.md`
    _an_abre f
    `# Maestro\n\n**Tidal não ligado** — { msg_desligado e } Termina aqui.\n`
    _an_fecha
    `Tidal não ligado — { msg_desligado e } Termina aqui.\n`
    _an_sair 0 } }
: msg_desligado i>i e ? ha e.clientId "O Tidal ainda não foi ligado na app." "Ainda falta o Client ID do Tidal no conector."

# a chave do agente na KV (pela API da Cloudflare; o token vem do proxy do ambiente): a resposta vai para fn
: kv_pede i>i fn {
  = ns kv_id
  Se ~ cheio ns falha $"Falta o id da KV em musica/proxy/wrangler.toml"
  = co _an_env $"CF_ACCOUNT_ID"
  = tk _an_env $"CLOUDFLARE_API_TOKEN"
  = u texto`https://api.cloudflare.com/client/v4/accounts/{ crut ? cheio co co $"e5f9f94050228b1fa9f74443667b20a6" }/storage/kv/namespaces/{ crut ns }/values/agente%3Achave`
  = h texto`Authorization: Bearer { crut ? cheio tk tk $"proxy-injected" }`
  pedir u h fn }
# a chave do agente: a de MUSICA_CHAVE ou a da KV
: chave >i {
  = c _an_env $"MUSICA_CHAVE"
  ? cheio c { ! 3 c pessoas 0 } { ! 8 1 kv_pede $"lido" } }
# o id da KV no musica/proxy/wrangler.toml: o «id = "..."» a seguir ao «binding = "KV"»
: kv_id >i {
  = t _an_fich texto`{ crut ? cheio @ 21 @ 21 $"musica" }/proxy/wrangler.toml`
  ? t {
    = b _tx_acha t $`binding = "KV"` 0
    = k _tx_acha t $`id = "` b
    ? && >= b 0 >= k 0 {
      = i + k 6
      = j _tx_acha t $`"` i
      _tx_sub t i ? >= j 0 j _tx_len t } 0 } 0 }
: s_kv ii>i t s {
  Se == s 404 falha $"Ainda não há chave do agente: o Tidal nunca foi ligado na app."
  Se != s 200 falha texto`Cloudflare: HTTP { N s } a ler agente:chave`
  ! 3 t pessoas 0 }

# cada pessoa da app (o dono e quem foi convidado); se a lista nao vier (Worker antigo), so o dono
: pessoas >i {
  ! 22 texto`Authorization: Bearer { crut @ 3 }
accept: application/json`
  ! 8 2 ! 26 0
  pedir_w $"/api/utilizadores" @ 22 }
: s_pessoas ii>i t s {
  = l ? == s 200 _ar_json t 0
  ! 5 ? == tipo l 6 l _ar_json $`[{"uid":"dono","ligado":true}]`
  = c pri @ 5 = n 0 W c { Se ha c.ligado = n + n 1 = c seg c }
  ! 18 n ! 6 0 ! 17 0
  proxima 0 }
: proxima >i {
  = c ? @ 6 seg @ 6 pri @ 5
  W && c ~ ha c.ligado = c seg c
  ! 6 c
  ? c { comeca 0 } { fim 0 } }
: comeca >i {
  = q @ 6
  ! 26 txt q.uid
  ! 9 0 ! 10 0 ! 11 0 ! 12 0 ! 13 A 3 ! 14 0 ! 15 0 ! 16 0 ! 19 0 ! 24 0 ! 25 0
  _an_pasta texto`{ crut @ 1 }/{ crut @ 26 }`
  ! 8 3
  pedir_w $"/api/perfil?fresco=1" @ 22 }
# um passo que falhou (perfil, pedidos, playlists): a seccao da pessoa diz porque e segue-se para a proxima
: perdida ii>i t s {
  = q @ 6
  _an_abre 0
  `# Pessoa: { ? ha q.nome cru q.nome crut @ 26 } (\`{ crut @ 26 }\`)\n\n`
  `Não consegui ler os dados desta pessoa: { perro t s @ 20 }\n`
  ! + @ 7 @ 17 _an_fecha ! 17 + @ 17 1
  proxima 0 }
: s_perfil ii>i t s {
  ? != s 200 { perdida t s 0 } {
    ! 9 t ! 10 _ar_json t
    _an_abre texto`{ crut @ 1 }/{ crut @ 26 }/perfil.json` crut t _an_fecha
    Se mesmo @ 26 $"dono" { _an_abre texto`{ crut @ 1 }/perfil.json` crut t _an_fecha }
    ! 8 4
    pedir_w $"/api/pedidos" @ 22 }
  0 }
: s_pedidos ii>i t s {
  ? != s 200 { perdida t s 0 } { ! 11 _ar_json t ! 8 5 pedir_w $"/api/playlists" @ 22 }
  0 }
: s_playlists ii>i t s {
  ? != s 200 { perdida t s 0 } { ! 12 _ar_json t ! 19 0 recente 0 } }
# as 3 playlists mais recentes, inteiras (as que nao vierem ficam de fora)
: recente >i {
  = c idx @ 12 @ 19
  ? && c < @ 19 3 { ! 8 6 pedir_w texto`/api/playlists/{ crut txt c.id }` @ 22 }
    { ! 8 7 pedir_w $"/api/mixes" @ 22 }
  0 }
: s_recente ii>i t s {
  Se == s 200 { ! + @ 13 @ 14 _ar_json t ! 14 + @ 14 1 }
  ! 19 + @ 19 1
  recente 0 }

# ---------- a seccao de uma pessoa ----------
# uma faixa: «artistas — título (versão) · ano · qualidade · bpm · tom · géneros»
: pqual i>i l ? inclui l $"HIRES_LOSSLESS" $"Hi-Res" ? inclui l $"LOSSLESS" $"Sem perdas" $"Normal"
: pcamelot i>i t { Se > t 0 { N + % - t 1 12 1 ? > t 12 "B" "A" } }
: plinha i>i f {
  `{ pjunta f.artistas $", " } — { crut txt f.titulo }`
  Se cheio txt f.versao ` ({ crut txt f.versao })`
  ` · { ? ha f.ano cru f.ano "?" }`
  ` · { crut pqual f.tags }`
  Se ha f.bpm ` · { cru f.bpm } bpm`
  Se ha f.tom ` · { pcamelot I num f.tom }`
  Se > quantos f.generos 0 ` · { pjunta f.generos $"/" }` }
# «- `id` <faixa>», uma por linha (no máximo m)
: pfaixas_id ii>i l m { = c pri l = i 0 W && c < i m { `{ Se i "\n" }- \`{ cru c.id }\` { plinha c }` = c seg c = i + i 1 } }
: pnomemix i>i t ? mesmo t $"descoberta" "Descoberta" ? mesmo t $"diaria" "Diária" ? mesmo t $"lancamentos" "Lançamentos" crut t
# a ultima playlist da semana do Maestro (a primeira da lista, que vem da mais recente)
: semanal i>i l { = c pri l = r 0 W && c ~ r { Se && mesmo txt c.por $"curador" contem txt c.nome $"semana" = r c = c seg c } r }

: seccao >i {
  = pf @ 10 = r pf.resumo = q @ 6
  _an_abre 0
  `# Pessoa: { ? ha pf.utilizador cru pf.utilizador ? ha q.nome cru q.nome crut @ 26 } (\`{ crut @ 26 }\`)\n\n`
  `Conta Tidal: **{ ? ha pf.utilizador cru pf.utilizador "?" }** ({ cru pf.pais }) · { N quantos pf.favoritas } favoritas lidas (as mais recentes) · `
  `{ N quantos pf.artistas } artistas seguidos · { N quantos pf.playlists } playlists tuas.\n\n`
  # o perfil (o que a pessoa disse, o que se aprendeu, os pedidos recentes): o conector já o escreve
  = cx pf.contexto
  Se ha cx `**O perfil desta pessoa** (tem-no em conta em tudo o que fizeres para ela) — { cru cx }\n\n`
  # pedidos a espera
  = np 0 = c pri @ 11
  W c { Se mesmo txt c.estado $"pendente" = np + np 1 = c seg c }
  `## Pedidos à espera ({ N np })\n`
  ? np {
    = c pri @ 11 = pr 1
    W c {
      Se mesmo txt c.estado $"pendente" {
        Se ~ pr "\n"
        = pr 0
        = o c.opcoes
        `- \`{ cru c.id }\` — «{ cru c.texto }» · { cru o.faixas } faixas, máx. { cru o.maxArtista } por artista, estilo { cru o.estilo }, arco { cru o.arco }{ Se ha o.limpa ", sem letras explícitas" } · pedido a { plisboa iso_ms txt c.criadoEm }`
        = af c.afinar
        Se af {
          ` · **{ ? ha af.rever "rever" "afinar" } a playlist «{ cru af.nome }» (\`{ cru af.playlist }\`)**{ Se ha af.rever " — são as faixas parecidas do Tidal, por rever" }`
          = rj af.rejeitadas
          Se > quantos rj 0 ` — tira: { plista rj 100 }` } }
      = c seg c } } "- nenhum"
  "\n\n"
  # a playlist da semana
  "## Playlist da semana\n"
  = u semanal @ 12
  ? u {
    = dd _dt_dia - @ 4 iso_ms txt u.criadaEm
    `A última foi «{ cru u.nome }» há { N dd } dia(s){ ? >= dd 7 " — **está na altura de uma nova**." "." }` } "Ainda não há nenhuma — **cria a primeira**."
  "\n\n"
  # novidades dos artistas que segue
  "## Novidades dos artistas que segues (álbuns dos últimos 7 dias)\n"
  = nv @ 16 = al nv.albuns
  ? > quantos al 0 {
    = c pri al = i 0
    W c { `{ Se i "\n" }- { cru c.data } · { cru c.artista } — «{ cru c.titulo }»` = c seg c = i + i 1 }
    `\n\nFaixas (com o id do Tidal):\n{ pfaixas_id nv.faixas 100000 }` } "- nenhum álbum novo esta semana"
  "\n"
  = lis _dt_lisboa @ 4
  Se && && == _dt_semana _dt_dia lis 5 < / % lis 86400000 3600000 12 >= quantos nv.faixas 5 "\n**É sexta de manhã: cria a playlist «Novidades dos teus artistas · dd/mm»** com estas faixas."
  "\n\n"
  # as mixes do Tidal
  "## As tuas mixes do Tidal (o Tidal escolheu-as para ti; usa-as como candidatas quando encaixam)\n"
  = mx @ 15 = c pri mx.mixes = i 0
  W c {
    Se > quantos c.faixas 0 {
      `{ Se i "\n\n" }### { pnomemix txt c.tipo }\n{ pfaixas_id c.faixas 20 }`
      = i + i 1 }
    = c seg c }
  Se ~ i "- o Tidal não devolveu mixes"
  "\n\n"
  # as tendencias (as tabelas que o conector recolhe todos os dias; o que disso e do gosto da pessoa)
  "## Tendências (o que se está a ouvir: tabelas do Apple Music e do Deezer, recolhidas pelo conector todos os dias)\n"
  = td @ 24
  ? ~ ha td.dias "- ainda sem dados (o conector recolhe as tabelas uma vez por dia)" {
    `Histórico de { cru td.dias } dia(s), desde { cru td.desde }: «a subir» = ganhou 10 ou mais lugares numa semana; «nova» = entrou nos últimos 7 dias; «dura» = 21 dias ou mais na tabela. Usa-as no campo \`tendencia\` das candidatas.\n\n`
    "### Para ti (das tabelas, o que é do teu gosto)\n"
    = c pri td.paraTi = i 0
    Se ~ c "- nada das tabelas encaixa no teu gosto, por agora"
    W c { `{ Se i "\n" }- { cru c.artista } — { cru c.titulo } · { cru c.fonte } n.º { cru c.pos }{ pestado txt c.estado } · { cru c.porque }` = c seg c = i + i 1 }
    = f pri td.fontes
    W f {
      `\n\n### { cru f.nome }\n- Top 10 hoje: `
      = c pri f.itens = i 0
      W && c < i 10 { `{ Se i " · " }{ cru c.pos }. { cru c.artista } — { cru c.titulo }` = c seg c = i + i 1 }
      `\n- A subir: { pcat f $"sobe" 1 }\n- Novas: { pcat f $"nova" 2 }\n- Duram: { pcat f $"dura" 3 }`
      = f seg f } }
  "\n\n"
  # como correram as playlists (o conector avalia-as sozinho) e as que se atualizam sozinhas
  "## Como correram as playlists (automático: faixas que guardaste nas favoritas, que tiraste ou juntaste no Tidal, e artistas delas que o Tidal pôs nas tuas mixes)\n"
  = av @ 25 = lp av.playlists
  = c pri lp = i 0
  Se ~ c "- ainda não há playlists para avaliar"
  W c {
    Se i "\n"
    = a c.avaliacao
    `- «{ cru c.nome }» ({ crut _tx_s16 pdata c 0 10 }){ petq a }`
    = g a.guardadas Se > quantos g 0 ` · guardaste { N quantos g }: { plista g 10 }`
    = g a.tiradas Se > quantos g 0 ` · tiraste { N quantos g }: { plista g 10 }`
    Se ha a.juntadas ` · juntaste { cru a.juntadas }`
    Se > quantos a.eco 0 ` · nas tuas mixes: { pjunta a.eco $", " }`
    = c seg c = i + i 1 }
  "\n\n"
  `### Não voltes a propor (faixas que tiraste das playlists)\n{ ptiradas lp }\n\n`
  `## Playlists que se atualizam sozinhas (ligadas na app)\n{ prenovar lp }\n\n`
  # o gosto
  "## O teu gosto (das favoritas)\n"
  "- Artistas mais presentes: " = c pri r.artistas = i 0
  Se ~ c "—"
  W c { `{ Se i ", " }{ cru c.nome } ({ cru c.n })` = c seg c = i + i 1 }
  "\n- Géneros (etiquetas do Tidal): " = c pri r.generos = i 0
  Se ~ c "o Tidal não indicou"
  W c { `{ Se i ", " }{ cru c.nome } ({ cru c.n })` = c seg c = i + i 1 }
  "\n- Décadas: " = c pri r.decadas = i 0
  Se ~ c "—"
  W c { `{ Se i ", " }{ cru c.decada }s ({ cru c.n })` = c seg c = i + i 1 }
  "\n- Qualidade das favoritas: " = c pri r.qualidade = i 0
  Se ~ c "—"
  W c { `{ Se i ", " }{ cru c.q } { cru c.n }` = c seg c = i + i 1 }
  "\n- Artistas seguidos: " = c pri pf.artistas = i 0
  Se ~ c "—"
  W && c < i 40 { `{ Se i ", " }{ cru c.nome }` = c seg c = i + i 1 }
  "\n- As tuas playlists: " = c pri pf.playlists = i 0
  Se ~ c "—"
  W && c < i 25 { `{ Se i "; " }{ cru c.nome }{ Se > tipo c.faixas 1 ` ({ cru c.faixas })` }` = c seg c = i + i 1 }
  "\n\n### Favoritas mais recentes\n"
  = c pri pf.favoritas = i 0
  Se ~ c "- nenhuma"
  W && c < i 40 { `{ Se i "\n" }- { plinha c }{ Se cheio txt c.adicionada ` · ❤ { crut _tx_s16 txt c.adicionada 0 10 }` }` = c seg c = i + i 1 }
  "\n\n"
  # o que o Maestro ja fez
  "## O que o Maestro já fez (não repetir estas faixas)\n"
  = c pri @ 12 = i 0
  Se ~ c "- ainda nada"
  W && c < i 10 {
    Se i "\n"
    `- { crut _tx_s16 txt c.criadaEm 0 10 } · «{ cru c.nome }» · { cru c.faixas } faixas, { N / I num c.duracao 60 } min{ Se ha c.tidal " · no Tidal" }`
    = c seg c = i + i 1 }
  "\n"
  L i @ 14 {
    Se i "\n"
    = d @ + @ 13 i
    `\n### «{ cru d.nome }» ({ crut _tx_s16 txt d.criadaEm 0 10 })\n`
    = c pri d.faixas = k 0
    W c { `{ Se k "\n" }- { pjunta c.artistas $", " } — { cru c.titulo }` = c seg c = k + k 1 } }
  "\n"
  ! + @ 7 @ 17 _an_fecha ! 17 + @ 17 1 }

# ---------- as tendencias ----------
: pestado i>i t Se cheio t ` · { ? mesmo t $"sobe" "a subir" ? mesmo t $"nova" "nova" "dura" }`
# as (ate 8) da tabela f no estado e: 1 «A — T (semana.º → pos.º)», 2 «A — T (pos.º)», 3 «A — T (dias dias, pos.º)»
: pcat iii>i f e m {
  = c pri f.itens = i 0
  W && c < i 8 {
    Se mesmo txt c.estado e {
      `{ Se i " · " }{ cru c.artista } — { cru c.titulo } (`
      Se == m 1 `{ cru c.semana }.º → `
      Se == m 3 `{ cru c.dias } dias, `
      `{ cru c.pos }.º)`
      = i + i 1 }
    = c seg c }
  Se ~ i "—" }

# ---------- como correram as playlists ----------
# a data da playlist: a da renovacao, ou a da criacao
: pdata i>i c ? cheio txt c.renovadaEm txt c.renovadaEm txt c.criadaEm
: petq i>i a { = e txt a.etiqueta ? || mesmo e $"ainda cedo" mesmo e $"sem sinais" ` · { crut e }` ` · **{ crut e }** (nota { cru a.nota })` }
# ate n faixas «A — T» separadas por «; »
: plista ii>i l n { = c pri l = i 0 W && c < i n { `{ Se i "; " }{ cru c.artista } — { cru c.titulo }` = c seg c = i + i 1 } }
# as tiradas de todas as playlists, sem repetir (ate 40)
: ptiradas i>i lp {
  = vs A 41 = n 0
  = c pri lp
  W c {
    = t pri c.avaliacao.tiradas
    W && t < n 40 {
      = k txt t.id = j 0 = ja 0
      W < j n { Se mesmo txt _ar_get @ + vs j $"id" k = ja 1 = j + j 1 }
      Se ~ ja { ! + vs n t = n + n 1 }
      = t seg t }
    = c seg c }
  ? n { "- " L j n `{ Se j "; " }{ cru _ar_get @ + vs j $"artista" } — { cru _ar_get @ + vs j $"titulo" }` } "- nenhuma" }
# as que se atualizam sozinhas: o criterio, o que fica e o que nao volta
: prenovar i>i lp {
  = c pri lp = i 0
  W c {
    Se ha c.renovar {
      Se i "\n"
      = dias _dt_dia - @ 4 iso_ms pdata c
      `- \`{ cru c.id }\` «{ cru c.nome }» · { ? cheio txt c.renovadaEm "renovada" "criada" } há { N dias } dia(s){ Se >= dias 7 " — **está na altura de a renovar**" }\n`
      = o c.opcoes
      `  - Critério: { Se cheio txt c.pedido `«{ cru c.pedido }» · ` }{ cru o.faixas } faixas, máx. { cru o.maxArtista } por artista, estilo { cru o.estilo }, arco { cru o.arco }{ Se ha o.limpa ", sem letras explícitas" }\n`
      = a c.avaliacao
      "  - Fica (guardaste): " = g pri a.guardadas = k 0
      Se ~ g "—"
      W g { `{ Se k "; " }\`{ cru g.id }\` { cru g.artista } — { cru g.titulo }` = g seg g = k + k 1 }
      "\n  - Não voltes a pôr (tiraste): " = t a.tiradas
      ? > quantos t 0 plista t 30 "—"
      = i + i 1 }
    = c seg c }
  Se ~ i "- nenhuma" }

# ---------- o fim: o dados.md (o cabecalho e as seccoes, separadas por ---) no ficheiro e no ecra ----------
: fim >i {
  _an_abre 0
  `# Maestro — dados de { plisboa @ 4 }\n\n`
  ? > @ 18 1 `**{ N @ 18 } pessoas** na app. Trata cada uma à parte: os pedidos, a playlist da semana e as novidades são de cada pessoa — escreve a proposta em \`{ crut @ 1 }/<id>/proposta.json\` e publica com \`--utilizador <id>\`.` "Uma pessoa na app (o dono)."
  "\n\n"
  L i @ 17 { Se i "\n---\n\n" crut @ + @ 7 i }
  = md _an_fecha
  _an_abre texto`{ crut @ 1 }/dados.md` crut md _an_fecha
  crut md "\n"
  _an_sair 0 }
