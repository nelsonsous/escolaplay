# gerado por tools/gerar_mat.py: a matematica (seno, coseno, exp, log) escrita em Onda, acrescentada quando o programa a usa
: wmat >i "# matematica da Onda em Onda (fdlibm): igual ao bit em C, WebAssembly e x86, e igual ao Math do JavaScript
: _mks ffi>f x y iy {
  = ix & Bh x 0x7fffffff
  ? && < ix 0x3e400000 == I x 0 x
  { = z * x x
    = v * z x
    = r + Bw 0x3F811111 0x1110F8A6 * z + Bw 0xBF2A01A0 0x19C161D5 * z + Bw 0x3EC71DE3 0x57B1FE7D * z + Bw 0xBE5AE5E6 0x8A2B9CEB * z Bw 0x3DE5D93A 0x5ACFD57C
    ? == iy 0 + x * v + Bw 0xBFC55555 0x55555549 * z r - x - - * z - * 0.5 y * v r y * v Bw 0xBFC55555 0x55555549 } }
: _mkc ff>f x y {
  = ix & Bh x 0x7fffffff
  ? && < ix 0x3e400000 == I x 0 1.0
  { = z * x x
    = r * z + Bw 0x3FA55555 0x5555554C * z + Bw 0xBF56C16C 0x16C15177 * z + Bw 0x3EFA01A0 0x19CB1590 * z + Bw 0xBE927E4F 0x809C52AD * z + Bw 0x3E21EE9E 0xBDB4B1C4 * z Bw 0xBDA8FAE9 0xBE8838D4
    ? < ix 0x3FD33333 - 1.0 - * 0.5 z - * z r * x y
    { = qx ? > ix 0x3fe90000 0.28125 Bw - ix 0x00200000 0
      = hz - * 0.5 z qx
      = a - 1.0 qx
      - a - hz - * z r * x y } } }
: _sn f>f x {
  = hx Bh x
  = ix & hx 0x7fffffff
  ? <= ix 0x3FE921FB _mks x 0.0 0
  ? >= ix 0x7FF00000 - x x
  ? > ix 0x413921FB Sn x
  { = n 0
    = y0 0.0
    = y1 0.0
    ? < ix 0x4002D97C { ? > hx 0
        { = z - x Bw 0x3FF921FB 0x54400000
          ? != ix 0x3FF921FB
            { = y0 - z Bw 0x3DD0B461 0x1A626331 = y1 - - z y0 Bw 0x3DD0B461 0x1A626331 }
            { = z - z Bw 0x3DD0B461 0x1A600000 = y0 - z Bw 0x3BA3198A 0x2E037073 = y1 - - z y0 Bw 0x3BA3198A 0x2E037073 }
          = n 1 }
        { = z + x Bw 0x3FF921FB 0x54400000
          ? != ix 0x3FF921FB
            { = y0 + z Bw 0x3DD0B461 0x1A626331 = y1 + - z y0 Bw 0x3DD0B461 0x1A626331 }
            { = z + z Bw 0x3DD0B461 0x1A600000 = y0 + z Bw 0x3BA3198A 0x2E037073 = y1 + - z y0 Bw 0x3BA3198A 0x2E037073 }
          = n -1 } } { = t Ab x
      = n I + * t Bw 0x3FE45F30 0x6DC9C883 0.5
      = fn F n
      = r - t * fn Bw 0x3FF921FB 0x54400000
      = w * fn Bw 0x3DD0B461 0x1A626331
      ? && < n 32 != ix Bh * fn Bw 0x3FF921FB 0x54442D18
        { = y0 - r w 0 }
        { = j >> ix 20
          = y0 - r w
          = i - j & >> Bh y0 20 0x7FF
          ? > i 16
            { = t r
              = w * fn Bw 0x3DD0B461 0x1A600000
              = r - t w
              = w - * fn Bw 0x3BA3198A 0x2E037073 - - t r w
              = y0 - r w
              = i - j & >> Bh y0 20 0x7FF
              ? > i 49
                { = t r
                  = w * fn Bw 0x3BA3198A 0x2E000000
                  = r - t w
                  = w - * fn Bw 0x397B839A 0x252049C1 - - t r w
                  = y0 - r w 0 } 0 } 0 }
      = y1 - - r y0 w
      ? < hx 0 { = y0 * -1.0 y0 = y1 * -1.0 y1 = n - 0 n } 0 }
    = m & n 3
    ? == m 0 _mks y0 y1 1 ? == m 1 _mkc y0 y1 ? == m 2 * -1.0 _mks y0 y1 1 * -1.0 _mkc y0 y1 } }
: _cs f>f x {
  = hx Bh x
  = ix & hx 0x7fffffff
  ? <= ix 0x3FE921FB _mkc x 0.0
  ? >= ix 0x7FF00000 - x x
  ? > ix 0x413921FB Cs x
  { = n 0
    = y0 0.0
    = y1 0.0
    ? < ix 0x4002D97C { ? > hx 0
        { = z - x Bw 0x3FF921FB 0x54400000
          ? != ix 0x3FF921FB
            { = y0 - z Bw 0x3DD0B461 0x1A626331 = y1 - - z y0 Bw 0x3DD0B461 0x1A626331 }
            { = z - z Bw 0x3DD0B461 0x1A600000 = y0 - z Bw 0x3BA3198A 0x2E037073 = y1 - - z y0 Bw 0x3BA3198A 0x2E037073 }
          = n 1 }
        { = z + x Bw 0x3FF921FB 0x54400000
          ? != ix 0x3FF921FB
            { = y0 + z Bw 0x3DD0B461 0x1A626331 = y1 + - z y0 Bw 0x3DD0B461 0x1A626331 }
            { = z + z Bw 0x3DD0B461 0x1A600000 = y0 + z Bw 0x3BA3198A 0x2E037073 = y1 + - z y0 Bw 0x3BA3198A 0x2E037073 }
          = n -1 } } { = t Ab x
      = n I + * t Bw 0x3FE45F30 0x6DC9C883 0.5
      = fn F n
      = r - t * fn Bw 0x3FF921FB 0x54400000
      = w * fn Bw 0x3DD0B461 0x1A626331
      ? && < n 32 != ix Bh * fn Bw 0x3FF921FB 0x54442D18
        { = y0 - r w 0 }
        { = j >> ix 20
          = y0 - r w
          = i - j & >> Bh y0 20 0x7FF
          ? > i 16
            { = t r
              = w * fn Bw 0x3DD0B461 0x1A600000
              = r - t w
              = w - * fn Bw 0x3BA3198A 0x2E037073 - - t r w
              = y0 - r w
              = i - j & >> Bh y0 20 0x7FF
              ? > i 49
                { = t r
                  = w * fn Bw 0x3BA3198A 0x2E000000
                  = r - t w
                  = w - * fn Bw 0x397B839A 0x252049C1 - - t r w
                  = y0 - r w 0 } 0 } 0 }
      = y1 - - r y0 w
      ? < hx 0 { = y0 * -1.0 y0 = y1 * -1.0 y1 = n - 0 n } 0 }
    = m & n 3
    ? == m 0 _mkc y0 y1 ? == m 1 * -1.0 _mks y0 y1 1 ? == m 2 * -1.0 _mkc y0 y1 _mks y0 y1 1 } }
: _xp f>f x {
  = hx Bh x
  = xsb & >> hx 31 1
  = ax & hx 0x7fffffff
  ? && >= ax 0x7FF00000 != | & ax 0xfffff Bl x 0 + x x
  ? >= ax 0x7FF00000 ? == xsb 0 x 0.0
  ? && >= ax 0x40862E42 > x Bw 0x40862E42 0xFEFA39EF * Bw 0x7E37E43C 0x8800759C Bw 0x7E37E43C 0x8800759C
  ? && >= ax 0x40862E42 < x Bw 0xC0874910 0xD52D3051 * Bw 0x01700000 0x00000000 Bw 0x01700000 0x00000000
  ? < ax 0x3E300000 + 1.0 x
  ? == x 1.0 Bw 0x4005BF0A 0x8B145769
  { = k 0
    = hi 0.0
    = lo 0.0
    = y x
    ? > ax 0x3FD62E42
      { ? < ax 0x3FF0A2B2
          { = hi - x ? xsb Bw 0xBFE62E42 0xFEE00000 Bw 0x3FE62E42 0xFEE00000
            = lo ? xsb Bw 0xBDEA39EF 0x35793C76 Bw 0x3DEA39EF 0x35793C76
            = k - - 1 xsb xsb }
          { = k I + * Bw 0x3FF71547 0x652B82FE x ? xsb -0.5 0.5
            = t F k
            = hi - x * t Bw 0x3FE62E42 0xFEE00000
            = lo * t Bw 0x3DEA39EF 0x35793C76 0 }
        = y - hi lo 0 } 0
    = t * y y
    = twopk ? >= k -1021 Bw + 0x3FF00000 << k 20 0 Bw + 0x3FF00000 << + k 1000 20 0
    = c - y * t + Bw 0x3FC55555 0x5555553E * t + Bw 0xBF66C16C 0x16BEBD93 * t + Bw 0x3F11566A 0xAF25DE2C * t + Bw 0xBEBBBD41 0xC5D26BF1 * t Bw 0x3E663769 0x72BEA4D0
    ? == k 0 - 1.0 - / * y c - c 2.0 y
    { = yy - 1.0 - - lo / * y c - 2.0 c hi
      ? >= k -1021 ? == k 1024 * * yy 2.0 Bw 0x7FE00000 0x00000000 * yy twopk * * yy twopk Bw 0x01700000 0x00000000 } } }
: _lg f>f x0 {
  = x x0
  = hx Bh x
  = lx Bl x
  = k 0
  ? && < hx 0x00100000 == | & hx 0x7fffffff lx 0 / * -1.0 Bw 0x43500000 0x00000000 0.0
  ? && < hx 0x00100000 < hx 0 / - x x 0.0
  { ? < hx 0x00100000 { = k - k 54 = x * x Bw 0x43500000 0x00000000 = hx Bh x } 0
    ? >= hx 0x7FF00000 + x x
    { = k + k - >> hx 20 1023
      = hx & hx 0x000FFFFF
      = i & + hx 0x95F64 0x100000
      = x Bw | hx ^ i 0x3FF00000 Bl x
      = k + k >> i 20
      = f - x 1.0
      ? < & 0x000FFFFF + 2 hx 3
        { ? == f 0.0
            ? == k 0 0.0 { = dk F k + * dk Bw 0x3FE62E42 0xFEE00000 * dk Bw 0x3DEA39EF 0x35793C76 }
            { = rv * * f f - 0.5 * Bw 0x3FD55555 0x55555555 f
              ? == k 0 - f rv { = dk F k - * dk Bw 0x3FE62E42 0xFEE00000 - - rv * dk Bw 0x3DEA39EF 0x35793C76 f } } }
        { = s / f + 2.0 f
          = dk F k
          = z * s s
          = i - hx 0x6147A
          = w * z z
          = j - 0x6B851 hx
          = t1 * w + Bw 0x3FD99999 0x9997FA04 * w + Bw 0x3FCC71C5 0x1D8E78AF * w Bw 0x3FC39A09 0xD078C69F
          = t2 * z + Bw 0x3FE55555 0x55555593 * w + Bw 0x3FD24924 0x94229359 * w + Bw 0x3FC74664 0x96CB03DE * w Bw 0x3FC2F112 0xDF3E5244
          = i | i j
          = rv + t2 t1
          ? > i 0
            { = hfsq * * 0.5 f f
              ? == k 0 - f - hfsq * s + hfsq rv - * dk Bw 0x3FE62E42 0xFEE00000 - - hfsq + * s + hfsq rv * dk Bw 0x3DEA39EF 0x35793C76 f }
            ? == k 0 - f * s - f rv - * dk Bw 0x3FE62E42 0xFEE00000 - - * s - f rv * dk Bw 0x3DEA39EF 0x35793C76 f } } } }
"
