# Quicksort recursivo in-place em Onda. Le inteiros (um por linha) do stdin, ordena, imprime um por linha.
# @1 vetor @2 n
: tr ii>i i j { = t @ + @ 1 i ! + @ 1 i @ + @ 1 j ! + @ 1 j t 0 }
: qs ii>i lo hi {
  ? >= lo hi 0 {
    = piv @ + @ 1 hi
    = i lo
    = j lo
    W < j hi { ? <= @ + @ 1 j piv { tr i j = i + i 1 } 0 = j + j 1 }
    tr i hi
    qs lo - i 1
    qs + i 1 hi
    0 } }
: main >i {
  ! 1 A 2000000
  = n 0 = c R
  W >= c 0 {
    ? || && >= c '0 <= c '9 == c '- {
      = v 0 = neg 0
      ? == c '- { = neg 1 = c R } 0
      W && >= c '0 <= c '9 { = v + * v 10 - c '0 = c R }
      ! + @ 1 n ? neg - 0 v v = n + n 1 } { = c R } }
  ! 2 n
  ? > n 0 qs 0 - n 1 0
  = i 0 W < i n { N @ + @ 1 i P 10 = i + i 1 } 0 }
