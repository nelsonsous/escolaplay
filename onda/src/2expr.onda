: lnm i>i j @ + @ 8 * j 2
: lty i>i j @ + + @ 8 * j 2 1
: addl ii>i n y { = p + @ 8 * @ 9 2 ! p n ! + p 1 y ! 9 + @ 9 1 }
: floc i>i i { = k 0 = r -1 W && < r 0 < k @ 9 { ? teq i lnm k = r k 0 = k + k 1 } r }
: nt i>i y { = r @ 11 ! + @ 10 r y ! 11 + r 1 r }
: tty i>i t @ + @ 10 t
: edge i>i k { = p + @ 14 * @ 15 2 ! p @ 13 ! + p 1 k ! 15 + @ 15 1 }
: sighdr i>i k {
  ? @ 12 0 "static "
  ? isjs "function" ety @ fe k 3
  " f_"
  etx @ fe k 0
  "("
  = np @ fe k 2
  ? && == np 0 ~ @ 12 "void" 0
  = j 0
  W < j np { ? > j 0 "," 0 ? isjs "v_" { ety fpt k j " v_" } etx + @ fe k 4 j = j + j 1 }
  ")" }
: cfun i>i k {
  ! 13 k
  ! 9 0
  ! 11 0
  = np @ fe k 2
  = j 0
  W < j np { addl + @ fe k 4 j fpt k j = j + j 1 }
  ! 7 @ fe k 5
  O 16
  ! fe k 8 @ 16
  = r cx
  ? != tty r @ fe k 3 { ebeg "tipo de retorno errado" eend } 0
  ? && < @ 7 @ 4 != tcode @ 7 ': { ebeg "tokens a mais" eend } 0
  "return " et r ";\n}\n"
  ! fe k 9 @ 16
  O 17
  ! fe k 6 @ 17
  sighdr k "{\n"
  = j 0
  W < j @ 11 { ety tty j " " et j "=" ez tty j ";\n" = j + j 1 }
  = j np
  W < j @ 9 { ety lty j " v_" etx lnm j "=" ez lty j ";\n" = j + j 1 }
  ! fe k 7 @ 17
  O 0 }
: lit ii>i i y { = r nt y eq r etx i ";\n" r }
: clit i>i i { ? < tkl i 2 { ebeg "caracter invalido" eend } 0 = r nt 0 eq r N tc i 1 ";\n" r }
: cstr i>i i {
  ? @ 12 "\n#error onda: texto so em CPU\n" 0
  "os(\""
  = s tks i
  = l tkl i
  = j 1
  W < j - l 1 { = c @ + s j ? == c 10 "\\n" ? == c 9 "\\t" ? == c 13 "\\r" P c = j + j 1 }
  "\");\n"
  = r nt 0
  eq r "0;\n"
  r }
: cargs ii>i k sk {
  = n - @ fe k 2 sk
  = a A + n 1
  = j 0
  W < j n { = t cx ? != tty t fpt k + sk j { ebeg "argumento com tipo errado" eend } 0 ! + a j t = j + j 1 }
  a }
: eargs iii>i a n ld { = j 0 W < j n { ? || > j 0 ld "," 0 et @ + a j = j + j 1 } 0 }
: ccall i>i k {
  = a cargs k 0
  = r nt @ fe k 3
  eq r "f_" etx @ fe k 0 "("
  eargs a @ fe k 2 0
  ");\n"
  edge k
  r }
: cid i>i i {
  = j floc i
  ? >= j 0
    { = r nt lty j eq r "v_" etx i ";\n" r }
    { = k ffun i ? < k 0 { ! 7 i ebeg "nome desconhecido" eend } 0 ccall k } }
: cx >i {
  ? >= @ 7 @ 4 { ebeg "fim inesperado" eend } 0
  = i @ 7
  ! 7 + i 1
  = k tkk i
  ? == k 1 lit i 0
  ? == k 2 lit i 1
  ? == k 4 clit i
  ? == k 3 cstr i
  ? == k 0 cid i
  cop i }
: isar i>i o || || == o '+ == o '- || == o '* == o '/
: isbi i>i o || || || == o '% == o '& || == o '| == o '^ || == o k2 '< '< == o k2 '> '>
: iscm i>i o || || || == o '< == o '> || == o k2 '< '= == o k2 '> '= || == o k2 '= '= == o k2 '! '=
: ckint i>i t ? tty t { ebeg "esperava inteiro" eend } 0
: ckflt i>i t ? tty t 0 { ebeg "esperava real" eend }
: ckc i>i t ? tty t { ebeg "condicao deve ser inteira" eend } 0
: mname i>i c ? isjs { ? == c 0 "+" ? == c 1 "Math.trunc" { "Math." ? == c 2 "sqrt" ? == c 3 "sin" ? == c 4 "cos" ? == c 5 "exp" ? == c 6 "log" ? == c 7 "floor" ? == c 8 "abs" ? == c 9 "pow" "atan2" } } {
  ? == c 0 ? @ 12 "float" "(F)"
  ? == c 1 ? @ 12 "int" "(I)"
  ? == c 2 "sqrt"
  ? == c 3 "sin"
  ? == c 4 "cos"
  ? == c 5 "exp"
  ? == c 6 "log"
  ? == c 7 "floor"
  ? == c 8 ? @ 12 "abs" "fabs"
  ? == c 9 "pow"
  ? @ 12 "atan" "atan2" }
: cbin ii>i i m {
  = a cx
  = b cx
  = y tty a
  ? != y tty b { ebeg "tipos diferentes" eend } 0
  ? && == m 0 != y 0 { ebeg "operacao so para inteiros" eend } 0
  = r nt y
  ? && isjs && == y 0 == tcode i '/ { eq r "Math.trunc(" et a "/" et b ");\n" } { eq r et a etx i et b ";\n" }
  r }
: ccmp i>i i {
  = a cx
  = b cx
  ? != tty a tty b { ebeg "tipos diferentes" eend } 0
  = r nt 0
  eq r "(" et a etx i et b ")?1:0;\n"
  r }
: cand >i { = a cx ckc a = r nt 0 eq r "0;\nif(" et a "!=0){\n" = b cx ckc b eq r "(" et b "!=0)?1:0;\n}\n" r }
: cor >i { = a cx ckc a = r nt 0 eq r "1;\nif(" et a "==0){\n" = b cx ckc b eq r "(" et b "!=0)?1:0;\n}\n" r }
: cnot >i { = a cx ckc a = r nt 0 eq r "(" et a "==0)?1:0;\n" r }
: cun iii>i c ti to {
  = a cx
  ? != tty a ti { ebeg ? ti "esperava real" "esperava inteiro" eend } 0
  = r nt to
  eq r mname c "(" et a ");\n"
  r }
: cbf i>i c { = a cx = b cx ckflt a ckflt b = r nt 1 eq r mname c "(" et a "," et b ");\n" r }
: cmm i>i m {
  = a cx
  = b cx
  ? != tty a tty b { ebeg "tipos diferentes" eend } 0
  = r nt tty a
  eq r "(" et a ? m ">" "<" et b ")?" et a ":" et b ";\n"
  r }
: cif >i {
  = c cx
  ckc c
  = r nt 0
  "if(" et c "!=0){\n"
  = a cx
  eq r et a ";\n}else{\n"
  = b cx
  eq r et b ";\n}\n"
  ? != tty a tty b { ebeg "ramos com tipos diferentes" eend } 0
  ! + @ 10 r tty a
  r }
: cwh >i {
  ? @ 12 "while(true){\n" "while(1){\n"
  = c cx
  ckc c
  "if(" et c "==0)break;\n"
  cx
  "}\n"
  = r nt 0
  eq r "0;\n"
  r }
: cblk >i {
  = r -1
  W { ? >= @ 7 @ 4 { ebeg "falta }" eend } 0 != tcode @ 7 '} } = r cx
  ! 7 + @ 7 1
  ? < r 0 { = r nt 0 eq r "0;\n" r } r }
: cset >i {
  = n @ 7
  ? || >= n @ 4 tkk n { ebeg "= precisa de nome" eend } 0
  ! 7 + n 1
  = e cx
  = y tty e
  = j floc n
  ? < j 0 addl n y ? != lty j y { ebeg "tipo de variavel mudou" eend } 0
  "v_" etx n "=" et e ";\n"
  e }
