# emissor NATIVO ARM64 (aarch64) -- a Onda escreve o seu proprio codigo-maquina ARM, sem C nem assembler.
# Irmao do -x (que escreve x86-64), mas para o chip do Mac/iPhone (Apple Silicon) e qualquer ARM64.
# Primeira fatia: nucleo inteiro (literais, + - * / %, & | ^, << >>, comparacoes, locais, ciclos W) e um ELF
# estatico minimo. Cada instrucao = 4 bytes little-endian. Rascunho: x9/x10/x11. Base da moldura: sp.
# Disposicao: slot(local j) = j; slot(temp t) = @9 + t; byte = slot*8. Tudo vive na moldura (sem alocar registos).
# FOLHA: o -a nunca compila o proprio compilador (o ponto fixo faz-se em C/wasm/x86), logo um erro aqui falha
# testes mas NAO pode partir o ponto fixo -- a mesma garantia do vetorizador.

# --- codificadores de instrucoes (hex = encoding exato, conferido com o llvm-objdump) ---
: aslt i>i t * + @ 9 t 8
: asll i>i j * j 8
: ald ii>i rt off x4 | | | 0xF9400000 << / off 8 10 << 31 5 rt
: ast ii>i rt off x4 | | | 0xF9000000 << / off 8 10 << 31 5 rt
: agT ii>i rt t ald rt aslt t
: asT ii>i rt t ast rt aslt t
: agL ii>i rt j ald rt asll j
: asL ii>i rt j ast rt asll j
: aimm ii>i rd v {
  x4 | | 0xD2800000 << & v 0xffff 5 rd
  x4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd
  x4 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd
  x4 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd }
: aadd iii>i rd rn rm x4 | | | 0x8B000000 << rm 16 << rn 5 rd
: asub iii>i rd rn rm x4 | | | 0xCB000000 << rm 16 << rn 5 rd
: amul iii>i rd rn rm x4 | | | 0x9B007C00 << rm 16 << rn 5 rd
: asdiv iii>i rd rn rm x4 | | | 0x9AC00C00 << rm 16 << rn 5 rd
: amsub iiii>i rd rn rm ra x4 | | | | 0x9B008000 << rm 16 << ra 10 << rn 5 rd
: aand iii>i rd rn rm x4 | | | 0x8A000000 << rm 16 << rn 5 rd
: aorr iii>i rd rn rm x4 | | | 0xAA000000 << rm 16 << rn 5 rd
: aeor iii>i rd rn rm x4 | | | 0xCA000000 << rm 16 << rn 5 rd
: alsl iii>i rd rn rm x4 | | | 0x9AC02000 << rm 16 << rn 5 rd
: alsr iii>i rd rn rm x4 | | | 0x9AC02400 << rm 16 << rn 5 rd
: acmp ii>i rn rm x4 | | | 0xEB000000 << rm 16 << rn 5 31
: acset ii>i rd cc x4 | | 0x9A9F07E0 << cc 12 rd
: acc i>i o ? == o '< 0xB ? == o '> 0xC ? == o k2 '< '= 0xD ? == o k2 '> '= 0xA ? == o k2 '= '= 0 1
: asubsp i>i imm x4 | | | 0xD1000000 << imm 10 << 31 5 31
: aaddsp i>i imm x4 | | | 0x91000000 << imm 10 << 31 5 31
: aret >i x4 0xD65F03C0
: ab i>i off x4 | 0x14000000 & / off 4 0x3FFFFFF
: abl i>i off x4 | 0x94000000 & / off 4 0x3FFFFFF
: afs >i & + * 8 + @ 9 @ 11 15 -16
# --- reais (registos d) e arrays em M (base pinada em x28, bump em x27) ---
: aldfr ii>i rt off x4 | | | 0xFD400000 << / off 8 10 << 31 5 rt
: astfr ii>i rt off x4 | | | 0xFD000000 << / off 8 10 << 31 5 rt
: agTf ii>i rt t aldfr rt aslt t
: asTf ii>i rt t astfr rt aslt t
: agLf ii>i rt j aldfr rt asll j
: asLf ii>i rt j astfr rt asll j
: afadd iii>i rd rn rm x4 | | | 0x1E602800 << rm 16 << rn 5 rd
: afsub iii>i rd rn rm x4 | | | 0x1E603800 << rm 16 << rn 5 rd
: afmul iii>i rd rn rm x4 | | | 0x1E600800 << rm 16 << rn 5 rd
: afdiv iii>i rd rn rm x4 | | | 0x1E601800 << rm 16 << rn 5 rd
: afmovxd ii>i rd rn x4 | | 0x9E670000 << rn 5 rd
: ascvtf ii>i rd rn x4 | | 0x9E620000 << rn 5 rd
: afcvtzs ii>i rd rn x4 | | 0x9E780000 << rn 5 rd
: aldrx iii>i rt rn rm x4 | | | 0xF8607800 << rm 16 << rn 5 rt
: astrx iii>i rt rn rm x4 | | | 0xF8207800 << rm 16 << rn 5 rt
: aldrdx iii>i rt rn rm x4 | | | 0xFC607800 << rm 16 << rn 5 rt
: astrdx iii>i rt rn rm x4 | | | 0xFC207800 << rm 16 << rn 5 rt
: afbits i>i tok { !f 24 fltval tok @ 24 }
: aaddi iii>i rd rn imm x4 | | | 0x91000000 << imm 10 << rn 5 rd
: aaddlsl iiii>i rd rn rm sh x4 | | | | 0x8B000000 << rm 16 << sh 10 << rn 5 rd
: abcc ii>i cc off x4 | | 0x54000000 << & / off 4 0x7FFFF 5 cc
# --- NEON (v.2d, 2 doubles por instrucao): o mapa vetorizado. x em v1; constantes em v2..v9 (via salloc); x12 rascunho ---
# emissores conscientes da largura w: 2 = par (q/.2d), 1 = escalar (d). Por-lane = escalar, logo bit-exato.
: vfld iii>i w rt rn ? == w 2 x4 | | 0x3DC00000 << rn 5 rt x4 | | 0xFD400000 << rn 5 rt
: vfst iii>i w rt rn ? == w 2 x4 | | 0x3D800000 << rn 5 rt x4 | | 0xFD000000 << rn 5 rt
: vfb iii>i w r bits { aimm 12 bits ? == w 2 { x4 | | 0x4E080C00 << 12 5 r } { afmovxd r 12 } }
: vfbin iiiii>i w o rd rn rm ? == w 2
  { ? == o '+ x4 | | | 0x4E60D400 << rm 16 << rn 5 rd ? == o '- x4 | | | 0x4EE0D400 << rm 16 << rn 5 rd ? == o '* x4 | | | 0x6E60DC00 << rm 16 << rn 5 rd x4 | | | 0x6E60FC00 << rm 16 << rn 5 rd }
  { ? == o '+ afadd rd rn rm ? == o '- afsub rd rn rm ? == o '* afmul rd rn rm afdiv rd rn rm }
: avreg i>i s + salloc s 2
: avfree ii>i s r ? >= r 2 sfree s - r 2 0
: avem ii>i w s {
  = i @ 7
  ! 7 + i 1
  = kk tkk i
  ? == kk 2 { = r avreg s vfb w r afbits i r }
  ? == kk 0 1
  { = o tcode i
    = sA @ 7 xskip = sB @ 7 xskip = af @ 7
    ! 7 sB = rb avem w s
    ! 7 sA = ra avem w s
    ! 7 af
    = rd avreg s
    vfbin w o rd ra rb
    avfree s ra avfree s rb
    rd } }
# mapa vetorizado NEON: dst(a) count(b) elemento(c) fonte(x). Laco de pares (passo 2) + cauda escalar (n impar).
: amap i>i p {
  = d @ + p 2
  = n @ + p 3
  = k @ + p 4
  = sb @ + p 5
  = rs + @ fe k 5 7
  = s7 @ 7
  = stw A 1
  agT 13 d agT 14 n agT 15 sb aimm 9 0
  = l1 @ 16
  aaddi 10 9 1 acmp 10 14
  = p1 @ 16 abcc 0xA 0
  aadd 10 15 9 aaddlsl 11 28 10 3 vfld 2 1 11
  ! stw 255 ! 7 rs = rr avem 2 stw
  aadd 10 13 9 aaddlsl 11 28 10 3 vfst 2 rr 11
  aaddi 9 9 2 ab - l1 @ 16
  xput4 p1 | | 0x54000000 << & / - @ 16 p1 4 0x7FFFF 5 0xA
  = l2 @ 16
  acmp 9 14
  = p2 @ 16 abcc 0xA 0
  aadd 10 15 9 aaddlsl 11 28 10 3 vfld 1 1 11
  ! stw 255 ! 7 rs = rr2 avem 1 stw
  aadd 10 13 9 aaddlsl 11 28 10 3 vfst 1 rr2 11
  aaddi 9 9 1 ab - l2 @ 16
  xput4 p2 | | 0x54000000 << & / - @ 16 p2 4 0x7FFFF 5 0xA
  ! 7 s7 }

# --- pilha de ciclos (nested W): @63 = array; [0] = profundidade; cada moldura = (inicio, pos_do_cbz) ---
: adep >i @ @ 63
: afrm i>i i + @ 63 + 1 * i 2
: a21 >i { = d adep = f afrm d ! f @ 16 ! + f 1 0 ! @ 63 + d 1 }
: a22 i>i a { agT 9 a = f afrm - adep 1 ! + f 1 @ 16 x4 0xB4000009 }
: a23 >i { = f afrm - adep 1 ab - @ f @ 16 = cp @ + f 1 xput4 cp | | 0xB4000000 << & / - @ 16 cp 4 0x7FFFF 5 9 ! @ 63 - adep 1 }

: ains i>i p {
  = k @ p
  = d @ + p 1
  = a @ + p 2
  = b @ + p 3
  = c @ + p 4
  ? == k 1 { ? tty d { aimm 9 afbits a afmovxd 0 9 asTf 0 d } { aimm 9 tokval a asT 9 d } }
  ? == k 2 { aimm 9 a asT 9 d }
  ? == k 4 { ? tty d { afmovxd 0 31 asTf 0 d } { aimm 9 0 asT 9 d } }
  ? == k 5 { ? tty d { agLf 0 b asTf 0 d } { agL 9 b asT 9 d } }
  ? == k 6 { ? tty b { agTf 0 b asLf 0 c } { agT 9 b asL 9 c } }
  ? == k 8 { = o opof a ? tty d
    { agTf 0 b agTf 1 c ? == o '+ afadd 0 0 1 ? == o '- afsub 0 0 1 ? == o '* afmul 0 0 1 ? == o '/ afdiv 0 0 1 { ebeg "operador real ainda nao em -a" eend } asTf 0 d }
    { agT 9 b agT 10 c
      ? == o '+ aadd 9 9 10 ? == o '- asub 9 9 10 ? == o '* amul 9 9 10 ? == o '/ asdiv 9 9 10
      ? == o '% { asdiv 11 9 10 amsub 9 11 10 9 } ? == o '& aand 9 9 10 ? == o '| aorr 9 9 10
      ? == o '^ aeor 9 9 10 ? == o k2 '< '< alsl 9 9 10 ? == o k2 '> '> alsr 9 9 10
      { ebeg "operador ainda nao em -a" eend } asT 9 d } }
  ? == k 9 { ? tty b { ebeg "comparacao de reais ainda nao em -a" eend } 0 agT 9 b agT 10 c acmp 9 10 acset 9 ^ acc opof a 1 asT 9 d }
  ? == k 15 { ? == a 0 { agT 9 b ascvtf 0 9 asTf 0 d } ? == a 1 { agTf 0 b afcvtzs 9 0 asT 9 d } { ebeg "funcao matematica ainda nao em -a" eend } }
  ? == k 21 a21
  ? == k 22 a22 a
  ? == k 23 a23
  ? == k 24 { agT 9 a aldrx 10 28 9 asT 10 d }
  ? == k 25 { agT 9 a agT 10 b astrx 10 28 9 }
  ? == k 26 { agT 9 a aldrdx 0 28 9 asTf 0 d }
  ? == k 27 { agT 9 a agTf 0 b astrdx 0 28 9 }
  ? == k 28 { agT 9 a asT 27 d aadd 27 27 9 }
  ? == k 53 amap p
  ? == k 41 { ? tty a { agTf 0 a } { agT 0 a } aaddsp afs aret }
  { ebeg "operacao ainda nao suportada em -a" eend } }
: afun i>i k {
  = np @ fe k 2
  ? > np 8 { ebeg "mais de 8 parametros ainda nao em -a" eend } 0
  O 16
  ! fe k 8 @ 16
  asubsp afs
  = j 0
  W < j np { asL j j = j + j 1 }
  = j 0
  W < j @ 19 { ains + @ 18 * j 8 = j + j 1 }
  ! fe k 9 @ 16
  O 0 }
: amain >i { = k 0 = r -1 W < k @ 6 { ? ismain k = r k 0 = k + k 1 } r }
: outa >i {
  = mi amain
  # o stub de entrada ocupa 44 bytes (2 aimm = 8 instr + bl + mov + svc); o bl esta no byte 32
  = moff 44
  = k 0
  W < k mi { = moff + moff - @ fe k 9 @ fe k 8 = k + k 1 }
  = clen 44
  = k 0
  W < k @ 6 { = clen + clen - @ fe k 9 @ fe k 8 = k + k 1 }
  # 2 cabecalhos de programa (2*56) a seguir ao cabecalho ELF (64) -> codigo no byte 176
  = fsz + 176 clen
  = base 4194304
  = mbase 268435456
  # cabecalho ELF (64 bytes): aarch64, ET_EXEC, 2 segmentos, entry = base+176
  P 127 P 'E P 'L P 'F P 2 P 1 P 1 P 0 x8 0
  wword 2 2 wword 183 2 x4 1 x8 + base 176
  x8 64 x8 0 x4 0
  x4 | 64 << 56 16 x4 2 x4 0
  # segmento 1 (56 bytes): PT_LOAD RX -- cabecalhos + codigo
  x4 1 x4 5 x8 0 x8 base x8 base x8 fsz x8 fsz x8 4096
  # segmento 2 (56 bytes): PT_LOAD RW -- M (heap), BSS puro (filesz 0, memsz 256 MiB) em mbase
  x4 1 x4 6 x8 0 x8 mbase x8 mbase x8 0 x8 mbase x8 4096
  # stub de entrada: x28 = base de M ; x27 = bump = 0 ; bl main ; exit(x0)
  aimm 28 mbase
  aimm 27 0
  abl - moff 32
  x4 | | 0xD2800000 << 93 5 8
  x4 0xD4000001
  # corpo de cada funcao
  = k 0
  W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  0 }
