# Mercados — a vista dos Destaques em Onda. Desde a 4.8.0 é a Onda a referência desta vista (o viewHighlights do JS saiu).
# Simples, como a Análise e a Música: o sentimento do mercado numa linha que abre (com os índices do dia); UMA lista por
# secção — os meus ativos hoje, o que mais sobe e o que mais cai do que sigo —, com as linhas do Painel: o ícone, o nome, o
# porquê numa linha pequena (o motivo do Claude, com o ponto dele, ou a notícia do dia, com o ponto da cor do tom; sem
# porquê, o símbolo), o preço e a variação DO DIA (data-chg="day": também ao vivo, seja qual for o período do Painel); e o
# resto em linhas fechadas no fim, cada uma com uma linha de resumo: o mercado dos EUA (as maiores subidas e descidas) e
# a cripto hoje (medo e ganância, valor, dominância e volume). A partir do instantâneo que o highlightsSnap monta (ver lá
# o que vai nele e o que vai já feito). Os eventos continuam no JS (data-open, data-fold…).
# Entrada: `ecra_destaques s`, com s o instantâneo (ecra.onda); saída: o HTML no stdout. As chaves do instantâneo e os
# textos com que se compara são textos constantes ($"…").
# As listas filtram-se e ordenam-se com o comparador que o JS usava e o sort do V8 (ts_ordena de ecra.onda).
# Nomes: hl_*.

# o motivo do Claude para kn: o why do primeiro dos CLAUDE.movers com s === kn (o moverWhy do JS), ou 0
: hl_cl i>i kn { = c pri es.why = r 0 W && c ~ r { Se && == tipo c 7 igual c.s kn = r c = c seg c } ? r r.why 0 }
# o 1.º objeto de uma lista, e quantos objetos tem (até m)
: hl_obj i>i l { = c pri l W && c != tipo c 7 = c seg c c }
: hl_nobj ii>i l m { = c pri l = j 0 W && c < j m { Se == tipo c 7 = j + j 1 = c seg c } j }

# ===== pedaços =====
# um tom dos dados: 'up', 'down' ou 'flat'; e o de um código (1 up, 2 down)
: hl_tom i>i n ? eh n $"up" "up" ? eh n $"down" "down" "flat"
: hl_t3 i>i t ? == t 1 "up" ? == t 2 "down" "flat"
# um nó como real (NaN se não é número)
: hl_num i>f n ? == tipo n 4 @f + n 1 / 0. 0.
# o fmtPx(price, a, cur) do mercados.js, com a moeda pela ordem do JS: cur || Q[a.key].currency || (cripto ? cfg.fiat : null)
: hl_preco iii>i pn a cu {
  = m ? ha cu cu ? && a ha a.qc a.qc ? && a eh a.kind $"crypto" es.fiat 0
  ? == tipo pn 4 fm_px @f + pn 1 ? a a.dec 0 ? a a.pts 0 m "—" }
# o porquê, numa linha pequena: o motivo do Claude (com o ponto dele) ou o título da 1.ª notícia (com o ponto da cor do
# tom); dá 1 se escreveu, 0 se não há porquê
: hl_porque ii>i kn a {
  = w hl_cl kn
  ? ha w { `<span class="hl-w cl">{ esc w }</span>` 1 } {
    = n ? a a.n1 0 = t n.title
    ? ha t { `<span class="hl-w { hl_tom n.tone }">{ esc t }</span>` 1 } 0 } }

# ===== as linhas: as do Painel (ícone, nome, a linha pequena, preço e variação do dia) =====
: hl_linha i>i a {
  = k a.k = nm a.name = s a.sym
  `\n            <button type="button" class="row hl-row" data-open="{ esc k }" data-key="{ esc k }" data-chg="day">`
  ln_ico k nm ? eh a.kind $"crypto" s 0 0
  `<div class="r-main"><div class="r-name">{ esc nm }</div><div class="r-sub">`
  ? hl_porque k a 0 ? ha s esc s esc k
  `</div></div><div class="r-px num"><span class="px">{ hl_preco a.px a a.cur }</span>{ ln_chg a.chg }</div></button>` }
# uma da lista dos EUA (q: { symbol, name, price, changePct, volume, currency }, o que o conector manda; a é o ativo, se
# também está nas listas da app); sem porquê, o símbolo e o volume
: hl_linhaq i>i q {
  = k q.symbol = a ln_ativo k = n0 q.name = nm ? ha n0 n0 k
  `\n            <button type="button" class="row hl-row" data-open="{ esc k }" data-key="{ esc k }" data-chg="day" data-name="{ Se ha n0 esc n0 }">`
  ln_ico k nm 0 0
  `<div class="r-main"><div class="r-name">{ esc nm }</div><div class="r-sub">`
  ? hl_porque k a 0 {
      = s ? a a.sym 0 ? ha s esc s esc k
      = v q.volume Se ln_fin v ` · vol. { _nu_compacto @f + v 1 }` }
  `</div></div><div class="r-px num"><span class="px">{ hl_preco q.price a q.currency }</span>{ ln_chg q.changePct }</div></button>` }

# ===== em cima: o sentimento do mercado, numa linha (o tom e os índices do dia); ao abrir, o que o explica =====
# um índice do dia (a chave t, o nome nm): "S&P 500 −0,42%", com " · " antes se não é o primeiro (f); dá 1 se escreveu
: hl_ind iii>i t nm f {
  = a ln_ativot t = v ? a a.chg 0
  ? ln_fin v { `{ Se f " · " }{ esct nm } <span class="{ ln_tom @f + v 1 }-t">{ fm_pct @f + v 1 }</span>` 1 } 0 }
: hl_humor >i {
  = m es.mood
  ? ~ ha m 0 {
    `\n        <details class="an-f hl-mood" data-fold="hl-mood" { Se ha es.foldMood "open" }><summary><span class="f-t">Sentimento do mercado<small>`
    = n hl_ind $"^GSPC" $"S&P 500" 0
    = n + n hl_ind $"^IXIC" $"Nasdaq" n
    = n + n hl_ind $"^STOXX50E" $"Euro Stoxx" n
    ? n 0 esc m.hint
    `</small></span><span class="f-n { hl_tom m.tone }-t">{ esc m.label }</span></summary>`
    Se n `<p class="hl-hint">{ esc m.hint }</p>`
    `<ul class="hl-rz">`
    = c pri m.reasons W c { `<li class="{ hl_tom c.tone }">{ esc c.txt }</li>` = c seg c }
    "</ul></details>" } }

# ===== as listas =====
# os meus ativos hoje (o holdingKeys(), pela ordem dos Ajustes)
: hl_meus >i {
  = l es.mine = w A + quantos l 1 = m 0
  = c pri l W c { = a ln_ativo c Se a { ! + w m a = m + m 1 } = c seg c }
  Se m {
    `\n        <section class="sec"><div class="sec-h"><h2>Os meus ativos hoje</h2></div><div class="list">`
    L j m hl_linha @ + w j
    "</div></section>" } }
# as linhas b[w[0..m-1]]
: hl_lista iii>i b w m { `<div class="list">` L j m hl_linha @ + b @ + w j "</div>" }
# o que mais sobe e o que mais cai hoje do que sigo (fora os meus): os da lista (listed: nem temporário nem auxiliar), sem
# os índices, com a variação do dia finita; os 5 primeiros de cada lado pela variação
: hl_movem >i {
  = l es.assets = n quantos l = b A + n 1 = k1 A + n 1 = wu A + n 1 = wd A + n 1 = nu 0 = nd 0 = mi es.mine
  = c pri l = i 0
  W c {
    ! + b i c
    = kd c.kind = v c.chg
    Se && && && && ~ ha c.temp ~ eh kd $"aux" ~ eh kd $"index" ln_fin v ~ _ar_tem mi c.k {
        = x @f + v 1 !f + k1 i x
        ? > x 0. { ! + wu nu i = nu + nu 1 0 } Se < x 0. { ! + wd nd i = nd + nd 1 } }
    = c seg c = i + i 1 }
  # sort((a, b) => V[b].changePct - V[a].changePct) e sort((a, b) => V[a].changePct - V[b].changePct)
  _or_power wu nu k1 0 0 _or_power wd nd k1 0 1
  `\n        <section class="sec"><div class="sec-h"><h2>Mais sobem</h2></div>`
  ? nu hl_lista b wu ? > nu 5 5 nu `<div class="empty">Nada a subir hoje.</div>`
  `</section>\n        <section class="sec"><div class="sec-h"><h2>Mais caem</h2></div>`
  ? nd hl_lista b wd ? > nd 5 5 nd `<div class="empty">Nada a cair hoje.</div>`
  "</section>" }

# ===== em baixo, em linhas fechadas (details com data-fold: ficam como o utilizador as deixou) =====
# o mercado dos EUA (a lista do conector, que se pede ao abrir os Destaques): numa linha, o que mais sobe e o que mais
# cai; lá dentro as 5 maiores subidas e as 5 maiores descidas
: hl_qres i>i q { = n0 q.name = v q.changePct
  `{ ? ha n0 esc n0 esc q.symbol } <span class="{ ln_tom hl_num v }-t">{ fm_pctv v }</span>` }
: hl_qrows ii>i l m { `<div class="list">` = c pri l = j 0 W && c < j m { Se == tipo c 7 { hl_linhaq c = j + j 1 } = c seg c } "</div>" }
: hl_eua >i ? ~ ha es.proxy 0 {
  = mv es.mv = g mv.gainers = l mv.losers = ng hl_nobj g 5 = nl hl_nobj l 5 = e es.err
  ? && ha mv ~ || ng nl 0 {
    `\n        <details class="an-f" data-fold="hl-eua" { Se ha es.foldEua "open" }><summary><span class="f-t">Mercado dos EUA<small>`
    ? ha mv {
        = a hl_obj g = z hl_obj l
        Se a hl_qres a Se && a z " · " Se z hl_qres z
        "</small></span></summary>"
        Se ng `<div class="grp-h">Sobem</div>{ hl_qrows g 5 }`
        Se nl `<div class="grp-h">Caem</div>{ hl_qrows l 5 }` } {
        ? ha e "Indisponível" "A carregar…"
        `</small></span></summary><div class="empty">{ ? ha e { `Não deu para ler a lista: { esc e }` 0 } "A carregar…" }</div>` }
    "</details>" } }
# a cripto hoje (o mercado cripto todo, do conector): numa linha, o medo e ganância e quanto o valor do mercado mexeu em
# 24 h; lá dentro os 4 números
: hl_fng i>i t ? eh t $"Extreme Fear" "Medo extremo" ? eh t $"Fear" "Medo" ? eh t $"Neutral" "Neutro"
  ? eh t $"Greed" "Ganância" ? eh t $"Extreme Greed" "Ganância extrema" esc t
# um valor em euros: o em euros, se o há (fin), ou o em dólares a dividir pelo EUR/USD (eu, se é verdade)
: hl_eur iii>f a u eu ? ln_fin a @f + a 1 ? && ln_fin u ha eu / @f + u 1 num eu / 0. 0.
: hl_cripto >i {
  = g es.cg
  ? ~ ha g 0 {
    = f g.fng = fv ha f = eu es.eu
    = mc hl_eur g.mcap g.mcapUsd eu = vo hl_eur g.vol g.volUsd eu
    = bd g.btcDom = ch g.mcapChg = fc ln_fin ch
    # f.v < 45 'down', > 55 'up', senão 'flat'
    = x num f.v = ft ? < x 45. 2 ? > x 55. 1 0
    ? ~ || || || fv fin mc ln_fin bd fin vo 0 {
      `\n        <details class="an-f" data-fold="hl-cripto" { Se ha es.foldCg "open" }><summary><span class="f-t">Cripto hoje<small>`
      Se fv hl_fng f.label
      Se fc `{ Se fv " · " }mercado <span class="{ ln_tom @f + ch 1 }-t">{ fm_pct @f + ch 1 }</span> em 24 h`
      ? || fv fc 0 "Valor, dominância e volume"
      "</small></span>"
      Se fv `<span class="f-n { hl_t3 ft }-t">{ esc f.v }</span>`
      `</summary><div class="cg">`
      Se fv { `<div><small>Medo e ganância</small><b class="num"><span class="{ hl_t3 ft }-t">{ esc f.v }</span></b><em>{ hl_fng f.label }`
          = pr f.prev `{ Se ln_fin pr ` · ontem { _nu_ps @f + pr 1 }` }</em></div>` }
      Se fin mc { `<div><small>Valor do mercado</small><b class="num">{ _nu_compacto mc }{ P 194 }{ P 160 }€</b>`
          `{ Se fc `<em><span class="{ ln_tom @f + ch 1 }-t">{ fm_pct @f + ch 1 }</span> em 24 h</em>` }</div>` }
      Se ln_fin bd { `<div><small>Dominância do Bitcoin</small><b class="num">{ _nu_intlm @f + bd 1 1 }%</b>`
          = ed g.ethDom `{ Se ln_fin ed `<em>Ether { _nu_intlm @f + ed 1 1 }%</em>` }</div>` }
      Se fin vo `<div><small>Volume 24 h</small><b class="num">{ _nu_compacto vo }{ P 194 }{ P 160 }€</b></div>`
      `</div><p class="note">Medo e ganância: 0 = medo extremo, 100 = ganância extrema (com medo, os preços costumam estar mais baixos). Dominância a subir = o dinheiro foge das outras moedas para o Bitcoin.</p></details>` } } }

# ===== a vista =====
: ecra_destaques i>i s {
  ! 53 s
  hl_humor hl_meus hl_movem hl_eua hl_cripto
  0 }
