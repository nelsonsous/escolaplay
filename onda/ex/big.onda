# Aritmetica de precisao arbitraria em Onda: calcula N! exato, para alem do limite do int64 (que faz fib(93) dar a
# volta). O numero grande e um vetor de "dígitos" na base 10^9, do menos para o mais significativo. uso: big N
: numa i>i i { = v 0 = j 0 W && >= Av i j '0 <= Av i j '9 { = v - + * v 10 Av i j '0 = j + j 1 } v }
# multiplica o numero grande (b, comprimento len) por um inteiro pequeno m; devolve o novo comprimento
: mulp iii>i b len m {
  = base 1000000000
  = carry 0
  = i 0
  W < i len { = p + * @ + b i m carry ! + b i % p base = carry / p base = i + i 1 }
  W > carry 0 { ! + b len % carry base = carry / carry base = len + len 1 }
  len }
# imprime o numero grande (digito mais significativo sem zeros a esquerda, os outros com 9 casas)
: noved ii>i x casas { = d 1 = i 1 W < i casas { = d * d 10 = i + i 1 } W > d 0 { P + '0 % / x d 10 = d / d 10 } 0 }
: escreve ii>i b len { = i - len 1 N @ + b i = i - i 1 W >= i 0 { noved @ + b i 9 = i - i 1 } 0 }
: main >i {
  = n ? >= Ac 2 numa 1 100
  = b A 4000
  ! b 1
  = len 1
  = k 2
  W <= k n { = len mulp b len k = k + k 1 }
  N n "! = " escreve b len P 10 0 }
