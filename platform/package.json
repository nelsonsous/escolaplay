{
  "name": "escolaplay-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: core partilhado (conteudo + motor) consumido por web e mobile",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mobile": "pnpm --filter @escolaplay/core build && pnpm --filter @escolaplay/mobile start",
    "mobile:ios": "pnpm --filter @escolaplay/core build && pnpm --filter @escolaplay/mobile start:ios",
    "simulator": "bash setup-simulator.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-native": "0.81.4"
    }
  }
}
