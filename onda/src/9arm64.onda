  = j 0
  W < j nr {
    = q @ + @ 66 + 1 * j 2
    = s @ + @ 66 + 2 * j 2
    = ro - + elen q @ fe 0 8
    xput4 q | 0x94000000 & / - + st0 * 12 s ro 4 0x3FFFFFF
    = j + j 1 }
