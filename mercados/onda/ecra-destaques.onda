# Mercados — a vista dos Destaques em Onda. Desde a 4.8.0 é a Onda a referência desta vista (o viewHighlights do JS saiu).
# Simples, como a Análise e a Música: o sentimento do mercado numa linha que abre (com os índices do dia); UMA lista por
# secção — os meus ativos hoje, o que mais sobe e o que mais cai do que sigo —, com as linhas do Painel: o ícone, o nome, o
# porquê numa linha pequena (o motivo do Claude, com o ponto dele, ou a notícia do dia, com o ponto da cor do tom; sem
# porquê, o símbolo), o preço e a variação DO DIA (data-chg="day": também ao vivo, seja qual for o período do Painel); e o
# resto em linhas fechadas no fim, cada uma com uma linha de resumo: o mercado dos EUA (as maiores subidas e descidas) e
# a cripto hoje (medo e ganância, valor, dominância e volume). A partir do instantâneo que o highlightsSnap monta (ver lá
# o que vai nele e o que vai já feito). Os eventos continuam no JS (data-open, data-fold…).
# Entrada: `ecra_destaques s`, com s o instantâneo (ecra.onda); saída: o HTML no stdout. As chaves do instantâneo e os
# textos com que se compara são textos constantes ($"…").
# As listas filtram-se e ordenam-se com o comparador que o JS usava e o sort do V8 (ts_ordena de ecra.onda).
# Nomes: hl_*.

# ===== procurar =====
# o ativo (um dos assets, pela ordem de Object.keys(REG)) com a chave do nó kn (k === kn), ou 0
: hl_ativo i>i kn { = c _ar_prim sg $"assets" = r 0 W && c ~ r { ? _ar_igual _ar_get c $"k" kn = r c 0 = c _ar_prox c } r }
# … com a chave do texto t
: hl_ativot i>i t { = c _ar_prim sg $"assets" = r 0 W && c ~ r { ? _ar_eqt _ar_get c $"k" t = r c 0 = c _ar_prox c } r }
# o motivo do Claude para kn: o why do primeiro dos CLAUDE.movers com s === kn (o moverWhy do JS), ou 0
: hl_cl i>i kn { = c _ar_prim sg $"why" = r 0 W && c ~ r { ? && == _ar_tipo c 7 _ar_igual _ar_get c $"s" kn = r c 0 = c _ar_prox c } ? r _ar_get r $"why" 0 }
# o 1.º objeto de uma lista, e quantos objetos tem (até m)
: hl_obj i>i l { = c _ar_prim l W && c != _ar_tipo c 7 = c _ar_prox c c }
: hl_nobj ii>i l m { = c _ar_prim l = j 0 W && c < j m { ? == _ar_tipo c 7 = j + j 1 0 = c _ar_prox c } j }

# ===== pedaços =====
# um tom dos dados: 'up', 'down' ou 'flat'; e o de um código (1 up, 2 down)
: hl_tom i>i n ? _ar_eqt n $"up" "up" ? _ar_eqt n $"down" "down" "flat"
: hl_t3 i>i t ? == t 1 "up" ? == t 2 "down" "flat"
# um nó como real (NaN se não é número), e se é um número finito (o fin do JS)
: hl_num i>f n ? == _ar_tipo n 4 @f + n 1 / 0. 0.
: hl_fin i>i n && == _ar_tipo n 4 _nu_fin @f + n 1
# o fmtPx(price, a, cur) do mercados.js, com a moeda pela ordem do JS: cur || Q[a.key].currency || (cripto ? cfg.fiat : null)
: hl_preco iii>i pn a cu {
  = m ? _ar_verd cu cu ? && a _ar_verd _ar_get a $"qc" _ar_get a $"qc" ? && a _ar_eqt _ar_get a $"kind" $"crypto" sg $"fiat" 0
  ? == _ar_tipo pn 4 fm_px @f + pn 1 ? a _ar_get a $"dec" 0 ? a _ar_get a $"pts" 0 m "—" }
# o porquê, numa linha pequena: o motivo do Claude (com o ponto dele) ou o título da 1.ª notícia (com o ponto da cor do
# tom); dá 1 se escreveu, 0 se não há porquê
: hl_porque ii>i kn a {
  = w hl_cl kn
  ? _ar_verd w { "<span class=\"hl-w cl\">" _ar_ps w 1 "</span>" 1 } {
    = n ? a _ar_get a $"n1" 0 = t _ar_get n $"title"
    ? _ar_verd t { "<span class=\"hl-w " hl_tom _ar_get n $"tone" "\">" _ar_ps t 1 "</span>" 1 } 0 } }

# ===== as linhas: as do Painel (ícone, nome, a linha pequena, preço e variação do dia) =====
: hl_linha i>i a {
  = k _ar_get a $"k" = nm _ar_get a $"name" = s _ar_get a $"sym"
  "\n            <button type=\"button\" class=\"row hl-row\" data-open=\"" _ar_ps k 1 "\" data-key=\"" _ar_ps k 1 "\" data-chg=\"day\">"
  ln_ico k nm ? _ar_eqt _ar_get a $"kind" $"crypto" s 0 0
  "<div class=\"r-main\"><div class=\"r-name\">" _ar_ps nm 1 "</div><div class=\"r-sub\">"
  ? hl_porque k a 0 ? _ar_verd s _ar_ps s 1 _ar_ps k 1
  "</div></div><div class=\"r-px num\"><span class=\"px\">" hl_preco _ar_get a $"px" a _ar_get a $"cur" "</span>" ln_chg _ar_get a $"chg" "</div></button>" 0 }
# uma da lista dos EUA (q: { symbol, name, price, changePct, volume, currency }, o que o conector manda; a é o ativo, se
# também está nas listas da app); sem porquê, o símbolo e o volume
: hl_linhaq i>i q {
  = k _ar_get q $"symbol" = a hl_ativo k = n0 _ar_get q $"name" = nm ? _ar_verd n0 n0 k
  "\n            <button type=\"button\" class=\"row hl-row\" data-open=\"" _ar_ps k 1 "\" data-key=\"" _ar_ps k 1 "\" data-chg=\"day\" data-name=\"" ? _ar_verd n0 _ar_ps n0 1 0 "\">"
  ln_ico k nm 0 0
  "<div class=\"r-main\"><div class=\"r-name\">" _ar_ps nm 1 "</div><div class=\"r-sub\">"
  ? hl_porque k a 0 {
      = s ? a _ar_get a $"sym" 0 ? _ar_verd s _ar_ps s 1 _ar_ps k 1
      = v _ar_get q $"volume" ? hl_fin v { " · vol. " _nu_compacto @f + v 1 0 } 0 }
  "</div></div><div class=\"r-px num\"><span class=\"px\">" hl_preco _ar_get q $"price" a _ar_get q $"currency" "</span>" ln_chg _ar_get q $"changePct" "</div></button>" 0 }

# ===== em cima: o sentimento do mercado, numa linha (o tom e os índices do dia); ao abrir, o que o explica =====
# um índice do dia (a chave t, o nome nm): "S&P 500 −0,42%", com " · " antes se não é o primeiro (f); dá 1 se escreveu
: hl_ind iii>i t nm f {
  = a hl_ativot t = v ? a _ar_get a $"chg" 0
  ? hl_fin v { ? f " · " 0 _tx_html nm " <span class=\"" ln_tom @f + v 1 "-t\">" fm_pct @f + v 1 "</span>" 1 } 0 }
: hl_humor >i {
  = m sg $"mood"
  ? ~ _ar_verd m 0 {
    "\n        <details class=\"an-f hl-mood\" data-fold=\"hl-mood\" " ? _ar_verd sg $"foldMood" "open" 0 "><summary><span class=\"f-t\">Sentimento do mercado<small>"
    = n hl_ind $"^GSPC" $"S&P 500" 0
    = n + n hl_ind $"^IXIC" $"Nasdaq" n
    = n + n hl_ind $"^STOXX50E" $"Euro Stoxx" n
    ? n 0 _ar_ps _ar_get m $"hint" 1
    "</small></span><span class=\"f-n " hl_tom _ar_get m $"tone" "-t\">" _ar_ps _ar_get m $"label" 1 "</span></summary>"
    ? n { "<p class=\"hl-hint\">" _ar_ps _ar_get m $"hint" 1 "</p>" 0 } 0
    "<ul class=\"hl-rz\">"
    = c _ar_prim _ar_get m $"reasons" W c { "<li class=\"" hl_tom _ar_get c $"tone" "\">" _ar_ps _ar_get c $"txt" 1 "</li>" = c _ar_prox c }
    "</ul></details>" 0 } }

# ===== as listas =====
# os meus ativos hoje (o holdingKeys(), pela ordem dos Ajustes)
: hl_meus >i {
  = l sg $"mine" = w A + _ar_n l 1 = m 0
  = c _ar_prim l W c { = a hl_ativo c ? a { ! + w m a = m + m 1 0 } 0 = c _ar_prox c }
  ? m {
    "\n        <section class=\"sec\"><div class=\"sec-h\"><h2>Os meus ativos hoje</h2></div><div class=\"list\">"
    = j 0 W < j m { hl_linha @ + w j = j + j 1 }
    "</div></section>" 0 } 0 }
# as linhas b[w[0..m-1]]
: hl_lista iii>i b w m { "<div class=\"list\">" = j 0 W < j m { hl_linha @ + b @ + w j = j + j 1 } "</div>" 0 }
# o que mais sobe e o que mais cai hoje do que sigo (fora os meus): os da lista (listed: nem temporário nem auxiliar), sem
# os índices, com a variação do dia finita; os 5 primeiros de cada lado pela variação
: hl_movem >i {
  = l sg $"assets" = n _ar_n l = b A + n 1 = k1 A + n 1 = wu A + n 1 = wd A + n 1 = nu 0 = nd 0 = mi sg $"mine"
  = c _ar_prim l = i 0
  W c {
    ! + b i c
    = kd _ar_get c $"kind" = v _ar_get c $"chg"
    ? && && && && ~ _ar_verd _ar_get c $"temp" ~ _ar_eqt kd $"aux" ~ _ar_eqt kd $"index" hl_fin v ~ _ar_tem mi _ar_get c $"k" {
        = x @f + v 1 !f + k1 i x
        ? > x 0. { ! + wu nu i = nu + nu 1 0 } ? < x 0. { ! + wd nd i = nd + nd 1 0 } 0 } 0
    = c _ar_prox c = i + i 1 }
  # sort((a, b) => V[b].changePct - V[a].changePct) e sort((a, b) => V[a].changePct - V[b].changePct)
  _or_power wu nu k1 0 0 _or_power wd nd k1 0 1
  "\n        <section class=\"sec\"><div class=\"sec-h\"><h2>Mais sobem</h2></div>"
  ? nu hl_lista b wu ? > nu 5 5 nu "<div class=\"empty\">Nada a subir hoje.</div>"
  "</section>\n        <section class=\"sec\"><div class=\"sec-h\"><h2>Mais caem</h2></div>"
  ? nd hl_lista b wd ? > nd 5 5 nd "<div class=\"empty\">Nada a cair hoje.</div>"
  "</section>" 0 }

# ===== em baixo, em linhas fechadas (details com data-fold: ficam como o utilizador as deixou) =====
# o mercado dos EUA (a lista do conector, que se pede ao abrir os Destaques): numa linha, o que mais sobe e o que mais
# cai; lá dentro as 5 maiores subidas e as 5 maiores descidas
: hl_qres i>i q { = n0 _ar_get q $"name" = v _ar_get q $"changePct"
  ? _ar_verd n0 _ar_ps n0 1 _ar_ps _ar_get q $"symbol" 1 " <span class=\"" ln_tom hl_num v "-t\">" fm_pctv v "</span>" 0 }
: hl_qrows ii>i l m { "<div class=\"list\">" = c _ar_prim l = j 0 W && c < j m { ? == _ar_tipo c 7 { hl_linhaq c = j + j 1 } 0 = c _ar_prox c } "</div>" 0 }
: hl_eua >i ? ~ _ar_verd sg $"proxy" 0 {
  = mv sg $"mv" = g _ar_get mv $"gainers" = l _ar_get mv $"losers" = ng hl_nobj g 5 = nl hl_nobj l 5 = e sg $"err"
  ? && _ar_verd mv ~ || ng nl 0 {
    "\n        <details class=\"an-f\" data-fold=\"hl-eua\" " ? _ar_verd sg $"foldEua" "open" 0 "><summary><span class=\"f-t\">Mercado dos EUA<small>"
    ? _ar_verd mv {
        = a hl_obj g = z hl_obj l
        ? a hl_qres a 0 ? && a z " · " 0 ? z hl_qres z 0
        "</small></span></summary>"
        ? ng { "<div class=\"grp-h\">Sobem</div>" hl_qrows g 5 0 } 0
        ? nl { "<div class=\"grp-h\">Caem</div>" hl_qrows l 5 0 } 0 0 } {
        ? _ar_verd e "Indisponível" "A carregar…"
        "</small></span></summary><div class=\"empty\">" ? _ar_verd e { "Não deu para ler a lista: " _ar_ps e 1 0 } "A carregar…" "</div>" 0 }
    "</details>" 0 } }
# a cripto hoje (o mercado cripto todo, do conector): numa linha, o medo e ganância e quanto o valor do mercado mexeu em
# 24 h; lá dentro os 4 números
: hl_fng i>i t ? _ar_eqt t $"Extreme Fear" "Medo extremo" ? _ar_eqt t $"Fear" "Medo" ? _ar_eqt t $"Neutral" "Neutro"
  ? _ar_eqt t $"Greed" "Ganância" ? _ar_eqt t $"Extreme Greed" "Ganância extrema" _ar_ps t 1
# um valor em euros: o em euros, se o há (fin), ou o em dólares a dividir pelo EUR/USD (eu, se é verdade)
: hl_eur iii>f a u eu ? hl_fin a @f + a 1 ? && hl_fin u _ar_verd eu / @f + u 1 _ar_vnum eu / 0. 0.
: hl_cripto >i {
  = g sg $"cg"
  ? ~ _ar_verd g 0 {
    = f _ar_get g $"fng" = fv _ar_verd f = eu sg $"eu"
    = mc hl_eur _ar_get g $"mcap" _ar_get g $"mcapUsd" eu = vo hl_eur _ar_get g $"vol" _ar_get g $"volUsd" eu
    = bd _ar_get g $"btcDom" = ch _ar_get g $"mcapChg" = fc hl_fin ch
    # f.v < 45 'down', > 55 'up', senão 'flat'
    = x _ar_vnum _ar_get f $"v" = ft ? < x 45. 2 ? > x 55. 1 0
    ? ~ || || || fv _nu_fin mc hl_fin bd _nu_fin vo 0 {
      "\n        <details class=\"an-f\" data-fold=\"hl-cripto\" " ? _ar_verd sg $"foldCg" "open" 0 "><summary><span class=\"f-t\">Cripto hoje<small>"
      ? fv hl_fng _ar_get f $"label" 0
      ? fc { ? fv " · " 0 "mercado <span class=\"" ln_tom @f + ch 1 "-t\">" fm_pct @f + ch 1 "</span> em 24 h" 0 } 0
      ? || fv fc 0 "Valor, dominância e volume"
      "</small></span>"
      ? fv { "<span class=\"f-n " hl_t3 ft "-t\">" _ar_ps _ar_get f $"v" 1 "</span>" 0 } 0
      "</summary><div class=\"cg\">"
      ? fv { "<div><small>Medo e ganância</small><b class=\"num\"><span class=\"" hl_t3 ft "-t\">" _ar_ps _ar_get f $"v" 1 "</span></b><em>" hl_fng _ar_get f $"label"
          = pr _ar_get f $"prev" ? hl_fin pr { " · ontem " _nu_ps @f + pr 1 0 } 0 "</em></div>" 0 } 0
      ? _nu_fin mc { "<div><small>Valor do mercado</small><b class=\"num\">" _nu_compacto mc P 194 P 160 "€</b>"
          ? fc { "<em><span class=\"" ln_tom @f + ch 1 "-t\">" fm_pct @f + ch 1 "</span> em 24 h</em>" 0 } 0 "</div>" 0 } 0
      ? hl_fin bd { "<div><small>Dominância do Bitcoin</small><b class=\"num\">" _nu_intlm @f + bd 1 1 "%</b>"
          = ed _ar_get g $"ethDom" ? hl_fin ed { "<em>Ether " _nu_intlm @f + ed 1 1 "%</em>" 0 } 0 "</div>" 0 } 0
      ? _nu_fin vo { "<div><small>Volume 24 h</small><b class=\"num\">" _nu_compacto vo P 194 P 160 "€</b></div>" 0 } 0
      "</div><p class=\"note\">Medo e ganância: 0 = medo extremo, 100 = ganância extrema (com medo, os preços costumam estar mais baixos). Dominância a subir = o dinheiro foge das outras moedas para o Bitcoin.</p></details>" 0 } } }

# ===== a vista =====
: ecra_destaques i>i s {
  ! 53 s
  hl_humor hl_meus hl_movem hl_eua hl_cripto
  0 }
