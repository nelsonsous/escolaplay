                  = u2 jp_u4 + i 2
                  ? && >= u2 56320 < u2 57344 { = u + 65536 + << - u 55296 10 - u2 56320 = i + i 6 0 } 0 } 0
              = w tx_wcp w u 0 } }
          { = x ? == d 34 34 ? == d 92 92 ? == d '/ 47 ? == d 'b 8 ? == d 'f 12 ? == d 'n 10 ? == d 'r 13 ? == d 't 9 -1
            ? < x 0 { = ok 0 0 } { ! w x = w + w 1 = i + i 2 0 } } } }
    ? ~ ok jp_err s { ! r w ! -1 w ! s + p 1 r } } }
# os algarismos significativos de um número (até 780; os seguintes só contam como "há mais") vão para g_dig
: jp_num i>i s {
  = q @ s = e @ + s 1
  = neg 0 ? && < q e == @ q '- { = neg 1 = q + q 1 } 0
  ? || >= q e || < @ q '0 > @ q '9 jp_err s {
