# emissor NATIVO ARM64 (aarch64) -- a Onda escreve o seu proprio codigo-maquina ARM, sem C nem assembler.
# Irmao do -x (que escreve x86-64), mas para o chip do Mac/iPhone (Apple Silicon) e qualquer ARM64.
# Primeira fatia: nucleo inteiro (literais, + - * / %, & | ^, << >>, comparacoes, locais, ciclos W) e um ELF
# estatico minimo. Cada instrucao = 4 bytes little-endian. Rascunho: x9/x10/x11. Base da moldura: sp.
# Disposicao: slot(local j) = j; slot(temp t) = @9 + t; byte = slot*8. Tudo vive na moldura (sem alocar registos).
# FOLHA: o -a nunca compila o proprio compilador (o ponto fixo faz-se em C/wasm/x86), logo um erro aqui falha
# testes mas NAO pode partir o ponto fixo -- a mesma garantia do vetorizador.

# --- codificadores de instrucoes (hex = encoding exato, conferido com o llvm-objdump) ---
: aslt i>i t * + @ 9 t 8
: asll i>i j * j 8
# janela: uma carga de um slot logo a seguir a escrita do mesmo slot (sem rotulo pelo meio: xq 7 = ultimo alvo de
# salto) nao se repete -- some, ou vira mov se o registo e outro
: apeep ii>i w rt {
  = p - @ 16 4
  ? < p xq 7 0 {
    = pw | | | @ p << @ + p 1 8 << @ + p 2 16 << @ + p 3 24
    ? == & pw 0xFFFFFFE0 & ^ w 0x00400000 0xFFFFFFE0
      { = sr & pw 31 ? != sr rt { ? & w 0x04000000 afmovdd rt sr amov rt sr } 0 1 } 0 } }
: alab i>i k || && >= k 10 <= k 13 || && >= k 18 <= k 23 || == k 41 || == k 53 || == k 54 || == k 59 || == k 55 || == k 56 || == k 30 || == k 34 || == k 35 || == k 37 == k 42
: ains i>i p { ains0 p ? alab @ p xqs 7 @ 16 0 }
: ald ii>i rt off ? < off 32768 { = w | | | 0xF9400000 << / off 8 10 << 31 5 rt ? apeep w rt 0 x4 w } { aimm 12 / off 8 x4 | | | 0xF8607800 << 12 16 << 31 5 rt }
: ast ii>i rt off ? < off 32768 x4 | | | 0xF9000000 << / off 8 10 << 31 5 rt { aimm 12 / off 8 x4 | | | 0xF8207800 << 12 16 << 31 5 rt }
: agT ii>i rt t agV rt t
: asT ii>i rt t asV rt t
: agL ii>i rt j agV rt + @ 11 j
: asL ii>i rt j asV rt + @ 11 j
: aimm4 ii>i rd v {
  x4 | | 0xD2800000 << & v 0xffff 5 rd
  x4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd
  x4 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd
  x4 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd }
: aimm ii>i rd v {
  x4 | | 0xD2800000 << & v 0xffff 5 rd
  ? & >> v 16 0xffff x4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd 0
  ? & >> v 32 0xffff x4 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd 0
  ? & >> v 48 0xffff x4 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd 0 }
: aadd iii>i rd rn rm x4 | | | 0x8B000000 << rm 16 << rn 5 rd
: asub iii>i rd rn rm x4 | | | 0xCB000000 << rm 16 << rn 5 rd
: amul iii>i rd rn rm x4 | | | 0x9B007C00 << rm 16 << rn 5 rd
: asdiv iii>i rd rn rm x4 | | | 0x9AC00C00 << rm 16 << rn 5 rd
: amsub iiii>i rd rn rm ra x4 | | | | 0x9B008000 << rm 16 << ra 10 << rn 5 rd
: aand iii>i rd rn rm x4 | | | 0x8A000000 << rm 16 << rn 5 rd
: aorr iii>i rd rn rm x4 | | | 0xAA000000 << rm 16 << rn 5 rd
: aeor iii>i rd rn rm x4 | | | 0xCA000000 << rm 16 << rn 5 rd
: alsl iii>i rd rn rm x4 | | | 0x9AC02000 << rm 16 << rn 5 rd
: alsr iii>i rd rn rm x4 | | | 0x9AC02400 << rm 16 << rn 5 rd
: aasr iii>i rd rn rm x4 | | | 0x9AC02800 << rm 16 << rn 5 rd
: acmp ii>i rn rm x4 | | | 0xEB000000 << rm 16 << rn 5 31
: acset ii>i rd cc x4 | | 0x9A9F07E0 << cc 12 rd
: acc i>i o ? == o '< 0xB ? == o '> 0xC ? == o k2 '< '= 0xD ? == o k2 '> '= 0xA ? == o k2 '= '= 0 1
: asubsp i>i imm ? < imm 4096 x4 | | | 0xD1000000 << imm 10 << 31 5 31 { aimm 12 imm x4 | | | 0xCB206000 << 12 16 << 31 5 31 }
: aaddsp i>i imm ? < imm 4096 x4 | | | 0x91000000 << imm 10 << 31 5 31 { aimm 12 imm x4 | | | 0x8B206000 << 12 16 << 31 5 31 }
: aret >i x4 0xD65F03C0
: aprol >i x4 0xA9BF7BFD
: aepil >i x4 0xA8C17BFD
: ab i>i off x4 | 0x14000000 & / off 4 0x3FFFFFF
: abl i>i off x4 | 0x94000000 & / off 4 0x3FFFFFF
: afs >i & + * 8 + + @ 9 @ 11 14 15 -16
# --- atribuicao de registos (-a/-m): varrimento linear com prioridade aos ciclos mais fundos ---
# valor v: temporario t (v = t) ou variavel j (v = @11 + j). local: -1 moldura; 0..10 registo inteiro (0..7 = x19..x26,
# guardados pelo chamado; 8..10 = x13..x15, so para o que nao atravessa chamadas); 32+i real (0..5 = d10..d15 guardados;
# 6..21 = d16..d31 sem chamadas). 34 local 36 inicio 37 fim 38 profundidade 39 ocupacao por posicao (entrada 0, instrucao i em i+1; bits 0..10
# inteiros, 16..37 reais, 40 chamada, 41 chamada que tambem le os operandos em x13..x15: o mapa NEON) 40 ciclos (inicio,
# fim) 41 n de ciclos 42 registos guardados usados 43 pilha de ciclos 44 profundidade atual
: arep i>i v @ + @ 35 v
: aloc i>i v @ + @ 34 arep v
: arx i>i l ? >= l 64 - l 64 ? < l 8 + 19 l ? < l 11 + 5 l ? == l 11 8 ? == l 14 27 + 4 l
: aisx i>i l || && >= l 0 < l 32 && >= l 64 < l 96
: aisd i>i l || && >= l 32 < l 64 >= l 96
: ardl i>i l ? >= l 96 - l 96 ard - l 32
: ard i>i l ? < l 6 + 10 l ? < l 22 + 10 l - l 19
: avs i>i v + xq 4 * 8 @ + @ 56 arep v
: aty i>i v ? < v @ 11 tty v { = l lty - v @ 11 ? >= l 2 tty - l 2 l }
: amov ii>i rd rn ? == rd rn 0 amovr rd rn
: afmovdd ii>i rd rn ? == rd rn 0 x4 | | 0x1E604000 << rn 5 rd
# local -3: literal rematerializado (sem registo nem moldura: recalcula-se em cada uso)
: aremb i>i v { = q + @ 18 * @ + @ 47 arep v 8 = k @ q ? == k 2 @ + q 2 ? == k 44 | << @ + q 2 32 @ + q 3 ? tty @ + q 1 afbits @ + q 2 tokval @ + q 2 }
: arem i>i v { = j @ + @ 47 v ? || < j 0 != @ + @ 46 v 1 0 { = k @ + @ 18 * j 8 || || == k 1 == k 2 == k 44 } }
: agV ii>i rt v { = l aloc v ? == l -3 aic rt aremb v ? < l 0 ald rt avs v ? aisx l amov rt arx l x4 | | 0x9E660000 << ardl l 5 rt }
: asV ii>i rt v { = l aloc v ? == l -3 0 ? < l 0 ast rt avs v ? aisx l amov arx l rt afmovxd ardl l rt }
: agVf ii>i rt v { = l aloc v ? == l -3 afc rt aremb v ? < l 0 aldfr rt avs v ? aisd l afmovdd rt ardl l afmovxd rt arx l }
: asVf ii>i rt v { = l aloc v ? == l -3 0 ? < l 0 astfr rt avs v ? aisd l afmovdd ardl l rt x4 | | 0x9E660000 << rt 5 arx l }
# operando no seu registo (sem copia) ou carregado no rascunho r; destino: o registo do valor ou o rascunho r
: aox ii>i r v { = l aloc v ? aisx l arx l { agV r v r } }
: aod ii>i r v { = l aloc v ? aisd l ardl l { agVf r v r } }
: adx ii>i r v { = l aloc v ? aisx l arx l r }
: adf ii>i r v { = l aloc v ? aisd l ardl l r }
: afx ii>i r v ? == aloc v -1 ast r avs v 0
: afd ii>i r v ? == aloc v -1 astfr r avs v 0
: amvv ii>i dv sv ? == arep dv arep sv 0 ? aty dv ? aisd aloc dv agVf ardl aloc dv sv { = r aod 0 sv asVf r dv } ? aisx aloc dv agV arx aloc dv sv { = r aox 9 sv asV r dv }
# instrucoes que chamam funcoes (estragam x13..x15 e d16..d31): 1 = normal, 2 = o mapa NEON (le em x13..x15)
: acall i>i p { = k @ p ? || || || == k 7 == k 3 || || || || || == k 28 == k 62 == k 63 == k 65 == k 67 == k 29 || || == k 31 == k 32 || == k 36 == k 60 1 ? && == k 15 || == @ + p 2 3 == @ + p 2 4 1 ? || || == k 53 == k 54 == k 59 2 0 }
: arf ii>i v i { = v arep v ? @ + @ 58 v 0 { = q + @ 36 v ? || < @ q 0 > @ q i ! q i 0 = q + @ 37 v ? < @ q i ! q i 0 = q + @ 38 v ? < @ q @ 44 ! q @ 44 0 } }
: aext i>i v {
  = s @ + @ 36 v
  = e @ + @ 37 v
  = l 0
  W && >= s 0 < l @ 41 {
    = q + @ 40 * l 2
    = a @ q
    = b @ + q 1
    ? && && <= s b >= e a || < s a > e b { = s Mn s a = e Mx e b } 0
    = l + l 1 }
  ! + @ 36 v s
  ! + @ 37 v e }
: afree iii>i m lo hi { = r -1 = j lo W && < r 0 < j hi { ? & >> m j 1 0 = r j = j + j 1 } r }
: aal i>i v {
  = s @ + @ 36 v
  = e @ + @ 37 v
  ? && >= s 0 < @ + @ 34 v 0 {
    = m 0
    = cs 0
    # resultado de ? / && / ||: o valor da 1.a definicao nao vive no outro ramo (buraco entre as duas definicoes)
    = h0 -1
    = h1 -1
    ? && && < v @ 11 == @ + @ 46 v 2 >= @ + @ 55 v 0 {
      = k0 @ + @ 18 * @ + @ 55 v 8
      ? || || == k0 10 == k0 12 == k0 19 { = h0 + @ + @ 55 v 1 = h1 + @ + @ 47 v 1 } 0 } 0
    = p s
    W <= p e { ? && > p h0 < p h1 0 { = o @ + @ 39 p = m | m o ? && > p s || && < p e & o << 1 50 & o << 1 51 = cs 1 0 } = p + p 1 }
    = fl aty v
    = r ? fl { = r ? cs -1 afree m 22 43 = r ? < r 0 afree m 16 22 r ? < r 0 afree m 43 45 r } { = r ? cs -1 afree m 8 ? xq 5 11 14 = r ? < r 0 afree m 0 8 r ? && < r 0 ~ @ 67 afree m 14 15 r }
    ? >= r 0 {
      = b << 1 r
      = p s W <= p e { ? && > p h0 < p h1 0 { = q + @ 39 p ! q | @ q b } = p + p 1 }
      ? || || < r 8 == r 14 || && >= r 16 < r 22 >= r 43 ! 42 | @ 42 b 0
      ! + @ 34 v ? fl + 32 - r 16 r } 0 } 0 }
: aopn ii>i p q {
  = k @ p
  = f @ + @ 50 k
  = n 0
  ? & f 1 { ! + q n @ + p 2 = n + n 1 } 0
  ? & f 2 { ! + q n @ + p 3 = n + n 1 } 0
  ? & f 4 { ! + q n @ + p 4 = n + n 1 } 0
  ? == k 7 { = b @ + p 3 = j 0 W < j @ + p 4 { ! + q n @ + b j = n + n 1 = j + j 1 } } 0
  ? == k 53 { ! q @ + p 2 ! + q 1 @ + p 3 ! + q 2 @ + p 5 = n 3 ? > @ + p 6 0 { ! + q 3 - @ + p 6 1 = n 4 } 0 } 0
  ? == k 54 { ! q @ + p 2 = n 1 = b @ + p 4 = j 0 W < j - @ fe @ + p 3 2 1 { ! + q n @ + b j = n + n 1 = j + j 1 } ? > @ + p 5 0 { ! + q n - @ + p 5 1 = n + n 1 } 0 } 0
  ? == k 59 { = b @ + p 5 = j 0 W < j - @ fe @ + p 4 2 1 { ! + q n @ + b j = n + n 1 = j + j 1 } ? > @ + p 6 0 { ! + q n - @ + p 6 1 = n + n 1 } 0 } 0
  n }
# o intervalo ]a,b] e uma reta (sem inicio/fim de ciclo) onde a variavel j nao e escrita (nem lida, se rd)?
: aclr iiiii>i a b j rd q {
  = ok 1
  = nt @ 11
  = i + a 1
  W && ok <= i b {
    = p + @ 18 * i 8
    = k @ p
    ? || || == k 21 == k 23 || == k 55 == k 56 = ok 0 0
    ? && == k 6 == @ + p 4 j = ok 0 0
    ? && rd && == k 5 == @ + p 3 j = ok 0 0
    ? rd { = c aopn p q = h 0 W < h c { ? == @ + @ 35 @ + q h + nt j = ok 0 0 = h + h 1 } } 0
    = i + i 1 }
  ok }
: aali i>i q {
  = n @ 19
  = nt @ 11
  = nv + nt @ 9
  = v 0
  W < v nv { ! + @ 35 v v = v + v 1 }
  = t 0
  W < t nt { ! + @ 45 t 0 ! + @ 46 t 0 ! + @ 47 t -1 ! + @ 48 t -1 ! + @ 55 t -1 = t + t 1 }
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = c aopn p q
    = h 0 W < h c { = t @ + q h ! + @ 45 t + @ + @ 45 t 1 ! + @ 48 t i = h + h 1 }
    ? & @ + @ 50 @ p 8 { = d @ + p 1 ! + @ 46 d + @ + @ 46 d 1 ! + @ 47 d i ? < @ + @ 55 d 0 ! + @ 55 d i 0 } 0
    = i + i 1 }
  # ?) o valor de um ramo calculado mesmo antes do fim do ramo (19/20) nasce ja no registo do resultado do ?
  # (de tras para a frente, para os ? encaixados apontarem para o mais exterior); no else encolhe o buraco
  = i - n 1
  W > i 0 {
    = p + @ 18 * i 8
    ? || == @ p 19 == @ p 20 {
      = d @ + p 1
      = a @ + p 2
      = pv - p 8
      ? && && && < a nt == arep a a && == @ + @ 45 a 1 == @ + @ 48 a i
        || && == @ + @ 46 a 1 == @ + @ 47 a - i 1 && && == @ + @ 46 a 2 == @ + @ 47 a - i 1 == @ pv 20 {
        ! + @ 35 a arep d
        ? == @ p 20 ! + @ 47 d - i 1 0 } 0 } 0
    = i - i 1 }
  # a) t = variavel j: partilha o registo de j se j nao muda enquanto t vive
  = i 0
  W < i n {
    = p + @ 18 * i 8
    ? == @ p 5 { = d @ + p 1 = j @ + p 3 ? && && == @ + @ 46 d 1 >= @ + @ 48 d 0 aclr i @ + @ 48 d j 0 q ! + @ 35 d + nt j 0 } 0
    = i + i 1 }
  # b) variavel j = t, com t usado so aqui: t calcula-se ja no registo de j (se j nao e lida entretanto)
  = i 0
  W < i n {
    = p + @ 18 * i 8
    ? == @ p 6 {
      = t @ + p 3
      = j @ + p 4
      = s @ + @ 47 t
      ? && && && == @ + @ 46 t 1 == @ + @ 45 t 1 == @ + @ 35 t t && >= s 0 == aty t aty + nt j
        ? aclr s - i 1 j 1 q ! + @ 35 t + nt j 0 0 } 0
    = i + i 1 }
  0 }
# fusao a*b+c (fmadd/fmsub/fnmsub): um '*' real usado so por um '+'/'-' na mesma reta, sem os operandos mudarem
# entretanto. So com -mf/-af (como o FMA do -xf no x86): um so arredondamento muda os ultimos bits, e o -m/-a tem de dar
# os mesmos bits que o C, o WebAssembly e o x86. Nunca na biblioteca (funcoes _...), que fica igual ao bit ao fdlibm.
# 51 por instrucao: -1 normal; -2 '*' absorvido; m >= 0 a soma que absorve o '*' da instrucao m
: afmc ii>i t i {
  = j @ + @ 47 t
  = r -1
  ? && && >= j 0 == @ + @ 46 t 1 == @ + @ 45 t 1 {
    = q + @ 18 * j 8
    ? && && == @ q 8 == opof @ + q 2 '* == @ + @ 51 j -1 {
      = x arep @ + q 3
      = y arep @ + q 4
      = nt @ 11
      = ok 1
      = h + j 1
      W && ok < h i {
        = p + @ 18 * h 8
        = k @ p
        ? || || && >= k 10 <= k 13 && >= k 18 <= k 23 || == k 41 >= k 55 = ok 0 0
        ? && == k 6 || == + nt @ + p 4 x == + nt @ + p 4 y = ok 0 0
        ? && & @ + @ 50 k 8 || == arep @ + p 1 x == arep @ + p 1 y = ok 0 0
        = h + h 1 }
      ? ok = r j 0 } 0 } 0
  r }
: afm >i {
  = n @ 19
  = i 0
  W < i n { ! + @ 51 i -1 = i + i 1 }
  ? || ~ fastf == tc @ fe @ 13 0 0 '_ 0 {
    = i 0
    W < i n {
      = p + @ 18 * i 8
      ? && && == @ p 8 tty @ + p 1 || == opof @ + p 2 '+ == opof @ + p 2 '- {
        = m afmc @ + p 4 i
        = m ? < m 0 afmc @ + p 3 i m
        ? >= m 0 { ! + @ 51 i m ! + @ 51 m -2 } 0 } 0
      = i + i 1 } } }
# && / || cuja unica utilizacao e o salto do W ou do ? seguinte: saltam direto (sem materializar 0/1). 51 = -4 marca
# o 10/12, o 11/13 e o 22/18 fundidos.
: alog >i {
  = n @ 19
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = k @ p
    ? || == k 10 == k 12 {
      = d @ + p 1
      = j @ + @ 47 d
      ? && && == @ + @ 55 d i == @ + @ 46 d 2 && < + j 1 n == @ + @ 45 d 1 {
        = q + @ 18 * j 8
        = r + q 8
        ? && && == @ q + k 1 || == @ r 22 == @ r 18 == @ + r 2 d { ! + @ 51 i -4 ! + @ 51 j -4 ! + @ 51 + j 1 -4 } 0 } 0 } 0
    = i + i 1 }
  0 }
: afl i>i p == @ + @ 51 / - p @ 18 8 -4
: abrt i>i x ? >= @ 49 0 { x4 | 0x54000000 @ 49 ! 49 -1 } x4 | 0xB5000000 x
# pre-coloracao: o argumento calculado mesmo antes da chamada nasce ja em x_j/d_j; o resultado da chamada usado so
# pela instrucao seguinte fica em x0 (so inteiros: d0/d1 sao os rascunhos dos operandos reais na memoria)
: apok i>i k && && != k 7 != k 42 && != k 53 != k 54
: apre >i {
  = n @ 19
  = i 1
  W < i n {
    = p + @ 18 * i 8
    = pv - p 8
    = t @ + pv 1
    ? && && == @ p 7 || & @ + @ 50 @ pv 8 == @ pv 54 && && < t @ 11 == arep t t && && == @ + @ 46 t 1 == @ + @ 45 t 1 == @ + @ 58 t 0 {
      = kf @ + p 2
      = b @ + p 3
      = xc 0
      = dc 0
      = j 0
      W < j @ + p 4 {
        ? fpt kf j { ? == @ + b j t ! + @ 34 t + 96 dc 0 = dc + dc 1 } { ? == @ + b j t ! + @ 34 t + 64 xc 0 = xc + xc 1 }
        = j + j 1 } } 0
    ? == @ p 41 {
      = t @ + p 2
      ? && && & @ + @ 50 @ pv 8 && < t @ 11 == arep t t && && == @ + @ 46 t 1 == @ + @ 45 t 1 && == @ + @ 58 t 0 < @ + @ 34 t 0
        ! + @ 34 t ? tty t 96 64 0 } 0
    ? && == @ p 7 < + i 1 n {
      = t @ + p 1
      = q + p 8
      ? && && apok @ q && < t @ 11 == arep t t && && == @ + @ 46 t 1 == @ + @ 45 t 1 < @ + @ 34 t 0 {
        = c aopn q + @ 18 * @ 19 8
        = u 0 = h 0 W < h c { ? == @ + + @ 18 * @ 19 8 h t = u 1 0 = h + h 1 }
        ? && u ~ tty t ! + @ 34 t 64 0 } 0 } 0
    = i + i 1 }
  0 }
# comparacao seguida do salto que e o seu unico uso: cmp + b.cond (sem cset/cbz). 48 do bloco de cima nao serve aqui:
# a condicao pendente vive em @49 (-1 nenhuma)
: afz i>i p { = q + p 8 = d @ + p 1 && && < / - q @ 18 8 @ 19 || || == @ q 22 == @ q 18 && afl q && >= @ q 10 <= @ q 13 && == @ + q 2 d == @ + @ 45 d 1 }
: abr i>i x ? >= @ 49 0 { x4 | 0x54000000 ^ @ 49 1 ! 49 -1 } x4 | 0xB4000000 x
: ap19 i>i p { = w | | | @ p << @ + p 1 8 << @ + p 2 16 << @ + p 3 24 xput4 p | & w 0xFF00001F << & / - @ 16 p 4 0x7FFFF 5 }
: ara i>i kf {
  = n @ 19
  = nt @ 11
  = nv + nt @ 9
  = v 0
  W < v nv { ! + @ 34 v -1 ! + @ 36 v -1 ! + @ 37 v -1 ! + @ 38 v 0 = v + v 1 }
  = i 0
  W <= i n { ! + @ 39 i 0 = i + i 1 }
  xqs 5 0
  = qo A 64
  aali qo
  afm
  aimf
  alog
  ! 49 -1
  ! 41 0
  ! 44 0
  = sp 0
  = j 0
  W < j @ fe kf 2 { arf + nt j 0 = j + j 1 }
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = k @ p
    = ps + i 1
    ? || == k 21 == k 56 { ! + @ 43 sp ps = sp + sp 1 ! 44 + @ 44 1 } 0
    = f @ + @ 50 k
    ? & f 8 arf @ + p 1 ps 0
    ? == k 5 arf + nt @ + p 3 ps 0
    ? == k 6 arf + nt @ + p 4 ps 0
    = c aopn p qo
    = h 0 W < h c { arf @ + qo h ps = h + h 1 }
    = m @ + @ 51 i
    ? >= m 0 { = q2 + @ 18 * m 8 arf @ + q2 3 ps arf @ + q2 4 ps } 0
    = c acall p
    ? c { = q + @ 39 ps ! q | @ q << 1 + 49 c } 0
    ? || || == k 30 == k 34 || || == k 35 == k 37 == k 42 xqs 5 1 0
    ? || == k 23 == k 55 { = sp - sp 1 = q + @ 40 * @ 41 2 ! q @ + @ 43 sp ! + q 1 ps ! 41 + @ 41 1 ! 44 - @ 44 1 } 0
    = i + i 1 }
  # variaveis: vivas desde a entrada (podem ser lidas antes de escritas, p.ex. o valor da volta anterior de um ciclo)
  = v nt
  W < v nv { ? >= @ + @ 36 v 0 ! + @ 36 v 0 0 = v + v 1 }
  = v 0
  W < v nv { aext v = v + v 1 }
  ! 42 0
  = md 0
  = v 0
  W < v nv { = md Mx md @ + @ 38 v = v + v 1 }
  apre
  W >= md 0 {
    = v nt
    W < v nv { ? == @ + @ 38 v md aal v 0 = v + v 1 }
    = v 0
    W < v nt { ? == @ + @ 38 v md aal v 0 = v + v 1 }
    = md - md 1 }
  afr
  0 }
# moldura: primeiro os registos do chamado que a funcao usa (aos pares, stp/ldp), depois so os valores que ficaram na
# memoria. 56 slot de cada valor 57 n de registos guardados 59 bytes da moldura 60 folha (sem bl: nao guarda x29/x30)
: afr >i {
  = nt @ 11
  = nv + nt @ 9
  = c 0
  = j 0
  W < j 45 { ? & >> @ 42 j 1 = c + c 1 0 = j + j 1 }
  = v 0
  W < v nt { ? && && == arep v v == @ + @ 34 v -1 && >= @ + @ 36 v 0 arem v ! + @ 34 v -3 0 = v + v 1 }
  = ns 0
  = v 0
  W < v nv { ? && && == arep v v == @ + @ 34 v -1 >= @ + @ 36 v 0 { ! + @ 56 v + c ns = ns + ns 1 } 0 = v + v 1 }
  ! 59 & + * 8 + c ns 15 -16
  = lf 1
  = i 0
  W < i @ 19 { ? == acall + @ 18 * i 8 1 = lf 0 0 = i + i 1 }
  ! 60 lf
  0 }
: asreg i>i j ? < j 8 + 19 j ? == j 14 27 ? < j 22 + 10 - j 16 - j 35
: asv1 iiii>i ld fl r off ? fl { ? ld aldfr r off astfr r off } { ? ld ald r off ast r off }
: asv2 iiiii>i ld fl r1 r2 i x4 | | | | ? fl ? ld 0x6D400000 0x6D000000 ? ld 0xA9400000 0xA9000000 << i 15 << r2 10 << 31 5 r1
: asave i>i ld {
  = c 0
  = pr -1
  = pf 0
  = j 0
