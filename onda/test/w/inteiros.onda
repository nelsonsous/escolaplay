  = b A 100 ! b + b 1 O b "texto desviado " N 42 O 0 = n - @ b + b 1 ln n = i 1 W <= i n { P @ + b i = i + i 1 } P 10
  ln Ac = i 0 W Av 1 i { P Av 1 i = i + i 1 } P 10
  = s 0 = c R W >= c 0 { = s + s c = c R } ln s
  ln -9223372036854775807
