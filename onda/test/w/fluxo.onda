# fluxo: ciclos, condicoes compostas, resultados de ? atravessando chamadas, aliases e promocao
: id i>i x x
: soma ii>i a b + a b
: fib i>i n ? < n 2 n + fib - n 1 fib - n 2
: sq ii>f i a { = v @f + a i * v v }
: tri i>i n { = s 0 = i 0 W < i n { = s + s i = i + i 1 } s }
: main >i {
  = n 1000
  = t 0
  = i 0
  W < i n { = t + t ? && > i 10 < i 20 1 0 = i + i 1 }
  N t "\n"
  = i 0
  = u 0
  W || < i 5 && > i 90 < i 95 { = u + u i = i + i 1 }
  N u "\n"
  = x 7
  = k 0
  W < k 10 { = x ? == % k 3 0 + x 1 x = k + k 1 }
  N x "\n"
  = c id 3
  = y ? > c 2 id 40 soma c 1
  N y " " N fib 20 "\n"
  = a A 100
  = i 0
  W < i 100 { !f + a i F i = i + i 1 }
  = s S 100 sq a
  G s "\n"
  = m 0
  = i 0
  W < i 50 { ? > % * i 7 13 m = m % * i 7 13 0 = i + i 1 }
  N m "\n"
  = z 0
  = i 0
  W < i 30 { ? == & i 1 0 { = q * i i } 0 = z + z q = i + i 1 }
  N z "\n"
  = w 0
  = j 0
  W < j 20 { = w + w tri j = j + j 1 }
  N w "\n"
  = f 1.5
  = g 0.0
  = i 0
  W && < i 40 < g 100.0 { = g + g f = f * f 1.05 = i + i 1 }
  G g " " N i "\n"
  = h -5
  W ~ >= h 3 = h + h 2
  N h " " N ? || == h 3 == h 5 1 0 " " N && != h 3 1 "\n"
  = b 0
  = i 0
  W < i 64 { = b | b << 1 & i 7 = b ^ b >> b 3 = i + i 1 }
  N b " " N / -17 4 " " N % -17 4 " " N >> -17 2 "\n"
  0 }
