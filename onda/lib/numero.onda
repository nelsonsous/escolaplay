  # corrige-a. Sem Lg: numa função _ o Lg é a primitiva (não o _lg do fdlibm), e o -a não a tem
  = e _nu_e10 f q
  = b + _me_lb 64 = d 0 = go 1
  W go {
    = d _nu_bq * 4 f - 16 e q b
    ? >= d 100000000000000000 { = e + e 1 0 } ? < d 10000000000000000 { = e - e 1 0 } { = go 0 0 } }
  = cv @ _me_lb
  = s - 16 e
  = inc == & f 1 0
  = hi _nu_bq + * 4 f 2 s q b
  = hi ? && == @ _me_lb 0 ~ inc - hi 1 hi
  = lo _nu_bq - * 4 f ? && == f 4503599627370496 > ex 1 1 2 s q b
  = lo + lo ? @ _me_lb 1 ? inc 0 1
  # o maior passo 10^t com um múltiplo dentro do intervalo; depois o múltiplo mais perto de V (empate: par)
  = m 100000000000000000 = t 17
  W && > t 0 < * / hi m m lo { = m / m 10 = t - t 1 }
  = c0 * / d m m = c1 + c0 m
  = dl - d c0
  = w ? <= + * 2 dl 2 m -1 ? >= * 2 dl + m 1 1 ? == * 2 dl m ? cv 1 0 ? == cv 3 1 ? == cv 2 0 -1
  = r ? && >= c0 lo <= c1 hi { ? < w 0 c0 ? > w 0 c1 ? == & / c0 m 1 0 c0 c1 } ? >= c0 lo c0 c1
  ? == r 100000000000000000 { = r 10000000000000000 = e + e 1 0 } 0
  ! + _me_lb 12 e
  r }
# d × 10^(e-16) (10^16 <= d < 10^17) no formato do Number#toString do JS, sem os zeros finais (sep no lugar do ponto)
: _nu_pdig iii>i d e sep {
  = b + _me_lb 16
  = j 16 W >= j 0 { ! + b j + 48 % d 10 = d / d 10 = j - j 1 }
  = k 17 W && > k 1 == @ + b - k 1 48 = k - k 1
  = n + e 1
  ? && <= k n <= n 21 { = j 0 W < j k { P @ + b j = j + j 1 } W < j n { P '0 = j + j 1 } 0 }
  ? && > n 0 <= n 21 { = j 0 W < j n { P @ + b j = j + j 1 } P sep W < j k { P @ + b j = j + j 1 } 0 }
  ? && > n -6 <= n 0 { P '0 P sep = j 0 W < j - 0 n { P '0 = j + j 1 } = j 0 W < j k { P @ + b j = j + j 1 } 0 }
  { P @ b ? > k 1 { P sep = j 1 W < j k { P @ + b j = j + j 1 } 0 } 0
    P 'e ? > n 0 { P '+ N - n 1 } { P '- N - 1 n } } }
