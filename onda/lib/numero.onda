        = kk + kk _nu_xarr g nl kk
        ? <= kk d { P '0 P sep = j kk W < j d { P '0 = j + j 1 } = j 0 W < j kk { P + '0 @ + g j = j + j 1 } 0 } {
          = j 0 W < j - kk d { P + '0 @ + g j = j + j 1 } P sep W < j kk { P + '0 @ + g j = j + j 1 } 0 } } } }
