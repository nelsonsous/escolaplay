# ecra-carteira.onda — o separador Carteira (Mercados 4.12): o simulador do plano e do objetivo.
# Instantâneo: budget (€ por mês), cp (% em cripto; 0 sem cripto), core (o nome do fundo núcleo), start (€ que já tem
# investidos), years (anos a simular, 1..60), goal (€ a atingir; 0 = sem objetivo).
#
# Como se faz a conta: mês a mês, o que já está investido rende e entra o valor do plano, dividido entre o fundo
# núcleo e a cripto. Três cenários por ano: ações 3 / 6 / 9 %, cripto 0 / 10 / 25 %. Em euros de hoje: inflação de 2 %.
# O imposto, se vender tudo no fim: cada compra paga pela idade (ações e ETF: 28 % até 2 anos, 25,2 % de 2 a 5, 22,4 % de
# 5 a 8, 19,6 % com 8 ou mais; a cripto com 1 ano ou mais está isenta, antes paga 28 %).

# a taxa por ano da classe q (0 ações, 1 cripto) no cenário s (0 pessimista, 1 base, 2 otimista), e por mês
: cs_tx ii>f s q ? == q 0 ? == s 0 0.03 ? == s 1 0.06 0.09 ? == s 0 0.0 ? == s 1 0.10 0.25
: cs_mes f>f r - Pw + 1.0 r / 1.0 12.0 1.0
# o valor ao fim de n meses no cenário s: m € por mês, a fração c em cripto, st € no início
: cs_val iifff>f s n m c st {
  = ra cs_mes cs_tx s 0 = rb cs_mes cs_tx s 1
  = a * st - 1.0 c = b * st c = i 0
  W < i n { = a + * a + 1.0 ra * m - 1.0 c = b + * b + 1.0 rb * m c = i + i 1 }
  + a b }
# os meses até chegar ao objetivo g no cenário s (até 100 anos; -1 se não chega)
: cs_meta iiffff>i s h m c st g {
  = ra cs_mes cs_tx s 0 = rb cs_mes cs_tx s 1
  = a * st - 1.0 c = b * st c = i 0
  W && < i 1200 < / + a b cs_df h i g { = a + * a + 1.0 ra * m - 1.0 c = b + * b + 1.0 rb * m c = i + i 1 }
  ? >= / + a b cs_df h i g i -1 }
# o imposto se vender tudo ao fim de n meses, no cenário base: compra a compra (a de hoje e uma por mês)
: cs_imp ifff>f n m c st {
  = ra cs_mes cs_tx 1 0 = rb cs_mes cs_tx 1 1 = t 0.0 = j 0
  W <= j n {
    = v ? == j 0 st m
    = id - n j
    = ga * * v - 1.0 c - Pw + 1.0 ra F id 1.0
    = gb * * v c - Pw + 1.0 rb F id 1.0
    = tx ? < id 24 0.28 ? < id 60 0.252 ? < id 96 0.224 0.196
    = t + t * Mx 0.0 ga tx
    = t + t ? < id 12 * Mx 0.0 gb 0.28 0.0
    = j + j 1 }
  t }

# ---- escrever ----
: cs_eur f>i x _nu_moeda x 0 $"EUR"
: cs_mil f>i x { _nu_compacto x P 194 P 160 "€" 0 }
# "12 anos e 4 meses"
: cs_tempo i>i n {
  = a / n 12 = m % n 12
  ? > a 0 { N a ? == a 1 " ano" " anos" 0 } 0
  ? && > a 0 > m 0 " e " 0
  ? > m 0 { N m ? == m 1 " mês" " meses" 0 } 0
  ? == n 0 "já" 0
  0 }
# um número do instantâneo (0 se não é um número finito e positivo)
: cs_num i>f k { = v _ar_vnum sg k ? && _nu_fin v > v 0.0 v 0.0 }
: cs_x ii>f t y + 34.0 / * 296.0 F t F y
: cs_y ff>f v vm - 186.0 / * 172.0 v vm
# euros de hoje (h = 1): o que vale daqui a n meses dividido pela inflação de 2 % ao ano; h = 0, o valor do futuro
: cs_df ii>f h n ? h Pw 1.02 / F n 12.0 1.0
# o que foi investido ao fim de n meses (em euros de hoje: cada entrega pela inflação até ao seu mês)
: cs_inv iiff>f h n m st { ? h { = e st = j 1 W <= j n { = e + e / m cs_df h j = j + j 1 } e } + st * m F n }
# o valor no cenário s ao fim de n meses, como se mostra (h)
: cs_vh iiifff>f s h n m c st / cs_val s n m c st cs_df h n
# os pontos "x y L x y …" de um cenário (s = 3: o investido), ano a ano; r = 1 do fim para o início
: cs_pts iiiiffff>i s h y r m c st vm {
  = k 0
  W <= k y {
    = t ? r - y k k = n * t 12
    = v ? == s 3 cs_inv h n m st cs_vh s h n m c st
    ? k " L" 0 _nu_fixo cs_x t y 1 P 32 _nu_fixo cs_y v vm 1
    = k + k 1 }
  0 }
# o gráfico: a faixa entre o pessimista e o otimista (com as duas linhas), o base, o que se investe e o objetivo
: cs_graf iiiffff>i h y n m c st g {
  = vm * 1.06 Mx Mx cs_vh 2 h n m c st g cs_inv h n m st
  "<svg class=\"sim-g\" viewBox=\"0 0 340 208\" role=\"img\" aria-label=\"Evolução do valor nos três cenários: arrasta para ver cada ano\">"
  "<path class=\"sim-band\" d=\"M" cs_pts 2 h y 0 m c st vm " L" cs_pts 0 h y 1 m c st vm " Z\"/>"
  "<path class=\"sim-otim\" d=\"M" cs_pts 2 h y 0 m c st vm "\"/>"
  "<path class=\"sim-pess\" d=\"M" cs_pts 0 h y 0 m c st vm "\"/>"
  "<path class=\"sim-inv\" d=\"M" cs_pts 3 h y 0 m c st vm "\"/>"
  "<path class=\"sim-base\" d=\"M" cs_pts 1 h y 0 m c st vm "\"/>"
  ? > g 0.0 {
    = gy cs_y g vm
    "<line class=\"sim-goal\" x1=\"34\" x2=\"330\" y1=\"" _nu_fixo gy 1 "\" y2=\"" _nu_fixo gy 1 "\"/>"
    "<text class=\"sim-t\" x=\"36\" y=\"" _nu_fixo - gy 4.0 1 "\">objetivo</text>" 0 } 0
  "<text class=\"sim-t\" x=\"30\" y=\"18\" text-anchor=\"end\">" _nu_compacto vm "</text>"
  "<text class=\"sim-t\" x=\"30\" y=\"189\" text-anchor=\"end\">0</text>"
  "<text class=\"sim-t\" x=\"34\" y=\"203\">hoje</text>"
  ? > y 3 { "<text class=\"sim-t\" x=\"" _nu_fixo cs_x / y 2 y 1 "\" y=\"203\" text-anchor=\"middle\">" N / y 2 " anos</text>" 0 } 0
  "<text class=\"sim-t\" x=\"330\" y=\"203\" text-anchor=\"end\">" N y ? == y 1 " ano" " anos" "</text>"
  # o dedo: uma faixa invisível por ano, com o texto desse ano (a casca mostra-o e põe a linha lá)
  "<line class=\"sim-cur\" x1=\"-9\" x2=\"-9\" y1=\"10\" y2=\"186\"/>"
  = w / 296.0 F y = t 0
  W <= t y {
    = x cs_x t y = n * t 12
    "<rect class=\"sim-hit\" x=\"" _nu_fixo - x / w 2.0 1 "\" y=\"0\" width=\"" _nu_fixo w 1 "\" height=\"208\" data-x=\"" _nu_fixo x 1 "\" data-tx=\""
    ? t { "Em " N t ? == t 1 " ano" " anos" 0 } "Hoje"
    ": " cs_eur cs_vh 1 h n m c st " · entre " cs_mil cs_vh 0 h n m c st " e " cs_mil cs_vh 2 h n m c st " · investido " cs_eur cs_inv h n m st "\"/>"
    = t + t 1 }
  "</svg>" 0 }

# uma linha da tabela: ao fim de t anos
: cs_linha iiffff>i t h m c st s0 {
  = n * t 12
  "<tr><td>" N t ? == t 1 " ano" " anos" "</td><td class=\"num\">" cs_eur cs_inv h n m st "</td><td class=\"num\"><b>"
  cs_eur cs_vh 1 h n m c st "</b></td><td class=\"num sim-r\">" cs_mil cs_vh 0 h n m c st " – " cs_mil cs_vh 2 h n m c st "</td></tr>" 0 }

# um controlo: o nome e o valor por cima; a barra com − e + (passo d) por baixo. k = a chave nos Ajustes (data-cfg);
# f = 0 euros, 1 anos, 2 euros ou "sem objetivo" (o JS escreve o mesmo enquanto se arrasta: data-fmt)
: cs_ctl iiffffi>i k nome v mn mx d f {
  "<div class=\"sim-c\"><div class=\"sim-ch\"><span>" _tx_p nome "</span><b class=\"num\" data-out=\"" _tx_p k "\">"
  ? == f 1 { N I v ? == I v 1 " ano" " anos" 0 } ? && == f 2 <= v 0.0 "sem objetivo" cs_eur v
  "</b></div><div class=\"sim-cr\"><button type=\"button\" class=\"sim-pm\" data-act=\"sim-step\" data-k=\"" _tx_p k "\" data-d=\"-" _nu_ps d "\" aria-label=\"Menos\">−</button>"
  "<input type=\"range\" class=\"sim-rg\" min=\"" _nu_ps mn "\" max=\"" _nu_ps mx "\" step=\"" _nu_ps d "\" value=\"" _nu_ps v "\" data-cfg=\"" _tx_p k "\" data-fmt=\"" N f "\" aria-label=\"" _tx_p nome "\">"
  "<button type=\"button\" class=\"sim-pm\" data-act=\"sim-step\" data-k=\"" _tx_p k "\" data-d=\"" _nu_ps d "\" aria-label=\"Mais\">+</button></div></div>" 0 }

# ===== o rendimento real (4.13): o que já investiu, pelo plano e pelas compras avulsas =====
# Instantâneo real: now (s), desde (texto), loading, bench {name, px, h}, ativos [{k, name, px, h, b, plan, pm, pmDef}]:
# h = [[t, preço em €]] (semanal até há 5 anos, diário no último), b = [[t, €]] as compras (as do plano já expandidas).
# Cada compra compra e / preço(t) unidades; o preço num dia é o último fecho até esse dia.
: cr_vec i>i h {
  = n _ar_n h = v A + 1 * 2 n ! v n = c _ar_prim h = i 0
  W c { !f + + v 1 i _ar_num _ar_idx c 0 !f + + + v 1 n i _ar_num _ar_idx c 1 = c _ar_prox c = i + i 1 }
  v }
: cr_px if>f v t {
  = n @ v = lo 0 = hi - n 1
  ? < t @f + v 1 @f + + + v 1 n 0 {
    W < lo hi { = md / + + lo hi 1 2 ? <= @f + + v 1 md t { = lo md 0 } { = hi - md 1 0 } }
    @f + + + v 1 n lo } }
# a tabela dos ativos com compras e preços: [na, e por ativo 7 palavras: nó, preços, compras, preço agora, unidades,
# investido, agora (s)]
: cr_prep if>i l tf {
  = n _ar_n l = tb A + 1 * 7 n ! tb 0 = c _ar_prim l
  W c {
    = b _ar_get c $"b" = h _ar_get c $"h" = pa _ar_vnum _ar_get c $"px"
    ? && && > _ar_n b 0 > _ar_n h 0 && _nu_fin pa > pa 0.0 {
      = p + + tb 1 * 7 @ tb
      ! p c ! + p 1 cr_vec h ! + p 2 cr_vec b !f + p 3 pa !f + p 6 tf
      = bv @ + p 2 = nb @ bv = u 0.0 = e 0.0 = i 0
      W < i nb { = ei @f + + + bv 1 nb i = u + u / ei cr_px @ + p 1 @f + + bv 1 i = e + e ei = i + i 1 }
      !f + p 4 u !f + p 5 e
      ! tb + @ tb 1 0 } 0
    = c _ar_prox c }
  tb }
: cr_p ii>i tb j + + tb 1 * 7 j
# o valor do ativo (a linha p da tabela) no instante t (agora: com o preço de agora), e o que tinha investido até lá
: cr_vt if>f p t {
  = bv @ + p 2 = nb @ bv = u 0.0 = i 0
  W < i nb { = ti @f + + bv 1 i ? <= ti t { = u + u / @f + + + bv 1 nb i cr_px @ + p 1 ti 0 } 0 = i + i 1 }
  * u ? >= t @f + p 6 @f + p 3 cr_px @ + p 1 t }
: cr_it if>f p t {
  = bv @ + p 2 = nb @ bv = e 0.0 = i 0
  W < i nb { ? <= @f + + bv 1 i t { = e + e @f + + + bv 1 nb i 0 } 0 = i + i 1 }
  e }
# o primeiro dia de compra dos ativos j0..j1-1
: cr_t0 iii>f tb j0 j1 {
  = m 99999999999.0 = j j0
  W < j j1 { = bv @ + cr_p tb j 2 = nb @ bv = i 0 W < i nb { = m Mn m @f + + bv 1 i = i + i 1 } = j + j 1 }
  m }
# o que as compras dos ativos j0..j1-1 valeriam em T a render r por ano (dinheiro ponderado: a TIR)
: cr_fv iiiff>f tb j0 j1 r tf {
  = s 0.0 = j j0
  W < j j1 {
    = bv @ + cr_p tb j 2 = nb @ bv = i 0
    W < i nb { = s + s * @f + + + bv 1 nb i Pw + 1.0 r / - tf @f + + bv 1 i 31557600.0 = i + i 1 }
    = j + j 1 }
  s }
: cr_tir iiiff>f tb j0 j1 vv tf {
  = lo -0.95 = hi 5.0 = k 0
  W < k 90 { = md * 0.5 + lo hi ? > cr_fv tb j0 j1 md tf vv { = hi md 0 } { = lo md 0 } = k + k 1 }
  * 0.5 + lo hi }
# o que as mesmas compras valeriam no fundo de referência (vb: os preços, pb: o preço agora)
: cr_bench iif>f tb vb pb {
  = s 0.0 = j 0
  W < j @ tb { = bv @ + cr_p tb j 2 = nb @ bv = i 0
    W < i nb { = s + s / @f + + + bv 1 nb i cr_px vb @f + + bv 1 i = i + i 1 } = j + j 1 }
  * s pb }
# "03/2024"
: cr_mes f>i t { _dt_civil _dt_dia I * t 1000.0 = c _dt_cv _nu_pzk @ + c 1 2 P '/ N @ c 0 }
: cr_pc f>i x { ? >= x 0.0 P '+ { P 226 P 136 P 146 0 } _nu_intl * Ab x 100.0 1 " %" 0 }
: cr_eursg f>i x { ? >= x 0.0 P '+ { P 226 P 136 P 146 0 } cs_eur Ab x 0 }

# o gráfico da evolução: o valor (com a área) e o que foi investido, com o dedo (data-tx) como no simulador
: cr_graf iiff>i tb na t0 tf {
  = kk 60 = vm 1.0 = k 0
  W < k kk { = t + t0 * - tf t0 / F k F - kk 1 = v 0.0 = e 0.0 = j 0
    W < j na { = v + v cr_vt cr_p tb j t = e + e cr_it cr_p tb j t = j + j 1 }
    = vm Mx vm Mx v e = k + k 1 }
  = vm * vm 1.06
  "<svg class=\"sim-g real-g\" viewBox=\"0 0 340 208\" role=\"img\" aria-label=\"Evolução da carteira: arrasta para ver cada mês\">"
  "<path class=\"real-a\" d=\"M34 186" = k 0
  W < k kk { = t + t0 * - tf t0 / F k F - kk 1 = v 0.0 = j 0 W < j na { = v + v cr_vt cr_p tb j t = j + j 1 }
    " L" _nu_fixo + 34.0 / * 296.0 F k F - kk 1 1 P 32 _nu_fixo cs_y v vm 1 = k + k 1 }
  " L330 186 Z\"/><path class=\"sim-inv\" d=\"M" = k 0
  W < k kk { = t + t0 * - tf t0 / F k F - kk 1 = e 0.0 = j 0 W < j na { = e + e cr_it cr_p tb j t = j + j 1 }
    ? k " L" 0 _nu_fixo + 34.0 / * 296.0 F k F - kk 1 1 P 32 _nu_fixo cs_y e vm 1 = k + k 1 }
  "\"/><path class=\"real-v\" d=\"M" = k 0
  W < k kk { = t + t0 * - tf t0 / F k F - kk 1 = v 0.0 = j 0 W < j na { = v + v cr_vt cr_p tb j t = j + j 1 }
    ? k " L" 0 _nu_fixo + 34.0 / * 296.0 F k F - kk 1 1 P 32 _nu_fixo cs_y v vm 1 = k + k 1 }
  "\"/>"
  "<text class=\"sim-t\" x=\"30\" y=\"18\" text-anchor=\"end\">" _nu_compacto vm "</text>"
  "<text class=\"sim-t\" x=\"30\" y=\"189\" text-anchor=\"end\">0</text>"
  "<text class=\"sim-t\" x=\"34\" y=\"203\">" cr_mes t0 "</text>"
  "<text class=\"sim-t\" x=\"330\" y=\"203\" text-anchor=\"end\">hoje</text>"
  "<line class=\"sim-cur\" x1=\"-9\" x2=\"-9\" y1=\"10\" y2=\"186\"/>"
  = w / 296.0 F - kk 1 = k 0
  W < k kk { = t + t0 * - tf t0 / F k F - kk 1 = v 0.0 = e 0.0 = j 0
    W < j na { = v + v cr_vt cr_p tb j t = e + e cr_it cr_p tb j t = j + j 1 }
    = x + 34.0 * w F k
    "<rect class=\"sim-hit\" x=\"" _nu_fixo - x / w 2.0 1 "\" y=\"0\" width=\"" _nu_fixo w 1 "\" height=\"208\" data-x=\"" _nu_fixo x 1 "\" data-tx=\""
    ? == k - kk 1 "Hoje" cr_mes t ": " cs_eur v " · investido " cs_eur e ? > e 0.0 { " · " cr_pc - / v e 1.0 0 } 0 "\"/>"
    = k + k 1 }
  "</svg>" 0 }

# o editor: desde quando compra pelo plano e quanto por mês, ativo a ativo
: cr_editor ii>i l aberto {
  "<details class=\"how real-ed\" data-fold=\"real-ed\"" ? aberto " open" 0 "><summary>As tuas compras pelo plano</summary>"
  = c _ar_prim l
  W c {
    "<div class=\"real-in\"><b>" _ar_ps _ar_get c $"name" 1 "</b>"
    "<label><small>Desde</small><input class=\"inp\" type=\"date\" data-lot=\"plan\" data-k=\"" _ar_ps _ar_get c $"k" 1 "\" value=\"" _ar_ps _ar_get c $"plan" 1 "\"></label>"
    "<label><small>€ por mês</small><input class=\"inp\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"10\" data-lot=\"pm\" data-k=\"" _ar_ps _ar_get c $"k" 1 "\" value=\""
    = pm _ar_vnum _ar_get c $"pm" ? && _nu_fin pm > pm 0.0 _nu_ps pm 0
    "\" placeholder=\"" = pd _ar_vnum _ar_get c $"pmDef" ? && _nu_fin pd > pd 0.0 _nu_ps pd P '0 "\"></label></div>"
    = c _ar_prox c }
  "<p class=\"note\">O plano conta nos dias de execução escolhidos nos Ajustes, com o valor de cada mês dividido por eles. As compras avulsas (data e valor) juntam-se na ficha de cada cripto.</p></details>" 0 }

: cr_real i>i r {
  = l _ar_get r $"ativos"
  "\n        <section class=\"sec real\"><div class=\"sec-h\"><h2>A tua carteira</h2>"
  ? _ar_verd _ar_get r $"desde" { "<span class=\"sub\">desde " _ar_ps _ar_get r $"desde" 1 "</span>" 0 } 0 "</div>"
  = tb cr_prep l _ar_vnum _ar_get r $"now" = na @ tb
  ? == na 0 {
    ? _ar_verd _ar_get r $"loading" "<div class=\"empty\">A carregar os preços…</div>"
      "<div class=\"empty\">Diz desde quando compras pelo plano (e quanto por mês) para veres quanto vale hoje, quanto ganhaste e a evolução.</div>"
    cr_editor l 1 "</section>" 0 } {
    = tf _ar_vnum _ar_get r $"now"
    = vv 0.0 = ee 0.0 = j 0 W < j na { = p cr_p tb j = vv + vv * @f + p 3 @f + p 4 = ee + ee @f + p 5 = j + j 1 }
    = t0 cr_t0 tb 0 na
    = umano >= - tf t0 31557600.0
    "<div class=\"sim-big\"><small>Vale hoje</small><b class=\"num\">" cs_eur vv "</b>"
    "<div class=\"sim-rng " ? >= vv ee "up-t" "down-t" "\">" cr_eursg - vv ee " (" cr_pc - / vv ee 1.0 ")"
    ? umano { " · " cr_pc cr_tir tb 0 na vv tf " por ano" 0 } 0 "</div></div>"
    cr_graf tb na t0 tf
    "<div class=\"sim-tip\">Arrasta o dedo no gráfico para ver cada mês.</div>"
    "<div class=\"sim-leg\"><span><i class=\"b\"></i>vale</span><span><i class=\"v\"></i>investido</span></div>"
    "<div class=\"stats sim-st\">"
    "<div><small>Investido</small><b class=\"num\">" cs_eur ee "</b></div>"
    "<div><small>Ganho</small><b class=\"num " ? >= vv ee "up-t" "down-t" "\">" cr_eursg - vv ee "</b></div>"
    "<div><small>Por ano</small><b class=\"num\">" ? umano cr_pc cr_tir tb 0 na vv tf "—" "</b></div>"
    = bn _ar_get r $"bench" = bh _ar_get bn $"h" = bp _ar_vnum _ar_get bn $"px"
    ? && > _ar_n bh 0 && _nu_fin bp > bp 0.0 {
      = vb cr_bench tb cr_vec bh bp
      "<div><small>Tudo em " _ar_ps _ar_get bn $"name" 1 "</small><b class=\"num\">" cs_eur vb "</b></div>" 0 } 0
    "</div>"
    # ativo a ativo
    "<div class=\"list real-l\">" = j 0
    W < j na {
      = p cr_p tb j = c @ p = v * @f + p 3 @f + p 4 = e @f + p 5
      "<button type=\"button\" class=\"row\" data-open=\"" _ar_ps _ar_get c $"k" 1 "\"><div class=\"r-main\"><div class=\"r-name\">" _ar_ps _ar_get c $"name" 1
      "</div><div class=\"r-sub\">investido " cs_eur e
      ? >= - tf cr_t0 tb j + j 1 31557600.0 { " · " cr_pc cr_tir tb j + j 1 v tf " por ano" 0 } 0
      "</div></div><div class=\"r-px num\"><span class=\"px\">" cs_eur v "</span><span class=\"chg " ? >= v e "up" "down" "\">" cr_pc - / v e 1.0 "</span></div></button>"
      = j + j 1 }
    "</div>"
    ? ~ umano "<p class=\"note\">O rendimento por ano aparece quando a primeira compra fizer 1 ano.</p>" 0
    cr_editor l 0 "</section>" 0 }
  0 }

: ecra_carteira i>i s {
  ! 53 s
  = rl sg $"real" ? _ar_verd rl cr_real rl 0
  = m cs_num $"budget" = st cs_num $"start" = g cs_num $"goal" = h _ar_verd sg $"hoje"
  = c / Mn 100.0 cs_num $"cp" 100.0
  = y I cs_num $"years"
  ? < y 1 { = y 20 0 } 0
  ? > y 60 { = y 60 0 } 0
  = n * y 12
  "\n        <section class=\"sec sim\"><div class=\"sec-h\"><h2>Simulador</h2><span class=\"sub\">o teu plano daqui a uns anos</span></div>"
  # os controlos (gravam ao largar: data-cfg; − e + num passo)
  "<div class=\"sim-ctl\">"
  cs_ctl $"budget" $"Por mês" m 0.0 Mx 3000.0 m 50.0 0
  cs_ctl $"simStart" $"Já investido" st 0.0 Mx 200000.0 st 1000.0 0
  cs_ctl $"simYears" $"Anos" F y 1.0 Mx 40.0 F y 1.0 1
  cs_ctl $"simGoal" $"Objetivo" g 0.0 Mx 1000000.0 g 10000.0 2
  "</div>"
  # o valor do futuro ou em euros de hoje
  "<div class=\"seg sim-seg\" role=\"group\" aria-label=\"Como mostrar os valores\"><button type=\"button\" data-act=\"sim-hoje\" data-v=\"0\"" ? h 0 " class=\"on\"" ">Valor no futuro</button>"
  "<button type=\"button\" data-act=\"sim-hoje\" data-v=\"1\"" ? h " class=\"on\"" 0 ">Em euros de hoje</button></div>"
  "<p class=\"note sim-infl\">Com 2 % de inflação por ano, 1000 € daqui a " N y ? == y 1 " ano" " anos" " compram o mesmo que " cs_eur / 1000.0 Pw 1.02 F y " hoje.</p>"
  ? && == m 0.0 == st 0.0 {
    "<div class=\"empty\">Escolhe quanto investes por mês (ou quanto já tens investido) para ver onde chegas.</div></section>" 0 } {
    = vb cs_vh 1 h n m c st = vp cs_vh 0 h n m c st = vo cs_vh 2 h n m c st
    = inv cs_inv h n m st
    "<div class=\"sim-big\"><small>Daqui a " N y ? == y 1 " ano" " anos" ", no cenário base" ? h ", em euros de hoje" 0 "</small><b class=\"num\">" cs_eur vb "</b>"
    "<div class=\"sim-rng\">entre " cs_eur vp " e " cs_eur vo "</div>"
    "<div class=\"sim-split\">" ? > m 0.0 { cs_eur m " por mês · " 0 } 0
    ? > c 0.0 { _nu_intl * 100.0 - 1.0 c 0 " % " _ar_ps sg $"core" 1 " · " _nu_intl * 100.0 c 0 " % cripto" 0 } { "100 % " _ar_ps sg $"core" 1 0 } "</div></div>"
    cs_graf h y n m c st g
    "<div class=\"sim-tip\" id=\"sim-tip\">Arrasta o dedo no gráfico para ver cada ano.</div>"
    "<div class=\"sim-leg\"><span><i class=\"o\"></i>otimista</span><span><i class=\"b\"></i>base</span><span><i class=\"p\"></i>pessimista</span><span><i class=\"v\"></i>investido</span></div>"
    # o resumo: investido, ganho, o outro valor (de hoje ou do futuro), imposto no fim
    = imp / cs_imp n m c st cs_df h n
    "<div class=\"stats sim-st\">"
    "<div><small>Investes" ? h ", em euros de hoje" 0 "</small><b class=\"num\">" cs_eur inv "</b></div>"
    "<div><small>Ganho" ? h " real" " (base)" "</small><b class=\"num up-t\">" cs_eur - vb inv "</b></div>"
    ? h { "<div><small>Valor no futuro</small><b class=\"num\">" cs_eur cs_val 1 n m c st "</b></div>" 0 }
      { "<div><small>Em euros de hoje</small><b class=\"num\">" cs_eur / vb Pw 1.02 F y "</b></div>" 0 }
    "<div><small>Imposto se venderes tudo</small><b class=\"num\">" cs_eur imp "</b></div>"
    "</div>"
    # o objetivo (em euros de hoje, se é assim que se mostra)
    ? > g 0.0 {
      = mb cs_meta 1 h m c st g = mp cs_meta 0 h m c st g = mo cs_meta 2 h m c st g
      "<div class=\"box sim-meta\"><h3>Objetivo: " cs_eur g ? h " de hoje" 0 "</h3>"
      ? < mb 0 "<p>Com este plano, não chegas lá em 100 anos no cenário base. Sobe o valor por mês ou o que já tens investido.</p>"
      { "<p>Chegas lá em <b>" cs_tempo mb "</b> no cenário base"
        ? && >= mo 0 >= mp 0 { " (entre " cs_tempo mo " e " cs_tempo mp ")" 0 } ? >= mo 0 { " (no otimista, em " cs_tempo mo ")" 0 } 0
        ".</p>"
        ? > mb n { "<p class=\"note\">Mais do que os " N y " anos simulados: o gráfico não chega lá.</p>" 0 } 0 0 }
      "</div>" 0 } 0
    # os marcos
    "<div class=\"box\"><h3>Ao longo do tempo" ? h " <small>em euros de hoje</small>" 0 "</h3><table class=\"sim-tab\"><thead><tr><th></th><th>Investido</th><th>Base</th><th>Intervalo</th></tr></thead><tbody>"
    = k 0 W < k 6 {
      = t ? == k 0 5 ? == k 1 10 ? == k 2 15 ? == k 3 20 ? == k 4 30 40
      ? < t y cs_linha t h m c st 0.0 0
      = k + k 1 }
    cs_linha y h m c st 0.0
    "</tbody></table></div>"
    "<details class=\"how\"><summary>Como é feita a conta</summary><ul>"
    "<li>Mês a mês: o que já tens rende e entra o valor do plano, dividido como no plano do mês.</li>"
    "<li>Ações (o fundo núcleo): 3 % por ano no pessimista, 6 % no base e 9 % no otimista. As ações do mundo renderam cerca de 8 % por ano nos últimos 50 anos, antes da inflação.</li>"
    "<li>Cripto: 0 %, 10 % e 25 % por ano. Pode também cair muito mais.</li>"
    "<li>Em euros de hoje: tudo dividido pela inflação de 2 % por ano até à data — é o que esse dinheiro compra hoje.</li>"
    "<li>Imposto, se venderes tudo no fim: cada compra paga pela idade — 28 % até 2 anos, 25,2 % de 2 a 5, 22,4 % de 5 a 8 e 19,6 % com 8 ou mais; a cripto com 1 ano ou mais está isenta.</li>"
    "</ul></details></section>" 0 }
  0 }
