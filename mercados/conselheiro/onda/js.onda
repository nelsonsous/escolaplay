# JSON.parse(t): o valor, ou 0 se o texto não é JSON válido (o JS lança SyntaxError)
: js_parse i>i t {
  = s g_jp ! s + t 1 ! + s 1 @ t ! + s 2 0
  = v jp_v s
  ? @ + s 2 0 { jp_ws s ? < @ s @ + s 1 0 v } }

# ---------- JSON.stringify ----------
# escreve v (ind = espaços por nível, 0 = compacto; d = nível); devolve 0 se v é undefined (não escreve nada)
: js_ind ii>i ind d { P 10 = j 0 W < j * ind d { P 32 = j + j 1 } 0 }
: js_pj iii>i v ind d {
  = t js_tipo v
  ? == t 1 0 ? == t 2 { "null" 1 } ? == t 3 { "false" 1 } ? == t 4 { "true" 1 } ? == t 5 { nu_pj js_f v 1 }
  ? == t 8 { tx_pj v 1 } ? == t 6 {
    = n js_len v
    ? == n 0 { "[]" 1 } {
      P '[ = j 0
      W < j n { ? j P ', 0 ? ind js_ind ind + d 1 0 = x js_it v j ? == js_tipo x 1 "null" js_pj x ind + d 1 0 = j + j 1 }
      ? ind js_ind ind d 0 P '] 1 } } {
    = r js_ordem v = n js_on v = c 0
    P '{ = j 0
    W < j n {
      = p js_pos r j = x js_ov v p
      ? != js_tipo x 1 { ? c P ', 0 ? ind js_ind ind + d 1 0 tx_pj js_ok v p P ': ? ind P 32 0 js_pj x ind + d 1 = c + c 1 } 0
      = j + j 1 }
    ? && ind c js_ind ind d 0 P '} 1 } }
# o String(v) do JS: listas pelo join(','), objetos "[object Object]"
: js_ps i>i v {
  = t js_tipo v
  ? == t 1 "undefined" ? == t 2 "null" ? == t 3 "false" ? == t 4 "true" ? == t 5 nu_ps js_f v ? == t 8 tx_p v
  ? == t 6 { = j 0 W < j js_len v { ? j P ', 0 = x js_it v j ? js_nulo x 0 js_ps x = j + j 1 } 0 } "[object Object]" }
# o String(v) como texto
: js_str i>i v ? js_ehtxt v v { sb_ini js_ps v sb_fim }
# o Number(v) do JS
: js_tonum i>f v {
  = t js_tipo v
  ? || == t 1 == t 7 Bw 2146959360 0 ? || == t 2 == t 3 0. ? == t 4 1. ? == t 5 js_f v ? == t 8 nu_s2n v nu_s2n js_str v }
# o StringToNumber do JS: sem espaços à volta; vazio dá 0; decimal (com sinal, ponto e expoente), Infinity, 0x 0o 0b
: nu_s2n i>f t {
  = q + t 1 = e @ t
  W && < q e tx_ews tx_cp q = q + q @ g_nb
  # o fim sem os espaços: recua enquanto o último código é espaço
  = go 1 W && go > e q { = b - e 1 W && > b q == & @ b 192 128 = b - b 1 = go tx_ews tx_cp b ? go = e b 0 }
  ? >= q e 0. {
    = c0 @ q
    = r ? && == c0 '0 < + q 1 e { = c1 | @ + q 1 32 = base ? == c1 'x 16 ? == c1 'o 8 ? == c1 'b 2 0
        ? base nu_s2nb + q 2 e base Bw 2146959360 1 } Bw 2146959360 1
    ? == Bh r 2146959360 {
      = neg 0 ? || == c0 '+ == c0 '- { = neg == c0 '- = q + q 1 0 } 0
      = v ? && == - e q 8 nu_eh q k_Infinity Bw 2146435072 0 nu_s2nd q e
      ? neg * -1. v v } r } }
# o pedaço [q, e) é o texto t?
: nu_eh ii>i q t { = n tx_len t = ok 1 = j 0 W && ok < j n { = ok == @ + q j tx_b t j = j + j 1 } ok }
# decimal sem sinal em [q, e): algarismos, ponto, expoente (pelo menos um algarismo antes ou depois do ponto)
: nu_s2nd ii>f q e {
  = dg g_dig = nd 0 = ex 0 = st 0 = na 0
  W && < q e && >= @ q '0 <= @ q '9 {
    = d - @ q '0 = na + na 1
    ? < nd 780 { ? || > nd 0 d { ! + dg nd d = nd + nd 1 0 } 0 } { = ex + ex 1 = st || st d }
    = q + q 1 }
  ? && < q e == @ q '. {
      = q + q 1
      W && < q e && >= @ q '0 <= @ q '9 {
        = d - @ q '0 = na + na 1
        ? < nd 780 { ? || > nd 0 d { ! + dg nd d = nd + nd 1 0 } 0 = ex - ex 1 } { = st || st d }
        = q + q 1 } } 0
  = ok > na 0
  ? && && ok < q e || == @ q 'e == @ q 'E {
      = q + q 1 = sg 1
      ? && < q e || == @ q '+ == @ q '- { = sg ? == @ q '- -1 1 = q + q 1 } 0
      ? || >= q e || < @ q '0 > @ q '9 { = ok 0 0 } {
        = x 0 W && < q e && >= @ q '0 <= @ q '9 { = x ? < x 100000 + * x 10 - @ q '0 x = q + q 1 }
        = ex + ex * sg x } } 0
  ? || ~ ok < q e Bw 2146959360 0 {
    ? st { ! + dg nd 1 = nd + nd 1 = ex - ex 1 } 0
    ? == nd 0 0. nu_d2f dg nd ex } }
# 0x 0o 0b: o valor exato, arredondado a 53 bits
: nu_s2nb iii>f q e base {
  ? >= q e Bw 2146959360 0 {
    = b g_big bset b 0 = ok 1
    W && ok < q e { = c | @ q 32 = d ? && >= c '0 <= c '9 - c '0 ? && >= c 'a <= c 'f + 10 - c 'a 99 = ok < d base ? ok { bmul b base nu_badd b d } 0 = q + q 1 }
    ? ~ ok Bw 2146959360 0 ? == @ b 0 0. nu_b2f b 0 0 } }
# igualdades: === (strict) e SameValueZero (includes, Set, Map)
: js_eq ii>i a b { = ta js_tipo a ? != ta js_tipo b 0 ? == ta 5 == js_f a js_f b ? == ta 8 tx_igual a b == a b }
: js_svz ii>i a b { = ta js_tipo a ? != ta js_tipo b 0 ? == ta 5 { = x js_f a = y js_f b || == x y && != x x != y y } ? == ta 8 tx_igual a b == a b }
# a.includes(x) / a.indexOf(x) (SameValueZero / ===)
: js_inc ii>i a x { = n js_len a = r 0 = j 0 W && ~ r < j n { = r js_svz js_it a j x = j + j 1 } r }
: js_ix ii>i a x { = n js_len a = r -1 = j 0 W && < r 0 < j n { ? js_eq js_it a j x = r j 0 = j + j 1 } r }

# ---------- ordenar (estável, como o sort do JS: o que fica à frente quando cs_cmp(depois, antes) < 0) ----------
# a ordem: cs_cmp k x y (comum.onda) devolve um real como o comparador do JS (NaN conta como 0)
: js_ordena ii>i a k {
  = n js_len a
  ? < n 2 a {
    = s @ + a 3 = d A n = w 1
    W < w n {
      = i 0
      W < i n {
        = m Mn + i w n = h Mn + i * 2 w n = x i = y m = o i
        W < o h {
          = dir ? >= x m 1 ? >= y h 0 < cs_cmp k @ + s y @ + s x 0.
          ? dir { ! + d o @ + s y = y + y 1 } { ! + d o @ + s x = x + x 1 }
          = o + o 1 }
        = i h }
      = t s = s d = d t
      = w * w 2 }
    = it @ + a 3
    ? != s it { = j 0 W < j n { ! + it j @ + s j = j + j 1 } 0 } 0
    a } }

# ---------- datas ----------
# dias desde 1970 e o resto, para um tempo em ms (inteiro)
: dt_dia i>i t ? >= t 0 / t 86400000 - / + t 1 86400000 1
# o toISOString do JS para um tempo t (ms, real): 0 se não é uma data válida (o JS lança RangeError)
: dt_ok f>i t && finito t <= Ab t 8640000000000000.
: dt_piso f>i t {
  = ms I tioi t
  = z dt_dia ms = r - ms * z 86400000
  dcal z
  = y @ cv
  ? && >= y 0 <= y 9999 pzk y 4 { P ? < y 0 '- '+ pzk ? < y 0 - 0 y y 6 }
  P '- pzk @ + cv 1 2 P '- pzk @ + cv 2 2
  P 'T pzk / r 3600000 2 P ': pzk % / r 60000 60 2 P ': pzk % / r 1000 60 2 P '. pzk % r 1000 3 P 'Z }
# a data UTC de um tempo (AAAA-MM-DD; o toISOString().slice(0, 10))
: dt_pdia i>i ms { dcal dt_dia ms pzk @ cv 4 P '- pzk @ + cv 1 2 P '- pzk @ + cv 2 2 }
# Lisboa: a hora de inverno é a UTC; a de verão (UTC+1) vai do último domingo de março à 01:00 UTC até ao último
# domingo de outubro à 01:00 UTC (as regras da UE, as de Portugal desde 1996)
: dt_ultdom ii>i y m { = z dciv y m 31 - z % + % z 7 11 7 }
: dt_lisboa i>i t {
  dcal dt_dia t
  = y @ cv
  = a + * dt_ultdom y 3 86400000 3600000 = b + * dt_ultdom y 10 86400000 3600000
  ? && >= t a < t b + t 3600000 t }
# a data de hoje em Lisboa (o Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Lisbon' }))
: dt_phoje i>i t dt_pdia dt_lisboa t
# o Intl.DateTimeFormat('pt-PT', { timeZone: 'Europe/Lisbon', weekday: 'long', hour: '2-digit', minute: '2-digit' })
: dt_pquando i>i t {
  = l dt_lisboa t = z dt_dia l = r - l * z 86400000
  = w % + % z 7 11 7
  ? == w 0 "domingo" ? == w 1 "segunda-feira" ? == w 2 "terça-feira" ? == w 3 "quarta-feira" ? == w 4 "quinta-feira"
    ? == w 5 "sexta-feira" "sábado"
  ", " pzk / r 3600000 2 P ': pzk % / r 60000 60 2 }
