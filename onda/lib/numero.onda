    {
      = r _nu_grade a = e @ + _me_lb 12
      = j 16 W >= j 0 { ! + + g 2 j % r 10 = r / r 10 = j - j 1 }
      = k 17 W && > k 1 == @ + + g 1 k 0 = k - k 1
