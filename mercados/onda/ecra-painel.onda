# Mercados — a vista do Painel em Onda. Desde a 4.9.0 é a Onda a referência desta vista (o viewDashboard, o todayCard, o
# briefParts, o row, o card e o viewFuel do JS saíram).
# Simples, como a Trade Republic e a Música: os meus ativos (com o período da variação, 1D 1S 1M 1A, a branco), logo a
# seguir o cartão Hoje, compacto — o resumo do Claude em 3 linhas e a próxima execução do plano; o resto (o plano, o que
# mais seguir, o porquê dos movimentos, os riscos, a agenda) numa dobra —, depois as listas que sigo (cripto, fundos e ETF,
# ações, com a ordem: sobe, desce, bolsa, nome, a minha) com as linhas de sempre (o ícone, o nome, o gráfico pequeno, o
# preço e a variação no período; arrastar para a esquerda retira) e, no fim, em linhas fechadas com uma linha de resumo, os
# índices, a energia e os combustíveis. Sem parágrafos a explicar. A partir do instantâneo que o panelSnap monta (ver lá o
# que vai nele e o que vai já feito). Os eventos, os gestos e os preços ao vivo (o patchLive: .row[data-key] .px e .chg)
# continuam no JS; os gráficos pequenos (canvas.spark) desenha-os o JS depois.
# Entrada: `ecra_painel s`, com s o instantâneo (ecra.onda); saída: o HTML no stdout. As chaves do instantâneo e os
# textos com que se compara são textos constantes ($"…").
# As listas filtram-se e ordenam-se com o comparador que o JS usava e o sort do V8 (ts_ordena de ecra.onda).
# Nomes: pn_*.


# os bytes [a, b) do texto t, escapados
: pn_esc iii>i t a b { = j a W < j b { = c _tx_b t j ? == c '& "&amp;" ? == c '< "&lt;" ? == c '> "&gt;" ? == c 34 "&quot;" ? == c 39 "&#39;" P c = j + j 1 } }

# ===== os números =====
# o fmtPx(price, a, cur) do mercados.js, com a moeda pela ordem do JS: cur || Q[a.key].currency || (cripto ? cfg.fiat : null)
: pn_preco iii>i pn a cu {
  = m ? ha cu cu ? ha a.qc a.qc ? eh a.kind $"crypto" es.fiat 0
  ? == tipo pn 4 fm_px @f + pn 1 a.dec a.pts m "—" }
# fmtPx(v, { decimals: 3 }, 'EUR') (combustíveis e €/L)
: pn_eur3 i>i n ? ln_fin n `{ _nu_intl @f + n 1 3 }{ P 194 }{ P 160 }€` "—"
# o Intl.NumberFormat('pt-PT') por omissão (o NF({}) do JS, até 3 casas) de um número, um booleano, null ou undefined
: pn_nf i>i n { = x num n ? != x x "NaN" ? ~ fin x { `{ Se < x 0. P '- }∞` } _nu_intlm x 3 }

# ===== as linhas: a do Painel (o row() do JS), dentro do sw-wrap (arrastar para a esquerda mostra Retirar) =====
# md 0 só o nome (índices, ações), 1 o card() do JS (a unidade e, na energia por litro, o €/L), 2 os meus ativos (linha
# larga, com o conselho, o desconto e o imposto da cripto); g o grupo do arrastar (hold, list ou fixed)
: pn_linha iii>i a md g {
  = k a.k = px a.px = t a.t
  `\n            <div class="sw-wrap{ Se igual es.swipe k " open" }" data-swk="{ esc k }" data-grp="{ crut g }`
  `"><button type="button" class="sw-del" data-hide="{ esc k }" data-grp="{ crut g }" tabindex="-1">Retirar</button><button type="button" class="row{ Se == md 2 " wide" }" data-open="{ esc k }" data-key="{ esc k }">`
  ln_ico k a.name ? eh a.kind $"crypto" a.sym 0 0
  `<div class="r-main"><div class="r-name">{ esc a.name }</div>`
  ? == md 2 pn_meu a Se == md 1 pn_card a
  `</div><canvas class="spark" data-key="{ esc k }"></canvas><div class="r-px num">`
  Se ha t `<span class="r-t">{ esc t }</span>`
  ? || == tipo px 0 == tipo px 1 `<span class="px skel">0000,00</span>` `<span class="px">{ pn_preco px a a.cur }</span>`
  `{ ln_chg a.pc }</div></button></div>` }
# o card(): a unidade ("por barril") e, na energia por litro, o €/L sem impostos
: pn_card i>i a {
  = u a.unit = l a.pl
  Se ha u `<div class="r-sub">por { esc u }</div>`
  Se ha l `<div class="r-note">≈ { pn_eur3 l }/L sem impostos</div>` }
# os meus ativos: o conselho (o do Claude, com a cor do tom; sem ele o das fontes automáticas, marcado "auto"), o desconto face ao
# máximo do ano e o imposto da cripto (o taxLine do JS)
: pn_meu i>i a {
  = an a.an = cl a.cl = d an.d = ad an.adv = tx a.tax
  = bc && ha cl ha cl.action
  = ba && ~ bc && ha an ha ad
  = vd && ha an ha d
  = vt ha tx
  ? || || || bc ba vd vt {
    `<div class="r-sub">`
    Se bc { = kk cl.key `<span class="badge { ln_tomk kk }">{ ? ln_sht kk 1 0 esc cl.action }</span>` }
    # sem o Claude: o veredicto da decisão consolidada (a.dk, o mesmo da ficha); sem ela, o do sinal automático
    Se ba { = ak ? ha a.dk a.dk ad.key `<span class="badge auto">{ ? ln_sht ak 1 0 esc ad.action }</span>` }
    ? vd `<span class="nb">{ fm_pct1 * num d.dd 100. } do máximo</span>`
      # o conselho do Claude chegou antes da análise da app: o lugar do desconto já guardado
      { Se ~ ha an `<span class="nb-sk skel">−00,0% do máximo</span>` }
    Se && vd vt `<span class="dotsep"> · </span>`
    Se vt `<span class="nb">{ esc tx }</span>`
    "</div>" }
    # ainda sem a análise: o lugar do conselho e do desconto já ocupado, para a linha não crescer (e a lista saltar) depois
    { Se ~ ha an `<div class="r-sk"><span class="badge skel">Manter</span><span class="nb skel">−00,0% do máximo</span></div>` } }

# ===== as listas =====
# os ativos das chaves da lista l (pela ordem dela; as que não são ativos ficam de fora), menos os que tenho (fl & 1) e os
# retirados (fl & 2), em w; dá quantos
: pn_junta iii>i l fl w {
  = mi es.mine = hi es.hidden = c pri l = m 0
  W c {
    ? || && & fl 1 _ar_tem mi c && & fl 2 _ar_tem hi c 0 { = a ln_ativo c Se a { ! + w m a = m + m 1 } }
    = c seg c }
  m }
# quantas chaves da lista l estão retiradas (o nHid do JS)
: pn_nret i>i l { = hi es.hidden = c pri l = m 0 W c { Se _ar_tem hi c = m + m 1 = c seg c } m }
: pn_lista iiii>i w m md g { `<div class="list sw-list">` L j m pn_linha @ + w j md g "</div>" }
# o rodapé (o foot do JS): + Juntar (com o data-act ad; sem ele, 0) e Repor n (com o data-unhide u; nada se n é 0)
: pn_pe iii>i ad u n Se || ad n {
  `<div class="sec-f">`
  Se ad `<button type="button" class="lnk" data-act="{ crut ad }">+ Juntar</button>`
  Se n `<button type="button" class="lnk" data-unhide="{ crut u }">Repor { N n }</button>`
  "</div>" }
# o período da variação ((cfg.per || '1d') === v: a escolha a branco)
: pn_per ii>i p v `<button type="button" data-per="{ crut v }" class="{ Se ? ha p eh p v mesmo v $"1d" "on" }">`
: pn_periodo >i {
  = p es.per
  `<div class="right seg per" role="group" aria-label="Período da variação">`
  `{ pn_per p $"1d" }1D</button>{ pn_per p $"1w" }1S</button>{ pn_per p $"1m" }1M</button>{ pn_per p $"1y" }1A</button>`
  "</div>" }
# os meus ativos (o holdingKeys(), pela ordem dos Ajustes)
: pn_meus >i {
  = l es.mine = w A + quantos l 1 = m pn_junta l 0 w
  `\n        <section class="sec"><div class="sec-h"><h2>Os meus ativos</h2>{ pn_periodo }</div>`
  ? m pn_lista w m 2 $"hold" `<div class="empty">Escolhe em Ajustes → O que tenho.</div>`
  `{ pn_pe $"go-hold" 0 0 }</section>` }
# a cripto que não tenho (e não retirei); com alguma retirada, a secção fica (com o Repor)
: pn_cripto >i {
  = l es.crypto = w A + quantos l 1 = m pn_junta l 3 w = nh pn_nret l
  Se || m nh `\n        <section class="sec"><div class="sec-h"><h2>Cripto</h2></div>{ pn_lista w m 1 $"fixed" }{ pn_pe 0 $"crypto" nh }</section>` }
# os fundos e ETF que sigo e não tenho
: pn_fundos >i {
  = l es.funds = w A + quantos l 1 = m pn_junta l 1 w
  Se || m ~ quantos l {
    `\n        <section class="sec"><div class="sec-h"><h2>Fundos e ETF</h2></div>`
    ? m pn_lista w m 1 $"list" `<div class="empty">Sem fundos. Junta em Ajustes (ex.: VWCE, IWDA).</div>`
    `{ pn_pe $"go-add" 0 0 }</section>` } }
# as ações que sigo, pela ordem escolhida: sobe ou desce (a variação no período; sem ela, no fim), por bolsa (pela subida,
# em grupos), pelo nome (o localeCompare('pt') do browser: a ordem nr que o JS manda) ou a minha (a dos Ajustes)
: pn_chip ii>i so v `<button type="button" data-sort="{ crut v }" class="{ Se mesmo so v "on" }">`
: pn_acoes >i {
  = l es.watch = w A + quantos l 1 = m pn_junta l 0 w
  = s es.sort = so ? eh s $"chg" $"up" ? == tipo s 5 txt s 0
  = dn mesmo so $"down" = nm mesmo so $"name"
  # sort((a, b) => (pc(b) ?? -1e9) - (pc(a) ?? -1e9)) (sobe e bolsa), (pc(a) ?? 1e9) - (pc(b) ?? 1e9) (desce) e o nome
  = ix A + m 1 = k1 A + m 1 L j m {
    = a @ + w j = v a.pc
    ! + ix j j
    !f + k1 j ? nm num a.nr ? ln_fin v @f + v 1 ? dn 1000000000. -1000000000. }
  ? || mesmo so $"up" mesmo so $"mkt" _or_power ix m k1 0 0 Se || dn nm _or_power ix m k1 0 1
  `\n        <section class="sec"><div class="sec-h"><h2>Ações que sigo</h2></div><div class="chips sort" role="group" aria-label="Ordenar">`
  `{ pn_chip so $"up" }↑ Sobe</button>{ pn_chip so $"down" }↓ Desce</button>{ pn_chip so $"mkt" }Bolsa</button>`
  `{ pn_chip so $"name" }Nome</button>{ pn_chip so $"mine" }Minha</button></div>`
  ? m { ? mesmo so $"mkt" pn_grupos ix m w { `<div class="list sw-list">` L j m pn_linha @ + w @ + ix j 0 $"list" "</div>" } }
    `<div class="empty">Sem ações na lista. Junta em Ajustes.</div>`
  `{ pn_pe $"go-add" 0 0 }</section>` }
# por bolsa (o mktOf do JS): os grupos do MKT_ORDER primeiro, por essa ordem, e depois os outros pela ordem em que aparecem;
# em cada um, as linhas pela ordem da subida
: pn_grupos iii>i ix m w {
  = gs A + m 1 = ng 0 L j m {
    = g _ar_get @ + w @ + ix j $"mkt" = i 0 = ach 0
    W && < i ng ~ ach { Se igual @ + gs i g = ach 1 = i + i 1 }
    ? ach 0 { ! + gs ng g = ng + ng 1 0 } }
  = mo es.mktOrder = c pri mo
  W c { L i ng Se igual @ + gs i c { pn_grupo @ + gs i ix m w = i ng } = c seg c }
  L i ng ? _ar_tem mo @ + gs i 0 pn_grupo @ + gs i ix m w }
: pn_grupo iiii>i g ix m w {
  = n 0 L j m Se igual _ar_get @ + w @ + ix j $"mkt" g = n + n 1
  `<div class="grp-h">{ esc g }<small>{ N n }</small></div><div class="list sw-list">`
  L j m { = a @ + w @ + ix j Se igual a.mkt g pn_linha a 0 $"list" }
  "</div>" }

# ===== em baixo, em linhas fechadas (details com data-fold: ficam como o utilizador as deixou) =====
# numa linha pequena: os três primeiros com a variação no período (o nome e a variação, com a cor do tom)
: pn_resumo ii>i w m {
  = j 0 = q 0
  W && < j m < q 3 {
    = a @ + w j = v a.pc
    Se ln_fin v { `{ ? q " · " "<small>" }{ esc a.name } <span class="{ ln_tom @f + v 1 }-t">{ fm_pct @f + v 1 }</span>` = q + q 1 }
    = j + j 1 }
  Se q "</small>" }
# os índices, o câmbio e o ouro; a energia (com o €/L da gasolina e do gasóleo)
: pn_indices >i {
  = l es.indices = w A + quantos l 1 = m pn_junta l 2 w = nh pn_nret l
  `\n        <details class="an-f pn-f" data-fold="pn-idx" { Se ha es.foldIdx "open" }><summary><span class="f-t">Índices, câmbio e ouro`
  `{ pn_resumo w m }</span></summary>{ pn_lista w m 0 $"fixed" }{ pn_pe 0 $"index" nh }</details>` }
: pn_energia >i {
  = l es.energy = w A + quantos l 1 = m pn_junta l 2 w = nh pn_nret l
  `\n        <details class="an-f pn-f" data-fold="pn-en" { Se ha es.foldEn "open" }><summary><span class="f-t">Petróleo e energia`
  `{ pn_resumo w m }</span></summary>{ pn_lista w m 1 $"fixed" }{ pn_pe 0 $"energy" nh }</details>` }
# os combustíveis (a DGEG, pelo conector), no concelho ou no distrito dos Ajustes: numa linha, a mediana de cada um; lá
# dentro os cartões (tocar mostra os postos, do mais barato)
: pn_fcard i>i f {
  ? ha f.error `<div class="card fuel"><div class="c-name">{ esc f.name }</div><div class="c-sub">{ esc f.error }</div></div>` {
    = nm f.name = n f.n
    `<button type="button" class="card fuel" data-fuel="{ _ar_ps f.id 2 }" aria-label="Ver os preços nos postos: { esc nm }"><div class="c-top"><span class="c-name">{ esc nm }`
    `</span></div><div class="f-avg num">{ pn_eur3 f.median }<span class="c-unit">/L</span></div><div class="c-note">mediana · média { pn_eur3 f.avg }`
    `<br>{ pn_nf n } postos · máx. { pn_eur3 f.max }</div>`
    = ch f.cheapest = c0 ? == tipo ch 6 idx ch 0 0
    Se ha c0 {
      `<div class="f-min">Mais barato: <b class="num">{ pn_eur3 c0.price }</b><br>`
      = b c0.brand = nn c0.name Se ha b esc b Se && ha b ha nn " — " Se ha nn esc nn
      = pl c0.place Se ha pl `<br>{ esc pl }`
      "</div>" }
    `<div class="f-more">Ver os { pn_nf n } postos ›</div></button>` } }
: pn_fuel >i ? ~ ha es.proxy 0 {
  = mn es.mname = dn es.dname = fu es.fuel = fl fu.fuels = ls ? == tipo fl 6 fl 0 = e es.fuelErr
  `\n        <details class="an-f pn-f" data-fold="pn-fuel" { Se ha es.foldFuel "open" }><summary><span class="f-t">Combustíveis em `
  ? ha mn esc mn ? ha dn esc dn "Portugal"
  ? || ~ ha fu ~ ha fl {
      `<small>{ ? ha e "Indisponível" "A carregar…" }</small></span></summary>`
      ? ha e `<div class="empty">Não deu para ler a DGEG: { esc e }</div>` `<div class="empty">A carregar os preços da DGEG…</div>` } {
      = c pri ls = q 0
      W c { Se && == tipo c 7 ~ ha c.error { `{ ? q " · " "<small>" }{ esc c.name } { pn_eur3 c.median }` = q + q 1 } = c seg c }
      Se q "</small>"
      `</span></summary><div class="grid g3" style="grid-template-columns:repeat(2,minmax(0,1fr))">`
      = c pri ls W c { Se == tipo c 7 pn_fcard c = c seg c }
      `</div><p class="note">Fonte: DGEG — Preços dos Combustíveis Online. Preço mediano por litro`
      ? ha mn ` no concelho de { esc mn }` ? ha dn ` no distrito de { esc dn }` " em Portugal"
      = u _ar_get idx ls 0 $"updated" Se ha u ` · última atualização { esc u }`
      ".</p>" }
  "</details>" }

# ===== o cartão Hoje: o resumo do Claude e o plano do mês =====
: pn_advk i>i an { = ad an.adv ? ha ad ad.key 0 }
: pn_adva i>i an { = ad an.adv ? ha ad ad.action 0 }
# AN[k] && ['buy', 'scale'].includes(adv(k).key)
: pn_compra i>i a { = an a.an = k pn_advk an && ha an || eh k $"buy" eh k $"scale" }
# O resumo automático do dia (o briefParts do JS), dos ativos analisados que se compram na TR (inv, pela ordem de
# Object.keys(AN)): o que mais sobe e cai hoje, o plano do mês automático (o núcleo, os satélites e a cripto, pela
# estratégia e pelo perfil) e o que evitar. Num bloco b (palavras):
#   0 quantos em inv (sem eles, não há resumo)  1/2 sobem (ativos, quantos)  3/4 caem  5 linhas do plano  6 os ativos das
#   linhas (0: só a chave, 19)  7 as frações (reais)  8 o tipo (0 núcleo, 1 satélite, 2 cripto)  9 os ativos de inv
#   10/11 evitar (índices em 9, quantos)  12/13 as notas (sem satélites, sem cripto)  14 o orçamento (real)
#   15 execuções por mês  16 o perfil (0 prud, 1 bal, 2 dyn)  17 ETF + cripto  18 a % da cripto (real)  19 as chaves
: pn_breve i>i h {
  = b A 24 = inv h.inv = n quantos inv
  ! b n
  = ne quantos h.saveDays ! + b 15 ? < ne 1 1 ne
  = bb num h.budget !f + b 14 ? && == bb bb != bb 0. bb 0.
  = cp num h.cryptoPct = cp ? && == cp cp != cp 0. cp 0. !f + b 18 cp
  Se n {
    = ia A + n 1 = m 0 = c pri inv
    W c { = a ln_ativo c Se a { ! + ia m a = m + m 1 } = c seg c }
    ! + b 9 ia
    # o que mais mexe hoje, pela variação do dia (a descer): sobem os 2 primeiros acima de +1%, caem os 2 últimos (do
    # último para trás) abaixo de −1%
    = mv A + m 1 = k1 A + m 1 = nv 0 L j m { = v _ar_get @ + ia j $"chg" Se ln_fin v { ! + mv nv j !f + k1 j @f + v 1 = nv + nv 1 } }
    _or_power mv nv k1 0 0
    = up A 3 = nu 0 = j 0
    W && < j 2 < j nv { = i @ + mv j Se > @f + k1 i 1. { ! + up nu @ + ia i = nu + nu 1 } = j + j 1 }
    = dw A 3 = nd 0 = j - nv 1
    W && >= j 0 > j - nv 3 { = i @ + mv j Se < @f + k1 i -1. { ! + dw nd @ + ia i = nd + nd 1 } = j - j 1 }
    ! + b 1 up ! + b 2 nu ! + b 3 dw ! + b 4 nd
    # o perfil (PROFILES): a parte dos satélites e a da cripto
    = pf h.profile = pi ? eh pf $"prud" 0 ? eh pf $"dyn" 2 1 ! + b 16 pi
    = qs ? == pi 0 0.1 ? == pi 2 0.3 0.2
    = qc ? == pi 0 0. ? == pi 2 0.15 0.1
    # o núcleo: os fundos com a pontuação longa (ou a média) de 50 ou mais, o VWCE primeiro, depois pela pontuação
    = fw A + m 1 = fk A + m 1 = fp A + m 1 = nf 0 L j m { = a @ + ia j = l num a.an.L
      Se && eh a.kind $"fund" >= l 50. { ! + fw nf j !f + fk j ? eh a.k $"VWCE.DE" 1. 0. !f + fp j l = nf + nf 1 } }
    _or_power fw nf fk fp 2
    = co ? nf @ + ia @ fw 0
    # os satélites (sem a cripto e o núcleo, com sinal de compra): pelo desconto (os de comprar aos poucos) ou pela
    # pontuação longa; os 2 primeiros
    = sw A + m 1 = sk A + m 1 = ns 0 L j m { = a @ + ia j = an a.an = k pn_advk an
      Se && && != a co ~ eh a.kind $"crypto" || eh k $"buy" eh k $"scale" {
          ! + sw ns j !f + sk j ? eh k $"scale" num an.d.score num an.L = ns + ns 1 } }
    _or_power sw ns sk 0 0
    = ns ? > ns 2 2 ns
    # a cripto com sinal de compra (o Bitcoin e o Ether)
    = ck A 3 = ca A 3 = nc 0
    = a ln_ativot $"c:BTC" Se && a pn_compra a { ! + ck nc $"c:BTC" ! + ca nc a = nc + nc 1 }
    = a ln_ativot $"c:ETH" Se && a pn_compra a { ! + ck nc $"c:ETH" ! + ca nc a = nc + nc 1 }
    # evitar por agora: os 4 com a pontuação longa mais baixa
    = aw A + m 1 = ak A + m 1 = na 0 L j m { = an _ar_get @ + ia j $"an" Se eh pn_advk an $"avoid" { ! + aw na j !f + ak j num an.L = na + na 1 } }
    _or_power aw na ak 0 1
    ! + b 10 aw ! + b 11 ? > na 4 4 na
    # as partes: satélites, cripto e o núcleo com o resto; ETF + cripto (fora do "mix"): o núcleo dos Ajustes e a cripto
    # todos os meses, sem ações
    = cs ? ns qs 0. = cc ? nc qc 0. = cr - - 1. cs cc
    = etf ~ eh h.strategy $"mix" ! + b 17 etf
    ! + b 12 && && ~ etf == ns 0 != qs 0.
    ! + b 13 && && ~ etf == nc 0 != qc 0.
    Se etf {
        = cf ln_ativo h.coreFund = co ? cf cf co
        = ns 0 = cs 0.
        ! ck $"c:BTC" ! ca ln_ativot $"c:BTC" = nc 1
        Se eh h.cryptoMix $"btceth" { ! + ck 1 $"c:ETH" ! + ca 1 ln_ativot $"c:ETH" = nc 2 }
        = cc / cp 100. = cr - 1. cc
        Se == cc 0. = nc 0 }
    # as linhas do plano
    = la A 6 = lk A 6 = lf A 6 = lt A 6 = nl 0
    Se co { ! la co !f lf cr = nl 1 }
    L j ns { ! + la nl @ + ia @ + sw j !f + lf nl / cs F ns ! + lt nl 1 = nl + nl 1 }
    = bt && eh h.cryptoMix $"btceth" == nc 2
    L j nc {
      ! + la nl @ + ca j ! + lk nl @ + ck j ! + lt nl 2
      !f + lf nl ? bt * cc ? mesmo @ + ck j $"c:BTC" 0.7 0.3 / cc F nc
      = nl + nl 1 }
    ! + b 5 nl ! + b 6 la ! + b 7 lf ! + b 8 lt ! + b 19 lk }
  b }
# o valor da fração f do plano: em euros (o × f, sem casas) com o orçamento; sem ele, a percentagem (o Math.round)
: pn_amt ff>i o f ? != o 0. peur0 * o f { _nu_ps _nu_round * f 100. P '% 0 }
# a chave e o nome da linha i do plano (o ativo; sem ele, a chave)
: pn_lchave ii>i b i { = a @ + @ + b 6 i ? a esc a.k esct @ + @ + b 19 i 0 }
: pn_lnome ii>i b i { = a @ + @ + b 6 i ? a esc a.name esct @ + @ + b 19 i 0 }
# … e o porquê: "núcleo · comprar", "satélite · …", "cripto · …" (com ETF + cripto: todos os meses, manter ≥ 1 ano)
: pn_lporque ii>i b i {
  = a @ + @ + b 6 i = t @ + @ + b 8 i
  ? == t 0 "núcleo · " ? == t 1 "satélite · " "cripto · "
  ? && == t 2 @ + b 17 "todos os meses, manter ≥ 1 ano" _ht_min txt pn_adva a.an 0 }
# o subtítulo do plano automático: a estratégia (ETF + cripto, as partes) ou o perfil, e o orçamento
: pn_psub i>i b {
  = cp @f + b 18
  ? @ + b 17 `ETF + cripto ({ _nu_ps - 100. cp }/{ _nu_ps cp })` { = pi @ + b 16 `perfil { ? == pi 0 "prudente" ? == pi 2 "dinâmico" "equilibrado" }` }
  = o @f + b 14 ? != o 0. ` · { peur0 o }/mês` " · define o valor em Ajustes" }
# o plano do Claude (c.plan, se é uma lista com alguma coisa), ou 0
: pn_cplan i>i c { = p c.plan ? && == tipo p 6 quantos p p 0 }
# os valores da próxima execução (o execTxt do JS): os do plano do Claude (os que têm um valor em euros, a dividir pelas
# execuções do mês) ou os do automático; com pr 0 só conta
: pn_exa iiiii>i h b cp ne pr {
  = q 0
  ? cp {
      = x pri cp
      W x { Se == tipo x 7 { = e x.eur = v ? == tipo e 4 / @f + e 1 F ne 0.
          Se && fin v > v 0. { Se pr `{ Se q " + " }{ peur0 v } { esc x.nm }` = q + q 1 } }
        = x seg x } }
    { Se @ b {
      = o / @f + b 14 F ne = nl @ + b 5 L i nl { Se pr `{ Se q " + " }{ pn_amt o @f + @ + b 7 i } { pn_lnome b i }` = q + q 1 } } }
  q }
# o total, em euros, de uma execução (o que o pn_exa escreve, somado; 0. se não há valores em euros)
: pn_ext iii>f b cp ne {
  = t 0.
  ? cp {
      = x pri cp
      W x { Se == tipo x 7 { = e x.eur = v ? == tipo e 4 / @f + e 1 F ne 0. Se && fin v > v 0. = t + t v } = x seg x } }
    { Se @ b { = o / @f + b 14 F ne = nl @ + b 5 L i nl = t + t * o @f + @ + b 7 i } }
  t }
# de onde vem o cartão, numa linha pequena: o Claude e a hora (atrasada: devia haver uma mais nova), ou o automático
: pn_fonte ii>i h c ? ha c {
    `<small class="hj-src cl"><b>Claude</b>` = w h.when `{ Se ha w ` · { esc w }` }{ Se ha h.old " · atrasada" }</small>` }
  { `<small class="hj-src">Resumo automático`
    ? ~ ha h.claudeOn 0 ? ha h.off " · análise do Claude em pausa" ` · a análise do Claude chega às { esc h.horas }`
    "</small>" }
# o tamanho, em bytes, do espaço do \s do JS que começa no byte j do texto t (0 se não é um)
: pn_esp ii>i t j {
  = b _tx_b t j
  ? || && >= b 9 <= b 13 == b 32 1
  ? && == b 194 == _tx_b t + j 1 160 2
  ? && == b 225 && == _tx_b t + j 1 154 == _tx_b t + j 2 128 3
  ? == b 226 { = b1 _tx_b t + j 1 = b2 _tx_b t + j 2 ? && == b1 128 || || <= b2 138 == b2 168 || == b2 169 == b2 175 3 ? && == b1 129 == b2 159 3 0 }
  ? && == b 227 && == _tx_b t + j 1 128 == _tx_b t + j 2 128 3
  ? && == b 239 && == _tx_b t + j 1 187 == _tx_b t + j 2 191 3 0 }
# uma mudança de linha (o que o . do JS não apanha: \n, \r, U+2028, U+2029) no byte j
: pn_nl ii>i t j { = b _tx_b t j ? || == b 10 == b 13 1 && == b 226 && == _tx_b t + j 1 128 || == _tx_b t + j 2 168 == _tx_b t + j 2 169 }
# uma linha do resumo do Claude: "Mercado: venda em tecnologia", com a etiqueta a negro — o /^([^:]{2,14}):\s*(.*)$/ do
# JS sobre String(t): 2 a 14 unidades UTF-16 antes do 1.º ':', os espaços do \s a seguir e o resto sem mudanças de linha;
# senão o texto todo (o esc(t): o null e o undefined vazios)
: pn_tl i>i n {
  = t _ar_str n = m _tx_len t
  = j 0 = u 0
  W && < j m != _tx_b t j ': { = b _tx_b t j Se != & b 192 128 = u + u ? >= b 240 2 1 = j + j 1 }
  = ok && && < j m >= u 2 <= u 14
  = k + j 1
  Se ok {
      W && < k m > pn_esp t k 0 = k + k pn_esp t k
      = i k W && ok < i m { Se pn_nl t i = ok 0 = i + i 1 } }
  ? ok `<b>{ pn_esc t 0 j }:</b> { pn_esc t k m }` esc n }
# o que mexe hoje (sem o Claude): "Sobem: Allianz +6,80%, …" e "Caem: …"
: pn_mexe i>i b {
  = nu @ + b 2 = nd @ + b 4
  "<p>"
  Se nu { "Sobem: " L i nu { Se i ", " = a @ + @ + b 1 i `{ esc a.name } <span class="up-t">{ fm_pctv a.chg }</span>` } }
  Se && nu nd "<br>"
  Se nd { "Caem: " L i nd { Se i ", " = a @ + @ + b 3 i `{ esc a.name } <span class="down-t">{ fm_pctv a.chg }</span>` } }
  "</p>" }
# o dia nos índices (o S&P 500, o Nasdaq, o Euro Stoxx 50 e o PSI, pela variação do dia) e o VIX
: pn_temcab i>i h { = c pri h.ind = r ln_fin h.vix W && c ~ r { = r ln_fin c = c seg c } r }
: pn_cab i>i h {
  = c pri h.ind = j 0 = q 0
  W c {
    Se ln_fin c { Se q " · " ? == j 0 "S&P 500" ? == j 1 "Nasdaq" ? == j 2 "Euro Stoxx 50" "PSI"
        ` <span class="{ ln_tom @f + c 1 }-t">{ fm_pct @f + c 1 }</span>` = q + q 1 }
    = c seg c = j + j 1 }
  = v h.vix
  Se ln_fin v { = x @f + v 1 `{ Se q " · " }VIX { _nu_ps _nu_round x }{ ? > x 25. " (medo)" Se < x 16. " (calma)" }` } }
# os itens do plano do Claude: o nome (o dele, ou o da app), o porquê e o valor; abre a ficha se é um ativo da app
: pn_citens i>i p {
  = x pri p
  W x {
    Se == tipo x 7 {
        = r ha x.r = nm x.name = wy x.why = am x.amount
        ? r `<button type="button" data-open="{ esc x.s }"` "<div"
        ` class="idea"><span class="i-n">{ ? ha nm esc nm esc x.nm }<small>{ Se ha wy esc wy }</small></span><span class="i-t num">{ Se ha am esc am }</span>`
        ? r "</button>" "</div>" }
    = x seg x } }
# os itens do plano automático
: pn_bitens i>i b {
  = nl @ + b 5 = o @f + b 14 L i nl {
    `<button type="button" class="idea" data-open="{ pn_lchave b i }"><span class="i-n">{ pn_lnome b i }<small>{ pn_lporque b i }</small></span><span class="i-t num">{ pn_amt o @f + @ + b 7 i }</span></button>` } }
# a execução, por dentro: até quando se ajusta o plano, quantas há por mês e os lembretes no calendário
: pn_exbox ii>i x ne {
  = aj && ~ ha x.exec ~ ha x.prazo
  `<div class="exec{ Se ha x.prazo " hot" }">`
  Se || aj > ne 1 `<div class="ex-t">{ Se aj `Ajustar até <b>{ esc x.dl }</b>` }{ Se && aj > ne 1 " · " }{ Se > ne 1 `{ N ne } execuções por mês` }</div>`
  `<div class="ex-btns"><button type="button" class="btn sm" data-act="ics">Lembretes no calendário</button></div></div>` }
# fora do que tenho: as ideias de maior convicção do Claude (compras e vendas pela convicção média + longa; sem ela, as 6
# primeiras), com o nome da app ou o de toda a TR (n) e o tipo (t) para a ficha
: pn_pull i>f a {
  = mi a.mid = lo a.long = k a.key
  = s + ? ln_fin mi @f + mi 1 50. ? ln_fin lo @f + lo 1 50.
  ? || eh k $"buy" eh k $"scale" s ? || eh k $"sell" eh k $"reduce" - 200. s -1. }
: pn_outros i>i c {
  = l c.actions = mi es.mine = n quantos l
  = w A + n 1 = k1 A + n 1 = ws A + n 1 = nr 0 = fm 0
  Se == tipo l 6 { = x pri l W x { Se && == tipo x 7 ~ _ar_tem mi x.s { ! + w nr x = nr + nr 1 Se ln_fin x.mid = fm 1 } = x seg x } }
  = m 0
  ? fm {
      L j nr { = p pn_pull @ + w j Se >= p 0. { ! + ws m j !f + k1 j p = m + m 1 } }
      _or_power ws m k1 0 0 }
    { L j nr ! + ws j j = m nr }
  = m ? > m 6 6 m
  Se m {
    `<div class="i-blk"><div class="i-h">Também a seguir</div>`
    L j m {
      = a @ + w @ + ws j = wy a.why = ac a.action
      `<button type="button" class="idea" data-open="{ esc a.s }" data-name="{ esc a.n }" data-ut="{ esc a.t }"><span class="i-n">{ esc a.n }`
      `<small>{ Se ha wy esc wy }</small></span><span class="i-t { ln_tomk a.key }-t">{ Se ha ac esc ac }</span></button>` }
    "</div>" } }
# porque sobem ou descem: o motivo do Claude para os movimentos fortes (com a variação do dia, se é um ativo da app)
: pn_porque i>i c {
  = l c.movers
  Se && == tipo l 6 quantos l {
    `<div class="i-blk"><div class="i-h">Porque sobem ou descem</div>`
    = x pri l
    W x {
      Se == tipo x 7 {
          = r ha x.r = v x.chg
          ? r `<button type="button" data-open="{ esc x.s }"` "<div"
          ` class="idea why"><span class="i-n">{ esc _ar_get x ? r $"nm" $"s" }<small>{ esc x.why }</small></span>`
          Se && r ln_fin v `<span class="i-t { ln_tom @f + v 1 }-t num">{ fm_pct @f + v 1 }</span>`
          ? r "</button>" "</div>" }
      = x seg x }
    "</div>" } }
: pn_riscos i>i c {
  = l c.risks
  Se && == tipo l 6 quantos l {
    `<div class="i-blk"><div class="i-h">Riscos a vigiar</div><ul class="dnotes">`
    = x pri l W x { `<li>{ esc x }</li>` = x seg x }
    "</ul></div>" } }
# a agenda dos próximos 14 dias (resultados, dividendos e os juros da Fed e do BCE; as datas, o JS)
: pn_agenda i>i h {
  = l h.agenda
  Se && == tipo l 6 quantos l {
    `<div class="i-blk"><div class="i-h">Agenda — próximos 14 dias</div>`
    = x pri l
    W x {
      Se == tipo x 7 {
          = k x.k = r ha k
          ? r `<button type="button" data-open="{ esc k }"` "<div"
          ` class="idea"><span class="i-n">{ esc x.txt }</span><span class="i-t muted num">{ esc x.quando }</span>{ ? r "</button>" "</div>" }` }
      = x seg x }
    "</div>" } }
# o cartão: no resumo (o que se vê fechado) o Hoje, de onde vem, as 3 linhas do Claude (sem elas, o título dele) e a próxima
# execução (quando é e quanto leva; os valores por ativo só nos dias de agir); na dobra o resto, com o plano do mês
: pn_hoje >i {
  = h es.hoje = c h.cl = cv ha c = b pn_breve h = bv @ b
  Se || cv bv {
    = x h.ex = ne @ + b 15 = cp ? cv pn_cplan c 0
    = tl ? cv c.tldr 0 = tv && == tipo tl 6 quantos tl
    `\n        <details class="today" data-fold="hoje" { Se ha es.foldHoje "open" }><summary><span class="hj-t">Hoje`
    `{ pn_fonte h c }</span>`
    Se cv {
        `<span class="tldr">`
        ? tv { = l pri tl W l { `<span class="tl">{ pn_tl l }</span>` = l seg l } } `<span class="tl">{ esc c.headline }</span>`
        "</span>" }
    Se ha x {
        # nos dias de agir (a execução, o último dia para ajustar), os valores por ativo; nos outros só o total de cada
        # execução: os valores por ativo estão no plano, na dobra
        = hot || ha x.exec ha x.prazo
        `<span class="hj-ex{ Se ha x.prazo " hot" }"><span class="ex-t">`
        ? ha x.exec "Hoje executam os planos" ? ha x.prazo "Hoje é o último dia para ajustar os planos" "Próxima execução"
        `: <b>{ esc x.quando }</b>`
        = tot pn_ext b cp ne
        Se && ~ hot > tot 0. ` · { peur0 tot }`
        "</span>"
        Se && hot pn_exa h b cp ne 0 `<span class="ex-a num">{ pn_exa h b cp ne 1 }</span>`
        "</span>" }
    `</summary><div class="hj-in">`
    # o sentimento do mercado e o dia nos índices
    = mo h.mood = mv && bv ha mo = hv && bv pn_temcab h
    Se || mv hv {
        `<p class="t-mk">`
        Se mv `<b class="{ esc mo.tone }-t">{ esc mo.label }</b>{ Se hv " · " }`
        Se hv pn_cab h
        "</p>" }
    # o Claude: o título (se as 3 linhas estão em cima) e o mercado; sem ele, a frase do sentimento e o que mexe
    ? cv {
        Se tv `<div class="cl-head">{ esc c.headline }</div>`
        = mk c.market Se ha mk `<p>{ esc mk }</p>` }
      { Se mv `<p class="muted">{ esc mo.hint }</p>` }
    Se && ~ cv && bv || @ + b 2 @ + b 4 pn_mexe b
    # o plano do mês: o do Claude; o automático só sem ele
    `<div class="i-blk plan-blk"><div class="i-h">Plano do mês na Trade Republic<small>`
    # o subtítulo é sempre o da app (a estratégia e o valor dos Ajustes: os dias e os valores de cada execução vêm daí,
    # como a próxima execução); a nota do Claude, se a há, vai por baixo
    = pnt ? cv c.planNote 0 Se bv pn_psub b
    "</small></div>"
    Se ha pnt `<p class="pl-nota">{ esc pnt }</p>`
    ? cp pn_citens cp Se bv pn_bitens b
    Se ha x pn_exbox x ne
    "</div>"
    Se cv { pn_outros c pn_porque c pn_riscos c }
    pn_agenda h
    Se bv {
        Se @ + b 12 `<p class="note">Sem ações em boa altura: a parte dos satélites fica no núcleo este mês.</p>`
        Se @ + b 13 `<p class="note">Cripto sem sinal de compra: essa parte fica no núcleo este mês.</p>`
        = na @ + b 11
        Se && ~ cv na { `<p class="note">Evitar por agora: ` L i na { Se i ", " esc _ar_get @ + @ + b 9 @ + @ + b 10 i $"name" } ".</p>" } }
    "</div></details>" } }

# ===== a vista =====
: ecra_painel i>i s {
  ! 53 s
  pn_meus pn_hoje pn_cripto pn_fundos pn_acoes pn_indices pn_energia pn_fuel
  0 }
