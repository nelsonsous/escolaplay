# armazem no x86 (K n, Kc): escrito em Onda sobre chamadas ao sistema cruas (Y 10 p 0: rax = M[p], rdi rsi rdx r10 r8 r9 = M[p+1..p+6]).
# Mapeado em privado em 0x100000000; o ficheiro (mapeado so para leitura em 0x4000000000) so muda no Kc ou a saida, pelo diario.
# M[-8] base, -9 bloco das chamadas, -10 descritor, -11 bytes, -12 nome do diario, -13 rodape
: xkrt >i "
: _ksc iiiiiii>i n a b c d e f { = p @ -9 ? p 0 { = p _oa 8 ! -9 p } ! p n ! + p 1 a ! + p 2 b ! + p 3 c ! + p 4 d ! + p 5 e ! + p 6 f Y 10 p 0 }
: _kad i>i w + 268435584 << w 3
: _kwi i>i a >> - a 268435584 3
: _kby i>i a { = d - a 268435584 & >> @ >> d 3 << & d 7 3 255 }
: _kfc iii>i s w n { = j 0 W < j n { = s * ^ s @ + w j 1099511628211 = j + j 1 } s }
: _kdf ii>i x y { = j 0 W && < j 512 == @ + x j @ + y j = j + j 1 < j 512 }
: _kmo >i { \"onda: armazem indisponivel\\n\" _ex 2 }
: _kwr iiii>i f a l o { W > l 0 { = r ? < o 0 _ksc 1 f a l 0 0 0 _ksc 18 f a l o 0 0 ? <= r 0 _kmo 0 = a + a r = l - l r ? >= o 0 = o + o r 0 } 0 }
: _kev >i {
  = w _kwi @ 67108864
  = e + + w @ w 2
  = r 0
  W && ~ r != @ e 0 {
    = a @ e
    = j 0
    W && < j 8 == _kby + a j & >> 5571587566383418959 << j 3 255 = j + j 1
    ? && == j 8 == _kby + a 8 61 = r + a 9 0
    = e + e 1 }
  r }
: _kjp i>i f {
  = b _oa 520
  = i 0
  W && < i 4150 != _kby + f i 0 { = w + b >> i 3 ! w | @ w << _kby + f i << & i 7 3 = i + i 1 }
  = w + b >> i 3 ! w | @ w << 46 << & i 7 3
  = i + i 1
  = w + b >> i 3 ! w | @ w << 106 << & i 7 3
  b }
: _kre ii>i d jp {
  = j _ksc 2 _kad jp 0 0 0 0 0
  ? < j 0 0 {
    = l _ksc 8 j 0 2 0 0 0
    ? && >= l 24 == % - l 24 4104 0 {
      = m _ksc 9 549755813888 l 1 18 j 0
      = w 68685922288
      = n / - l 24 4104
      = ft + w >> - l 24 3
      ? && == m 549755813888 && == @ ft n && == @ + ft 2 3552867634917953103 == @ + ft 1 _kfc -3750763034362895579 w >> - l 24 3 {
        = i 0
        W < i n { = r + w * i 513 _kwr d _kad + r 1 4096 << @ r 12 = i + i 1 }
        _ksc 74 d 0 0 0 0 0 } 0
      ? == m 549755813888 _ksc 11 549755813888 l 0 0 0 0 0 } 0
    _ksc 3 j 0 0 0 0 0
    _ksc 87 _kad jp 0 0 0 0 0 } }
: _ko i>i n ? @ -8 @ -8 {
  = z << >> + << Mx n 1 3 4095 12 12
  = f _kev
  = d -1
  ! -13 _oa 4
  ? f {
    = jp _kjp f
    ! -12 jp
    = d _ksc 2 f 66 420 0 0 0
    ? < d 0 _kmo 0
    _kre d jp
    = sz _ksc 8 d 0 2 0 0 0
    = z Mx z << >> + sz 4095 12 12
