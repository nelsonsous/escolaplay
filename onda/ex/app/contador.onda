# App de exemplo, toda em Onda: um contador que se lembra do valor (armazem do browser), botoes, e uma leitura
# da rede (fetch de JSON). Corre com o anfitriao rt/anfitriao.js: o main prepara; cada clique e cada resposta
# chamam uma funcao daqui. Monta-se com: cat lib/app.onda ex/app/contador.onda | build/ondac -w > contador.wasm
# Globais: M[0] contagem, M[2] texto da ultima leitura da rede. Os textos fixos (seletores, chaves, nomes das funcoes
# de evento) sao textos constantes ($"..."): nao se fazem nem gastam o monte.
: render >i {
  = m marca
  = h tnovo 4000
  O h
  "<h1>Contador</h1><p id=\"n\">" pint @ 0 "</p>"
  "<button data-onda=\"menos\">−</button> <button data-onda=\"mais\">+</button>"
  "<p id=\"rede\">" ? @ 2 thtml @ 2 "…" "</p>"
  O 0
  Y 100 $"#app" h
  solta m }
: clique i>i t {
  ? tigual t $"mais" ! 0 + @ 0 1 ! 0 - @ 0 1
  = v tnovo 24 O v N @ 0 O 0
  Y 106 $"contagem" v
  render
  solta t }
: lido ii>i t estado {
  = r json t
  = s tnovo 64 O s "valor " pdec jnum jget r $"valor" 2 " (HTTP " N estado ")" O 0
  ! 2 s
  render }
: main >i {
  = g Y 105 $"contagem" 0
  ! 0 ? g tint g 0
  Y 101 $"click" $"clique"
  Y 102 $"dados.json" $"lido"
  render 0 }
