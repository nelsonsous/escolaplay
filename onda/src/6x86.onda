  P 72 P 199 P 192 x4 -1
  xr24
  xpat j2
  ? >= fby k3 '_ 'k 'c 0 xrt k3 '_ 'k 'c 0
  xmr 7 24
  P 184 x4 231
  P 15 P 5
  xpat j3
  xi 0 805306496
  P 72 P 139 P 0
  P 72 P 139 P 0
  xr24
  xpat j4
  xi 1 805306496
  P 72 P 139 P 9
  xmr 0 24
  xtest
  = z1 xjcc 140
  P 72 P 59 P 1
