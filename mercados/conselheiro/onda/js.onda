# Conselheiro em Onda — o modelo dos valores do JavaScript: o que o JSON.parse dá, o que o JSON.stringify escreve, e as
# conversões do JS (String, Number, toFixed, toPrecision, Math.round, Date) com os mesmos resultados, ao byte.
# Junta-se depois da análise (mercados/onda/*.onda: usa pnz, pinteiro, jround, bext, bd10…) — ver build.mjs.
#
# VALORES (uma palavra v): 1 undefined, 2 null, 3 false, 4 true; v >= 64 é um nó: M[v] < 64 é a etiqueta
#   5 número [5, real]   6 lista [6, n, cap, itens]   7 objeto [7, n, cap, chaves, valores] (pela ordem de inserção)
#   e M[v] >= 64 é um TEXTO (o formato do `O t`: M[v] = fim e um byte por palavra em M[v+1 .. fim-1]).
# Os textos são WTF-8: UTF-8 em que um substituto sozinho do UTF-16 (o que o slice do JS pode deixar, ou um \udxxx
# do JSON) fica nos 3 bytes ED A0..BF xx. Ao escrever: o JSON escapa-o (\udxxx), um ficheiro de texto leva U+FFFD.
# Globais: g_* (endereços fixos no bloco do main) e k_* (textos constantes) são gerados pelo build.mjs.

# ---------- anfitrião (onda/rt/anfitriao-node.js) ----------
: ho_arg i>i i Y 200 i 0
: ho_env i>i t Y 201 t 0
: ho_ler i>i t Y 202 t 0
: ho_pasta i>i t Y 204 t 0
: ho_existe i>i t Y 205 t 0
: ho_pede ii>i p fn Y 206 p fn
: ho_fd i>i fd { _fl Y 208 fd 0 }
: ho_volta >i { _fl Y 208 0 0 }
: ho_abre i>i t { _fl Y 209 t 0 }
: ho_fecha >i { _fl Y 210 0 0 }
: ho_sair i>i c { _fl Y 211 c 0 }
: ho_erro >i Y 213 0 0
: ho_agora >f F Y 108 0 0
# um texto sem limite: tudo o que se escreve entre sb_ini e sb_fim (vai para um fluxo em memória do anfitrião)
: sb_ini >i ho_abre 0
: sb_fim >i ho_fecha

# ---------- textos ----------
: tx_len i>i t - - @ t t 1
: tx_b ii>i t j @ + + t 1 j
: tx_igual ii>i a b { = n tx_len a = r == n tx_len b = p + a 1 = q + b 1 = e + p n W && r < p e { = r == @ p @ q = p + p 1 = q + q 1 } r }
# um texto curto (até 4096 bytes) pelo `O`: tx_ini abre, escreve-se, tx_fim fecha e devolve o que sobrou ao monte
: tx_ini >i { = t A 4097 ! t + t 1 O t t }
: tx_fim i>i t { O 0 ? == @ -1 + t 4097 ! -1 @ t 0 t }
# escreve os bytes tal e qual
: tx_p i>i t { = q + t 1 = e @ t W < q e { P @ q = q + q 1 } 0 }
# escreve em UTF-8 válido (o que o writeFileSync e o console.log do JS fazem): um substituto sozinho dá U+FFFD
: tx_pu i>i t {
  = q + t 1 = e @ t
  W < q e { = c @ q ? && == c 237 >= @ + q 1 160 { P 239 P 191 P 189 = q + q 3 } { P c = q + q 1 } }
  0 }
# o texto como texto JSON (com aspas), como o JSON.stringify: \" \\ \b \f \n \r \t, o resto abaixo de 32 e os
# substitutos sozinhos em \uxxxx (minúsculas); o resto tal e qual
: tx_pj i>i t {
  P 34
  = q + t 1 = e @ t
  W < q e {
    = c @ q
    ? == c 34 { P 92 P 34 } ? == c 92 { P 92 P 92 } ? >= c 32 {
        ? && == c 237 >= @ + q 1 160 {
            = u | | << & c 15 12 << & @ + q 1 63 6 & @ + q 2 63
            P 92 P 'u hx & >> u 12 15 hx & >> u 8 15 hx & >> u 4 15 hx & u 15 = q + q 2 } P c }
      ? == c 8 { P 92 P 'b } ? == c 12 { P 92 P 'f } ? == c 10 { P 92 P 'n } ? == c 13 { P 92 P 'r }
        ? == c 9 { P 92 P 't } { P 92 P 'u P '0 P '0 hx >> c 4 hx & c 15 }
    = q + q 1 }
  P 34 }
# o comprimento em unidades UTF-16 (o .length do JS)
: tx_l16 i>i t { = q + t 1 = e @ t = n 0 W < q e { = c @ q ? != & c 192 128 { = n + n ? >= c 240 2 1 0 } 0 = q + q 1 } n }
# escreve o código c (WTF-8) em w; devolve o w seguinte
: tx_wcp ii>i w c
  ? < c 128 { ! w c + w 1 } ? < c 2048 { ! w | 192 >> c 6 ! + w 1 | 128 & c 63 + w 2 }
  ? < c 65536 { ! w | 224 >> c 12 ! + w 1 | 128 & >> c 6 63 ! + w 2 | 128 & c 63 + w 3 }
  { ! w | 240 >> c 18 ! + w 1 | 128 & >> c 12 63 ! + w 2 | 128 & >> c 6 63 ! + w 3 | 128 & c 63 + w 4 }
# o código no byte q (de 1 a 4 bytes) e quantos bytes tem: M[g_nb]
: tx_cp i>i q {
  = c @ q
  ? < c 128 { ! g_nb 1 c } ? < c 224 { ! g_nb 2 | << & c 31 6 & @ + q 1 63 }
  ? < c 240 { ! g_nb 3 | | << & c 15 12 << & @ + q 1 63 6 & @ + q 2 63 }
  { ! g_nb 4 | | | << & c 7 18 << & @ + q 1 63 12 << & @ + q 2 63 6 & @ + q 3 63 } }
# o slice(a, b) do JS (em unidades UTF-16, 0 <= a, b; o b passa do fim sem mal): um par cortado ao meio deixa o
# substituto sozinho
: tx_s16 iii>i t a b {
  = r A + 1 tx_len t
  = w + r 1 = q + t 1 = e @ t = u 0
  W && < q e < u b {
    = c tx_cp q = nb @ g_nb
    ? == nb 4 {
        = hi && >= u a < u b = lo && >= + u 1 a < + u 1 b
        ? && hi lo { ! w @ q ! + w 1 @ + q 1 ! + w 2 @ + q 2 ! + w 3 @ + q 3 = w + w 4 } {
          = v - c 65536
          ? hi { = w tx_wcp w | 55296 >> v 10 } 0
          ? lo { = w tx_wcp w | 56320 & v 1023 } 0 }
        = u + u 2 }
      { ? >= u a { = j 0 W < j nb { ! w @ + q j = w + w 1 = j + j 1 } } 0 = u + u 1 }
    = q + q nb }
  ! r w ! -1 w r }
# a unidade UTF-16 seguinte de um texto: s = [posição, baixo pendente]; -1 no fim
: tx_u16 ii>i s e {
  = pd @ + s 1
  ? pd { ! + s 1 0 pd } ? >= @ s e -1 {
    = c tx_cp @ s
    ! s + @ s @ g_nb
    ? < c 65536 c { = v - c 65536 ! + s 1 | 56320 & v 1023 | 55296 >> v 10 } } }
# compara como os < e > do JS (unidades UTF-16): -1, 0, 1
: tx_cmp ii>i a b {
  = s g_cmp ! s + a 1 ! + s 1 0 ! + s 2 + b 1 ! + s 3 0
  = ea @ a = eb @ b = r 2
  W == r 2 { = x tx_u16 s ea = y tx_u16 + s 2 eb = r ? < x 0 ? < y 0 0 -1 ? < y 0 1 ? < x y -1 ? > x y 1 2 }
  r }
# espaço do JS (o que o trim tira): WhiteSpace e LineTerminator
: tx_ews i>i u
  ? <= u 32 || == u 32 && >= u 9 <= u 13 ? < u 160 0 ? == u 160 1 ? == u 5760 1 ? && >= u 8192 <= u 8202 1
  ? || == u 8232 == u 8233 1 ? || == u 8239 == u 8287 1 || == u 12288 == u 65279
# 1 se o texto só tem espaços (o !t.trim() do JS)
: tx_branco i>i t { = q + t 1 = e @ t = r 1 W && r < q e { = r tx_ews tx_cp q = q + q @ g_nb } r }
# o encodeURIComponent: 1 se há um substituto sozinho (o JS lança URIError: URI malformed)
: tx_urimal i>i t { = q + t 1 = e @ t = r 0 W && ~ r < q e { = r && == @ q 237 >= @ + q 1 160 = q + q 1 } r }
: hxu i>i d P ? < d 10 + 48 d + 55 d
: tx_puri i>i t {
  = q + t 1 = e @ t
  W < q e {
    = c @ q
    ? || || && >= c 'a <= c 'z && >= c 'A <= c 'Z || && >= c '0 <= c '9 || || == c '- == c '_ || || == c '. == c '! || || == c '~ == c '* || == c 39 || == c 40 == c 41
      P c { P '% hxu >> c 4 hxu & c 15 }
    = q + q 1 }
  0 }
# o texto em UTF-16 para as funções da fase C da análise: [n, unidades...]
: tx_a16 i>i t {
  = n tx_l16 t = r A + n 1 ! r n
  = s g_cmp ! s + t 1 ! + s 1 0 = e @ t = j 0
  W < j n { ! + + r 1 j tx_u16 s e = j + j 1 }
  r }
# os bytes que vêm de fora (rede, ficheiros) como o JS os lê em UTF-8 (TextDecoder): cada sequência inválida dá
# U+FFFD (a maior subparte, como no WHATWG); bom = 1 tira o BOM do início (o r.text() e o r.json() do fetch)
: tx_valido i>i t {
  = q + t 1 = e @ t = ok 1
  W && ok < q e {
    = c @ q
    ? < c 128 { = q + q 1 0 } {
      = n ? && >= c 194 <= c 223 1 ? && >= c 224 <= c 239 2 ? && >= c 240 <= c 244 3 0
      = lo ? == c 224 160 ? == c 240 144 128 = hi ? == c 237 159 ? == c 244 143 191
      ? || == n 0 > + + q n 1 e { = ok 0 0 } {
        = b @ + q 1 = ok && >= b lo <= b hi
        = j 2 W && ok <= j n { = b @ + q j = ok && >= b 128 <= b 191 = j + j 1 }
        = q + + q n 1 } } }
  ok }
: tx_norm ii>i t bom {
  = sb && && bom >= tx_len t 3 && && == tx_b t 0 239 == tx_b t 1 187 == tx_b t 2 191
  ? && ~ sb tx_valido t t {
    = r A + 1 * 3 tx_len t = w + r 1
    = q + + t 1 ? sb 3 0 = e @ t
    W < q e {
      = c @ q
      ? < c 128 { ! w c = w + w 1 = q + q 1 0 } {
        = n ? && >= c 194 <= c 223 1 ? && >= c 224 <= c 239 2 ? && >= c 240 <= c 244 3 0
        ? == n 0 { = w tx_wcp w 65533 = q + q 1 0 } {
          = lo ? == c 224 160 ? == c 240 144 128 = hi ? == c 237 159 ? == c 244 143 191
          = j 1 = ok 1
          W && ok <= j n { = b ? < + q j e @ + q j -1 = ok && >= b lo <= b hi = lo 128 = hi 191 ? ok = j + j 1 0 }
          ? ok { = k 0 W < k + n 1 { ! w @ + q k = w + w 1 = k + k 1 } = q + + q n 1 0 }
            { = w tx_wcp w 65533 = q + q j 0 } } } }
    ! r w ! -1 w r } }

# ---------- valores ----------
: js_tipo i>i v ? < v 64 v ? < @ v 64 @ v 8
: js_nulo i>i v || == v 1 == v 2
: js_bool i>i b ? b 4 3
: js_num f>i x { = p A 2 ! p 5 !f + p 1 x p }
: js_f i>f v @f + v 1
: js_ehnum i>i v && >= v 64 == @ v 5
: js_ehtxt i>i v && >= v 64 >= @ v 64
: js_ehlst i>i v && >= v 64 == @ v 6
: js_ehobj i>i v && >= v 64 == @ v 7
# o Number.isFinite do JS (só números)
: js_fin i>i v && js_ehnum v finito js_f v
# a verdade do JS (if (v))
: js_v i>i v { = t js_tipo v ? <= t 3 0 ? == t 4 1 ? == t 5 { = x js_f v && != x 0. == x x } ? == t 8 > tx_len v 0 1 }
# listas
: js_lst i>i cap { = v A 4 ! v 6 ! + v 1 0 ! + v 2 cap ! + v 3 A cap v }
: js_len i>i a @ + a 1
: js_it ii>i a i @ + @ + a 3 i
: js_at ii>i a i ? && >= i 0 < i @ + a 1 @ + @ + a 3 i 1
: js_push ii>i a x {
  = n @ + a 1 = c @ + a 2
  ? >= n c {
      = nc ? < c 4 4 * c 2 = ni A nc = it @ + a 3
      = j 0 W < j n { ! + ni j @ + it j = j + j 1 }
      ! + a 3 ni ! + a 2 nc 0 } 0
  ! + @ + a 3 n x ! + a 1 + n 1 a }
# o slice(a, b) de uma lista (a, b já dentro de 0..n)
: js_fatia iii>i l a b { = r js_lst - b a = j a W < j b { js_push r js_it l j = j + j 1 } r }
# objetos
: js_obj i>i cap { = v A 5 ! v 7 ! + v 1 0 ! + v 2 cap ! + v 3 A cap ! + v 4 A cap v }
: js_on i>i o @ + o 1
: js_ok ii>i o i @ + @ + o 3 i
: js_ov ii>i o i @ + @ + o 4 i
: js_oidx ii>i o k { = n @ + o 1 = ks @ + o 3 = j 0 = r -1 W && < r 0 < j n { ? tx_igual @ + ks j k = r j 0 = j + j 1 } r }
: js_oget ii>i o k { = i js_oidx o k ? < i 0 1 @ + @ + o 4 i }
: js_otem ii>i o k >= js_oidx o k 0
: js_oset iii>i o k v {
  = i js_oidx o k
  ? >= i 0 { ! + @ + o 4 i v 0 } {
    = n @ + o 1 = c @ + o 2
    ? >= n c {
        = nc ? < c 4 4 * c 2 = nk A nc = nv A nc = ks @ + o 3 = vs @ + o 4
        = j 0 W < j n { ! + nk j @ + ks j ! + nv j @ + vs j = j + j 1 }
        ! + o 3 nk ! + o 4 nv ! + o 2 nc 0 } 0
    ! + @ + o 3 n k ! + @ + o 4 n v ! + o 1 + n 1 0 }
  o }
# o v[k] do JS para uma chave de texto: objetos pelas chaves; listas e textos pelo índice e pelo length; o resto
# (números, booleanos) não tem propriedades próprias. Em undefined/null o JS lança TypeError: ver js_getx.
: js_get ii>i v k {
  = t js_tipo v
  ? == t 7 js_oget v k ? == t 6 { = i js_indice k ? >= i 0 js_at v i ? tx_igual k k_length js_num F js_len v 1 }
  ? == t 8 { = i js_indice k ? >= i 0 { = n tx_l16 v ? < i n tx_s16 v i + i 1 1 } ? tx_igual k k_length js_num F tx_l16 v 1 } 1 }
# o v[k] com o erro do JS se v é undefined/null: escreve a mensagem e sai com 1
: js_getx ii>i v k ? js_nulo v { sb_ini "Cannot read properties of " ? == v 1 "undefined" "null" " (reading '" tx_p k "')" cs_lanca k_TypeError sb_fim } js_get v k
# o índice de lista (0 .. 2^32-2) que o texto k é, ou -1 (as chaves que o JS põe primeiro, por ordem numérica)
: js_indice i>i k {
  = n tx_len k
  ? || == n 0 > n 10 -1 ? && > n 1 == tx_b k 0 '0 -1 {
    = v 0 = j 0 = ok 1
    W && ok < j n { = c tx_b k j = ok && >= c '0 <= c '9 = v + * v 10 - c '0 = j + j 1 }
    ? && ok <= v 4294967294 v -1 } }
# a ordem das chaves do JS (Object.keys, JSON.stringify): primeiro as de índice, por ordem numérica, depois as outras
# pela ordem de inserção. Devolve uma lista de posições (ou 0: a ordem de inserção serve)
: js_ordem i>i o {
  = n js_on o = ni 0 = j 0
  W < j n { ? >= js_indice js_ok o j 0 = ni + ni 1 0 = j + j 1 }
  ? == ni 0 0 {
    = r A n = q 0 = j 0
    W < j n {
      = x js_indice js_ok o j
      ? >= x 0 {
          # inserção ordenada pelo valor do índice
          = i q W && > i 0 > js_indice js_ok o @ + r - i 1 x { ! + r i @ + r - i 1 = i - i 1 } ! + r i j = q + q 1 } 0
      = j + j 1 }
    = j 0 W < j n { ? < js_indice js_ok o j 0 { ! + r q j = q + q 1 } 0 = j + j 1 }
    r } }
: js_pos ii>i r j ? r @ + r j j
# Object.keys(o)
: js_chaves i>i o { = r js_ordem o = n js_on o = l js_lst n = j 0 W < j n { js_push l js_ok o js_pos r j = j + j 1 } l }

# ---------- números exatos ----------
# 10^k como real (exato até 22) e como inteiro (k < 19)
: nu_p10 i>f k { = r 1. W > k 0 { = r * r 10. = k - k 1 } r }
: nu_p10i i>i k { = r 1 W > k 0 { = r * r 10 = k - k 1 } r }
# o real com estes 64 bits
: nu_bits i>f b { ! g_tmp b @f g_tmp }
# inteiros grandes (bset/bmul/bshl/bdiv/bext de analise.onda): + x pequeno; quantos bits
: nu_badd ii>i b x { = n @ b = i 1 = c x W && c <= i n { = t + @ + b i c ! + b i & t 4294967295 = c >> t 32 = i + i 1 } ? c { ! + + b n 1 c ! b + n 1 0 } 0 0 }
: nu_nbits i>i b { = n @ b ? == n 0 0 { = t limb b - n 1 = k 0 W > t 0 { = t >> t 1 = k + k 1 } + * 32 - n 1 k } }
# divide por 10^k no lugar; devolve 1 se sobrou resto
: nu_bd10k ii>i b k { = st 0 W >= k 9 { = r bdiv b 1000000000 = st || st r = k - k 9 } ? > k 0 { = r bdiv b nu_p10i k = st || st r 0 } 0 st }
# X·2^-s (st: há mais abaixo) → o real mais perto (empate: par), com os subnormais; X > 0
: nu_b2f iii>f b s st {
  = nb nu_nbits b
  = sh - nb 53
  = sh ? < - sh s -1074 + -1074 s sh
  ? <= sh 0 F bget b {
    = m bext b sh = c @ 7
    = c ? st ? == c 0 1 ? == c 2 3 c c
    = m ? || == c 3 && == c 2 & m 1 + m 1 m
    = q - sh s
    ? == m 9007199254740992 { = m 4503599627370496 = q + q 1 } 0
    ? < m 4503599627370496 nu_bits m {
      = be + q 1075
      ? >= be 2047 nu_bits 9218868437227405312 nu_bits | << be 52 - m 4503599627370496 } } }
# D × 10^e → o real mais perto (empate: par), como o JSON.parse e o Number(); D tem nd algarismos (valores 0..9) em dg,
# o mais significativo primeiro, D > 0
: nu_d2f iii>f dg nd e {
  ? && <= nd 15 && >= e -22 <= e 22 {
      = d 0 = j 0 W < j nd { = d + * d 10 @ + dg j = j + j 1 }
      ? >= e 0 * F d nu_p10 e / F d nu_p10 - 0 e }
    ? > + nd e 310 nu_bits 9218868437227405312 ? < + nd e -324 0. {
      = b g_big bset b 0
      = j 0 W < j nd { = k Mn 9 - nd j = d 0 = i 0 W < i k { = d + * d 10 @ + dg + j i = i + i 1 } bmul b nu_p10i k nu_badd b d = j + j k }
      ? >= e 0 { bp10 b e nu_b2f b 0 0 } {
        = k - 0 e
        = s + - + 64 I * F k 3.321928094887362 nu_nbits b 0
        = s ? < s 0 0 s
        bshl b s
        = st nu_bd10k b k
        nu_b2f b s st } } }
# um inteiro n (|n| < 2^53) × 10^k
: nu_i2f ii>f n k {
  ? && >= k 0 <= k 22 * F n nu_p10 k ? && < k 0 >= k -22 / F n nu_p10 - 0 k {
    = dg g_dig = nd 0 = x n = t 0 W > x 0 { = x / x 10 = t + t 1 }
    = j - t 1 = x n W >= j 0 { ! + dg j % x 10 = x / x 10 = j - j 1 }
    nu_d2f dg t k } }
# floor(f · 2^q · 10^s) (f > 0 inteiro), exato, com a classe do resto face a meio em M[7] (0 exato, 1 abaixo, 2 meio,
# 3 acima); o resultado tem de caber em 63 bits
: nu_fq iii>i f q s {
  = b g_big bset b f
  ? > q 0 bshl b q 0
  ? > s 0 bp10 b s 0
  = c10 0
  ? < s 0 { bd10 b - 0 s = c10 @ 7 0 } 0
  ? < q 0 { = m bext b - 0 q ? c10 ! 7 | @ 7 1 0 m } { ! 7 c10 bget b } }
# o String(x) do JS
: nu_ps f>i x ? != x x "NaN" ? == x 0. P '0 { ? < x 0. P '- 0 = a Ab x ? ~ finito a "Infinity" pnz a 46 }
# um número no JSON.stringify: os não finitos saem null
: nu_pj f>i x ? finito x nu_ps x "null"
# o x.toFixed(d) do JS, d de 0 a 2: o inteiro n mais perto de x·10^d (empate: o maior), sem notação científica abaixo
# de 1e21 (acima, o String(x))
: nu_pfix fi>i x d ? != x x "NaN" ? >= Ab x 1000000000000000000000. nu_ps x {
  ? < x 0. P '- 0
  = a Ab x
  = hx Bh a = ex & >> hx 20 2047
  = m | << & hx 1048575 32 Bl a
  = m ? ex | m 4503599627370496 m
  = q ? ex - ex 1075 -1074
  ? >= q 0 { pinteiro a ? d { P '. = j 0 W < j d { P '0 = j + j 1 } } 0 } {
    = k - 0 q = p nu_p10i d
    = n ? > k 61 0 >> + * m p << 1 - k 1 k
    N / n p ? d { P '. pzk % n p d } 0 } }
# Number(x.toPrecision(6)): 6 algarismos significativos (empate: o maior), lido de volta como real
: nu_r6 f>f x ? == x 0. 0. ? ~ finito x x {
  = a Ab x
  = hx Bh a = ex & >> hx 20 2047
  = f | << & hx 1048575 32 Bl a
  = f ? ex | f 4503599627370496 f
  = q ? ex - ex 1075 -1074
  = e I Fl * Lg a 0.4342944819032518
  = go 1 = n 0
  W go {
    = n nu_fq f q - 5 e
    ? >= n 1000000 { = e + e 1 0 } ? < n 100000 { = e - e 1 0 } { = go 0 0 } }
  = n ? >= @ 7 2 + n 1 n
  ? == n 1000000 { = n 100000 = e + e 1 0 } 0
  = r nu_i2f n - e 5
  ? < x 0. * -1. r r }
# Math.round(x) é o jround de analise.onda; (x * 10) etc. fazem-se em real, como no JS
: nu_r1 f>f x / jround * x 10. 10.

# ---------- JSON.parse ----------
# estado s: M[s] = posição, M[s+1] = fim, M[s+2] = erro. Devolve o valor (0 com erro).
: jp_c i>i s ? < @ s @ + s 1 @ @ s -1
: jp_av i>i s ! s + @ s 1
: jp_err i>i s { ! + s 2 1 ! s @ + s 1 0 }
: jp_ws i>i s { W && < @ s @ + s 1 { = c @ @ s || || == c 32 == c 10 || == c 13 == c 9 } jp_av s 0 }
: jp_lit iii>i s t v { = q @ s = n tx_len t = ok <= + q n @ + s 1 = j 0 W && ok < j n { = ok == @ + q j tx_b t j = j + j 1 } ? ok { ! s + q n v } jp_err s }
: jp_v i>i s {
  jp_ws s
  = c jp_c s
  ? == c '{ jp_obj s ? == c '[ jp_lst s ? == c 34 jp_str s ? == c 't jp_lit s k_true 4 ? == c 'f jp_lit s k_false 3
  ? == c 'n jp_lit s k_null 2 ? || == c '- && >= c '0 <= c '9 jp_num s jp_err s }
: jp_obj i>i s {
  jp_av s
  = o js_obj 4
  jp_ws s
  ? == jp_c s '} { jp_av s o } {
    = go 1
    W go {
      jp_ws s
      ? != jp_c s 34 { jp_err s = go 0 0 } {
        = k jp_str s
        jp_ws s
        ? || @ + s 2 != jp_c s ': { jp_err s = go 0 0 } {
          jp_av s
          = v jp_v s
          ? @ + s 2 { = go 0 0 } {
            js_oset o k v
            jp_ws s
            = c jp_c s
            ? == c ', { jp_av s 0 } ? == c '} { jp_av s = go 0 0 } { jp_err s = go 0 0 } } } } }
    o } }
: jp_lst i>i s {
  jp_av s
  = a js_lst 4
  jp_ws s
