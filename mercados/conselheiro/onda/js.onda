    a } }
: jp_hex i>i c ? && >= c '0 <= c '9 - c '0 ? && >= c 'a <= c 'f + 10 - c 'a ? && >= c 'A <= c 'F + 10 - c 'A -1
# 4 algarismos hexadecimais em q (ou -1)
: jp_u4 i>i q { = v 0 = j 0 W && >= v 0 < j 4 { = h jp_hex @ + q j = v ? < h 0 -1 + * v 16 h = j + j 1 } v }
: jp_str i>i s {
