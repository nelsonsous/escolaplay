# motor: IA de intencao feita na Onda. le texto -> features (palavras) -> rede -> intencao -> acao.
: letter i>i c && >= c 97 <= c 122
: digit i>i c && >= c 48 <= c 57
: sigf f>f z / 1.0 + 1.0 Ex * -1.0 z
: primo i>i n { ? < n 2 0 = d 2 = r 1 W && r <= * d d n { ? == 0 % n d = r 0 0 = d + d 1 } r }
: kwmatch iiiiii>i buf blen voc voff vlen ki {
  = off @ + voff ki = kl @ + vlen ki = p 0 = found 0
  W && == found 0 <= + p kl blen {
    = j 0 = ok 1 W && ok < j kl { ? != @ + buf + p j @ + voc + off j = ok 0 0 = j + j 1 }
    ? ok { = bef ? == p 0 1 ~ letter @ + buf - p 1 = aft ? == + p kl blen 1 ~ letter @ + buf + p kl ? && bef aft = found 1 0 } 0
    = p + p 1 } found }
