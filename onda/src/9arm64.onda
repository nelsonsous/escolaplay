: afimm i>i b {
  ? & b 0xFFFFFFFFFFFF -1 {
    = g & >> b 54 0xFF
    = b6 & >> b 61 1
    ? && == g * b6 255 == & >> b 62 1 ^ b6 1 | | << & >> b 63 1 7 << b6 6 & >> b 48 0x3F -1 } }
