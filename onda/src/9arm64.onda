  = fb A + cso 64
  = cur A 1
  ! cur fb
  O cur
  x4 0xFEEDFACF x4 0x0100000C x4 0 x4 2 x4 + nseg 8 x4 cmds x4 0x200085 x4 0
  x4 0x19 x4 72 "__PAGEZERO" az 6 x8 0 x8 bse x8 0 x8 0 x4 0 x4 0 x4 0 x4 0
  x4 0x19 x4 152 "__TEXT" az 10 x8 bse x8 tsz x8 0 x8 tsz x4 5 x4 5 x4 1 x4 0
  "__text" az 10 "__TEXT" az 10 x8 + bse tof x8 cl x4 tof x4 2 x4 0 x4 0 x4 0x80000400 x4 0 x4 0 x4 0
  ? ni {
    x4 0x19 x4 152 "__DATA" az 10 x8 + bse tsz x8 dsz x8 tsz x8 dsz x4 3 x4 3 x4 1 x4 0
    "__got" az 11 "__DATA" az 10 x8 + bse tsz x8 40 x4 tsz x4 3 x4 0 x4 0 x4 0 x4 0 x4 0 x4 0 } 0
  x4 0x19 x4 72 "__LINKEDIT" az 6 x8 + bse lof x8 al4 les 16384 x8 lof x8 les x4 1 x4 1 x4 0 x4 0
  x4 0x80000022 x4 48 x4 0 x4 0 x4 lof x4 bl x4 0 x4 0 x4 0 x4 0 x4 0 x4 0
  x4 2 x4 24 x4 syo x4 0 x4 syo x4 2
  x4 0xB x4 80 az 72
  x4 0xE x4 32 x4 12 "/usr/lib/dyld" az 7
  x4 0x80000028 x4 24 x8 tof x8 0
  x4 0xC x4 56 x4 24 x4 2 x4 0x05000000 x4 0x00010000 "/usr/lib/libSystem.B.dylib" az 6
  x4 0x32 x4 24 x4 1 x4 0x000B0000 x4 0x000B0000 x4 0
  x4 0x1D x4 16 x4 cso x4 sbl
  az - tof + 32 cmds
  ew estart elen
  = k 0 W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  adata
  az - st0 clen
  = s 0
  W < s ni {
    = pc + + bse tof + st0 * 12 s
    = tg + + bse tsz * 8 s
    = pg - >> tg 12 >> pc 12
    x4 | | 0x90000010 << & pg 3 29 << & >> pg 2 0x7FFFF 5
    x4 | 0xF9400210 << / & tg 0xFFF 8 10
    x4 0xD61F0200
    = s + s 1 }
  az - tsz + tof cl
  az dsz
  ? ni {
    P 0x11 P 0x40 "_sysconf" P 0 P 0x51 P 0x72 P 0 P 0x90
    P 0x11 P 0x40 "_pthread_create" P 0 P 0x51 P 0x72 P 8 P 0x90
    P 0x11 P 0x40 "_pthread_join" P 0 P 0x51 P 0x72 P 16 P 0x90
    P 0x11 P 0x40 "___ulock_wait" P 0 P 0x51 P 0x72 P 24 P 0x90
    P 0x11 P 0x40 "___ulock_wake" P 0 P 0x51 P 0x72 P 32 P 0x90
    az 7 } { az 8 }
  P 32 P 0
  az - cso + syo 2
  O 0
  ew fb cso
  # assinatura: SuperBlob com um CodeDirectory (big-endian): ad-hoc + linker-signed, SHA-256, paginas de 4 KiB
  xb4 0xFADE0CC0 xb4 sbl xb4 1 xb4 0 xb4 20
  xb4 0xFADE0C02 xb4 cdl xb4 0x20400 xb4 0x20002 xb4 93 xb4 88 xb4 0 xb4 nsl xb4 cso
  P 32 P 2 P 0 P 12 xb4 0 xb4 0 xb4 0 xb4 0 xb8 0 xb8 0 xb8 tsz xb8 1
  "onda" P 0
  = hk hsk
  = p 0
  W < p nsl { = o * p 4096 = ln ? > + o 4096 cso - cso o 4096 hsha + fb o ln hk = p + p 1 }
  0 }
: outa >i {
  = base 4194304
  = mbase 268435456
  # entrada (ELF Linux): argc em [sp], argv em sp+8; x28 = base de M + 128 (16 slots negativos p/ o runtime)
  O 16
  = estart @ 16
  ald 21 0 aaddi 22 31 8
  aimm 28 + mbase 128
  aimm 27 0
  = dp ainit
  = blp @ 16 abl 0
  x4 | | 0xD2800000 << 93 5 8
  x4 0xD4000001
  = elen - @ 16 estart
  O 0
  abls estart elen blp
  = ft aftot
  apimm dp 10 - + elen ft - - dp 4 estart
  = clen + + elen ft * 8 - @ 20 64
  # 2 cabecalhos de programa (2*56) a seguir ao cabecalho ELF (64) -> codigo no byte 176
  = fsz + 176 clen
  # cabecalho ELF (64 bytes): aarch64, ET_EXEC, 2 segmentos, entry = base+176
  P 127 P 'E P 'L P 'F P 2 P 1 P 1 P 0 x8 0
  wword 2 2 wword 183 2 x4 1 x8 + base 176
  x8 64 x8 0 x4 0
  x4 | 64 << 56 16 x4 2 x4 0
  # segmento 1 (56 bytes): PT_LOAD RX -- cabecalhos + codigo + dados
  x4 1 x4 5 x8 0 x8 base x8 base x8 fsz x8 fsz x8 4096
  # segmento 2 (56 bytes): PT_LOAD RW -- M (heap), BSS puro (filesz 0, memsz 256 MiB) em mbase
  x4 1 x4 6 x8 0 x8 mbase x8 mbase x8 0 x8 mbase x8 4096
  ew estart elen
  = k 0
  W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  adata
  0 }
