# ---------- o valor exato ----------
# a = f·2^q: com q < 0 é (f·5^-q)·10^q, um inteiro com algarismos finitos; os algarismos vão para b+400.., o mais
# significativo primeiro
: _nu_exato f>i a {
  = lb _me_lb
  = hx Bh a = ex & >> hx 20 2047
  = f | << & hx 1048575 32 Bl a
  = f ? ex | f 4503599627370496 f
  = q ? ex - ex 1075 -1074
  = b + lb 64
  _nu_bset b f
  ? >= q 0 _nu_bshl b q { = k - 0 q W >= k 13 { _nu_bmul b 1220703125 = k - k 13 } = m 1 W > k 0 { = m * m 5 = k - k 1 } _nu_bmul b m }
  = g + lb 400 = n 0
  W > @ b 0 { = r _nu_bdiv b 1000000000 = j 0 W < j 9 { ! + g n % r 10 = r / r 10 = n + n 1 = j + j 1 } }
  W && > n 1 == @ + g - n 1 0 = n - n 1
  = i 0 = j - n 1 W < i j { = t @ + g i ! + g i @ + g j ! + g j t = i + i 1 = j - j 1 }
  ! + lb 13 n ! + lb 14 + n ? < q 0 q 0
  g }
# os L algarismos exatos em g, levados a K (zeros depois do fim) e arredondados no K+1.º (empate: para cima); se o
# arredondamento passa a K+1 algarismos (999 → 1000), g fica com eles e devolve 1
: _nu_xarr iii>i g nl kk {
  = j nl W < j kk { ! + g j 0 = j + j 1 }
  ? && < kk nl >= @ + g kk 5 {
      = j - kk 1 W && >= j 0 == @ + g j 9 { ! + g j 0 = j - j 1 }
      ? >= j 0 { ! + g j + @ + g j 1 0 } { ! g 1 ! + g kk 0 1 } } 0 }
# o inteiro y (real, 2^52 <= y < 1e21) por extenso
: _nu_pinteiro f>i y ? < y 9000000000000000000. N I y {
