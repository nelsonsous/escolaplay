  ! + k 8 3624381080 ! + k 9 310598401 ! + k 10 607225278 ! + k 11 1426881987 ! + k 12 1925078388 ! + k 13 2162078206 ! + k 14 2614888103 ! + k 15 3248222580
  ! + k 16 3835390401 ! + k 17 4022224774 ! + k 18 264347078 ! + k 19 604807628 ! + k 20 770255983 ! + k 21 1249150122 ! + k 22 1555081692 ! + k 23 1996064986
  ! + k 24 2554220882 ! + k 25 2821834349 ! + k 26 2952996808 ! + k 27 3210313671 ! + k 28 3336571891 ! + k 29 3584528711 ! + k 30 113926993 ! + k 31 338241895
  ! + k 32 666307205 ! + k 33 773529912 ! + k 34 1294757372 ! + k 35 1396182291 ! + k 36 1695183700 ! + k 37 1986661051 ! + k 38 2177026350 ! + k 39 2456956037
  ! + k 40 2730485921 ! + k 41 2820302411 ! + k 42 3259730800 ! + k 43 3345764771 ! + k 44 3516065817 ! + k 45 3600352804 ! + k 46 4094571909 ! + k 47 275423344
  ! + k 48 430227734 ! + k 49 506948616 ! + k 50 659060556 ! + k 51 883997877 ! + k 52 958139571 ! + k 53 1322822218 ! + k 54 1537002063 ! + k 55 1747873779
  ! + k 56 1955562222 ! + k 57 2024104815 ! + k 58 2227730452 ! + k 59 2361852424 ! + k 60 2428436474 ! + k 61 2756734187 ! + k 62 3204031479 ! + k 63 3329325298
  k }
# bloco de 64 bytes (um byte por palavra) a partir de s+b -> w[0..15] (big-endian)
: hsld iii>i w s b { = i 0 W < i 16 { = p + s + b * i 4 ! + w i | | | << & @ p 255 24 << & @ + p 1 255 16 << & @ + p 2 255 8 & @ + p 3 255 = i + i 1 } 0 }
: hsblk iii>i h w k {
  = i 16
  W < i 64 {
    = u @ + w - i 15 = v @ + w - i 2
    ! + w i & + + + ^ ^ hsr v 17 hsr v 19 >> v 10 @ + w - i 7 ^ ^ hsr u 7 hsr u 18 >> u 3 @ + w - i 16 4294967295
    = i + i 1 }
  = a0 @ h = a1 @ + h 1 = a2 @ + h 2 = a3 @ + h 3 = a4 @ + h 4 = a5 @ + h 5 = a6 @ + h 6 = a7 @ + h 7
  = i 0
  W < i 64 {
    = e1 ^ ^ hsr a4 6 hsr a4 11 hsr a4 25
    = cg ^ & a4 a5 & ^ a4 4294967295 a6
    = t1 & + + + + a7 e1 cg @ + k i @ + w i 4294967295
    = e0 ^ ^ hsr a0 2 hsr a0 13 hsr a0 22
    = mj ^ ^ & a0 a1 & a0 a2 & a1 a2
    = t2 & + e0 mj 4294967295
    = a7 a6 = a6 a5 = a5 a4 = a4 & + a3 t1 4294967295 = a3 a2 = a2 a1 = a1 a0 = a0 & + t1 t2 4294967295
    = i + i 1 }
  ! h & + @ h a0 4294967295 ! + h 1 & + @ + h 1 a1 4294967295 ! + h 2 & + @ + h 2 a2 4294967295 ! + h 3 & + @ + h 3 a3 4294967295
  ! + h 4 & + @ + h 4 a4 4294967295 ! + h 5 & + @ + h 5 a5 4294967295 ! + h 6 & + @ + h 6 a6 4294967295 ! + h 7 & + @ + h 7 a7 4294967295
  0 }
# SHA-256 de n bytes em s (um por palavra); escreve os 32 bytes do resumo
: hsha iii>i s n k {
  = h A 8
  ! h 1779033703 ! + h 1 3144134277 ! + h 2 1013904242 ! + h 3 2773480762
  ! + h 4 1359893119 ! + h 5 2600822924 ! + h 6 528734635 ! + h 7 1541459225
  = w A 64
  = t A 128
  = b 0
  W <= + b 64 n { hsld w s b hsblk h w k = b + b 64 }
  = r - n b
  = i 0 W < i r { ! + t i @ + s + b i = i + i 1 }
  ! + t r 128
  = m ? < r 56 64 128
  = i + r 1 W < i - m 8 { ! + t i 0 = i + i 1 }
  = bits * n 8
  = i 0 W < i 8 { ! + t + - m 8 i & >> bits * 8 - 7 i 255 = i + i 1 }
  hsld w t 0 hsblk h w k
  ? == m 128 { hsld w t 64 hsblk h w k } 0
  = i 0 W < i 8 { xb4 @ + h i = i + i 1 }
  0 }
: outmx >i {
  O 16
  = estart @ 16
  = dp aentm
  = elen - @ 16 estart
  O 0
  abls estart elen - + estart elen 24
  = ft aftot
  apimm dp 10 - + elen ft - - dp 4 estart
  = clen + + elen ft * 8 - @ 20 64
  = nr ? > @ 66 0 @ @ 66 0
  = ni ? nr 5 0
  = bse 4294967296
  # disposicao: cabecalho+comandos | codigo (+ stubs) | __got | __LINKEDIT (bind, strings, assinatura)
  = st0 al4 clen 4
  = cl + st0 * 12 ni
  = nseg ? ni 4 3
  = cmds + + * 72 nseg 80 ? ni 80 0
  = cmds + + + + cmds 48 24 80 32
  = cmds + + + + cmds 24 56 24 16
  = tof al4 + 32 cmds 16
  = tsz al4 + tof cl 16384
  = dsz ? ni 16384 0
  = lof + tsz dsz
  = bl ? ni 104 8
  = syo + lof bl
  = cso al4 + syo 2 16
  = nsl / + cso 4095 4096
  = cdl + 93 * 32 nsl
  = sbl + 20 cdl
  = les - + cso sbl lof
