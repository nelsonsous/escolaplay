# le pares (alto baixo) e escreve os bits de Sn Cs Ex Lg de cada valor
: rn >i { = c R = s 1 W || == c 32 == c 10 = c R ? == c 45 { = s -1 = c R } 0 = v 0 W && >= c 48 <= c 57 { = v + * v 10 - c 48 = c R } * s v }
: pb f>i v { N Bh v " " N Bl v 0 }
: main >i {
  = n rn
  = i 0
  W < i n {
    = h rn
    = l rn
    = x Bw h l
    = ax ? < x 0.0 * -1.0 x x
    pb Sn x " " pb Cs x " " pb Ex x " " pb Lg ax "\n"
    = i + i 1 }
  0 }
