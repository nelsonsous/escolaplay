  W > j 0 { = j - j 1 P @ + g j } }
# x.toFixed(d): o inteiro n mais perto de |x|·10^d (empate: o maior), com d casas; de 1e21 para cima o String(x)
: _nu_fixo fi>i x d _nu_fixos x d 46
: _nu_fixos fii>i x d sep
  ? != x x "NaN" ? >= Ab x 1000000000000000000000. { ? < x 0. P '- 0 ? ~ _nu_fin x "Infinity" _nu_pnz Ab x sep } {
  ? < x 0. P '- 0
  = a Ab x
  = hx Bh a = ex & >> hx 20 2047
  = m | << & hx 1048575 32 Bl a
  = m ? ex | m 4503599627370496 m
  = q ? ex - ex 1075 -1074
  ? >= q 0 { _nu_pinteiro a ? d { P sep = j 0 W < j d { P '0 = j + j 1 } } 0 }
    ? <= d 2 {
      # m·10^d + metade cabe em 63 bits
      = k - 0 q = p _nu_p10i d
      = n ? > k 61 0 >> + * m p << 1 - k 1 k
      N / n p ? d { P sep _nu_pzk % n p d } 0 } {
      = g _nu_exato a = nl @ + _me_lb 13 = kk + @ + _me_lb 14 d
