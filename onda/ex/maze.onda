# Busca em largura (BFS) do caminho mais curto num labirinto, em Onda. Le a grelha do stdin:
# '#' parede, ' ' ou '.' livre, 'S' inicio, 'E' fim. Imprime o numero de passos (ou -1 se nao houver caminho).
# @1 grelha (linha a linha, com larguras possivelmente diferentes -> guardo por (linha,coluna)) @2 larg @3 alt
# fila em @4 (indices lineares), dist em @5
: cel ii>i y x @ + @ 1 + * y @ 2 x
: main >i {
  ! 1 A 1000000
  = w 0 = h 0 = x 0 = c R
  # ler a grelha: cada caratere; newline termina a linha. a largura e a da linha mais comprida.
  W >= c 0 {
    ? == c 10 { = h + h 1 ? > x w = w x 0 = x 0 } { ! + @ 1 + * h 10000 x c = x + x 1 }
    = c R }
  ? > x 0 { = h + h 1 ? > x w = w x 0 } 0
  ! 2 10000 ! 3 h
  # achar S
  = sy 0 = sx 0 = y 0
  W < y h { = j 0 W < j w { ? == @ + @ 1 + * y 10000 j 'S { = sy y = sx j } 0 = j + j 1 } = y + y 1 }
  ! 4 A 2000000 ! 5 A 2000000
  = i 0 W < i * h 10000 { ! + @ 5 i -1 = i + i 1 }
  = cab 0 = rab 0
  ! + @ 4 rab + * sy 10000 sx ! + @ 5 + * sy 10000 sx 0 = rab + rab 1
  = resp -1
  W && < cab rab < resp 0 {
    = p @ + @ 4 cab = cab + cab 1
    = py / p 10000 = px % p 10000
    = d @ + @ 5 p
    ? == @ + @ 1 p 'E = resp d 0
    = dir 0
    W < dir 4 {
      = ny + py ? == dir 0 - 0 1 ? == dir 1 1 0
      = nx + px ? == dir 2 - 0 1 ? == dir 3 1 0
      ? && && && >= ny 0 < ny h >= nx 0 < nx w {
        = np + * ny 10000 nx
        = ce @ + @ 1 np
        ? && != ce '# < @ + @ 5 np 0 { ! + @ 5 np + d 1 ! + @ 4 rab np = rab + rab 1 } 0 } 0
      = dir + dir 1 } }
  N resp P 10 0 }
