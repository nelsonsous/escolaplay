: apbc ii>i p cc xput4 p | | 0x54000000 << & / - @ 16 p 4 0x7FFFF 5 cc
: acsel iiii>i rd rn rm cc x4 | | | | 0x9A800000 << rm 16 << cc 12 << rn 5 rd
: astod ii>i d a amvv d a
# --- NEON (v.2d, 2 doubles por instrucao): o mapa vetorizado. x em v1; constantes em v2..v9 (via salloc); x12 rascunho ---
# emissores conscientes da largura w: 2 = par (q/.2d), 1 = escalar (d). Por-lane = escalar, logo bit-exato.
: vfld iii>i w rt rn ? == w 2 x4 | | 0x3DC00000 << rn 5 rt x4 | | 0xFD400000 << rn 5 rt
: vfst iii>i w rt rn ? == w 2 x4 | | 0x3D800000 << rn 5 rt x4 | | 0xFD000000 << rn 5 rt
: vfb iii>i w r bits { aimm 12 bits ? == w 2 { x4 | | 0x4E080C00 << 12 5 r } { afmovxd r 12 } }
: vfbin iiiii>i w o rd rn rm ? == w 2
  { ? == o '+ x4 | | | 0x4E60D400 << rm 16 << rn 5 rd ? == o '- x4 | | | 0x4EE0D400 << rm 16 << rn 5 rd ? == o '* x4 | | | 0x6E60DC00 << rm 16 << rn 5 rd x4 | | | 0x6E60FC00 << rm 16 << rn 5 rd }
  { ? == o '+ afadd rd rn rm ? == o '- afsub rd rn rm ? == o '* afmul rd rn rm afdiv rd rn rm }
# alocador de registos NEON parametrizado: banco com base tb (p/ dois bancos independentes no desenrolamento)
: avreg ii>i s tb { = r salloc s ? < r 0 { ! + s 1 | @ + s 1 1 tb } + r tb }
: avfree iii>i s tb r ? && >= r tb < r + tb 8 sfree s - r tb 0
# FMA fundido (rd += rn*rm): fmla vd.2d (par) ou fmadd dd (escalar). Um so arredondamento -> NEON==escalar.
: afmla iiii>i w rd rn rm ? == w 2 x4 | | | 0x4E60CC00 << rm 16 << rn 5 rd x4 | | | | 0x1F400000 << rm 16 << rd 10 << rn 5 rd
# o no na posicao p e um operador '*'? (constante=tkk 2, variavel=tkk 0, operador=o resto)
: ismul i>i p ? && && != tkk p 2 != tkk p 0 == tcode p '* 1 0
# avalia o elemento no banco (xr = registo de x; tb = base dos temporarios). Funde '+ a (* x y)' em fmla.
: avem iiii>i w s xr tb {
  = i @ 7
  ! 7 + i 1
  = kk tkk i
  ? == kk 2 { = r ascq afbits i ? >= r 0 r { ! + s 1 | @ + s 1 2 = r avreg s tb vfb w r afbits i r } }
  ? == kk 0 xr
  { = o tcode i
    = sA @ 7 xskip = sB @ 7 xskip = af @ 7
    = mp ? && fastf == o '+ ? ismul sB sB ? ismul sA sA -1 -1
    = ad ? == mp sA sB sA
    ? && >= mp 0 != tkk ad 0
      { ! 7 ad = ra avem w s xr tb
        ! 7 + mp 1 = sX @ 7 xskip = sY @ 7 xskip
        ! 7 sY = ry avem w s xr tb
        ! 7 sX = rx avem w s xr tb
        ! 7 af
        ? || >= ra 26 && >= ra 10 <= ra 15 { = q avreg s tb avmov q ra = ra q } 0
        afmla w ra rx ry
        avfree s tb rx avfree s tb ry
        ra }
      { ! 7 sB = rb avem w s xr tb
        ! 7 sA = ra avem w s xr tb
        ! 7 af
        = rd avreg s tb
        vfbin w o rd ra rb
        avfree s tb ra avfree s tb rb
        rd } } }
# mapa vetorizado NEON: dst(a) count(b) elemento(c) fonte(x). Desenrolado 2x (4 doubles/iter, dois bancos de
# registos independentes -> esconde a latencia da cadeia de FMA dependente) + par + cauda escalar (restos).
: ail ii>i b0 ln {
  = nw / ln 4
  = t A * 4 nw
  = j 0 W < j nw { = q 0 W < q 4 { ! + t + * j 4 q arw + + b0 * q ln * j 4 = q + q 1 } = j + j 1 }
  = j 0 W < j * 4 nw { xput4 + b0 * j 4 @ + t j = j + j 1 } }
: amap2 iiii>i k rs stw stB {
  # laco desenrolado 2x: banco A (x=v1, temps v2-9), banco B (x=v16, temps v17-24) -- cadeias independentes
  = l0 @ 16
  aaddi 10 9 3 acmp 10 14
  = p0 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 x4 | | 0xAD404000 << 11 5 1
  ! stw 255 ! 7 rs = rrA avem 2 stw 1 2
  ! stB 255 ! 7 rs = rrB avem 2 stB 16 17
  aaddlsl 11 13 9 3 x4 | | | 0xAD000000 << rrB 10 << 11 5 rrA
  aaddi 9 9 4 ab - l0 @ 16
  xput4 p0 | | 0x54000000 << & / - @ 16 p0 4 0x7FFFF 5 0xA
  # par que sobra (passo 2)
  = l1 @ 16
  aaddi 10 9 1 acmp 10 14
  = p1 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 vfld 2 1 11
  ! stw 255 ! 7 rs = rr avem 2 stw 1 2
  aaddlsl 11 13 9 3 vfst 2 rr 11
  aaddi 9 9 2 ab - l1 @ 16
  xput4 p1 | | 0x54000000 << & / - @ 16 p1 4 0x7FFFF 5 0xA
  # cauda escalar (n impar)
  = l2 @ 16
  acmp 9 14
  = p2 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 vfld 1 1 11
  ! stw 255 ! 7 rs = rr2 avem 1 stw 1 2
  aaddlsl 11 13 9 3 vfst 1 rr2 11
  aaddi 9 9 1 ab - l2 @ 16
  xput4 p2 | | 0x54000000 << & / - @ 16 p2 4 0x7FFFF 5 0xA
  0 }
: amap i>i p {
  = d @ + p 2
  = n @ + p 3
  = k @ + p 4
  = sb @ + p 5
  = rs + @ fe k 5 7
  = s7 @ 7
  = stw A 2
  = stB A 2
  # d8..d15 sao guardados pelo chamado; o banco A usa v8/v9 e as constantes v10..v15, por isso guardam-se aqui
  x4 0x6DBF27E8 x4 0x6DBF2FEA x4 0x6DBF37EC x4 0x6DBF3FEE
  # as constantes do corpo vao uma so vez para v26..v31 e v10..v15 (antes do ciclo); as que nao cabem fazem-se no sitio
  ! @ 54 0
  = j @ fe k 5 = je fend k
  W < j je { ? && == tkk j 2 < @ @ 54 12 ascst 0 afbits j 0 0 = j + j 1 }
  # fonte (x15) e destino (x13) passam a enderecos: cada acesso e add + ldp/stp
  agT 13 d agT 14 n agT 15 sb ? > @ + p 6 0 agT 9 - @ + p 6 1 aimm 9 0
  aaddlsl 15 28 15 3 aaddlsl 13 28 13 3
  # 1a tentativa: 4 vetores (8 doubles) por volta, 4 bancos de 4 temporarios (x v0/v5/v16/v21; temps v1-4, v6-9,
  # v17-20, v22-25) -- mais cadeias independentes escondem a latencia das contas dependentes. Se o corpo precisar de
  # mais temporarios (stw[1] = 1), recua o codigo emitido e usa 2 bancos de 8.
  = pos @ 16
  = l0 @ 16
  aaddi 10 9 7 acmp 10 14
  = p0 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 x4 | | 0xAD401400 << 11 5 0 x4 | | 0xAD415400 << 11 5 16
  = b0 @ 16 ! stw 15 ! + stw 1 0 ! 7 rs = r0 avem 2 stw 0 1
  = b1 @ 16 ! stw 15 ! 7 rs = r1 avem 2 stw 5 6
  = b2 @ 16 ! stw 15 ! 7 rs = r2 avem 2 stw 16 17
  = b3 @ 16 ! stw 15 ! 7 rs = r3 avem 2 stw 21 22
  = b4 @ 16
  = bad & @ + stw 1 1
  # as 4 cadeias intercaladas instrucao a instrucao (como o clang): cada banco so toca os seus registos e as
  # constantes; nao ha saltos. Nao se faz se alguma constante foi feita no sitio (x12 e partilhado).
  ? && && ~ bad ~ & @ + stw 1 2 && && == - b1 b0 - b2 b1 == - b2 b1 - b3 b2 == - b3 b2 - b4 b3 ail b0 - b1 b0 0
  aaddlsl 11 13 9 3 x4 | | | 0xAD000000 << r1 10 << 11 5 r0 x4 | | | 0xAD010000 << r3 10 << 11 5 r2
  aaddi 9 9 8 ab - l0 @ 16
  xput4 p0 | | 0x54000000 << & / - @ 16 p0 4 0x7FFFF 5 0xA
  ? bad { ! 16 pos amap2 k rs stw stB } {
  = l1 @ 16
  aaddi 10 9 1 acmp 10 14
  = p1 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 vfld 2 0 11
  ! stw 15 ! 7 rs = rr avem 2 stw 0 1
  aaddlsl 11 13 9 3 vfst 2 rr 11
  aaddi 9 9 2 ab - l1 @ 16
  xput4 p1 | | 0x54000000 << & / - @ 16 p1 4 0x7FFFF 5 0xA
  = l2 @ 16
  acmp 9 14
  = p2 @ 16 abcc 0xA 0
  aaddlsl 11 15 9 3 vfld 1 0 11
  ! stw 15 ! 7 rs = rr2 avem 1 stw 0 1
  aaddlsl 11 13 9 3 vfst 1 rr2 11
  aaddi 9 9 1 ab - l2 @ 16
  xput4 p2 | | 0x54000000 << & / - @ 16 p2 4 0x7FFFF 5 0xA }
  x4 0x6CC13FEE x4 0x6CC137EC x4 0x6CC12FEA x4 0x6CC127E8
  ! 7 s7 }

# --- recursao com acumulador (como o clang): numa funcao inteira cujo valor devolvido e X + f(...) (a propria f),
# a chamada final vira um salto: acc += X; parametros = argumentos; volta ao inicio. No fim devolve acc + resultado.
# A soma inteira (com volta) e associativa e comutativa, logo o resultado e o mesmo. 55 salto para o rotulo 56.
: airp ii>i q p { = j 0 W < j 8 { ! + q j @ + p j = j + j 1 } + q 8 }
: air iiiiii>i q k d a b c { ! q k ! + q 1 d ! + q 2 a ! + q 3 b ! + q 4 c ! + q 5 0 ! + q 6 0 ! + q 7 0 + q 8 }
: anuse ii>i t q { = u 0 = i 0 W < i @ 19 { = c aopn + @ 18 * i 8 q = h 0 W < h c { ? == @ + q h t = u + u 1 0 = h + h 1 } = i + i 1 } u }
: atre i>i kf {
  = n @ 19
  = ul - n 1
  = pl + @ 18 * ul 8
  ? || || != @ fe kf 3 0 != @ pl 41 < n 4 0 {
    = rv @ + pl 2
    = q A 64
    = site -1
    = dep 0
    = i 1
    W && < site 0 < i ul {
      = p + @ 18 * i 8
      = k @ p
      ? == k 21 = dep + dep 1 0
      ? == k 23 = dep - dep 1 0
      ? && && == k 8 == dep 0 && ~ tty @ + p 1 == opof @ + p 2 '+ {
        = pc - p 8
        = r @ + p 1
        = ct @ + pc 1
        ? && && == @ pc 7 == @ + pc 2 kf || == @ + p 3 ct == @ + p 4 ct {
          = pn + p 8
          = ok ? == r rv == + i 1 ul ? && && || == @ pn 19 == @ pn 20 == @ + pn 1 rv == @ + pn 2 r && == @ - pl 8 20 == @ + - pl 8 1 rv 0
          ? && && ok == anuse ct q 1 == anuse r q 1 = site i 0 } 0 } 0
      = i + i 1 }
    ? < site 0 0 {
      = ps + @ 18 * site 8
      = pc - ps 8
      = ct @ + pc 1
      = x ? == @ + ps 3 ct @ + ps 4 @ + ps 3
      = ja @ 9
      addl 0 0
      = w xq 8
      = q w
      = t0 nt 0
      = q air q 4 t0 0 0 0
      = q air q 6 0 0 t0 ja
      = q air q 56 0 0 0 0
      = i 0
      W < i - site 1 { = q airp q + @ 18 * i 8 = i + i 1 }
      = tx nt 0 = ty nt 0
      = q air q 5 tx 0 ja 0
      = q air q 8 ty -43 tx x
      = q air q 6 0 0 ty ja
      = ar @ + pc 3
      = j 0
      W < j @ + pc 4 { = q air q 6 0 0 @ + ar j j = j + j 1 }
      = q air q 55 0 0 0 0
      = i + site 1
      W < i ul { = q airp q + @ 18 * i 8 = i + i 1 }
      = tr nt 0 = ts nt 0
      = q air q 5 tr 0 ja 0
      = q air q 8 ts -43 tr rv
      = q air q 41 0 ts 0 0
      = m / - q w 8
      = j 0
      W < j * m 8 { ! + @ 18 j @ + w j = j + j 1 }
      ! 19 m
      0 } } }
# --- CSE: numeracao de valores sobre a RI (so -a/-m). Uma instrucao pura igual a outra que a domina (na mesma regiao:
# a tabela limpa-se nas juncoes -- inicio/fim de ciclo, else, fim de ?/&&/||) passa a usar o resultado da primeira.
# As leituras de variaveis tem versao (cada escrita incrementa). 48 renomeacao dos temporarios, 58 versoes, 56 tabela.
: acsr i>i t @ + @ 48 t
: acslit i>i t { = j @ + @ 47 t ? < j 0 0 { = q + @ 18 * j 8 || == @ q 2 && == @ q 1 ~ tty t } }
: acse >i {
  = n @ 19
  = nt @ 11
  = t 0
  W < t nt { ! + @ 48 t t ! + @ 47 t -1 = t + t 1 }
  = j 0
  W < j @ 9 { ! + @ 58 j 0 = j + j 1 }
  = ne 0
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = k @ p
    = f @ + @ 50 k
    ? & f 1 ! + p 2 acsr @ + p 2 0
    ? & f 2 ! + p 3 acsr @ + p 3 0
    ? & f 4 ! + p 4 acsr @ + p 4 0
    ? == k 7 { = b @ + p 3 = j 0 W < j @ + p 4 { ! + b j acsr @ + b j = j + j 1 } } 0
    ? == k 54 { ! + p 2 acsr @ + p 2 = b @ + p 4 = j 0 W < j - @ fe @ + p 3 2 1 { ! + b j acsr @ + b j = j + j 1 } ? > @ + p 5 0 ! + p 5 + 1 acsr - @ + p 5 1 0 } 0
    ? == k 59 { = b @ + p 5 = j 0 W < j - @ fe @ + p 4 2 1 { ! + b j acsr @ + b j = j + j 1 } ? > @ + p 6 0 ! + p 6 + 1 acsr - @ + p 6 1 0 } 0
    ? == k 53 { ! + p 2 acsr @ + p 2 ! + p 3 acsr @ + p 3 ! + p 5 acsr @ + p 5 ? > @ + p 6 0 ! + p 6 + 1 acsr - @ + p 6 1 0 } 0
    # o fim de um && seguido do salto sobre ele nao e juncao para o lado que continua (so la se chega com A e B)
    = aj && == k 11 && < + i 1 n && || == @ + p 8 22 == @ + p 8 18 == @ + p 10 @ + p 1
    ? && ~ aj || || || == k 21 == k 23 || == k 11 == k 13 || || == k 19 == k 20 || == k 55 == k 56 = ne 0 0
    ? == k 6 { = q + @ 58 @ + p 4 ! q + @ q 1 } 0
    = d @ + p 1
    # literal a esquerda de uma operacao inteira: passa para a direita (vira imediato)
    ? && || == k 8 == k 9 ~ tty @ + p 3 {
      = o opof @ + p 2
      ? && acslit @ + p 3 ~ acslit @ + p 4 {
        = nb @ + p 4 = nc @ + p 3
        ? == k 8
          { ? || || == o '+ == o '* || || == o '& == o '| == o '^ { ! + p 3 nb ! + p 4 nc } 0 }
          { = no ? == o '< '> ? == o '> '< ? == o k2 '< '= k2 '> '= ? == o k2 '> '= k2 '< '= o
            ! + p 3 nb ! + p 4 nc ! + p 2 - 0 no } } 0 } 0
    ? & f 8 ! + @ 47 d i 0
    = ck 0 = ka 0 = kb 0 = kc 0
    ? == k 1 { = ck 1 = ka ? tty d afbits @ + p 2 tokval @ + p 2 = kb tty d } 0
    ? == k 2 { = ck 1 = ka @ + p 2 } 0
    ? == k 5 { = ck 1 = ka @ + p 3 = kb @ + @ 58 @ + p 3 } 0
    ? || == k 8 == k 9 {
      = ck 1 = o opof @ + p 2 = ka o = kb @ + p 3 = kc @ + p 4
      ? && || || == o '+ == o '* || || == o '& == o '| == o '^ > kb kc { = z kb = kb kc = kc z } 0 } 0
    ? == k 14 { = ck 1 = ka @ + p 2 } 0
    ? || == k 15 == k 17 { = ck 1 = ka @ + p 2 = kb @ + p 3 = kc @ + p 4 } 0
    ? || == k 43 == k 44 { = ck 1 = ka @ + p 2 = kb @ + p 3 } 0
    ? ck {
      = r -1
      = e 0
      W && < r 0 < e ne { = q + @ 56 * e 5 ? && && == @ q k == @ + q 1 ka && == @ + q 2 kb == @ + q 3 kc = r @ + q 4 0 = e + e 1 }
      ? >= r 0 { ! + @ 48 d r ! p 45 }
        { ? < ne 99000 { = q + @ 56 * ne 5 ! q k ! + q 1 ka ! + q 2 kb ! + q 3 kc ! + q 4 d = ne + ne 1 } 0 } } 0
    = i + i 1 }
  = w 0
  = i 0
  W < i n {
    = p + @ 18 * i 8
    ? != @ p 45 { ? != w i { = q + @ 18 * w 8 = j 0 W < j 8 { ! + q j @ + p j = j + j 1 } } 0 = w + w 1 } 0
    = i + i 1 }
  ! 19 w
  0 }
# --- cauda do return duplicada no ramo then: ? c A B seguido de poucas instrucoes puras e do return -> o then devolve
# logo (sem copia para o resultado nem salto para a juncao). A copia usa temporarios novos; o original fica inalcancavel.
: atpure i>i k || || || == k 1 == k 2 || == k 5 == k 8 || || == k 9 == k 14 || == k 15 == k 17
: atail >i {
  = n @ 19
  = ul - n 1
  = pl + @ 18 * ul 8
  ? != @ pl 41 0 {
    = j - ul 1
    W && >= j 0 && atpure @ + @ 18 * j 8 > j - ul 7 = j - j 1
    = pj + @ 18 * j 8
    ? || < j 1 != @ pj 20 0 {
      = d @ + pj 1
      = h - j 1
      = dep 0
      = i19 -1
      W && < i19 0 >= h 0 {
        = q + @ 18 * h 8
        ? == @ q 20 = dep + dep 1 0
        ? == @ q 19 { ? && == dep 0 == @ + q 1 d = i19 h = dep - dep 1 } 0
        = h - h 1 }
      ? < i19 0 0 {
        = a19 @ + + @ 18 * i19 8 2
        = mp A + - ul j 2
        = w xq 8
        = q w
        = i 0
        W < i i19 { = q airp q + @ 18 * i 8 = i + i 1 }
        = i + j 1
        W <= i ul {
          = ps + @ 18 * i 8
          = q0 q
          = q airp q ps
          = f @ + @ 50 @ ps
          = c 0
          W < c 3 {
            = fl ? == c 0 1 ? == c 1 2 4
            = fo + q0 + 2 c
            ? & f fl { = v @ fo ? == v d ! fo a19 { = m 0 W < m - i + j 1 { ? == v @ + mp * m 2 ! fo @ + + mp * m 2 1 0 = m + m 1 } } } 0
            = c + c 1 }
          ? & f 8 { = nd nt tty @ + ps 1 = e - i + j 1 ! + mp * e 2 @ + ps 1 ! + + mp * e 2 1 nd ! + q0 1 nd } 0
          ? == @ ps 5 0 0
          = i + i 1 }
        = i i19
        W < i n { = q airp q + @ 18 * i 8 = i + i 1 }
        = m / - q w 8
        = i 0
        W < i * m 8 { ! + @ 18 i @ + w i = i + i 1 }
        ! 19 m
        0 } } } }
# --- S vetorizado em NEON (so com -mf/-af: reassocia a soma, como o -xf do x86; o -m/-a soma em serie, igual ao C) ---
# elemento f ii..>f i ...: corpo { = l E ... E } ou E, com + - * /, literais reais, parametros reais, F do indice ou de
# um parametro inteiro, e ate 2 locais. 4 elementos por volta (bancos A e B, 2 doubles cada, acumuladores proprios),
# constantes difundidas antes do ciclo (v25..v31), FMA, cauda escalar. Bancos: A indice v0, acumulador v1, locais v2-3,
# temporarios v4-7; B v16, v17, v18-19, v20-23; passo v24. 52 locais [n, tokens..., 15 = folhas] 53 modo (0 pre-carga,
# 1 codigo) 54 constantes [n, (tipo, chave, registo)...]
: asvl i>i i { = r -1 = j 0 W && < r 0 < j @ @ 52 { ? teq i @ + @ 52 + 1 j = r j 0 = j + j 1 } r }
: asvp ii>i k i { = r -1 = j 0 W && < r 0 < j @ fe k 2 { ? teq i xpe k j = r j 0 = j + j 1 } r }
: asop i>i i && == tkk i 5 isar tcode i
: asfF i>i i && == tkk i 5 == tcode i 'F
: asfl >i { = q + @ 52 15 ! q + @ q 1 0 }
# leitura de vetor @f + a i (a parametro inteiro, i o indice): o registo base (x11/x13/x15) calcula-se antes do ciclo
: asld i>i i && == tkk i 5 == tcode i k2 '@ 'f
: asldok ii>i k i {
  ? || ~ asop + i 1 != tcode + i 1 '+ 0 {
    = ja asvp k + i 2
    = jb asvp k + i 3
    || && == ja 0 && > jb 0 ~ fpt k jb && == jb 0 && > ja 0 ~ fpt k ja } }
: asbr i>i c ? == c 0 11 ? == c 1 13 15
: asbase ii>i j src {
  = q + @ 52 8
  = n @ q
  = r -1
  = c 0
  W && < r 0 < c n { ? == @ + q + 1 c j = r c 0 = c + c 1 }
  ? < r 0 { ! + q + 1 n j ! q + n 1 = r n agT 10 src aaddlsl asbr n 28 10 3 } 0
  asbr r }
# validacao: devolve pressao*4 + (no e '*')*2 + (no ocupa temporario), ou -1
: asvx i>i k {
  = i @ 7
  ? >= i @ 4 -1 {
    ! 7 + i 1
    = kk tkk i
    ? == kk 2 { asfl 0 }
    ? == kk 0 ? >= asvl i 0 0 { = j asvp k i ? && > j 0 fpt k j { asfl 0 } -1 }
    ? asfF i { = t @ 7 ! 7 + t 1 ? != tkk t 0 -1 { = j asvp k t ? < j 0 -1 ? fpt k j -1 ? > j 0 { asfl 0 } 0 } }
    ? asld i ? asldok k i { ! 7 + i 4 = q + @ 52 12 ! q + @ q 1 5 } -1
    ? && == kk 5 == tcode i '? {
      = rc asvcv k
      ? < rc 0 -1 {
        = ra asvx k
        ? < ra 0 -1 {
          = rb asvx k
          ? < rb 0 -1 { | << + 1 Mx Mx >> rc 2 + 1 >> ra 2 + 2 >> rb 2 2 1 } } } }
    ? asop i {
      = ra asvx k
      ? < ra 0 -1 {
        = rb asvx k
        ? < rb 0 -1 {
          = pa >> ra 2 = ta & ra 1 = pb >> rb 2 = tb & rb 1
          = p Mx Mx pb + tb pa + + ta tb 1
          = p ? && == tcode i '+ || & ra 2 & rb 2 Mx p + 2 Mx pa pb p
          | | << p 2 << == tcode i '* 1 1 } } }
    -1 } }
: asvco i>i k {
  = i @ 7
  ? && == tkk i 0 >= asvp k i 0 { = j asvp k i ? == j 0 { ! 7 + i 1 0 } ? ~ fpt k j { ! 7 + i 1 asfl 0 } asvx k }
  ? == tkk i 1 { ! 7 + i 1 asfl 0 }
  asvx k }
: asvcv i>i k {
  = i @ 7
  ? || != tkk i 5 ~ iscm tcode i -1 {
    ! 7 + i 1
    = ra asvco k
    ? < ra 0 -1 { = rb asvco k ? < rb 0 -1 | << + 1 Mx >> ra 2 >> rb 2 2 1 } } }
: asva i>i k {
  ? || || != @ fe k 3 1 < @ fe k 2 1 fpt k 0 0 {
    = sv @ 7
    ! @ 52 0
    ! + @ 52 15 0
    ! + @ 52 12 0
    = b @ fe k 5
    = ok 1
    = mp 0
    ? == tcode b '{ {
      ! 7 + b 1
      W && ok && == tcode @ 7 '= == tkl @ 7 1 {
        = nm + @ 7 1
        ? || || != tkk nm 0 >= asvp k nm 0 || >= asvl nm 0 >= @ @ 52 2 = ok 0 {
          ! 7 + nm 1
          = r asvx k
          ? < r 0 = ok 0 { = mp Mx mp >> r 2 ! + @ 52 + 1 @ @ 52 nm ! @ 52 + @ @ 52 1 } } }
      ? ok { = r asvx k ? < r 0 = ok 0 { = mp Mx mp >> r 2 ? != tcode @ 7 '} = ok 0 0 } } 0 }
      { ! 7 b = r asvx k ? < r 0 = ok 0 = mp Mx mp >> r 2 }
    ! 7 sv
    && && && ok <= mp 4 <= @ + @ 52 15 7 <= @ + @ 52 12 3 } }
: lowSa iii>i n k a { = r nt 1 ir 54 r n k a 0 0 r }
# geracao
: asvk >i { = i @ 7 ! 7 + i 1 ? asfF i { ! 7 + @ 7 1 0 } ? asld i { ! 7 + i 4 0 } ? || asop i && == tkk i 5 iscm tcode i { asvk asvk } ? && == tkk i 5 == tcode i '? { asvk asvk asvk } 0 }
: asmul i>i s && asop s == tcode s '*
: astmp ii>i r tb && >= r tb < r + tb 4
: asfr iii>i st tb r ? astmp r tb sfree st - r tb 0
: asal ii>i st tb + salloc st tb
: avmov ii>i d r x4 | | | 0x4EA01C00 << r 16 << r 5 d
# constante ja carregada num registo (tabela do ascst em @54, kd 0)? -1 se nao. Nao emite nada.
: ascq i>i key { = r -1 = j 0 W && < r 0 < j @ @ 54 { = e + @ 54 + 1 * j 3 ? && == @ e 0 == @ + e 1 key = r @ + e 2 0 = j + j 1 } r }
: ascst iii>i kd key src {
  = n @ @ 54
  = r -1
  = j 0
  W && < r 0 < j n { = e + @ 54 + 1 * j 3 ? && == @ e kd == @ + e 1 key = r @ + e 2 0 = j + j 1 }
  ? >= r 0 r {
    = r ? < n 6 + 26 n + 4 n
    = e + @ 54 + 1 * n 3
    ! e kd ! + e 1 key ! + e 2 r ! @ 54 + n 1
    ? == kd 0 { aimm 9 key x4 | | 0x4E080C00 << 9 5 r }
    ? == kd 1 { agTf 0 src x4 | 0x4E080400 r }
    { agT 9 src ascvtf 0 9 x4 | 0x4E080400 r }
    r } }
: asve iiiiiii>i k a w lb tb vx st {
  = i @ 7
  ! 7 + i 1
  = kk tkk i
  ? == kk 2 ascst 0 afbits i 0
  ? == kk 0 { = l asvl i ? >= l 0 + lb l { = j asvp k i ascst 1 j @ + a - j 1 } }
  ? asfF i { = t @ 7 ! 7 + t 1 = j asvp k t ? == j 0 vx ascst 2 j @ + a - j 1 }
  ? asld i {
    ! 7 + i 4
    = ja asvp k + i 2
    = j ? == ja 0 asvp k + i 3 ja
    ? == @ 53 0 { asbase j @ + a - j 1 0 }
      { = xb asbase j 0
        = r asal st tb
        ? == w 2 { aaddlsl 12 xb 9 3 x4 | | | 0x3DC00000 << ? == vx 16 1 0 10 << 12 5 r } { aldrdx r xb 9 }
        r } }
  ? && == kk 5 == tcode i '? {
    ? == @ 53 0 { ascmp k a w lb tb vx st asve k a w lb tb vx st asve k a w lb tb vx st 0 }
    { = m ascmp k a w lb tb vx st
      = ra asve k a w lb tb vx st
      = rb asve k a w lb tb vx st
      x4 | | | 0x6E601C00 << rb 16 << ra 5 m
      asfr st tb ra asfr st tb rb
      m } }
  { = o tcode i
    = sA @ 7 asvk
    = sB @ 7 asvk
    = af @ 7
    ? == @ 53 0 { ! 7 sA asve k a w lb tb vx st ! 7 sB asve k a w lb tb vx st ! 7 af 0 }
    { ? && && fastf == o '+ || asmul sA asmul sB
        { = ad ? asmul sB sA sB
          = ml ? asmul sB sB sA
          ! 7 ad
          = r0 asve k a w lb tb vx st
          = rt ? astmp r0 tb r0 { = q asal st tb avmov q r0 q }
          ! 7 + ml 1
          = sX @ 7 asvk
          = sY @ 7
          ! 7 sY = ry asve k a w lb tb vx st
          ! 7 sX = rx asve k a w lb tb vx st
          ! 7 af
          afmla w rt rx ry
          asfr st tb rx asfr st tb ry
          rt }
        { ! 7 sB = rb asve k a w lb tb vx st
          ! 7 sA = ra asve k a w lb tb vx st
          ! 7 af
          asfr st tb ra asfr st tb rb
          = rd asal st tb
          vfbin w o rd ra rb
          rd } } } }
: asvo iiiiiii>i k a w lb tb vx st {
  = i @ 7
  ? && == tkk i 0 >= asvp k i 0 { = j asvp k i ? == j 0 { ! 7 + i 1 vx } ? ~ fpt k j { ! 7 + i 1 ascst 2 j @ + a - j 1 } asve k a w lb tb vx st }
  ? == tkk i 1 { ! 7 + i 1 !f 24 F tokval i ascst 0 @ 24 0 }
  asve k a w lb tb vx st }
: ascmp iiiiiii>i k a w lb tb vx st {
  = c @ 7
  ! 7 + c 1
  = o tcode c
  = x asvo k a w lb tb vx st
  = y asvo k a w lb tb vx st
  ? == @ 53 0 0 {
    asfr st tb x asfr st tb y
    = m asal st tb
    = sw || == o '< == o k2 '< '=
    = rn ? sw y x
    = rm ? sw x y
    = bs ? || == o k2 '= '= == o k2 '! '= ? == w 2 0x4E60E400 0x5E60E400 ? || == o '< == o '> ? == w 2 0x6EE0E400 0x7EE0E400 ? == w 2 0x6E60E400 0x7E60E400
    x4 | | | bs << rm 16 << rn 5 m
    ? == o k2 '! '= x4 | | 0x6E205800 << m 5 m 0
    m } }
: asbody iiiiiii>i k a w lb tb vx st {
  ! @ 52 0
  = b @ fe k 5
  ? == tcode b '{ {
    ! 7 + b 1
    W && == tcode @ 7 '= == tkl @ 7 1 {
      = nm + @ 7 1
      ! 7 + nm 1
      = r asve k a w lb tb vx st
      = l @ @ 52
      ! + @ 52 + 1 l nm
      ! @ 52 + l 1
      ? @ 53 { avmov + lb l r asfr st tb r } 0 }
    asve k a w lb tb vx st }
    { ! 7 b asve k a w lb tb vx st } }
# mapa E vetorizado (59): d[i] = f(i, ...) com o mesmo analisador do S. Sem reassociar nada (cada elemento faz as
# mesmas contas), por isso vale tambem no -m/-a (o FMA so entra com -mf). Destino em x17, 4 elementos por volta.
: lowEg iiii>i d n k a { ir 59 0 d n k a 0 d }
: aemap i>i p {
  = dd @ + p 2
  = n @ + p 3
  = k @ + p 4
  = a @ + p 5
  = s7 @ 7
  = st A 1
  ! @ 54 0
  ! + @ 52 8 0
  ! 53 0 ! st 15 asbody k a 2 2 4 0 st
  ! 53 1
