# Mercados — avisos: groupAlert (vários movimentos numa só notificação) e isQuiet (silêncio à noite), em Onda.

# ---------- groupAlert ----------
# b: [held, n] e n itens seguidos: pct (real), name, pctTxt, px (textos UTF-16 [n, unidades...])
# A ordem é a do sort do JS com (a, b) => |b.pct| - |a.pct| (um resultado NaN conta como 0): o TimSort do V8 do Node, o
# _or_tim da biblioteca (onda/lib/ordenar.onda), com as chaves |pct|.
: gnome i>i q + q 1
: gtxt i>i q { = s gnome q + + s 1 @ s }
: gpx i>i q { = s gtxt q + + s 1 @ s }
: gprox i>i q { = s gpx q + + s 1 @ s }
# ordena no lugar os n itens o[0..n-1]
: gsort ii>i o n {
  = k A + n 1 = w A + n 1 = t A + n 1 L i n { !f + k i Ab @f @ + o i ! + w i i ! + t i @ + o i }
  _or_tim w n k k 0
  L i n ! + o i @ + t @ + w i }
: aviso i>i b {
  = held @ b = n @ + b 1
  ? == n 0 "null" {
    = o A n = q + b 2 L j n { ! + o j q = q gprox q } gsort o n
    ? == n 1 {
        = x @ o
        `\{"title":"{ Se held "Durante a noite: " }{ _tx_pj16c gnome x }{ ? > @f x 0. " sobe " " cai " }{ _tx_pj16c gtxt x }{ ? held 0 " hoje" }`
        `","body":"{ _tx_pj16c gpx x } · toca para ver"\}` }
      { = up 0 L j n Se > @f @ + o j 0. = up + up 1
        = dn - n up
        `\{"title":"{ Se held "Durante a noite: " }{ N n } ativos { ? == up 0 "a cair" ? == dn 0 "a subir" "com movimentos fortes" }`
        `{ ? held 0 " hoje" }","body":"`
        = m ? > n 6 6 n L j m { Se j " · " = x @ + o j _tx_pj16c gnome x P 32 _tx_pj16c gtxt x }
        Se > n 6 ` · +{ N - n 6 }`
        ` · toca para ver"\}` } } }

# ---------- isQuiet(h, from, to): silêncio entre `from` e `to` horas (ex.: 22 → 10, atravessa a meia-noite) ----------
: quieto fff>i h f t ? > f t || >= h f < h t && >= h f < h t
