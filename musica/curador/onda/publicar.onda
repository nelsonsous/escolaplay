# Maestro em Onda — o ultimo passo da tarefa agendada (o que era o curador/publicar.mjs; a versao em JavaScript fica
# em curador/js/publicar.mjs, so como referencia do teste de paridade): valida a proposta do Claude, encontra as
# candidatas no Tidal (pelo Worker), junta os sinais do gosto da pessoa, deixa o motor de curadoria (onda/motor.onda)
# escolher e ordenar, e grava a playlist na biblioteca da app (e no Tidal).
#   node musica/curador/publicar.mjs <dir>/proposta.json [--utilizador <pessoa>] [--pedido <id>] [--modelo <id>]
#        [--ensaio] (nao grava nada) [--sem-tidal] (so na biblioteca da app) [--aceitar-menos]
#        [--renovar <id>] (renova essa playlist: no mesmo sitio da app e do Tidal)
# Junta-se depois da biblioteca da Onda (onda/lib), do motor e do dados.onda (usa o kv_id, o falha e os utilitarios
# que ele traz); o musica/onda/compilar.mjs monta tudo. Os pedidos sao em serie: cada resposta chega a «pb_lido», que
# segue o passo (M[6]).
#
# Globais (so deste script; a biblioteca so usa o M[63]): 1 ficheiro  2 Worker  3 chave  4 pessoa (uid ou 0)
#   5 pedido (id ou 0)  6 passo  7 nome  8 descricao  9 resumo  10 tendencias (textos)  11 quantas  12 pedido (texto)
#   13 o pedido vem do Worker (0 nao, no do JSON, -1 sem)  14 faixas  15 max. por artista  16 estilo  17 arco
#   18 candidatas (registos)  19 quantas  20 caminho do pedido em curso  21 pasta musica/ (o kv_id le-a)
#   23 a proxima a encontrar no Tidal  24 pasta da proposta  25 perfil  26 as encontradas (indices, sem a mesma faixa
#   duas vezes)  27 quantas  28 ordem (3 por faixa: encontrada, motivo, pontos)  29 quantas  30 custo  31 modelo (texto;
#   0 = sem)  32..46 o gosto (pb_gosto)  47 48 e 53 54 os ids de artistas e generos para o motor  49 as ideias (texto
#   JSON; 0)  55 a playlist gravada  56 o texto do ficheiro lido (pb_ler)  57 sem letras explicitas  58 a playlist a
#   renovar (id, ou 0)
# Candidata (16): 0 artista 1 titulo 2 ano (-1) 3 album (0) 4 genero (0) 5 nota 6 energia 7 tendencia 8 bpm (-1)
#   9 motivo (0) 10 isrc (0) 11 tidalId (0) 12 fixa 13 a faixa do Tidal (no; 0) 14 chave (artista|titulo)
#   15 sinais (12: artista genero ano gosto qualidade tendencia claude novidade energia bpm tom fixa)

# ---------- caracteres (UTF-8) ----------
# fim de linha (o . das expressoes regulares nao passa por eles)
: pb_lt i>i c || == c 10 || == c 13 || == c 8232 == c 8233
: pb_an i>i c || && >= c 'a <= c 'z && >= c '0 <= c '9
: pb_dg i>i b && >= b '0 <= b '9
: pb_letra i>i b || && >= b 'A <= b 'Z && >= b 'a <= b 'z
# a letra base (minuscula) de U+00C0..U+02FF e U+1E00..U+1EFF pelo normalize('NFD') do JavaScript ('.': nao tem)
: pb_tab1 >i $"aaaaaa.ceeeeiiii.nooooo..uuuuy..aaaaaa.ceeeeiiii.nooooo..uuuuy.yaaaaaaccccccccdd..eeeeeeeeeegggggggghh..iiiiiiiii...jjkk.llllll....nnnnnn...oooooo..rrrrrrsssssssstttt..uuuuuuuuuuuuwwyyyzzzzzz.................................oo.............uu............................aaiioouuuuuuuuuu.aaaa....ggkkoooo..j...gg..nnaa....aaaaeeeeiiiioooorrrruuuusstt..hh......aaeeooooooooyy............................................................................................................................................................................................................"
: pb_tab2 >i $"aabbbbbbccddddddddddeeeeeeeeeeffgghhhhhhhhhhiiiikkkkkkllllllllmmmmmmnnnnnnnnoooooooopppprrrrrrrrssssssssssttttttttuuuuuuuuuuvvvvwwwwwwwwwwxxxxyyzzzzzzhtwy......aaaaaaaaaaaaaaaaaaaaaaaaeeeeeeeeeeeeeeeeiiiioooooooooooooooooooooooouuuuuuuuuuuuuuyyyyyyyy......"
: pb_tb iii>i t i c { = b _tx_b t i ? == b '. c b }
# o caracter depois do normalize('NFD'), sem acentos e com o toLowerCase: -1 e um acento solto (sai)
: pb_base i>i c ? && >= c 'A <= c 'Z + c 32 ? && >= c 768 <= c 879 -1 ? && >= c 192 <= c 767 pb_tb pb_tab1 - c 192 c ? && >= c 7680 <= c 7935 pb_tb pb_tab2 - c 7680 c ? == c 8490 'k ? == c 8491 'a c
# ---------- o normal() do lib/tidal.js e a chave() do onda/onda.js ----------
# (« ... »), [ ... ]: cada um passa a um espaco (sem atravessar fins de linha)
: pb_par ii>i a k {
  = o 0 = i 0
  W < i k {
    = c @ + a i = j -1
    Se || == c 40 == c 91 {
        = f ? == c 40 41 93 = q + i 1
        W && < j 0 < q k { = d @ + a q ? == d f { = j q 0 } Se pb_lt d = q k = q + q 1 } }
    ? >= j 0 { ! + a o 32 = o + o 1 = i + j 1 0 } { ! + a o c = o + o 1 = i + i 1 0 } }
  o }
# o primeiro « - ...» ate ao fim (\s+-\s+.*$) passa a um espaco
: pb_traco ii>i a k {
  = i 0 = r k
  W < i k {
    Se && _tx_ews @ + a i || == i 0 ~ _tx_ews @ + a - i 1 {
        = j i W && < j k _tx_ews @ + a j = j + j 1
        Se && && < + j 1 k == @ + a j '- _tx_ews @ + a + j 1 {
            = e + j 1 W && < e k _tx_ews @ + a e = e + e 1
            = ok 1 = q e W < q k { Se pb_lt @ + a q = ok 0 = q + q 1 }
            Se ok { ! + a i 32 = r + i 1 = i k } } }
    = i + i 1 }
  r }
# a palavra de s (inicio a, l bytes) e o texto k?
: pb_weq iiii>i s a l k { = r == l _tx_len k = j 0 W && r < j l { = r == _tx_b s + a j _tx_b k j = j + j 1 } r }
: pb_r1 iii>i s a l ? pb_weq s a l $"remaster" 1 ? pb_weq s a l $"remastered" 1 ? pb_weq s a l $"remasterizado" 1 ? pb_weq s a l $"remasterizada" 1 ? pb_weq s a l $"mono" 1 ? pb_weq s a l $"stereo" 1 ? pb_weq s a l $"version" 1 ? pb_weq s a l $"versao" 1 ? pb_weq s a l $"edit" 1 ? pb_weq s a l $"single" 1 ? pb_weq s a l $"mix" 1 ? pb_weq s a l $"original" 1 pb_weq s a l $"deluxe"
: pb_ano4 iii>i s a l { = r == l 4 = j 0 W && r < j 4 { = r pb_dg _tx_b s + a j = j + j 1 } r }
# o ruido de edicao (remaster, mono, deluxe...) sai; s ja e palavras separadas por um espaco
: pb_ruido i>i s {
  = n _tx_len s
  = w A + n 4 = nw 0 L i n { = b i W && < i n != _tx_b s i 32 = i + i 1 ! + w * 2 nw b ! + w + * 2 nw 1 - i b = nw + nw 1 }
  = r _tx_abre + n 1
  = e 0 = j 0
  W < j nw {
    = a @ + w * 2 j = l @ + w + * 2 j 1
    = a2 @ + w * 2 + j 1 = l2 @ + w + * 2 + j 1 1
    = t2 < + j 1 nw
    = x ? pb_r1 s a l 1 ? && && t2 pb_ano4 s a l || pb_weq s a2 l2 $"remaster" pb_weq s a2 l2 $"remastered" 2 ? && && t2 pb_weq s a l $"bonus" pb_weq s a2 l2 $"track" 2 0
    ? x { = j + j x 0 } { Se e P 32 L q l P _tx_b s + a q = e 1 = j + j 1 0 } }
  _tx_fecha r }
# m = 1: o normal(); m = 0: a chave() (sem acentos, minusculas, so letras e algarismos com um espaco entre palavras)
: pb_normal ii>i t m {
  = n _tx_len t
  = a A + n 1 = k 0 = i 0
  W < i n { = c pb_base _tx_cpj t i = i + i _tx_nb Se >= c 0 { ! + a k c = k + k 1 } }
  Se m { = k pb_par a k = k pb_traco a k }
  = s _tx_abre + * 5 k 2
  = sp 0 = em 0 L j k {
    = c @ + a j
    ? pb_an c { Se && sp em P 32 P c = sp 0 = em 1 0 }
      { Se && m == c '& { `{ Se em P 32 }and` = em 1 } = sp 1 0 } }
  _tx_fecha s
  ? m pb_ruido s s }

# ---------- valores como no JavaScript ----------
# a ?? b (o que falta ou e null passa ao b)
: pb_q ii>i a b ? && a != tipo a 1 a b
: pb_l1 i>i n ? == tipo n 6 pri n 0
# String(v ?? '') como texto
: pb_str i>i v ? || == tipo v 0 == tipo v 1 $"" _ar_str v
# o txt() do lib/playlist.js: String(v ?? ''), espacos seguidos num so, sem espacos nas pontas, ate max unidades UTF-16
: pb_txt ii>i v max {
  = s pb_str v
  = n _tx_len s
  = r _tx_abre + n 1
  = i 0 = u 0 = sp 0 = em 0
  W && < i n < u max {
    = c _tx_cpj s i = l _tx_nb
    ? _tx_ews c { = sp 1 0 } {
      Se && sp em { P 32 = u + u 1 }
      = sp 0 = em 1
      = w ? >= c 65536 2 1
      ? <= + u w max { L j l P _tx_b s + i j = u + u w 0 } { = u max 0 } }
    = i + i l }
  _tx_fecha r }
# o num() do lib/playlist.js com o Math.round: inteiro em [a, b], ou -1 (null: vazio, falta, ou nao e numero)
: pb_numr iii>i v a b {
  = t tipo v
  = x ? == t 4 num v ? == t 3 1. ? == t 2 0. ? && == t 5 > _tx_len txt v 0 _nu_s2n txt v / 0. 0.
  ? fin x I _nu_round _nu_clamp x F a F b -1 }
# parseInt(v, 10), ou -100000 (NaN)
: pb_pint i>i v {
  = t tipo v
  ? == t 4 I num v
  ? == t 5 {
     = s txt v = n _tx_len s = i 0
     W && < i n _tx_ews _tx_cpj s i = i + i _tx_nb
     = g 1 ? && < i n == _tx_b s i '- { = g -1 = i + i 1 0 } Se && < i n == _tx_b s i '+ = i + i 1
     = d 0 = r 0 W && < i n pb_dg _tx_b s i { = r - + * r 10 _tx_b s i '0 = i + i 1 = d + d 1 }
     ? d * g r -100000 }
  -100000 }

# ---------- JSON ----------
: pb_ind ii>i ind l Se ind { "\n" L i * ind l P 32 }
# um no como o JSON.stringify(x) (ind = 0) ou o JSON.stringify(x, null, ind)
: pb_jw iii>i n ind l {
  = t tipo n
  ? == t 5 _tx_pj txt n
  ? == t 4 _nu_pj num n
  ? == t 3 "true"
  ? == t 2 "false"
  ? || == t 6 == t 7 {
      = c pri n
      ? c {
        ? == t 6 P '[ P '{
        = k 0
        W c { Se k P ', pb_ind ind + l 1 Se == t 7 { _tx_pj _ar_chave c P ': Se ind P 32 } pb_jw c ind + l 1 = c seg c = k + k 1 }
        pb_ind ind l
        ? == t 6 P '] P '} } { ? == t 6 "[]" "{}" } }
  "null" }
# ---------- a proposta (o validarProposta do lib/playlist.js, estrito) ----------
: pb_isrc i>i t { ? != _tx_len t 12 0 { = ok && pb_letra _tx_b t 0 pb_letra _tx_b t 1 = i 2 W < i 5 { = ok && ok || pb_letra _tx_b t i pb_dg _tx_b t i = i + i 1 } W < i 12 { = ok && ok pb_dg _tx_b t i = i + i 1 } ok } }
: pb_maiusc i>i t { = n _tx_len t = r _tx_abre + n 1 L i n _tx_mai _tx_b t i _tx_fecha r }
: pb_dig i>i t { = n _tx_len t = ok > n 0 L i n = ok && ok pb_dg _tx_b t i ? ok t 0 }
: pb_chavef i>i c texto`{ crut minusc @ c }|{ crut minusc @ + c 1 }`
# uma candidata (o normalizarCandidatas): o registo, ou 0 se nao serve
: pb_cand i>i r ? < tipo r 6 0 {
  = c A 16
  ! c pb_txt pb_q r.artista r.artist 120
  ! + c 1 pb_txt pb_q r.titulo r.title 160
  ? || ~ _tx_len @ c ~ _tx_len @ + c 1 0 {
    = a pb_pint pb_q r.ano r.year
    ! + c 2 ? && >= a 1900 <= a 2100 a -1
    ! + c 3 ? ha r.album pb_txt r.album 160 0
    = g pb_q r.genero r.genre
    ! + c 4 ? ha g pb_txt g 40 0
    ! + c 5 pb_numr r.nota 0 100
    ! + c 6 pb_numr r.energia 0 100
    ! + c 7 pb_numr r.tendencia 0 100
    ! + c 8 pb_numr r.bpm 0 300
    = m pb_txt pb_q r.motivo r.note 140
    ! + c 9 ? _tx_len m m 0
    = s r.isrc
    ! + c 10 ? && == tipo s 5 pb_isrc txt s pb_maiusc txt s 0
    = d r.tidalId
    ! + c 11 ? ha d pb_dig pb_str d 0
    ! + c 12 ha r.fixa
    ! + c 14 pb_chavef c
    c } }
: pb_nova i>i c { = i 0 = r 1 W && r < i @ 19 { Se mesmo @ + @ + @ 18 i 14 @ + c 14 = r 0 = i + i 1 } r }
: pb_estilo i>i t ? mesmo t $"equilibrado" 1 ? mesmo t $"descoberta" 2 ? mesmo t $"moda" 3 ? mesmo t $"gosto" 4 ? mesmo t $"audiofilo" 5 0
: pb_arco i>i t ? mesmo t $"plano" 0 ? mesmo t $"onda" 1 ? mesmo t $"sobe" 2 ? mesmo t $"desce" 3 -1
# os pesos do estilo e (o ESTILOS do onda/onda.js): gosto, qualidade, tendencia, claude, novidade
: pb_peso ii>i e j
  ? == e 2 ? == j 0 150 ? == j 1 200 ? == j 2 150 ? == j 3 350 400
  ? == e 3 ? == j 0 150 ? == j 1 150 ? == j 2 500 ? == j 3 250 150
  ? == e 4 ? == j 0 550 ? == j 1 150 ? == j 2 50 ? == j 3 200 0
  ? == e 5 ? == j 0 150 ? == j 1 500 ? == j 2 50 ? == j 3 300 100
  ? == j 0 300 ? == j 1 200 ? == j 2 200 ? == j 3 300 100
# Math.ceil(n * 1.3) (o 13/10 e o mesmo double do 1.3 do JavaScript)
: pb_ceil13 i>i f { = x * F f / 13.0 10.0 = i I x ? < F i x + i 1 i }
: pb_invalida i>i m { _an_fd 2 `Proposta inválida:\n- { crut m }\n` _an_volta _an_sair 1 }
: pb_proposta i>i p {
  Se || ~ p < tipo p 6 pb_invalida $"a proposta tem de ser um objeto JSON"
  ! 7 pb_txt pb_q p.nome p.name 60
  ! 8 pb_txt pb_q p.descricao p.description 300
  ! 9 pb_txt p.resumo 1200
  ! 10 A 8 ! 11 0
  = c pb_l1 p.tendencias W c { = x pb_txt c 200 Se && _tx_len x < @ 11 8 { ! + @ 10 @ 11 x ! 11 + @ 11 1 } = c seg c }
  ! 12 pb_txt p.pedido 500 ! 13 0
  = o p.opcoes
  = x pb_numr pb_q o.faixas o.count 5 100 ! 14 ? < x 0 30 x
  = x pb_numr pb_q o.maxArtista o.perArtist 1 10 ! 15 ? < x 0 2 x
  = e o.estilo ! 16 ? && == tipo e 5 pb_estilo txt e txt e $"equilibrado"
  = a o.arco ! 17 ? && == tipo a 5 >= pb_arco txt a 0 txt a $"onda"
  ! 57 == tipo o.limpa 3
  = l pb_q p.candidatas p.tracks
  ! 18 A + quantos l 1 ! 19 0
  = r pb_l1 l W r { = c pb_cand r Se && c pb_nova c { ! + @ 18 @ 19 c ! 19 + @ 19 1 } = r seg r }
  # os erros, pela ordem do validarProposta
  = e1 ~ _tx_len @ 7 = e2 ~ @ 19 = e3 ~ _tx_len @ 8 = e4 < _tx_l16 @ 9 80
  = mn pb_ceil13 @ 14 = e5 < @ 19 mn
  = sn 0 = sm 0 = sg 0 = i 0
  W < i @ 19 { = c @ + @ 18 i Se < @ + c 5 0 = sn + sn 1 Se ~ @ + c 9 = sm + sm 1
    Se || || ~ @ + c 4 ~ _tx_len @ + c 4 < @ + c 2 0 = sg + sg 1 = i + i 1 }
  Se || || || e1 e2 e3 || || e4 e5 || || sn sm sg {
    _an_fd 2 "Proposta inválida:"
    Se e1 `\n- "nome" em falta`
    Se e2 `\n- "candidatas" vazia (cada uma com "artista" e "titulo")`
    Se e3 `\n- "descricao" em falta`
    Se e4 `\n- "resumo" curto demais (2 a 6 frases)`
    Se e5 `\n- só { N @ 19 } candidatas para { N @ 14 } faixas: propõe pelo menos { N mn } (o motor escolhe e algumas podem não existir no Tidal)`
    Se sn `\n- { N sn } candidata(s) sem "nota" (0-100)`
    Se sm `\n- { N sm } candidata(s) sem "motivo"`
    Se sg `\n- { N sg } candidata(s) sem "genero" ou "ano" (o ano original da gravação)`
    "\n" _an_volta _an_sair 1 } }

# ---------- argumentos e pedidos ao Worker ----------
# o indice do valor da opcao k (o process.argv.indexOf(k) + 1), ou -1
: pb_argi i>i k { = n _an_arg -1 = i 0 = r -1 W && < r 0 < i n { Se mesmo _an_arg i k = r + i 1 = i + i 1 } r }
: pb_flag i>i k >= pb_argi k 0
# a pasta do ficheiro (o dirname)
: pb_pasta i>i f {
  = n _tx_len f = l -1
  L i n Se == _tx_b f i '/ = l i
  ? < l 0 $"." ? == l 0 $"/" _tx_sub f 0 l }
# o encodeURIComponent
# o api() do comum.mjs: metodo (0 = GET), caminho e corpo (texto ou 0); a resposta vai para «pb_lido»
: pb_api iii>i m c b {
  ! 20 c
  = u texto`{ crut @ 2 }{ crut c }{ Se @ 4 { ? >= _tx_acha c $"?" 0 0 "&u=" "?u=" _tx_uri @ 4 } }`
  = h texto`accept: application/json
{ Se b `content-type: application/json
` }authorization: Bearer { crut @ 3 }`
  = p A 5 ! p m ! + p 1 u ! + p 2 h ! + p 3 b ! + p 4 60000
  _an_pede p $"pb_lido" }
# a resposta: o JSON (2xx), ou a mensagem de erro (a do Worker, ou «HTTP <estado> em <caminho>») e sai com 1
: pb_resp ii>i t s ? && >= s 200 < s 300 _ar_json t { _an_fd 2 `{ perro t s @ 20 }\n` _an_volta _an_sair 1 }
: pb_lido ii>i t s {
  = p @ 6
  Se == p 1 pb_kv t s
  Se == p 2 pb_pedidos pb_resp t s
  Se == p 3 pb_lote pb_resp t s
  Se == p 4 { ! 25 pb_resp t s pb_perfil }
  Se == p 5 pb_gravada pb_resp t s
  Se == p 6 { pb_resp t s pb_fim }
  Se == p 7 pb_ideias pb_resp t s }

# a chave do agente: a de MUSICA_CHAVE ou a da KV (pela API da Cloudflare; o token vem do proxy do ambiente)
: pb_chave >i {
  = c _an_env $"MUSICA_CHAVE"
  ? cheio c { ! 3 c pb_segue } { ! 6 1 kv_pede $"pb_lido" } }
: pb_kv ii>i t s {
  Se || == s 404 && == s 200 ~ cheio t falha $"Ainda não há chave do agente: o Tidal nunca foi ligado na app."
  Se || < s 200 >= s 300 falha texto`Cloudflare: HTTP { N s } a ler agente:chave`
  ! 3 t pb_segue 0 }
: pb_segue >i ? @ 49 { ! 6 7 pb_api $"POST" $"/api/ideias" @ 49 } ? @ 5 { ! 6 2 pb_api 0 $"/api/pedidos" 0 } pb_resolve
: pb_pedidos i>i l {
  = c pb_l1 l = r 0
  W && c ~ r { = x c.id Se && == tipo x 5 mesmo txt x @ 5 = r c = c seg c }
  Se ~ r falha texto`O pedido { crut @ 5 } não existe.`
  # (com o Maestro chamado na hora pode haver duas corridas: a segunda não publica o mesmo pedido outra vez)
  = e r.estado
  Se ~ && == tipo e 5 mesmo txt e $"pendente" falha texto`O pedido { crut @ 5 } já foi tratado (por outra corrida): não se publica outra vez.`
  Se ~ _tx_len @ 12 { = x r.texto ! 13 ? x x -1 }
  pb_resolve }

# 1) encontrar as candidatas no Tidal, de 10 em 10 (POST /api/resolver)
: pb_resolve >i ? >= @ 23 @ 19 pb_perfil_ler {
  _an_abre 0
  `\{"faixas":[`
  = i @ 23 = e Mn + i 10 @ 19
  W < i e {
    Se > i @ 23 ","
    = c @ + @ 18 i
    `\{"artista":{ _tx_pj @ c },"titulo":{ _tx_pj @ + c 1 }`
    Se @ + c 10 `,"isrc":{ _tx_pj @ + c 10 }`
    Se @ + c 11 `,"tidalId":{ _tx_pj @ + c 11 }`
    "}" = i + i 1 }
  `]{ Se @ 57 `,"limpa":true` }\}`
  = b _an_fecha
  ! 6 3 pb_api $"POST" $"/api/resolver" b }
: pb_lote i>i r {
  = l r.faixas
  = i @ 23 = e Mn + i 10 @ 19 = j 0
  # (sem letras explicitas: uma explicita que ainda venha conta como nao encontrada)
  W < i e { = x idx l j ! + @ + @ 18 i 13 ? && ha x ~ && @ 57 ha x.explicita x 0 = i + i 1 = j + j 1 }
  ! 23 e
  pb_resolve }
# 2) o perfil (o perfil.json do dados, ao lado da proposta, ou o do Worker)
: pb_perfil_ler >i {
  = f texto`{ crut @ 24 }/perfil.json`
  ? _an_existe f { ! 25 _ar_json _an_fich f pb_perfil } { ! 6 4 pb_api 0 $"/api/perfil" 0 } }

# ---------- o gosto (o perfilGosto do lib/sinais.js) ----------
# mapas: chaves em @g, contagens em @(g+1), quantas em @(g+2); o indice da chave k, ou -1
: pb_acha iii>i ks n k { = i 0 = r -1 W && < r 0 < i n { Se mesmo @ + ks i k = r i = i + i 1 } r }
: pb_entra ii>i g k { = i pb_acha @ g @ + g 2 k Se < i 0 { = i @ + g 2 ! + @ g i k ! + @ + g 1 i 0 ! + g 2 + i 1 } i }
: pb_entrad ii>i g k { = i 0 = r -1 W && < r 0 < i @ + g 2 { Se == @ + @ g i k = r i = i + i 1 } Se < r 0 { = r @ + g 2 ! + @ g r k ! + @ + g 1 r 0 ! + g 2 + r 1 } r }
: pb_mais ii>i g i { ! + @ + g 1 i + @ + @ + g 1 i 1 0 }
: pb_tem iii>i g n k >= pb_acha @ g @ n k 0
# 1 nas n chaves com mais contagens (empates: a ordem de entrada), como o topo()
: pb_topo iii>i cs m n { = f A + m 1 L i m { = r 0 L j m { = x @ + cs j = y @ + cs i Se || > x y && == x y < j i = r + r 1 } ! + f i < r n } f }
: pb_gosto >i {
  = fv _ar_get @ 25 $"favoritas" = ar _ar_get @ 25 $"artistas"
  = na quantos ar = ng 0 = nf 0
  = c pb_l1 fv W c { = na + na quantos c.artistas = ng + ng quantos c.generos = nf + nf 1 = c seg c }
  ! 32 A + na 1 ! 33 A + na 1 ! 34 0
  ! 35 A + ng 1 ! 36 A + ng 1 ! 37 0
  ! 38 A + nf 1 ! 39 A + nf 1 ! 40 0
  ! 41 A + nf 1 ! 42 0 ! 43 A + nf 1 ! 44 0
  = c pb_l1 fv
  W c {
    ! + @ 41 @ 42 pb_str c.id ! 42 + @ 42 1
    = s c.isrc Se ha s { ! + @ 43 @ 44 pb_str s ! 44 + @ 44 1 }
    = a pb_l1 c.artistas W a { pb_mais 32 pb_entra 32 pb_normal pb_str a 1 = a seg a }
    = g pb_l1 c.generos W g { pb_mais 35 pb_entra 35 pb_normal pb_str g 1 = g seg g }
    = y c.ano Se ha y pb_mais 38 pb_entrad 38 * / I num y 10 10
    = c seg c }
  = a pb_l1 ar
  W a { = nm a.nome = i pb_entra 32 pb_normal ? ha nm pb_str nm pb_str a 1 ! + @ 33 i Mx 2 @ + @ 33 i = a seg a }
  ! 45 pb_topo @ 36 @ 37 5
  ! 46 pb_topo @ 39 @ 40 3
  0 }

# ---------- os sinais de uma candidata (o sinais() do lib/sinais.js) ----------
: pb_qsom i>i l { = q ? inclui l $"HIRES_LOSSLESS" 1000 ? inclui l $"LOSSLESS" 750 350 ? || inclui l $"DOLBY_ATMOS" inclui l $"SONY_360RA" Mn 1000 + q 100 q }
# a energia pelo bpm: Math.round(min(950, max(100, (bpm - 60) * 1000 / 110)))
: pb_enbpm i>i b { = v * - b 60 1000 ? < v 11000 100 ? > v 104500 950 / + * 2 v 110 220 }
: pb_vezes ii>i k v { = i pb_acha @ 32 @ 34 pb_normal k 1 ? < i 0 v Mx v @ + @ 33 i }
: pb_sinais i>i c {
  = f @ + c 13 = s A 12
  = fa f.artistas
  = v 0
  ? && == tipo fa 6 > quantos fa 0 { = a pri fa W a { = v pb_vezes pb_str a v = a seg a } } { = v pb_vezes @ c 0 0 }
  = ano ? >= @ + c 2 0 @ + c 2 I num f.ano
  = g0 pri pb_l1 f.generos
  = gen ? && @ + c 4 _tx_len @ + c 4 @ + c 4 ? ha g0 pb_str g0 $""
  = go ? >= v 3 1000 ? == v 2 850 ? == v 1 700 200
  Se == v 0 {
    = gi ? _tx_len gen pb_acha @ 35 @ 37 pb_normal gen 1 -1
    ? && >= gi 0 @ + @ 45 gi { = go 450 0 } {
      = di ? ano { = d * / ano 10 10 = r -1 = i 0 W && < r 0 < i @ 40 { Se == @ + @ 38 i d = r i = i + i 1 } r } -1
      Se && >= di 0 @ + @ 46 di = go 350 } }
  = fav pb_tem 41 42 pb_str f.id
  = fi f.isrc Se && ~ fav ha fi = fav pb_tem 43 44 pb_str fi
  = bpm I num f.bpm = bpm ? bpm bpm ? >= @ + c 8 0 @ + c 8 0
  = a0 pri pb_l1 fa
  ! s ? ha a0 pb_str a0 @ c
  ! + s 1 gen
  ! + s 2 ano
  ! + s 3 go
  ! + s 4 pb_qsom f.tags
  ! + s 5 Mx I num f.popularidade ? >= @ + c 7 0 * @ + c 7 10 0
  ! + s 6 ? >= @ + c 5 0 * @ + c 5 10 700
  ! + s 7 ? fav 150 ? v 600 1000
  ! + s 8 ? >= @ + c 6 0 * @ + c 6 10 ? bpm pb_enbpm bpm 500
  ! + s 9 bpm
  ! + s 10 I num f.tom
  ! + s 11 @ + c 12
  ! + c 15 s 0 }

# ---------- o motor (o curar do onda/onda.js, sem passar por texto) ----------
: pb_id iiii>i g n k b { = i pb_acha @ g @ n k Se < i 0 { = i @ n ! + @ g i k ! n + i 1 } + i b }
: pb_motor >i {
  = n @ 27
  ! 29 0 ! 30 0
  Se n {
    = c ctx_novo n Mn @ 14 n Mn 1000 @ 15
    = e pb_estilo @ 16 = e ? e e 1
    cs c 3 pb_peso e 0 cs c 4 pb_peso e 1 cs c 5 pb_peso e 2 cs c 6 pb_peso e 3 cs c 7 pb_peso e 4
    cs c 8 300 cs c 9 250 cs c 10 200
    cs c 11 pb_arco @ 17
    ! 47 A + n 1 ! 48 0 ! 53 A + n 1 ! 54 0
    L i n {
      = s @ + @ + @ 18 @ + @ 26 i 15
      = ka pb_normal @ s 0
      = ka ? _tx_len ka ka texto`{ N @ 48 }`
      = kg pb_normal @ + s 1 0
      ap c 12 i Mn pb_id 47 48 ka 0 n
      ap c 13 i Mn ? _tx_len kg pb_id 53 54 kg 1 0 n
      ap c 14 i decada lim @ + s 2 0 2100
      ap c 29 i lim @ + s 3 0 1000 ap c 30 i lim @ + s 4 0 1000 ap c 31 i lim @ + s 5 0 1000
      ap c 32 i lim @ + s 6 0 1000 ap c 33 i lim @ + s 7 0 1000 ap c 15 i lim @ + s 8 0 1000
      ap c 16 i lim @ + s 9 0 400 ap c 17 i lim @ + s 10 0 24 ap c 18 i @ + s 11 }
    ! 30 curar c
    = m cg c 27 ! 29 m ! 28 A + * 3 m 1
    L p m { = x ag c 28 p ! + @ 28 * 3 p x ! + + @ 28 * 3 p 1 ag c 20 x ! + + @ 28 * 3 p 2 ag c 26 x } } }

# ---------- o que se mostra e o que se grava ----------
# a candidata da faixa p da ordem final
: pb_rc i>i p @ + @ 18 @ + @ 26 @ + @ 28 * 3 p
: pb_motivo i>i q ? == q 2 $"qualidade" ? == q 3 $"tendencia" ? == q 4 $"claude" ? == q 5 $"novidade" ? == q 6 $"fixa" $"gosto"
: pb_dectxt i>i y ? ha y texto`{ N * / I num y 10 10 }s` $"?"
# «chave n, ...» dos generos (1), decadas (2) ou qualidade (3) das faixas; as duas primeiras por contagem
: pb_mist i>i modo {
  = m @ 29 = ks A + m 1 = cs A + m 1 = n 0
  L p m {
    = r pb_rc p = f @ + r 13
    = k ? == modo 1 { = g @ + @ + r 15 1 ? _tx_len g g $"?" } ? == modo 2 pb_dectxt f.ano pqual f.tags
    = i pb_acha ks n k Se < i 0 { = i n ! + ks i k ! + cs i 0 = n + n 1 }
    ! + cs i + @ + cs i 1 }
  = o A + n 1 L i n ! + o i i
  Se != modo 3 { = i 1 W < i n { = x @ + o i = j - i 1 W && >= j 0 < @ + cs @ + o j @ + cs x { ! + o + j 1 @ + o j = j - j 1 } ! + o + j 1 x = i + i 1 } }
  L i n { Se i ", " = j @ + o i `{ crut @ + ks j } { N @ + cs j }` } }
# a faixa como o afinar() a guarda: { ...faixa do Tidal, genero, motivo, porque, pontos }
: pb_faixa i>i p {
  = r pb_rc p = f @ + r 13 = s @ + r 15
  = q @ + + @ 28 * 3 p 1 = pt @ + + @ 28 * 3 p 2
  = mo ? @ + r 9 @ + r 9 $""
  P '{ = k 0 = h1 0 = h2 0 = h3 0 = h4 0
  = c ? == tipo f 7 @ + f 4 0
  W c { = ch @ + c 2 Se k P ', = k 1 _tx_pj ch P ':
    ? mesmo ch $"genero" { _tx_pj @ + s 1 = h1 1 0 } ? mesmo ch $"motivo" { _tx_pj mo = h2 1 0 } ? mesmo ch $"porque" { _tx_pj pb_motivo q = h3 1 0 } ? mesmo ch $"pontos" { N pt = h4 1 0 } pb_jw c 0 0
    = c @ + c 3 }
  Se ~ h1 { Se k P ', = k 1 `"genero":{ _tx_pj @ + s 1 }` }
  Se ~ h2 { Se k P ', = k 1 `"motivo":{ _tx_pj mo }` }
  Se ~ h3 { Se k P ', = k 1 `"porque":{ _tx_pj pb_motivo q }` }
  Se ~ h4 { Se k P ', = k 1 `"pontos":{ N pt }` }
  P '} 0 }
# a candidata como o paraGuardar() a guarda: { ...candidata, faixa, sinais }
: pb_guardada i>i r {
  `\{"artista":{ _tx_pj @ r },"titulo":{ _tx_pj @ + r 1 }`
  Se >= @ + r 2 0 `,"ano":{ N @ + r 2 }`
  Se @ + r 3 `,"album":{ _tx_pj @ + r 3 }`
  Se @ + r 4 `,"genero":{ _tx_pj @ + r 4 }`
  Se >= @ + r 5 0 `,"nota":{ N @ + r 5 }`
  Se >= @ + r 6 0 `,"energia":{ N @ + r 6 }`
  Se >= @ + r 7 0 `,"tendencia":{ N @ + r 7 }`
  Se >= @ + r 8 0 `,"bpm":{ N @ + r 8 }`
  Se @ + r 9 `,"motivo":{ _tx_pj @ + r 9 }`
  Se @ + r 10 `,"isrc":{ _tx_pj @ + r 10 }`
  Se @ + r 11 `,"tidalId":{ _tx_pj @ + r 11 }`
  Se @ + r 12 `,"fixa":true`
  `,"faixa":{ pb_jw @ + r 13 0 0 }`
  = s @ + r 15
  `,"sinais":\{"artista":{ _tx_pj @ s },"genero":{ _tx_pj @ + s 1 },"ano":{ N @ + s 2 },"gosto":{ N @ + s 3 }`
  `,"qualidade":{ N @ + s 4 },"tendencia":{ N @ + s 5 },"claude":{ N @ + s 6 },"novidade":{ N @ + s 7 }`
  `,"energia":{ N @ + s 8 },"bpm":{ N @ + s 9 },"tom":{ N @ + s 10 },"fixa":{ ? @ + s 11 "true" "false" }\}\}` }

# 3) os sinais, o motor, o que saiu; 4) gravar na biblioteca e no Tidal
: pb_perfil >i {
  pb_gosto
  # as encontradas, sem a mesma faixa do Tidal duas vezes
  ! 26 A + @ 19 1 ! 27 0
  = ids A + @ 19 1 = i 0
  W < i @ 19 {
    = c @ + @ 18 i = f @ + c 13
    Se f { = d pb_str f.id Se < pb_acha ids @ 27 d 0 { ! + ids @ 27 d ! + @ 26 @ 27 i ! 27 + @ 27 1 pb_sinais c } }
    = i + i 1 }
  pb_motor
  `Encontradas no Tidal: { N @ 27 } de { N @ 19 }`
  = q 0 = i 0
  W < i @ 19 { = r @ + @ 18 i Se ~ @ + r 13 { `{ ? q "; " " · não encontradas: " }{ crut @ r } — { crut @ + r 1 }` = q 1 } = i + i 1 }
  "\n"
  Se && < @ 29 @ 14 ~ pb_flag $"--aceitar-menos" {
    _an_fd 2 `O motor só conseguiu { N @ 29 } de { N @ 14 } faixas (máx. { N @ 15 } por artista). Acrescenta candidatas (de outros artistas) à proposta e publica outra vez — ou usa --aceitar-menos.\n`
    _an_volta _an_sair 1 }
  = dur 0 = p 0 W < p @ 29 { = dur + dur I num _ar_get @ + pb_rc p 13 $"duracao" = p + p 1 }
  `\n«{ crut @ 7 }» — { N @ 29 } faixas, { N / dur 60 } min · custo das transições { N @ 30 }\n`
  = p 0
  W < p @ 29 {
    = r pb_rc p = f @ + r 13 = s @ + r 15
    `{ Se < p 9 P 32 }{ N + p 1 }. { pjunta f.artistas $", " } — { cru f.titulo } · `
    = y f.ano `{ ? ha y cru y "?" } · { ? _tx_len @ + s 1 crut @ + s 1 "?" } · { crut pqual f.tags }`
    = b f.bpm Se ha b ` · { cru b } bpm`
    = t f.tom Se ha t ` · { pcamelot I num t }`
    ` · { crut pb_motivo @ + + @ 28 * 3 p 1 } { N @ + + @ 28 * 3 p 2 }\n`
    = p + p 1 }
  `\nGéneros: { pb_mist 1 }\nDécadas: { pb_mist 2 }\nQualidade: { pb_mist 3 }\n`
  Se pb_flag $"--ensaio" { `\n(ensaio: nada gravado)\n` _an_sair 0 }
  _an_abre 0
  `\{"nome":{ _tx_pj @ 7 },"descricao":{ _tx_pj @ 8 },"resumo":{ _tx_pj @ 9 },"tendencias":[`
  L i @ 11 { Se i "," _tx_pj @ + @ 10 i } "]"
  ? == @ 13 0 `,"pedido":{ _tx_pj @ 12 }` Se > @ 13 0 `,"pedido":{ pb_jw @ 13 0 0 }`
  `,"opcoes":\{"faixas":{ N @ 14 },"maxArtista":{ N @ 15 },"estilo":{ _tx_pj @ 16 },"arco":{ _tx_pj @ 17 }{ Se @ 57 `,"limpa":true` }\}`
  `,"faixas":[` L p @ 29 { Se p "," pb_faixa p } "]"
  `,"custo":{ N @ 30 }`
  `,"candidatas":[` L i @ 27 { Se i "," pb_guardada @ + @ 18 @ + @ 26 i } "]"
  Se @ 31 `,"modelo":{ _tx_pj @ 31 }`
  `,"tidal":{ ? pb_flag $"--sem-tidal" "false" "true" }`
  "}"
  = b _an_fecha
  = u ? @ 58 texto`/api/playlists/{ crut @ 58 }/renovacoes` $"/api/playlists"
  ! 6 5 pb_api $"POST" u b }
: pb_gravada i>i d {
  ! 55 d
  ? @ 5 { ! 6 6 = c texto`/api/pedidos/{ crut @ 5 }?playlist={ cru d.id }` pb_api $"DELETE" c 0 } pb_fim }
: pb_fim >i {
  = d @ 55
  _an_abre texto`{ crut @ 24 }/publicada.json` pb_jw d 2 0 _an_fecha
  `\n{ ? @ 58 "Renovada" "Publicada" }: «{ cru d.nome }» ({ cru d.id })`
  = t d.tidal
  ? ha t ` · no Tidal: { cru t.url }` " · só na biblioteca da app"
  Se @ 5 ` · pedido { crut @ 5 } feito`
  "\n" _an_sair 0 }

# ---------- os argumentos de cada script ----------
# o uso, no stderr, e sai com 2
: pb_uso i>i m { _an_fd 2 `uso: { crut m }\n` _an_volta _an_sair 2 }
# o JSON do ficheiro f (a proposta ou as ideias): a raiz, com o texto no M[56]; sem ficheiro ou sem JSON, diz porque (no stderr) e sai com 1
: pb_ler i>i f {
  ! 56 _an_fich f
  = p _ar_json @ 56
  Se ~ p { _an_fd 2 `JSON inválido em { crut f }: { ? @ 56 "o texto não é JSON válido" crut _an_erro }\n` _an_volta _an_sair 1 }
  p }
# o valor da opcao k (--utilizador x), ou 0
: pb_opcao i>i k { = i pb_argi k ? >= i 0 _an_arg i 0 }
# a pessoa (--utilizador; o dono e sem), o Worker e a pasta musica/
: pb_ambiente >i {
  = u pb_opcao $"--utilizador"
  ! 4 ? && cheio u ~ mesmo u $"dono" u 0
  = w _an_env $"MUSICA_WORKER"
  ! 2 ? cheio w w $"https://musica.mercados-proxy.workers.dev"
  ! 21 _an_env $"MUSICA_DIR" }

: publicar >i {
  = f _an_arg 1
  Se || ~ cheio f _tx_comeca f $"--" pb_uso $"publicar.mjs /tmp/musica/<pessoa>/proposta.json [--utilizador <pessoa>] [--pedido <id>] [--modelo <id>] [--ensaio]"
  ! 1 f
  pb_proposta pb_ler f
  pb_ambiente
  = x pb_opcao $"--pedido" ! 5 ? cheio x x 0
  ! 31 ? pb_flag $"--modelo" pb_opcao $"--modelo" $"claude"
  = x pb_opcao $"--renovar" ! 58 ? cheio x x 0
  ! 24 pb_pasta f
  ! 23 0
  pb_chave }

# ---------- as ideias de pedidos (o Maestro escreve-as em cada corrida; a app mostra as do momento) ----------
#   node musica/curador/ideias.mjs <dir>/ideias.json [--utilizador <pessoa>]   (o JSON: { "ideias": [{ "texto", "momento", "opcoes" }] })
: ideias_main >i {
  = f _an_arg 1
  Se || ~ cheio f _tx_comeca f $"--" pb_uso $"ideias.mjs /tmp/musica/<pessoa>/ideias.json [--utilizador <pessoa>]"
  ! 1 f
  pb_ler f
  ! 49 @ 56
  pb_ambiente
  pb_chave }
: pb_ideias i>i r { `Ideias guardadas: { cru r.n } (de dia { cru r.dia }, de noite { cru r.noite })\n` _an_sair 0 }
# para os testes de paridade: [normal(), chave(), toLowerCase()] de cada argumento, em JSON
: pb_textos >i {
  L i - _an_arg -1 1 {
    = t _an_arg + i 1
    `[{ _tx_pj pb_normal t 1 },{ _tx_pj pb_normal t 0 },{ _tx_pj minusc t }]\n` }
  _an_sair 0 }