# Molde de uma app em Onda: uma lista que vem da rede (dados.json), com procura, filtro por grupo, favoritos que
# ficam guardados e uma folha de pormenor. Copia-se a pasta e muda-se este ficheiro, o dados.json e o app.css.
# Monta-se com `node build.mjs` (a biblioteca onda/lib + este ficheiro → gerado/app.wasm).
#
# COMO FUNCIONA: o anfitrião (rt/anfitriao.js) corre o `main` uma vez; depois chama uma função daqui em cada evento:
#   clique t         um toque num elemento com data-onda="ação:número" (t = esse texto)
#   escreve t        uma tecla num campo com data-onda (t = "nome" + tab + o que lá está escrito)
#   lido t estado    a resposta da rede (t = o corpo, estado = o HTTP; 0 = sem rede)
# A memória fica viva entre chamadas: o estado da app são os globais abaixo. Cada evento solta no fim o que
# reservou (_me_solta), por isso o monte não cresce com o uso.
#
# GLOBAIS (a app tem M[0..62]; a biblioteca só usa o M[63])
#   0 a lista "itens" (árvore do JSON; 0 enquanto não chegou)   1 aba (0 tudo, 1 favoritos)
#   2 grupo escolhido (-1 todos; senão o índice de um item desse grupo)   3 item aberto na folha (-1 nenhum)
#   4 favoritos (uma palavra por item)   5 o texto da procura (lugar fixo, 80 bytes)
#   6 rede (0 a carregar, 1 chegou, 2 falhou)   7 os nós dos itens (um endereço por item)   8 quantos itens
#   9 a folha acabou de abrir (para a animação de entrada só correr uma vez)

# ---------- os dados ----------
: no i>i i @ + @ 7 i
: fav i>i i @ + @ 4 i
: existe i>i i && >= i 0 < i @ 8
: grupo i>i i { = c no i txt c.grupo }

# minúscula de um byte (só o ASCII; os acentos comparam-se tal e qual)
: minb i>i c ? && >= c 'A <= c 'Z + c 32 c
# 1 se o texto t contém p, sem olhar a maiúsculas; um p vazio está em todos
: contem ii>i t p {
  = n _tx_len t = m _tx_len p = r == m 0 = i 0
  W ? r 0 <= + i m n {
    = j 0 W ? < j m == minb _tx_b t + i j minb _tx_b p j 0 = j + j 1
    = r == j m = i + i 1 }
  r }
# copia até max bytes de t para o texto fixo d (sem cortar um carácter UTF-8 a meio)
: fixa iii>i d t max {
  = n _tx_len t Se > n max = n max
  W ? > n 0 && >= _tx_b t n 128 < _tx_b t n 192 0 = n - n 1
  L j n ! + + d 1 j _tx_b t j
  ! d + + d 1 n }
# o item i aparece? (a aba, o grupo e a procura)
: passa i>i i {
  = c no i
  ? ? @ 1 ~ fav i 0 0
  ? ? < @ 2 0 0 ~ mesmo grupo i grupo @ 2 0
  contem txt c.nome @ 5 }
: nfav >i { = n 0 L i @ 8 = n + n fav i n }

# ---------- favoritos no armazém do browser: os ids separados por vírgulas ----------
: temid ii>i g id {
  = r 0 = j 0 = f _tx_campo g 0 44
  W ? r 0 > _tx_len f 0 { = r mesmo f id = j + j 1 = f _tx_campo g j 44 }
  r }
: lefav >i {
  = m _me_marca
  = g _an_ler $"favoritos"
  L i @ 8 { = c no i ! + @ 4 i ? g temid g txt c.id 0 }
  _me_solta m }
: gravafav >i {
  = n 1 L i @ 8 { = c no i = n + + n 1 _tx_len txt c.id }
  = t _tx_abre n
  L i @ 8 { = c no i Se fav i { crut txt c.id P 44 } }
  _tx_fecha t
  _an_gravar $"favoritos" t }

# ---------- o ecrã: cada função desenha um pedaço (um elemento do index.html) ----------
: dfiltros >i {
  = h _ht_ini + 400 * 200 @ 8
  `<button data-onda="grupo:-1"{ Se < @ 2 0 ` class="on"` }>Todos</button>`
  L i @ 8 {
    # um botão por grupo: no primeiro item de cada grupo
    = novo 1 = j 0 W ? novo < j i 0 { = novo ~ mesmo grupo j grupo i = j + j 1 }
    Se novo `<button data-onda="grupo:{N i}"{ Se ? < @ 2 0 0 mesmo grupo i grupo @ 2 ` class="on"` }>{ esct grupo i }</button>` }
  _ht_poe $"#filtros" h }
: dlista >i {
  = h _ht_ini + 600 * 400 @ 8
  Se == @ 6 0 `<p class="vazio">A carregar…</p>`
  Se == @ 6 2 `<p class="vazio">Sem ligação.</p><button class="acao" data-onda="tenta:0">Tentar outra vez</button>`
  = n 0 = tot 0.
  L i @ 8 {
    = c no i
    Se passa i {
      `<button class="linha" data-onda="abre:{N i}"><span><b>{ esc c.nome }</b><small>{ esc c.grupo }</small></span>`
      `<span class="num">{ Se fav i `<i>★</i> ` }{ inteiro num c.valor }</span></button>`
      = n + n 1 = tot + tot num c.valor } }
  Se && == @ 6 1 == n 0 `<p class="vazio">Nada por aqui.</p>`
  Se > n 0 `<p class="total">{ plural n $"lugar" $"lugares" } · { inteiro tot } habitantes</p>`
  _ht_poe $"#lista" h }
: dabas >i {
  = h _ht_ini 400
  = f nfav
  `<button data-onda="aba:0"{ Se ~ @ 1 ` class="on"` }>Tudo</button>`
  `<button data-onda="aba:1"{ Se @ 1 ` class="on"` }>Favoritos{ Se f ` · {N f}` }</button>`
  _ht_poe $"#abas" h }
: dfolha >i {
  = i @ 3
  = h _ht_ini 2000
  Se existe i {
    = c no i
    `<div class="veu" data-onda="fecha:0"></div><div class="cartao{ Se @ 9 ` entra` }">`
    `<small>{ esc c.grupo }</small><h2>{ esc c.nome }</h2>`
    `<p class="grande">{ inteiro num c.valor }<span> habitantes</span></p>`
    `<p>{ esc c.nota }</p>`
    `<button class="acao{ Se fav i ` on` }" data-onda="fav:{N i}">{ ? fav i `★ Guardado` `☆ Guardar` }</button>`
    `<button class="acao fraco" data-onda="fecha:0">Fechar</button></div>` }
  ! 9 0
  _ht_poe $"#folha" h }
: desenha >i { dfiltros dlista dabas dfolha }

# ---------- os eventos ----------
: pede >i { ! 6 0 _an_buscar $"dados.json" $"lido" }
: clique i>i t {
  = v arg t
  Se eacao t $"aba" ! 1 != v 0
  Se eacao t $"grupo" ! 2 ? existe v v -1
  Se eacao t $"abre" { ! 3 ? existe v v -1 ! 9 1 }
  Se eacao t $"fecha" ! 3 -1
  Se && eacao t $"fav" existe v { ! + @ 4 v ~ fav v gravafav }
  Se eacao t $"tenta" pede
  desenha
  _me_solta t }
: escreve i>i t {
  Se mesmo _tx_campo t 0 9 $"procura" fixa @ 5 _tx_campo t 1 9 80
  dlista
  _me_solta t }
: lido ii>i t estado {
  = r _ar_json t
  = l r.itens
  ? && == estado 200 == tipo l 6 {
    = n quantos l ! 8 n ! 7 A + n 1 ! 4 A + n 1
    = c pri l = i 0 W c { ! + @ 7 i c = c seg c = i + i 1 }
    ! 0 l ! 2 -1 ! 3 -1 ! 6 1
    lefav } ! 6 2
  desenha }
: main >i {
  _me_lb
  ! 5 _tx_novo 80 ! 2 -1 ! 3 -1
  _an_ouvir $"click" $"clique"
  _an_ouvir $"input" $"escreve"
  pede
  desenha 0 }
