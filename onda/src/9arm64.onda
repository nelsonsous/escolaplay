# emissor NATIVO ARM64 (aarch64) -- a Onda escreve o seu proprio codigo-maquina ARM, sem C nem assembler.
# Irmao do -x (que escreve x86-64), mas para o chip do Mac/iPhone (Apple Silicon) e qualquer ARM64.
# Primeira fatia: nucleo inteiro (literais, + - * / %, & | ^, << >>, comparacoes, locais, ciclos W) e um ELF
# estatico minimo. Cada instrucao = 4 bytes little-endian. Rascunho: x9/x10/x11. Base da moldura: sp.
# Disposicao: slot(local j) = j; slot(temp t) = @9 + t; byte = slot*8. Tudo vive na moldura (sem alocar registos).
# FOLHA: o -a nunca compila o proprio compilador (o ponto fixo faz-se em C/wasm/x86), logo um erro aqui falha
# testes mas NAO pode partir o ponto fixo -- a mesma garantia do vetorizador.

# --- codificadores de instrucoes (hex = encoding exato, conferido com o llvm-objdump) ---
: aslt i>i t * + @ 9 t 8
: asll i>i j * j 8
: ald ii>i rt off ? < off 32768 x4 | | | 0xF9400000 << / off 8 10 << 31 5 rt { aimm 12 / off 8 x4 | | | 0xF8607800 << 12 16 << 31 5 rt }
: ast ii>i rt off ? < off 32768 x4 | | | 0xF9000000 << / off 8 10 << 31 5 rt { aimm 12 / off 8 x4 | | | 0xF8207800 << 12 16 << 31 5 rt }
: agT ii>i rt t agV rt t
: asT ii>i rt t asV rt t
: agL ii>i rt j agV rt + @ 11 j
: asL ii>i rt j asV rt + @ 11 j
: aimm4 ii>i rd v {
  x4 | | 0xD2800000 << & v 0xffff 5 rd
  x4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd
  x4 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd
  x4 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd }
: aimm ii>i rd v {
  x4 | | 0xD2800000 << & v 0xffff 5 rd
  ? & >> v 16 0xffff x4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd 0
  ? & >> v 32 0xffff x4 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd 0
  ? & >> v 48 0xffff x4 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd 0 }
: aadd iii>i rd rn rm x4 | | | 0x8B000000 << rm 16 << rn 5 rd
: asub iii>i rd rn rm x4 | | | 0xCB000000 << rm 16 << rn 5 rd
: amul iii>i rd rn rm x4 | | | 0x9B007C00 << rm 16 << rn 5 rd
: asdiv iii>i rd rn rm x4 | | | 0x9AC00C00 << rm 16 << rn 5 rd
: amsub iiii>i rd rn rm ra x4 | | | | 0x9B008000 << rm 16 << ra 10 << rn 5 rd
: aand iii>i rd rn rm x4 | | | 0x8A000000 << rm 16 << rn 5 rd
: aorr iii>i rd rn rm x4 | | | 0xAA000000 << rm 16 << rn 5 rd
: aeor iii>i rd rn rm x4 | | | 0xCA000000 << rm 16 << rn 5 rd
: alsl iii>i rd rn rm x4 | | | 0x9AC02000 << rm 16 << rn 5 rd
: alsr iii>i rd rn rm x4 | | | 0x9AC02400 << rm 16 << rn 5 rd
: aasr iii>i rd rn rm x4 | | | 0x9AC02800 << rm 16 << rn 5 rd
: acmp ii>i rn rm x4 | | | 0xEB000000 << rm 16 << rn 5 31
: acset ii>i rd cc x4 | | 0x9A9F07E0 << cc 12 rd
: acc i>i o ? == o '< 0xB ? == o '> 0xC ? == o k2 '< '= 0xD ? == o k2 '> '= 0xA ? == o k2 '= '= 0 1
: asubsp i>i imm ? < imm 4096 x4 | | | 0xD1000000 << imm 10 << 31 5 31 { aimm 12 imm x4 | | | 0xCB206000 << 12 16 << 31 5 31 }
: aaddsp i>i imm ? < imm 4096 x4 | | | 0x91000000 << imm 10 << 31 5 31 { aimm 12 imm x4 | | | 0x8B206000 << 12 16 << 31 5 31 }
: aret >i x4 0xD65F03C0
: aprol >i x4 0xA9BF7BFD
: aepil >i x4 0xA8C17BFD
: ab i>i off x4 | 0x14000000 & / off 4 0x3FFFFFF
: abl i>i off x4 | 0x94000000 & / off 4 0x3FFFFFF
: afs >i & + * 8 + + @ 9 @ 11 14 15 -16
# --- atribuicao de registos (-a/-m): varrimento linear com prioridade aos ciclos mais fundos ---
# valor v: temporario t (v = t) ou variavel j (v = @11 + j). local: -1 moldura; 0..10 registo inteiro (0..7 = x19..x26,
# guardados pelo chamado; 8..10 = x13..x15, so para o que nao atravessa chamadas); 32+i real (0..5 = d10..d15 guardados;
# 6..21 = d16..d31 sem chamadas). 34 local 36 inicio 37 fim 38 profundidade 39 ocupacao por posicao (entrada 0, instrucao i em i+1; bits 0..10
# inteiros, 16..37 reais, 40 chamada, 41 chamada que tambem le os operandos em x13..x15: o mapa NEON) 40 ciclos (inicio,
# fim) 41 n de ciclos 42 registos guardados usados 43 pilha de ciclos 44 profundidade atual
: arep i>i v @ + @ 35 v
: aloc i>i v @ + @ 34 arep v
: arx i>i l ? < l 8 + 19 l + 5 l
: ard i>i l ? < l 6 + 10 l + 10 l
: avs i>i v { = v arep v ? < v @ 11 aslt v asll - v @ 11 }
: aty i>i v ? < v @ 11 tty v { = l lty - v @ 11 ? >= l 2 tty - l 2 l }
: amov ii>i rd rn ? == rd rn 0 amovr rd rn
: afmovdd ii>i rd rn ? == rd rn 0 x4 | | 0x1E604000 << rn 5 rd
: agV ii>i rt v { = l aloc v ? < l 0 ald rt avs v ? < l 32 amov rt arx l x4 | | 0x9E660000 << ard - l 32 5 rt }
: asV ii>i rt v { = l aloc v ? < l 0 ast rt avs v ? < l 32 amov arx l rt afmovxd ard - l 32 rt }
: agVf ii>i rt v { = l aloc v ? < l 0 aldfr rt avs v ? >= l 32 afmovdd rt ard - l 32 afmovxd rt arx l }
: asVf ii>i rt v { = l aloc v ? < l 0 astfr rt avs v ? >= l 32 afmovdd ard - l 32 rt x4 | | 0x9E660000 << rt 5 arx l }
# operando no seu registo (sem copia) ou carregado no rascunho r; destino: o registo do valor ou o rascunho r
: aox ii>i r v { = l aloc v ? && >= l 0 < l 32 arx l { agV r v r } }
: aod ii>i r v { = l aloc v ? >= l 32 ard - l 32 { agVf r v r } }
: adx ii>i r v { = l aloc v ? && >= l 0 < l 32 arx l r }
: adf ii>i r v { = l aloc v ? >= l 32 ard - l 32 r }
: afx ii>i r v ? < aloc v 0 ast r avs v 0
: afd ii>i r v ? < aloc v 0 astfr r avs v 0
: amvv ii>i dv sv ? == arep dv arep sv 0 ? aty dv { = r aod 0 sv asVf r dv } { = r aox 9 sv asV r dv }
# instrucoes que chamam funcoes (estragam x13..x15 e d16..d31): 1 = normal, 2 = o mapa NEON (le em x13..x15)
: acall i>i p { = k @ p ? || || || == k 7 == k 3 || == k 28 == k 29 || || == k 31 == k 32 == k 36 1 ? && == k 15 || == @ + p 2 3 == @ + p 2 4 1 ? || == k 53 == k 54 2 0 }
: arf ii>i v i { = v arep v = q + @ 36 v ? || < @ q 0 > @ q i ! q i 0 = q + @ 37 v ? < @ q i ! q i 0 = q + @ 38 v ? < @ q @ 44 ! q @ 44 0 }
: aext i>i v {
  = s @ + @ 36 v
  = e @ + @ 37 v
  = l 0
  W && >= s 0 < l @ 41 {
    = q + @ 40 * l 2
    = a @ q
    = b @ + q 1
    ? && && <= s b >= e a || < s a > e b { = s Mn s a = e Mx e b } 0
    = l + l 1 }
  ! + @ 36 v s
  ! + @ 37 v e }
: afree iii>i m lo hi { = r -1 = j lo W && < r 0 < j hi { ? & >> m j 1 0 = r j = j + j 1 } r }
: aal i>i v {
  = s @ + @ 36 v
  = e @ + @ 37 v
  ? >= s 0 {
    = m 0
    = cs 0
    = p s
    W <= p e { = o @ + @ 39 p = m | m o ? && > p s || && < p e & o << 1 40 & o << 1 41 = cs 1 0 = p + p 1 }
    = fl aty v
    = r ? fl { = r ? cs -1 afree m 22 38 ? < r 0 afree m 16 22 r } { = r ? cs -1 afree m 8 11 ? < r 0 afree m 0 8 r }
    ? >= r 0 {
      = b << 1 r
      = p s W <= p e { = q + @ 39 p ! q | @ q b = p + p 1 }
      ? || < r 8 && >= r 16 < r 22 ! 42 | @ 42 b 0
      ! + @ 34 v ? fl + 32 - r 16 r } 0 } 0 }
: aopn ii>i p q {
  = k @ p
  = f @ + @ 50 k
  = n 0
  ? & f 1 { ! + q n @ + p 2 = n + n 1 } 0
  ? & f 2 { ! + q n @ + p 3 = n + n 1 } 0
  ? & f 4 { ! + q n @ + p 4 = n + n 1 } 0
  ? == k 7 { = b @ + p 3 = j 0 W < j @ + p 4 { ! + q n @ + b j = n + n 1 = j + j 1 } } 0
  ? == k 53 { ! q @ + p 2 ! + q 1 @ + p 3 ! + q 2 @ + p 5 = n 3 } 0
  ? == k 54 { ! q @ + p 2 = n 1 = b @ + p 4 = j 0 W < j - @ fe @ + p 3 2 1 { ! + q n @ + b j = n + n 1 = j + j 1 } } 0
  n }
# o intervalo ]a,b] e uma reta (sem inicio/fim de ciclo) onde a variavel j nao e escrita (nem lida, se rd)?
: aclr iiiii>i a b j rd q {
  = ok 1
  = nt @ 11
  = i + a 1
  W && ok <= i b {
    = p + @ 18 * i 8
    = k @ p
    ? || == k 21 == k 23 = ok 0 0
    ? && == k 6 == @ + p 4 j = ok 0 0
    ? && rd && == k 5 == @ + p 3 j = ok 0 0
    ? rd { = c aopn p q = h 0 W < h c { ? == @ + @ 35 @ + q h + nt j = ok 0 0 = h + h 1 } } 0
    = i + i 1 }
  ok }
: aali i>i q {
  = n @ 19
  = nt @ 11
  = nv + nt @ 9
  = v 0
  W < v nv { ! + @ 35 v v = v + v 1 }
  = t 0
  W < t nt { ! + @ 45 t 0 ! + @ 46 t 0 ! + @ 47 t -1 ! + @ 48 t -1 = t + t 1 }
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = c aopn p q
    = h 0 W < h c { = t @ + q h ! + @ 45 t + @ + @ 45 t 1 ! + @ 48 t i = h + h 1 }
    ? & @ + @ 50 @ p 8 { = d @ + p 1 ! + @ 46 d + @ + @ 46 d 1 ! + @ 47 d i } 0
    = i + i 1 }
  # a) t = variavel j: partilha o registo de j se j nao muda enquanto t vive
  = i 0
  W < i n {
    = p + @ 18 * i 8
    ? == @ p 5 { = d @ + p 1 = j @ + p 3 ? && && == @ + @ 46 d 1 >= @ + @ 48 d 0 aclr i @ + @ 48 d j 0 q ! + @ 35 d + nt j 0 } 0
    = i + i 1 }
  # b) variavel j = t, com t usado so aqui: t calcula-se ja no registo de j (se j nao e lida entretanto)
  = i 0
  W < i n {
    = p + @ 18 * i 8
    ? == @ p 6 {
      = t @ + p 3
      = j @ + p 4
      = s @ + @ 47 t
      ? && && && == @ + @ 46 t 1 == @ + @ 45 t 1 == @ + @ 35 t t && >= s 0 == aty t aty + nt j
        ? aclr s - i 1 j 1 q ! + @ 35 t + nt j 0 0 } 0
    = i + i 1 }
  0 }
# fusao a*b+c (fmadd/fmsub/fnmsub): um '*' real usado so por um '+'/'-' na mesma reta, sem os operandos mudarem
# entretanto. So com -mf/-af (como o FMA do -xf no x86): um so arredondamento muda os ultimos bits, e o -m/-a tem de dar
# os mesmos bits que o C, o WebAssembly e o x86. Nunca na biblioteca (funcoes _...), que fica igual ao bit ao fdlibm.
# 51 por instrucao: -1 normal; -2 '*' absorvido; m >= 0 a soma que absorve o '*' da instrucao m
: afmc ii>i t i {
  = j @ + @ 47 t
  = r -1
  ? && && >= j 0 == @ + @ 46 t 1 == @ + @ 45 t 1 {
    = q + @ 18 * j 8
    ? && && == @ q 8 == opof @ + q 2 '* == @ + @ 51 j -1 {
      = x arep @ + q 3
      = y arep @ + q 4
      = nt @ 11
      = ok 1
      = h + j 1
      W && ok < h i {
        = p + @ 18 * h 8
        = k @ p
        ? || || && >= k 10 <= k 13 && >= k 18 <= k 23 == k 41 = ok 0 0
        ? && == k 6 || == + nt @ + p 4 x == + nt @ + p 4 y = ok 0 0
        ? && & @ + @ 50 k 8 || == arep @ + p 1 x == arep @ + p 1 y = ok 0 0
        = h + h 1 }
      ? ok = r j 0 } 0 } 0
  r }
: afm >i {
  = n @ 19
  = i 0
  W < i n { ! + @ 51 i -1 = i + i 1 }
  ? || ~ fastf == tc @ fe @ 13 0 0 '_ 0 {
    = i 0
    W < i n {
      = p + @ 18 * i 8
      ? && && == @ p 8 tty @ + p 1 || == opof @ + p 2 '+ == opof @ + p 2 '- {
        = m afmc @ + p 4 i
        = m ? < m 0 afmc @ + p 3 i m
        ? >= m 0 { ! + @ 51 i m ! + @ 51 m -2 } 0 } 0
      = i + i 1 } } }
# comparacao seguida do salto que e o seu unico uso: cmp + b.cond (sem cset/cbz). 48 do bloco de cima nao serve aqui:
# a condicao pendente vive em @49 (-1 nenhuma)
: afz i>i p { = q + p 8 = d @ + p 1 && && < / - q @ 18 8 @ 19 || == @ q 22 == @ q 18 && == @ + q 2 d == @ + @ 45 d 1 }
: abr i>i x ? >= @ 49 0 { x4 | 0x54000000 ^ @ 49 1 ! 49 -1 } x4 | 0xB4000000 x
: ap19 i>i p { = w | | | @ p << @ + p 1 8 << @ + p 2 16 << @ + p 3 24 xput4 p | & w 0xFF00001F << & / - @ 16 p 4 0x7FFFF 5 }
: ara i>i kf {
  = n @ 19
  = nt @ 11
  = nv + nt @ 9
  = v 0
  W < v nv { ! + @ 34 v -1 ! + @ 36 v -1 ! + @ 37 v -1 ! + @ 38 v 0 = v + v 1 }
  = i 0
  W <= i n { ! + @ 39 i 0 = i + i 1 }
  = qo A 64
  aali qo
  afm
  ! 49 -1
  ! 41 0
  ! 44 0
  = sp 0
  = j 0
  W < j @ fe kf 2 { arf + nt j 0 = j + j 1 }
  = i 0
  W < i n {
    = p + @ 18 * i 8
    = k @ p
    = ps + i 1
    ? == k 21 { ! + @ 43 sp ps = sp + sp 1 ! 44 + @ 44 1 } 0
    = f @ + @ 50 k
    ? & f 8 arf @ + p 1 ps 0
    ? == k 5 arf + nt @ + p 3 ps 0
    ? == k 6 arf + nt @ + p 4 ps 0
    = c aopn p qo
    = h 0 W < h c { arf @ + qo h ps = h + h 1 }
    = m @ + @ 51 i
    ? >= m 0 { = q2 + @ 18 * m 8 arf @ + q2 3 ps arf @ + q2 4 ps } 0
    = c acall p
    ? c { = q + @ 39 ps ! q | @ q << 1 + 39 c } 0
    ? == k 23 { = sp - sp 1 = q + @ 40 * @ 41 2 ! q @ + @ 43 sp ! + q 1 ps ! 41 + @ 41 1 ! 44 - @ 44 1 } 0
    = i + i 1 }
  # variaveis: vivas desde a entrada (podem ser lidas antes de escritas, p.ex. o valor da volta anterior de um ciclo)
  = v nt
  W < v nv { ? >= @ + @ 36 v 0 ! + @ 36 v 0 0 = v + v 1 }
  = v 0
  W < v nv { aext v = v + v 1 }
  ! 42 0
  = md 0
  = v 0
  W < v nv { = md Mx md @ + @ 38 v = v + v 1 }
  W >= md 0 {
    = v nt
    W < v nv { ? == @ + @ 38 v md aal v 0 = v + v 1 }
    = v 0
    W < v nt { ? == @ + @ 38 v md aal v 0 = v + v 1 }
    = md - md 1 }
  0 }
# guardar/repor os registos do chamado que esta funcao usa (slots @9+@11 .. +13 da moldura)
: asvb i>i i * 8 + + @ 9 @ 11 i
: asave >i { = j 0 W < j 8 { ? & >> @ 42 j 1 ast + 19 j asvb j 0 = j + j 1 } = j 0 W < j 6 { ? & >> @ 42 + 16 j 1 astfr + 10 j asvb + 8 j 0 = j + j 1 } 0 }
: arest >i { = j 0 W < j 8 { ? & >> @ 42 j 1 ald + 19 j asvb j 0 = j + j 1 } = j 0 W < j 6 { ? & >> @ 42 + 16 j 1 aldfr + 10 j asvb + 8 j 0 = j + j 1 } 0 }
# --- reais (registos d) e arrays em M (base pinada em x28, bump em x27) ---
: aldfr ii>i rt off ? < off 32768 x4 | | | 0xFD400000 << / off 8 10 << 31 5 rt { aimm 12 / off 8 x4 | | | 0xFC607800 << 12 16 << 31 5 rt }
: astfr ii>i rt off ? < off 32768 x4 | | | 0xFD000000 << / off 8 10 << 31 5 rt { aimm 12 / off 8 x4 | | | 0xFC207800 << 12 16 << 31 5 rt }
: agTf ii>i rt t agVf rt t
: asTf ii>i rt t asVf rt t
: agLf ii>i rt j agVf rt + @ 11 j
: asLf ii>i rt j asVf rt + @ 11 j
: afadd iii>i rd rn rm x4 | | | 0x1E602800 << rm 16 << rn 5 rd
: afsub iii>i rd rn rm x4 | | | 0x1E603800 << rm 16 << rn 5 rd
: afmul iii>i rd rn rm x4 | | | 0x1E600800 << rm 16 << rn 5 rd
: afdiv iii>i rd rn rm x4 | | | 0x1E601800 << rm 16 << rn 5 rd
: afmovxd ii>i rd rn x4 | | 0x9E670000 << rn 5 rd
: ascvtf ii>i rd rn x4 | | 0x9E620000 << rn 5 rd
: afcvtzs ii>i rd rn x4 | | 0x9E780000 << rn 5 rd
: aldrx iii>i rt rn rm x4 | | | 0xF8607800 << rm 16 << rn 5 rt
: astrx iii>i rt rn rm x4 | | | 0xF8207800 << rm 16 << rn 5 rt
: aldrdx iii>i rt rn rm x4 | | | 0xFC607800 << rm 16 << rn 5 rt
: astrdx iii>i rt rn rm x4 | | | 0xFC207800 << rm 16 << rn 5 rt
: afbits i>i tok { !f 24 fltval tok @ 24 }
: aaddi iii>i rd rn imm x4 | | | 0x91000000 << imm 10 << rn 5 rd
: aaddlsl iiii>i rd rn rm sh x4 | | | | 0x8B000000 << rm 16 << sh 10 << rn 5 rd
: abcc ii>i cc off x4 | | 0x54000000 << & / off 4 0x7FFFF 5 cc
# Sn/Cs nativos (so os pede a biblioteca em Onda, para |x| enorme): reduz x mod 2pi (Cody-Waite) e chama _sn/_cs.
# --- impressao/runtime: cmp imediato, fcmp (compara reais), condicao de reais, chamar funcao do runtime ---
: acmpi ii>i rn imm x4 | | | 0xF1000000 << imm 10 << rn 5 31
: afcmp ii>i rn rm x4 | | 0x1E602000 << rm 16 << rn 5
: afcc i>i o ? == o '< 0x4 ? == o '> 0xC ? == o k2 '< '= 0x9 ? == o k2 '> '= 0xA ? == o k2 '= '= 0 1
: acallf i>i fi { acsrec @ 16 fi abl 0 }
: aro i>i o fby k3 '_ 'o o
# pilha de ramos (if/else e &&/|| curto-circuito): @65[0]=n; cada entrada = posicao de um salto a corrigir
: aipush i>i p { = n @ @ 65 ! + @ 65 + 1 n p ! @ 65 + n 1 }
: aipop >i { = n - @ @ 65 1 ! @ 65 n @ + @ 65 + 1 n }
: apcbz i>i p ap19 p
: apcbnz i>i p ap19 p
: apb i>i p xput4 p | 0x14000000 & / - @ 16 p 4 0x3FFFFFF
: apbc ii>i p cc xput4 p | | 0x54000000 << & / - @ 16 p 4 0x7FFFF 5 cc
: acsel iiii>i rd rn rm cc x4 | | | | 0x9A800000 << rm 16 << cc 12 << rn 5 rd
: astod ii>i d a ? tty d { agTf 0 a asTf 0 d } { agT 9 a asT 9 d }
# --- NEON (v.2d, 2 doubles por instrucao): o mapa vetorizado. x em v1; constantes em v2..v9 (via salloc); x12 rascunho ---
# emissores conscientes da largura w: 2 = par (q/.2d), 1 = escalar (d). Por-lane = escalar, logo bit-exato.
: vfld iii>i w rt rn ? == w 2 x4 | | 0x3DC00000 << rn 5 rt x4 | | 0xFD400000 << rn 5 rt
: vfst iii>i w rt rn ? == w 2 x4 | | 0x3D800000 << rn 5 rt x4 | | 0xFD000000 << rn 5 rt
: vfb iii>i w r bits { aimm 12 bits ? == w 2 { x4 | | 0x4E080C00 << 12 5 r } { afmovxd r 12 } }
: vfbin iiiii>i w o rd rn rm ? == w 2
  { ? == o '+ x4 | | | 0x4E60D400 << rm 16 << rn 5 rd ? == o '- x4 | | | 0x4EE0D400 << rm 16 << rn 5 rd ? == o '* x4 | | | 0x6E60DC00 << rm 16 << rn 5 rd x4 | | | 0x6E60FC00 << rm 16 << rn 5 rd }
  { ? == o '+ afadd rd rn rm ? == o '- afsub rd rn rm ? == o '* afmul rd rn rm afdiv rd rn rm }
# alocador de registos NEON parametrizado: banco com base tb (p/ dois bancos independentes no desenrolamento)
: avreg ii>i s tb + salloc s tb
: avfree iii>i s tb r ? >= r tb sfree s - r tb 0
# FMA fundido (rd += rn*rm): fmla vd.2d (par) ou fmadd dd (escalar). Um so arredondamento -> NEON==escalar.
: afmla iiii>i w rd rn rm ? == w 2 x4 | | | 0x4E60CC00 << rm 16 << rn 5 rd x4 | | | | 0x1F400000 << rm 16 << rd 10 << rn 5 rd
# o no na posicao p e um operador '*'? (constante=tkk 2, variavel=tkk 0, operador=o resto)
: ismul i>i p ? && && != tkk p 2 != tkk p 0 == tcode p '* 1 0
# avalia o elemento no banco (xr = registo de x; tb = base dos temporarios). Funde '+ a (* x y)' em fmla.
: avem iiii>i w s xr tb {
  = i @ 7
  ! 7 + i 1
  = kk tkk i
  ? == kk 2 { = r avreg s tb vfb w r afbits i r }
  ? == kk 0 xr
  { = o tcode i
    = sA @ 7 xskip = sB @ 7 xskip = af @ 7
    = mp ? == o '+ ? ismul sB sB ? ismul sA sA -1 -1
    = ad ? == mp sA sB sA
    ? && >= mp 0 != tkk ad 0
      { ! 7 ad = ra avem w s xr tb
        ! 7 + mp 1 = sX @ 7 xskip = sY @ 7 xskip
        ! 7 sY = ry avem w s xr tb
        ! 7 sX = rx avem w s xr tb
        ! 7 af
        afmla w ra rx ry
        avfree s tb rx avfree s tb ry
        ra }
      { ! 7 sB = rb avem w s xr tb
        ! 7 sA = ra avem w s xr tb
        ! 7 af
        = rd avreg s tb
        vfbin w o rd ra rb
        avfree s tb ra avfree s tb rb
        rd } } }
# mapa vetorizado NEON: dst(a) count(b) elemento(c) fonte(x). Desenrolado 2x (4 doubles/iter, dois bancos de
# registos independentes -> esconde a latencia da cadeia de FMA dependente) + par + cauda escalar (restos).
: amap i>i p {
  = d @ + p 2
  = n @ + p 3
  = k @ + p 4
  = sb @ + p 5
  = rs + @ fe k 5 7
  = s7 @ 7
  = stw A 1
  = stB A 1
  agT 13 d agT 14 n agT 15 sb aimm 9 0
  # laco desenrolado 2x: banco A (x=v1, temps v2-9), banco B (x=v16, temps v17-24) -- cadeias independentes
  = l0 @ 16
  aaddi 10 9 3 acmp 10 14
  = p0 @ 16 abcc 0xA 0
  aadd 10 15 9 aaddlsl 11 28 10 3 vfld 2 1 11
  aadd 10 15 9 aaddi 10 10 2 aaddlsl 11 28 10 3 vfld 2 16 11
  ! stw 255 ! 7 rs = rrA avem 2 stw 1 2
  ! stB 255 ! 7 rs = rrB avem 2 stB 16 17
  aadd 10 13 9 aaddlsl 11 28 10 3 vfst 2 rrA 11
  aadd 10 13 9 aaddi 10 10 2 aaddlsl 11 28 10 3 vfst 2 rrB 11
  aaddi 9 9 4 ab - l0 @ 16
  xput4 p0 | | 0x54000000 << & / - @ 16 p0 4 0x7FFFF 5 0xA
  # par que sobra (passo 2)
  = l1 @ 16
  aaddi 10 9 1 acmp 10 14
  = p1 @ 16 abcc 0xA 0
  aadd 10 15 9 aaddlsl 11 28 10 3 vfld 2 1 11
  ! stw 255 ! 7 rs = rr avem 2 stw 1 2
  aadd 10 13 9 aaddlsl 11 28 10 3 vfst 2 rr 11
  aaddi 9 9 2 ab - l1 @ 16
  xput4 p1 | | 0x54000000 << & / - @ 16 p1 4 0x7FFFF 5 0xA
  # cauda escalar (n impar)
  = l2 @ 16
  acmp 9 14
  = p2 @ 16 abcc 0xA 0
  aadd 10 15 9 aaddlsl 11 28 10 3 vfld 1 1 11
  ! stw 255 ! 7 rs = rr2 avem 1 stw 1 2
  aadd 10 13 9 aaddlsl 11 28 10 3 vfst 1 rr2 11
  aaddi 9 9 1 ab - l2 @ 16
  xput4 p2 | | 0x54000000 << & / - @ 16 p2 4 0x7FFFF 5 0xA
  ! 7 s7 }

# --- S vetorizado em NEON (so com -mf/-af: reassocia a soma, como o -xf do x86; o -m/-a soma em serie, igual ao C) ---
# elemento f ii..>f i ...: corpo { = l E ... E } ou E, com + - * /, literais reais, parametros reais, F do indice ou de
# um parametro inteiro, e ate 2 locais. 4 elementos por volta (bancos A e B, 2 doubles cada, acumuladores proprios),
# constantes difundidas antes do ciclo (v25..v31), FMA, cauda escalar. Bancos: A indice v0, acumulador v1, locais v2-3,
# temporarios v4-7; B v16, v17, v18-19, v20-23; passo v24. 52 locais [n, tokens..., 15 = folhas] 53 modo (0 pre-carga,
# 1 codigo) 54 constantes [n, (tipo, chave, registo)...]
: asvl i>i i { = r -1 = j 0 W && < r 0 < j @ @ 52 { ? teq i @ + @ 52 + 1 j = r j 0 = j + j 1 } r }
: asvp ii>i k i { = r -1 = j 0 W && < r 0 < j @ fe k 2 { ? teq i xpe k j = r j 0 = j + j 1 } r }
: asop i>i i && == tkk i 5 isar tcode i
: asfF i>i i && == tkk i 5 == tcode i 'F
: asfl >i { = q + @ 52 15 ! q + @ q 1 0 }
# validacao: devolve pressao*4 + (no e '*')*2 + (no ocupa temporario), ou -1
: asvx i>i k {
  = i @ 7
  ? >= i @ 4 -1 {
    ! 7 + i 1
    = kk tkk i
    ? == kk 2 { asfl 0 }
    ? == kk 0 ? >= asvl i 0 0 { = j asvp k i ? && > j 0 fpt k j { asfl 0 } -1 }
    ? asfF i { = t @ 7 ! 7 + t 1 ? != tkk t 0 -1 { = j asvp k t ? < j 0 -1 ? fpt k j -1 ? > j 0 { asfl 0 } 0 } }
    ? asop i {
      = ra asvx k
      ? < ra 0 -1 {
        = rb asvx k
        ? < rb 0 -1 {
          = pa >> ra 2 = ta & ra 1 = pb >> rb 2 = tb & rb 1
          = p Mx Mx pb + tb pa + + ta tb 1
          = p ? && == tcode i '+ || & ra 2 & rb 2 Mx p + 2 Mx pa pb p
          | | << p 2 << == tcode i '* 1 1 } } }
    -1 } }
: asva i>i k {
  ? || || != @ fe k 3 1 < @ fe k 2 1 fpt k 0 0 {
    = sv @ 7
    ! @ 52 0
    ! + @ 52 15 0
    = b @ fe k 5
    = ok 1
    = mp 0
    ? == tcode b '{ {
      ! 7 + b 1
      W && ok && == tcode @ 7 '= == tkl @ 7 1 {
        = nm + @ 7 1
        ? || || != tkk nm 0 >= asvp k nm 0 || >= asvl nm 0 >= @ @ 52 2 = ok 0 {
          ! 7 + nm 1
          = r asvx k
          ? < r 0 = ok 0 { = mp Mx mp >> r 2 ! + @ 52 + 1 @ @ 52 nm ! @ 52 + @ @ 52 1 } } }
      ? ok { = r asvx k ? < r 0 = ok 0 { = mp Mx mp >> r 2 ? != tcode @ 7 '} = ok 0 0 } } 0 }
      { ! 7 b = r asvx k ? < r 0 = ok 0 = mp Mx mp >> r 2 }
    ! 7 sv
    && && ok <= mp 4 <= @ + @ 52 15 7 } }
: lowSa iii>i n k a { = r nt 1 ir 54 r n k a 0 0 r }
# geracao
: asvk >i { = i @ 7 ! 7 + i 1 ? asfF i { ! 7 + @ 7 1 0 } ? asop i { asvk asvk } 0 }
: asmul i>i s && asop s == tcode s '*
: astmp ii>i r tb && >= r tb < r + tb 4
: asfr iii>i st tb r ? astmp r tb sfree st - r tb 0
: asal ii>i st tb + salloc st tb
: avmov ii>i d r x4 | | | 0x4EA01C00 << r 16 << r 5 d
: ascst iii>i kd key src {
  = n @ @ 54
  = r -1
  = j 0
  W && < r 0 < j n { = e + @ 54 + 1 * j 3 ? && == @ e kd == @ + e 1 key = r @ + e 2 0 = j + j 1 }
  ? >= r 0 r {
    = r + 25 n
    = e + @ 54 + 1 * n 3
    ! e kd ! + e 1 key ! + e 2 r ! @ 54 + n 1
    ? == kd 0 { aimm 9 key x4 | | 0x4E080C00 << 9 5 r }
    ? == kd 1 { agTf 0 src x4 | 0x4E080400 r }
    { agT 9 src ascvtf 0 9 x4 | 0x4E080400 r }
    r } }
: asve iiiiiii>i k a w lb tb vx st {
  = i @ 7
  ! 7 + i 1
  = kk tkk i
  ? == kk 2 ascst 0 afbits i 0
  ? == kk 0 { = l asvl i ? >= l 0 + lb l { = j asvp k i ascst 1 j @ + a - j 1 } }
  ? asfF i { = t @ 7 ! 7 + t 1 = j asvp k t ? == j 0 vx ascst 2 j @ + a - j 1 }
  { = o tcode i
    = sA @ 7 asvk
    = sB @ 7 asvk
    = af @ 7
    ? == @ 53 0 { ! 7 sA asve k a w lb tb vx st ! 7 sB asve k a w lb tb vx st ! 7 af 0 }
    { ? && == o '+ || asmul sA asmul sB
        { = ad ? asmul sB sA sB
          = ml ? asmul sB sB sA
          ! 7 ad
          = r0 asve k a w lb tb vx st
          = rt ? astmp r0 tb r0 { = q asal st tb avmov q r0 q }
          ! 7 + ml 1
          = sX @ 7 asvk
          = sY @ 7
          ! 7 sY = ry asve k a w lb tb vx st
          ! 7 sX = rx asve k a w lb tb vx st
          ! 7 af
          afmla w rt rx ry
          asfr st tb rx asfr st tb ry
          rt }
        { ! 7 sB = rb asve k a w lb tb vx st
          ! 7 sA = ra asve k a w lb tb vx st
          ! 7 af
          asfr st tb ra asfr st tb rb
          = rd asal st tb
          vfbin w o rd ra rb
          rd } } } }
: asbody iiiiiii>i k a w lb tb vx st {
  ! @ 52 0
  = b @ fe k 5
  ? == tcode b '{ {
    ! 7 + b 1
    W && == tcode @ 7 '= == tkl @ 7 1 {
      = nm + @ 7 1
      ! 7 + nm 1
      = r asve k a w lb tb vx st
      = l @ @ 52
      ! + @ 52 + 1 l nm
      ! @ 52 + l 1
      ? @ 53 { avmov + lb l r asfr st tb r } 0 }
    asve k a w lb tb vx st }
    { ! 7 b asve k a w lb tb vx st } }
: asum i>i p {
  = d @ + p 1
  = n @ + p 2
  = k @ + p 3
  = a @ + p 4
  = s7 @ 7
  = st A 1
  ! @ 54 0
  ! 53 0 ! st 15 asbody k a 2 2 4 0 st
  ! 53 1
  agT 14 n
  aimm 9 0
  afmovxd 0 31 aimm 10 0x3FF0000000000000 afmovxd 24 10 x4 0x6E180700
  aimm 10 0x4000000000000000 x4 | | 0x4E080C00 << 10 5 24
  vfbin 2 '+ 16 0 24
  aimm 10 0x4010000000000000 x4 | | 0x4E080C00 << 10 5 24
  x4 0x6F00E401 x4 0x6F00E411
  = l0 @ 16
  aaddi 10 9 4 acmp 10 14 = pe @ 16 abcc 0xC 0
  ! st 15 = r asbody k a 2 2 4 0 st vfbin 2 '+ 1 1 r
  ! st 15 = r asbody k a 2 18 20 16 st vfbin 2 '+ 17 17 r
  vfbin 2 '+ 0 0 24 vfbin 2 '+ 16 16 24
  aaddi 9 9 4 ab - l0 @ 16
  apbc pe 0xC
  vfbin 2 '+ 1 1 17 x4 0x7E70D821
  = l1 @ 16
  acmp 9 14 = pt @ 16 abcc 0xA 0
  ascvtf 0 9
  ! st 15 = r asbody k a 1 2 4 0 st afadd 1 1 r
  aaddi 9 9 1 ab - l1 @ 16
  apbc pt 0xA
  asTf 1 d
  ! 7 s7
  0 }

# --- pilha de ciclos (nested W): @63 = array; [0] = profundidade; cada moldura = (inicio, pos_do_cbz) ---
: adep >i @ @ 63
: afrm i>i i + @ 63 + 1 * i 2
: a21 >i { = d adep = f afrm d ! f @ 16 ! + f 1 0 ! @ 63 + d 1 }
: a22 i>i a { = x ? >= @ 49 0 0 aox 9 a = f afrm - adep 1 ! + f 1 @ 16 abr x }
: a23 >i { = f afrm - adep 1 ab - @ f @ 16 = cp @ + f 1 ap19 cp ! @ 63 - adep 1 }

# tabela de chamadas: @64[0] = n; cada par (posicao do bl no buffer, indice da funcao alvo). Corrigida no outa.
: acsrec ii>i pos fi { = c @ @ 64 = b + @ 64 + 1 * c 2 ! b pos ! + b 1 fi ! @ 64 + c 1 }
# despacho de syscall em linha (Y a b c): a=numero logico, b/c=args; resultado em d. 0=escrever, 2=sair,
# 7=brk (devolve o limite fixo de M). svc #0 x8 no Linux (-a); svc #0x80 x16 no macOS (-m). Escreve byte a
# byte (o byte vai para M[-8]) -- simples e correto; o benchmark usa o codigo de saida, nao a impressao.
: arb >i 33553408
: asc >i {
  = wn ? ismo 4 64
  = rn2 ? ismo 3 63
  = en ? ismo 1 93
  = nr ? ismo 16 8
  acmpi 0 0 = jw @ 16 abcc 0 0
  acmpi 0 1 = jr @ 16 abcc 0 0
  acmpi 0 2 = je @ 16 abcc 0 0
  acmpi 0 7 = jk @ 16 abcc 0 0
  acmpi 0 3 = ja @ 16 abcc 0 0
  acmpi 0 4 = jv @ 16 abcc 0 0
  acmpi 0 6 = jt @ 16 abcc 0 0
  aimm 0 0 = jd1 @ 16 ab 0
  # escrever(fd 1, M[arg1..], arg2): cada char ocupa um slot; junta-os em blocos de ate 4096 bytes na pilha
  apbc jw 0
  amovr 3 1 amovr 4 2 aimm 5 0
  asubsp 4096
  = wo @ 16
  acmp 5 4 = pwe @ 16 abcc 0xA 0
  aimm 6 0
  = wi @ 16
  aimm 10 4096 acmp 6 10 = pf1 @ 16 abcc 0xA 0
  acmp 5 4 = pf2 @ 16 abcc 0xA 0
  aadd 10 3 5 aldrx 11 28 10 x4 0x38266BEB
  aaddi 6 6 1 aaddi 5 5 1 ab - wi @ 16
  apbc pf1 0xA apbc pf2 0xA
  aimm 0 1 aaddi 1 31 0 amovr 2 6 aimm nr wn ? ismo asvc80 x4 0xD4000001
  ab - wo @ 16
  apbc pwe 0xA
  aaddsp 4096
  amovr 0 4 = jd2 @ 16 ab 0
  # ler 1 byte de fd 0: buffer de 4096 bytes no fim de M (slot arb); posicao/comprimento em M[-13]/M[-14]
  apbc jr 0
  aimm 10 -13 aldrx 11 28 10 aimm 10 -14 aldrx 12 28 10
  acmp 11 12 = rh @ 16 abcc 0xB 0
  aimm 0 0 aimm 10 arb aaddlsl 1 28 10 3 aimm 2 4096 aimm nr rn2 ? ismo asvc80 x4 0xD4000001
  acmpi 0 0 = rz @ 16 abcc 0xD 0
  aimm 10 -14 astrx 0 28 10 aimm 11 0
  apbc rh 0xB
  aimm 10 arb aaddlsl 12 28 10 3 x4 0x386B6980
  aaddi 11 11 1 aimm 10 -13 astrx 11 28 10
  = jd4 @ 16 ab 0
  apbc rz 0xD
  aimm 0 -1 = jd5 @ 16 ab 0
  # sair(arg1)
  xput4 je | | 0x54000000 << & / - @ 16 je 4 0x7FFFF 5 0
  amovr 0 1 aimm nr en ? ismo asvc80 x4 0xD4000001
  # brk: devolve o limite fixo (M = 256 MiB = 33554432 slots, menos 1024 no fim: o buffer de leitura)
  xput4 jk | | 0x54000000 << & / - @ 16 jk 4 0x7FFFF 5 0
  aimm 0 arb = jd3 @ 16 ab 0
  # argc (guardado no arranque em M[-9])
  apbc ja 0
  aimm 10 -9 aldrx 0 28 10 = jd6 @ 16 ab 0
  # Av i j: byte j do argumento i (0 fora dos limites ou depois do fim); argv em M[-10]
  apbc jv 0
  aimm 0 0 aimm 10 -9 aldrx 11 28 10
  acmpi 1 0 = v1 @ 16 abcc 0xB 0
  acmp 1 11 = v2 @ 16 abcc 0xA 0
  acmpi 2 0 = v3 @ 16 abcc 0xB 0
  aimm 10 -10 aldrx 11 28 10 aldrx 11 11 1
  aimm 10 0
  = vl @ 16
  acmp 10 2 = v4 @ 16 abcc 0xA 0
  x4 0x386A696C = v5 @ 16 x4 0xB400000C
  aaddi 10 10 1 ab - vl @ 16
  apbc v4 0xA
  x4 0x38626960
  apbc v1 0xB apbc v2 0xA apbc v3 0xB xput4 v5 | | 0xB4000000 << & / - @ 16 v5 4 0x7FFFF 5 12
  = jd7 @ 16 ab 0
  # T: microssegundos (gettimeofday: 116 no macOS, 169 no Linux) -> struct em M[-12..-11]
  apbc jt 0
  aimm 10 -12 aaddlsl 0 28 10 3 aimm 1 0 aimm 2 0
  ? ismo { aimm 16 116 asvc80 } { aimm 8 169 x4 0xD4000001 }
  aimm 10 -12 aldrx 11 28 10 aimm 10 -11 aldrx 12 28 10 x4 0x2A0C03EC
  aimm 10 1000000 amul 11 11 10 aadd 0 11 12
  = jd8 @ 16 ab 0
  # done:
  xput4 jd1 | 0x14000000 & / - @ 16 jd1 4 0x3FFFFFF
  xput4 jd2 | 0x14000000 & / - @ 16 jd2 4 0x3FFFFFF
  xput4 jd3 | 0x14000000 & / - @ 16 jd3 4 0x3FFFFFF
  xput4 jd4 | 0x14000000 & / - @ 16 jd4 4 0x3FFFFFF
  xput4 jd5 | 0x14000000 & / - @ 16 jd5 4 0x3FFFFFF
  apb jd6 apb jd7 apb jd8
  0 }
: ains i>i p {
  = k @ p
  = d @ + p 1
  = a @ + p 2
  = b @ + p 3
  = c @ + p 4
  ? == k 1 { ? tty d { aimm 9 afbits a = r adf 0 d afmovxd r 9 afd r d } { = r adx 9 d aimm r tokval a afx r d } }
  ? == k 2 { = r adx 9 d aimm r a afx r d }
  ? == k 4 { ? tty d { = r adf 0 d afmovxd r 31 afd r d } { = r adx 9 d aimm r 0 afx r d } }
  ? == k 5 amvv d + @ 11 b
  ? == k 6 amvv + @ 11 c b
  ? == k 8 { = o opof a ? tty d
    { = ii / - p @ 18 8
      = m @ + @ 51 ii
      ? == m -2 0
      ? >= m 0 {
        = q + @ 18 * m 8
        = mt @ + q 1
        = ad ? == c mt b c
        = x aod 0 @ + q 3 = y aod 1 @ + q 4 = z aod 2 ad = r adf 0 d
        x4 | | | | ? == o '+ 0x1F400000 ? == ad c 0x1F608000 0x1F408000 << y 16 << z 10 << x 5 r
        afd r d }
      { = x aod 0 b = y aod 1 c = r adf 0 d
      ? == o '+ afadd r x y ? == o '- afsub r x y ? == o '* afmul r x y ? == o '/ afdiv r x y { ebeg "operador real ainda nao em -a" eend } afd r d } }
    { = x aox 9 b = y aox 10 c = r adx 9 d
      ? == o '+ aadd r x y ? == o '- asub r x y ? == o '* amul r x y ? == o '/ asdiv r x y
      ? == o '% { asdiv 11 x y amsub r 11 y x } ? == o '& aand r x y ? == o '| aorr r x y
      ? == o '^ aeor r x y ? == o k2 '< '< alsl r x y ? == o k2 '> '> aasr r x y
      { ebeg "operador ainda nao em -a" eend } afx r d } }
  ? == k 9 { = z afz p ? tty b { = x aod 0 b = y aod 1 c afcmp x y ? z ! 49 afcc opof a { = r adx 9 d acset r ^ afcc opof a 1 afx r d } } { = x aox 9 b = y aox 10 c acmp x y ? z ! 49 acc opof a { = r adx 9 d acset r ^ acc opof a 1 afx r d } } }
  ? == k 15 { ? == a 0 { = x aox 9 b = r adf 0 d ascvtf r x afd r d } ? == a 1 { = x aod 0 b = r adx 9 d afcvtzs r x afx r d }
    ? == a 2 { agTf 0 b x4 0x1E61C000 asTf 0 d } ? == a 7 { agTf 0 b x4 0x1E654000 asTf 0 d } ? == a 8 { agTf 0 b x4 0x1E60C000 asTf 0 d }
    ? == a 11 { agT 9 b x4 0x9360FD29 asT 9 d } ? == a 12 { agT 9 b x4 0x2A0903E9 asT 9 d }
    ? || == a 3 == a 4 { agTf 0 b aimm 9 0x3FC45F306DC9C883 afmovxd 1 9 afmul 2 0 1 x4 0x1E644042
      aimm 9 0x401921FB54442D18 afmovxd 1 9 x4 0x1F418040 aimm 9 0x3CB1A62633145C07 afmovxd 1 9 x4 0x1F418040
      acallf fby ? == a 3 k3 '_ 's 'n k3 '_ 'c 's asTf 0 d }
    { ebeg "funcao matematica ainda nao em -a: " N a eend } }
  ? == k 43 { agT 9 a agT 10 b x4 0x2A0A03EA x4 0xD3607D29 aorr 9 9 10 asT 9 d }
  ? == k 44 { aimm 9 | << a 32 b asT 9 d }
  ? == k 45 0
  ? == k 3 { = q sreg a aimm 0 q aimm 1 slen a acallf aro 's }
  ? == k 21 a21
  ? == k 22 a22 a
  ? == k 23 a23
  ? == k 24 { = x aox 9 a = r adx 10 d aldrx r 28 x afx r d }
  ? == k 25 { = x aox 9 a = y aox 10 b astrx y 28 x }
  ? == k 26 { = x aox 9 a = r adf 0 d aldrdx r 28 x afd r d }
  ? == k 27 { = x aox 9 a = y aod 0 b astrdx y 28 x }
  ? == k 10 { aimm 9 0 asT 9 d = x aox 9 a = p @ 16 x4 | 0xB4000000 x aipush p }
  ? == k 11 { agT 9 a acmpi 9 0 acset 9 0 asT 9 d apcbz aipop }
  ? == k 12 { aimm 9 1 asT 9 d = x aox 9 a = p @ 16 x4 | 0xB5000000 x aipush p }
  ? == k 13 { agT 9 a acmpi 9 0 acset 9 0 asT 9 d apcbnz aipop }
  ? == k 14 { = x aox 9 a acmpi x 0 = r adx 9 d acset r 1 afx r d }
  ? == k 17 { ? tty b { agTf 0 b agTf 1 c afcmp 0 1 x4 | | 0x1E600C00 << 1 16 << ? a 0xC 0x4 12 asTf 0 d } { agT 9 b agT 10 c acmp 9 10 acsel 9 9 10 ? a 0xC 0xB asT 9 d } }
  ? == k 18 { = x ? >= @ 49 0 0 aox 9 a = p @ 16 abr x aipush p }
  ? == k 19 { astod d a = p @ 16 ab 0 apcbz aipop aipush p }
  ? == k 20 { astod d a apb aipop }
  ? == k 28 { agT 0 a acallf aro 'a asT 0 d }
  ? == k 29 { agT 0 a acallf aro 'p }
  ? == k 31 { agT 0 a acallf aro 'n }
  ? == k 32 { agTf 0 a acallf aro 'f }
  ? == k 33 { agT 9 a aimm 10 -2 astrx 9 28 10 }
  ? == k 36 { agT 0 a acallf fby k3 '_ 'e 'x }
  ? == k 30 { aimm 0 1 asc asT 0 d }
  ? == k 34 { aimm 0 3 asc asT 0 d }
  ? == k 35 { agT 1 a agT 2 b aimm 0 4 asc asT 0 d }
  ? == k 37 { aimm 0 6 asc asT 0 d }
  ? == k 42 { agT 0 a agT 1 b agT 2 c asc asT 0 d }
  ? == k 7 {
    = xc 0 = dc 0 = j 0
    W < j c { = arg @ + b j ? fpt a j { agTf dc arg = dc + dc 1 } { agT xc arg = xc + xc 1 } = j + j 1 }
    acsrec @ 16 a
    abl 0
    ? @ fe a 3 { asTf 0 d } { asT 0 d } }
  ? == k 53 amap p
  ? == k 54 asum p
  ? == k 41 { ? tty a { agTf 0 a } { agT 0 a } arest aaddsp afs aepil aret }
  { ebeg "operacao ainda nao suportada em -a (kind " N k ")" eend } }
: afun i>i k {
  = np @ fe k 2
  ? > np 8 { ebeg "mais de 8 parametros ainda nao em -a" eend } 0
  # invariantes fora dos ciclos (a mesma passagem de RI do x86) e depois os registos
  xlicm
  ara k
  O 16
  ! fe k 8 @ 16
  aprol asubsp afs asave
  = xc 0
  = dc 0
  = j 0
  W < j np { ? fpt k j { asLf dc j = dc + dc 1 } { asL xc j = xc + xc 1 } = j + j 1 }
  = j 0
  W < j @ 19 { ains + @ 18 * j 8 = j + j 1 }
  ! fe k 9 @ 16
  O 0 }
: amain >i { = k 0 = r -1 W < k @ 6 { ? ismain k = r k 0 = k + k 1 } r }
# --- Mach-O (-m): o MESMO codigo-maquina do -a, mas num executavel nativo do Mac (Apple Silicon). M vem de um
# mmap no arranque (sem segmento fixo). Syscalls do macOS: numero em x16, svc #0x80 (write 4, exit 1, mmap 197).
: ismo >i && == Av 1 0 '- == Av 1 1 'm
: amovr ii>i rd rn x4 | | 0xAA0003E0 << rn 16 rd
: asvc80 >i x4 0xD4001001
: az i>i n { = j 0 W < j n { P 0 = j + j 1 } 0 }
# arranque comum (depois de x28 = base de M): guarda argc/argv (x21/x22) em M[-9]/M[-10], poe o ponteiro de
# alocacao M[-1] a seguir as strings (@20, como o x86) e copia o bloco de dados (as strings, M[64..@20)) que vai
# no fim do codigo para M. O endereco do bloco e relativo ao pc (bl +4 -> x30), logo vale em qualquer endereco.
# Devolve a posicao do aimm a corrigir com (inicio do bloco - posicao do mov x9,x30).
: apimm iii>i p rd v {
  xput4 p | | 0xD2800000 << & v 0xffff 5 rd
  xput4 + p 4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd
  xput4 + p 8 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd
  xput4 + p 12 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd }
: ainit >i {
  aimm 10 -9 astrx 21 28 10
  aimm 10 -10 astrx 22 28 10
  aimm 9 @ 20 aimm 10 -1 astrx 9 28 10
  abl 4
  amovr 9 30
  = dp @ 16
  aimm4 10 0
  aadd 9 9 10
  aimm 10 512 aadd 10 28 10
  aimm 11 - @ 20 64
  = l @ 16
  = pc @ 16 x4 0xB400000B
  x4 0xF840852C x4 0xF800854C x4 0xD100056B
  ab - l @ 16
  xput4 pc | 0xB400000B << & / - @ 16 pc 4 0x7FFFF 5
  dp }
# bloco de dados: as strings registadas (sreg), cada uma em palavras de 8 bytes, pela ordem dos enderecos
: adata >i { = j 0 W < j @ 22 { wchr @ + @ 21 * j 2 = j + j 1 } 0 }
: aftot >i { = t 0 = k 0 W < k @ 6 { = t + t - @ fe k 9 @ fe k 8 = k + k 1 } t }
# corrige o bl da entrada para _go e os bl entre funcoes (@64; posicoes no buffer 16, contiguas na saida)
: abls iii>i estart elen blp {
  = mi fby k3 '_ 'g 'o
  = moff elen
  = k 0 W < k mi { = moff + moff - @ fe k 9 @ fe k 8 = k + k 1 }
  xput4 blp | 0x94000000 & / - moff - blp estart 4 0x3FFFFFF
  = nc @ @ 64
  = c 0
  W < c nc { = pos @ + @ 64 + 1 * c 2 = fi @ + @ 64 + 2 * c 2 xput4 pos | 0x94000000 & / - @ fe fi 8 pos 4 0x3FFFFFF = c + c 1 }
  0 }
# entrada -m: argc/argv (x0/x1 do _main) -> x21/x22; mmap M -> x28; arranque comum; bl _go; exit(x0)
: aentm >i {
  amovr 21 0 amovr 22 1
  aimm 0 0 aimm 1 268435456 aimm 2 3 aimm 3 4098 aimm 4 -1 aimm 5 0 aimm 16 197 asvc80
  amovr 28 0 aaddi 28 28 128 aimm 27 0
  = dp ainit
  abl 0
  aimm4 16 1 asvc80
  dp }
# -m emite um OBJETO Mach-O (MH_OBJECT) com o MESMO codigo-maquina do -a (entrada mmap + funcoes + dados), e um
# simbolo _main na entrada. O clang linka-o num executavel valido do Mac: `clang prog.o -o prog` -- a validacao
# estrita, a assinatura e o __LINKEDIT ficam a cargo da toolchain do sistema; o codigo e todo escrito pela Onda.
: outm >i {
  O 16
  = estart @ 16
  = dp aentm
  = elen - @ 16 estart
  O 0
  abls estart elen - + estart elen 24
  = ft aftot
  apimm dp 10 - + elen ft - - dp 4 estart
  = clen + + elen ft * 8 - @ 20 64
  = coff 232
  = so + coff clen
  = sto + so 16
  # cabecalho (32): magic, arm64, subtype 0, filetype 1 (OBJECT), ncmds 3, sizeofcmds 200
  x4 0xFEEDFACF x4 0x0100000C x4 0 x4 1 x4 3 x4 200 x4 0 x4 0
  # LC_SEGMENT_64 (72) sem nome + 1 seccao __text,__TEXT (80)
  x4 0x19 x4 152 az 16
  x8 0 x8 clen x8 coff x8 clen x4 7 x4 7 x4 1 x4 0
  P '_ P '_ P 't P 'e P 'x P 't az 10 P '_ P '_ P 'T P 'E P 'X P 'T az 10
  x8 0 x8 clen x4 coff x4 2 x4 0 x4 0 x4 0x80000400 x4 0 x4 0 x4 0
  # LC_SYMTAB (24): symoff, nsyms 1, stroff, strsize 7
  x4 2 x4 24 x4 so x4 1 x4 sto x4 7
  # LC_BUILD_VERSION (24): macOS, minos 11.0, sdk 11.0, sem ferramentas (o ld deixa de avisar)
  x4 0x32 x4 24 x4 1 x4 0x000B0000 x4 0x000B0000 x4 0
  # codigo: entrada + corpo de cada funcao + dados
  ew estart elen
  = k 0 W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  adata
  # simbolo _main (externo, seccao 1, valor 0) + tabela de strings "\0_main\0"
  x4 1 P 15 P 1 P 0 P 0 x8 0
  P 0 P '_ P 'm P 'a P 'i P 'n P 0
  0 }
: outa >i {
  = base 4194304
  = mbase 268435456
  # entrada (ELF Linux): argc em [sp], argv em sp+8; x28 = base de M + 128 (16 slots negativos p/ o runtime)
  O 16
  = estart @ 16
  ald 21 0 aaddi 22 31 8
  aimm 28 + mbase 128
  aimm 27 0
  = dp ainit
  = blp @ 16 abl 0
  x4 | | 0xD2800000 << 93 5 8
  x4 0xD4000001
  = elen - @ 16 estart
  O 0
  abls estart elen blp
  = ft aftot
  apimm dp 10 - + elen ft - - dp 4 estart
  = clen + + elen ft * 8 - @ 20 64
  # 2 cabecalhos de programa (2*56) a seguir ao cabecalho ELF (64) -> codigo no byte 176
  = fsz + 176 clen
  # cabecalho ELF (64 bytes): aarch64, ET_EXEC, 2 segmentos, entry = base+176
  P 127 P 'E P 'L P 'F P 2 P 1 P 1 P 0 x8 0
  wword 2 2 wword 183 2 x4 1 x8 + base 176
  x8 64 x8 0 x4 0
  x4 | 64 << 56 16 x4 2 x4 0
  # segmento 1 (56 bytes): PT_LOAD RX -- cabecalhos + codigo + dados
  x4 1 x4 5 x8 0 x8 base x8 base x8 fsz x8 fsz x8 4096
  # segmento 2 (56 bytes): PT_LOAD RW -- M (heap), BSS puro (filesz 0, memsz 256 MiB) em mbase
  x4 1 x4 6 x8 0 x8 mbase x8 mbase x8 0 x8 mbase x8 4096
  ew estart elen
  = k 0
  W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  adata
  0 }
