# Conselheiro em Onda — publicar (o publicar.mjs): valida a análise escrita pelo Claude e grava-a no KV.
#   correr.mjs publicar /tmp/conselheiro/analise.json [/tmp/conselheiro/dados.json]
# Grava advice:<data>, advice:latest e advice:lessons (formato 2: um veredicto por ativo do dados.json, convicção
# 0–100 por prazo, níveis, o porquê, e a classificação por prazo). Os erros saem todos, pela ordem do JS.


# new Map(lista.map((r) => [r.s, r])): as chaves (SameValueZero) e os valores, pela ordem da 1.ª vez
: pu_mapa i>i l {
  Se ~ _js_ehlst l cs_lanca $"TypeError" $"(dados.rows || []).map is not a function"
  = ks _js_lst _js_len l = vs _js_lst _js_len l = j 0
  W < j _js_len l {
    = r _js_it l j = s cs_getx r $"s"
    = i -1 = m 0 W && < i 0 < m _js_len ks { Se _js_svz _js_it ks m s = i m = m + m 1 }
    ? < i 0 { _js_push ks s _js_push vs r 0 } { ! + @ + vs 3 i r 0 }
    = j + j 1 }
  = mp _js_lst 2 _js_push mp ks _js_push mp vs }
: pu_mget ii>i mp s { = ks _js_it mp 0 = i -1 = m 0 W && < i 0 < m _js_len ks { Se _js_svz _js_it ks m s = i m = m + m 1 } ? < i 0 1 _js_it _js_it mp 1 i }
: pu_mtem ii>i mp s != pu_mget mp s 1
# o FAM[k] (k: o ToPropertyKey) ou undefined (1)
: pu_fam i>i k { = v _js_oget cs_c $"FAM" _js_str k v }
# um campo de lista com o índice: `${nome}[${i}]${resto}`
: pu_ni iii>i nome i resto { _an_abre 0 crut nome P '[ N i P '] Se resto crut resto _an_fecha }
: pu_lista ii>i a k { = v _js_get a k ? _js_ehlst v v _js_lst 0 }
# buildAdvice(a, dados, uniRows): o out (g_res) e os erros (g_errs)
: pu_build iii>i a dados uni {
  ? || ~ _js_v a ~ || _js_ehobj a _js_ehlst a {
      `{ cs_eini }a análise tem de ser um objeto JSON{ cs_efim }` 0 } {
  = drows cs_getx dados $"rows"
  = rows pu_mapa ? _js_v drows drows _js_lst 0
  = ul ? _js_v uni uni _js_lst 0 Se ~ _js_ehlst ul cs_lanca $"TypeError" $"(uniRows || []).map is not a function"
  = un pu_mapa ul
  = o _js_obj 16
  _js_oset o $"v" _js_num 2.
  _js_oset o $"date" cs_hoje
  _js_oset o $"generatedAt" cs_iso
  _js_oset o $"headline" cs_str _js_get a $"headline" 160 $"headline" 1
  _js_oset o $"market" cs_str _js_get a $"market" 1400 $"market" 1
  _js_oset o $"planNote" cs_str _js_get a $"planNote" 160 $"planNote" 0
  = pl pu_lista a $"plan" = n Mn 6 _js_len pl = l _js_lst n L j n {
    = x _js_it pl j = e _js_obj 4
    _js_oset e $"s" cs_str cs_getx x $"s" 24 pu_ni $"plan" j $".s" 1
    _js_oset e $"name" cs_str _js_get x $"name" 60 pu_ni $"plan" j $".name" 0
    _js_oset e $"amount" cs_str _js_get x $"amount" 30 pu_ni $"plan" j $".amount" 1
    _js_oset e $"why" cs_str _js_get x $"why" 220 pu_ni $"plan" j $".why" 0
    _js_push l e }
  _js_oset o $"plan" l
  = acts _js_lst 64 _js_oset o $"actions" acts
  = rank _js_obj 3 _js_oset o $"rank" rank
  = rk pu_lista a $"risks" = n Mn 6 _js_len rk = l _js_lst n L j n _js_push l cs_str _js_it rk j 240 pu_ni $"risks" j 0 1
  _js_oset o $"risks" l
  = tl pu_lista a $"tldr" = n Mn 3 _js_len tl = ltl _js_lst n L j n _js_push ltl cs_str _js_it tl j 120 pu_ni $"tldr" j 0 1
  _js_oset o $"tldr" ltl
  = mv pu_lista a $"movers" = n Mn 10 _js_len mv = l _js_lst n L j n {
    = x _js_it mv j = e _js_obj 2
    _js_oset e $"s" cs_str cs_getx x $"s" 24 pu_ni $"movers" j $".s" 1
    _js_oset e $"why" cs_str _js_get x $"why" 260 pu_ni $"movers" j $".why" 1
    _js_push l e }
  _js_oset o $"movers" l
  _js_oset o $"review" cs_str _js_get a $"review" 1400 $"review" 0
  = le pu_lista a $"lessons" = n Mn 15 _js_len le = lle _js_lst n L j n _js_push lle cs_str _js_it le j 240 pu_ni $"lessons" j 0 1
  _js_oset o $"lessons" lle
  Se == _js_len _js_oget o $"plan" 0 `{ cs_eini }plan vazio: diz sempre o que fazer com o plano do mês{ cs_efim }`
  Se == _js_len ltl 0 `{ cs_eini }tldr vazio: escreve o resumo em 3 linhas curtas (mercado · hoje · atenção){ cs_efim }`
  # um veredicto por ativo
  = av _js_get a $"actions" = list ? _js_ehlst av av _js_lst 0
  Se ~ _js_ehlst av `{ cs_eini }actions tem de ser a lista dos veredictos (um por ativo){ cs_efim }`
  = seen _js_lst 64 = j 0
  W < j _js_len list {
    = x _js_it list j
    = s ? _js_v x _js_get x $"s" x = r pu_mget rows s
    `{ _an_abre 0 }actions[{ N j }] { ? _js_v s _js_ps s P '? }` = p _an_fecha
    ? && == r 1 ~ pu_mtem un s { `{ cs_eini }{ crut p }: ativo desconhecido (não está no dados.json nem na lista da TR){ cs_efim }` } {
      ? _js_inc seen s { `{ cs_eini }{ crut p }: repetido{ cs_efim }` } {
        _js_push seen s
        = ref && != r 1 _js_eht _js_get r $"kind" $"ref"
        = v pu_norm x p ref ? != r 1 _js_get r $"price" 2
        # o que as notícias dizem do ativo, lidas pelo Claude (0–100), o catalisador e o que faria a decisão estar errada
        = nw _js_get x $"news"
        Se ~ cs_vazio nw {
            = nt _js_tonum nw
            ? || || || == _js_tipo nw 3 == _js_tipo nw 4 ~ fin nt || < nt 0. > nt 100. {
                `{ cs_eini }{ crut p }.news: o tom das notícias é de 0 a 100 (veio { _js_pj nw 0 0 }){ cs_efim }` }
              { _js_oset v $"news" _js_num _nu_round nt 0 } }
        = ct cs_str _js_get x $"cat" 90 cs_pc2 p $"cat" 0
        = rs cs_str _js_get x $"risk" 140 cs_pc2 p $"risk" 0
        Se ~ _tx_branco ct _js_oset v $"cat" ct
        Se ~ _tx_branco rs _js_oset v $"risk" rs
        = vk _js_get v $"key"
        = fk 0 Se _js_ehtxt vk { = fv _js_oget cs_c $"FAM" vk Se != fv 1 = fk I _js_f fv }
        Se && && ~ ref fk _tx_branco rs
            `{ cs_eini }{ crut p }: mandas { ? > fk 0 "entrar" "sair" } ({ _js_ps _js_get v $"action" }): diz em risk o que faria esta decisão estar errada (até 140 caracteres){ cs_efim }`
        # a segunda opinião: a regra automática e a média das outras fontes (fontes.fam do dados.json)
        = ru ? != r 1 _js_get r $"rule" 1
        = cr && && != r 1 _js_v ru && != pu_fam ru 1 != pu_fam vk 1
        = ft ? != r 1 _js_get r $"fontes" 1
        = fo 0 Se _js_ehobj ft { = fm _js_oget ft $"fam" Se _js_ehnum fm = fo ? == _js_f fm 1. 1 ? == _js_f fm -1. -1 0 }
        Se || cr && fo fk {
            Se cr _js_oset v $"alg" ru
            `{ _an_abre 0 }{ crut p }.algWhy` = nm _an_fecha
            = w cs_str _js_get x $"algWhy" 300 nm 0
            ? && && cr ~ _js_eq pu_fam vk pu_fam ru _tx_branco w {
                = ra _js_get r $"ruleAction" = ra ? _js_v ra ra cs_alabel _js_str ru
                `{ cs_eini }{ crut p }: o teu veredicto ({ _js_ps _js_get v $"action" }) discorda do sinal automático ({ _js_ps ra }): explica porquê em algWhy (até 300 caracteres){ cs_efim }` }
              { Se && && fo == fk - 0 fo _tx_branco w
                  `{ cs_eini }{ crut p }: o teu veredicto ({ _js_ps _js_get v $"action" }) é o contrário da média das outras fontes ({ ? > fo 0 "entrar" "sair" }): explica porquê em algWhy (até 300 caracteres){ cs_efim }` }
            Se ~ _tx_branco w _js_oset v $"algWhy" w }
        # o que mudou: desde quando mantém esta família de veredicto e o que dizia antes (o prev do dados.json)
        = pv ? != r 1 _js_get r $"prev" 1
        = pv ? && _js_ehobj pv _js_ehtxt _js_oget pv $"key" pv 0
        = hoje _js_oget o $"date"
        ? && pv cs_mfam _js_oget pv $"key" vk {
            = d _js_oget pv $"since" = d2 _js_oget pv $"date"
            = d ? && _js_ehtxt d > _tx_len d 0 d ? && _js_ehtxt d2 > _tx_len d2 0 d2 hoje
            = wa _js_oget pv $"was" Se && _js_ehtxt wa > _tx_len wa 0 _js_oset v $"was" wa
            _js_oset v $"since" d 0 }
          { Se pv _js_oset v $"was" _js_oget pv $"key" _js_oset v $"since" hoje 0 }
        _js_push acts v 0 } }
    = j + j 1 }
  = ex 0 = j 0 W < j _js_len acts { Se ~ pu_mtem rows _js_get _js_it acts j $"s" = ex + ex 1 = j + j 1 }
  Se > ex 8 `{ cs_eini }no máximo 8 ativos de fora das listas da app; vieram { N ex }{ cs_efim }`
  = rk0 _js_it rows 0 = mi _js_lst 8 = j 0 W < j _js_len rk0 { = s _js_it rk0 j Se ~ _js_inc seen s _js_push mi s = j + j 1 }
  Se _js_len mi {
      `{ cs_eini }faltam { N _js_len mi } ativos em actions (a app mostra o veredicto em todos): ` = j 0 W < j _js_len mi { Se j ", " _js_ps _js_it mi j = j + j 1 } cs_efim }
  # a classificação do Claude por prazo: só o que se compra
  = inv _js_lst 64 = j 0
  W < j _js_len acts {
    = x _js_it acts j = r pu_mget rows _js_get x $"s"
    Se && ~ _js_inc cs_c $"REF_KEYS" _js_get x $"key" ~ && != r 1 _js_eht _js_get r $"kind" $"ref" _js_push inv x
    = j + j 1 }
  = ra _js_get a $"rank" = rr ? && _js_v ra || _js_ehobj ra _js_ehlst ra ra _js_obj 0
  = hz cs_c $"HZ" L i 3 {
    = h _js_it hz i = gv _js_get rr h
    ? || _js_nulo gv && _js_ehlst gv == _js_len gv 0 {
        = f _js_lst 16 = j 0 W < j _js_len inv { = x _js_it inv j Se _js_fin _js_get x h _js_push f x = j + j 1 }
        ! g_cmph h cs_ordena f 40
        = l _js_lst 10 = j 0 W < j Mn 10 _js_len f { _js_push l _js_get _js_it f j $"s" = j + j 1 }
        _js_oset rank h l 0 } {
      ? ~ _js_ehlst gv { `{ cs_eini }rank.{ crut h } tem de ser uma lista de símbolos{ cs_efim }` } {
        = l _js_lst 15 = pv 0 = j 0
        W < j Mn 15 _js_len gv {
          = s _js_it gv j
          = x 0 = m 0 W && ~ x < m _js_len inv { Se _js_eq _js_get _js_it inv m $"s" s = x _js_it inv m = m + m 1 }
          ? ~ x { `{ cs_eini }rank.{ crut h }{ P '[ }{ N j }]: { _js_ps s } não está em actions (ou é referência){ cs_efim }` } {
            ? _js_inc l s { `{ cs_eini }rank.{ crut h }: { _js_ps s } repetido{ cs_efim }` } {
              Se && && pv _js_fin _js_get x h && _js_fin _js_get pv h > _js_f _js_get x h _js_f _js_get pv h {
                  `{ cs_eini }rank.{ crut h }: { _js_ps s } ({ _js_ps _js_get x h }) atrás de { _js_ps _js_get pv $"s" } ({ _js_ps _js_get pv h }): ordena pela convicção ou ajusta-a{ cs_efim }` }
              _js_push l s = pv x 0 } }
          = j + j 1 }
        _js_oset rank h l 0 } } }
  # os preços no momento do conselho (em euros; a referência na sua unidade)
  = pr _js_obj 64 = dl ? _js_v drows drows _js_lst 0 = j 0
  W < j _js_len dl {
    = r _js_it dl j = pe _js_get r $"priceEur" = p ? _js_nulo pe _js_get r $"price" pe
    Se _js_fin p _js_oset pr _js_str _js_get r $"s" p
    = j + j 1 }
  _js_oset o $"prices" pr
  ! g_res o 0 } }
# normVerdict com as opções do publicar (scores 'req', plan)
: pu_norm iiii>i x p ref price cs_norm x p ref price 1 1
# o comparador do auto-rank (cs_cmp 40): y[h] - x[h]
: pu_cmp iii>f k x y - _js_tonum _js_get y @ g_cmph _js_tonum _js_get x @ g_cmph
: pu_corre >i {
  ! g_scr 5
  = f _an_arg 1
  Se || ~ f == _tx_len f 0 `{ _an_fd 2 }uso: publicar.mjs analise.json [dados.json]{ P 10 }{ _an_volta }{ _an_sair 2 }`
  = df _an_arg 2 = df ? df df $"/tmp/conselheiro/dados.json"
  = a cs_lejson f
  = dados cs_lejson df
  = uf cs_junta cs_dirname df $"universo.json"
  = ur ? _an_existe uf { = u cs_lejson uf = r cs_getx u $"rows" ? _js_v r r _js_lst 0 } _js_lst 0
  ! g_res 0
  pu_build a dados ur
  = e @ g_errs
  Se _js_len e { `{ _an_fd 2 }Análise inválida ({ N _js_len e }):\n- ` = j 0 W < j _js_len e { Se j "\n- " _tx_pu _js_it e j = j + j 1 } P 10 _an_volta _an_sair 1 }
  ! g_pout @ g_res
  `{ _an_abre 0 }advice:{ crut _js_oget @ g_res $"date" }` ! g_pk _an_fecha
  ! g_ph 1
  ? cs_kvput @ g_pk @ g_pout 0 cs_passo }
: pu_passo >i { = p @ g_ph ? == p 1 pu_p1 ? == p 2 pu_p2 ? == p 3 pu_p3 0 }
: pu_p1 >i { cs_rkvput @ g_pk cs_lancase ! g_ph 2 ~ cs_kvput $"advice:latest" @ g_pout }
: pu_p2 >i { cs_rkvput $"advice:latest" cs_lancase ! g_ph 3 ~ cs_kvput $"advice:lessons" _js_oget @ g_pout $"lessons" }
: pu_p3 >i {
  cs_rkvput $"advice:lessons" cs_lancase
  = o @ g_pout
  `Publicado advice:{ crut _js_oget o $"date" } ({ N _js_len _js_oget o $"actions" } ativos, { N _js_len _js_oget o $"plan" } linhas de plano, `
  `{ N _js_len _js_oget o $"lessons" } lições; mais fortes a médio prazo: `
  = m _js_oget _js_oget o $"rank" $"mid" = j 0 W < j Mn 3 _js_len m { Se j ", " _js_pu _js_it m j = j + j 1 } ")." P 10
  _an_sair 0 }
