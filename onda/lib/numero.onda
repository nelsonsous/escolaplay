      ? >= e 0 { _nu_bp10 b e _nu_b2f b 0 0 } {
        = k - 0 e
        = s + - + 64 I * F k 3.321928094887362 _nu_bbits b 0
        = s ? < s 0 0 s
        _nu_bshl b s
        = st _nu_bd10k b k
        _nu_b2f b s st } } }
# um inteiro n >= 0 × 10^k (o caminho rápido só com n < 2^53: o F n é então exato)
: _nu_i2f ii>f n k {
