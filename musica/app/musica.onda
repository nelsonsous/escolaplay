# ===== utilitarios =====
: abre >i { = t tnovo 400 O t t }
: kdef ii>i i t { ! + @ 0 i t 0 }
: jg ii>i n k jget n k
: jgi ii>i n k I jnum jget n k
: jgt ii>i n k jtxt jget n k
: jprim i>i n ? n @ + n 4 0
: jprox i>i c @ + c 3
: pt i>i t thtml t
: pjt i>i n thtml jtxt n
: busca ii>i u f Y 102 u f
: tvazio i>i d { ! d + d 1 0 }
: tcopia iii>i d s mx { ! d + d 1 O d = n Mn tlen s mx = j 0 W < j n { P tbyte s j = j + j 1 } O 0 0 }
: hexd i>i h P ? < h 10 + 48 h + 87 h
: hexm i>i h P ? < h 10 + 48 h + 55 h
# o texto t como string JSON, com aspas e escapes
: pjs i>i t {
  P 34
  = n tlen t = j 0
  W < j n {
    = c tbyte t j
    ? || == c 34 == c 92 { P 92 P c 0 } ? < c 32 { P 92 P 'u P '0 P '0 hexd / c 16 hexd % c 16 0 } P c
    = j + j 1 }
  P 34 0 }
# o texto t codificado para um URL (percent-encoding)
: purl i>i t {
  = n tlen t = j 0
  W < j n {
    = c tbyte t j
    = ok || && >= c 'a <= c 'z && >= c 'A <= c 'Z
    = ok || ok && >= c '0 <= c '9
    = ok || ok || == c '- == c '_
    = ok || ok || == c '. == c '~
    ? ok P c { P '% hexm / c 16 hexm % c 16 0 }
    = j + j 1 }
  0 }
# "2026-11-07T..." -> 7/11
: dd ii>i t j + * - tbyte t j '0 10 - tbyte t + j 1 '0
: pdia i>i t ? >= tlen t 10 { N dd t 8 "/" N dd t 5 0 } 0
# segundos -> "25 min" ou "1 h 05 min"
: pmin i>i s ? >= s 3600 { N / s 3600 " h " = r / + % s 3600 30 60 ? < r 10 "0" 0 N r " min" 0 } { N Mx 1 / + s 30 60 " min" 0 }
: partistas i>i l { = c jprim l = s 0 W c { ? s ", " 0 pjt c = s 1 = c jprox c } 0 }

# ===== aviso (toast) =====
: aviso i>i t {
  = m marca
  = h tnovo + tlen t 80
  O h "<div class=\"mu-toast on\">" pt t "</div>" O 0
  Y 100 k_s_aviso h
  ? @ 29 Y 104 @ 29 0 0
  ! 29 Y 103 3800 k_c_fim
  solta m }
: fim_aviso i>i z { ? @ 29 Y 104 @ 29 0 0 ! 29 0 = h tnovo 4 Y 100 k_s_aviso h solta h }
: nada ii>i t s 0
: erro_ped ii>i t s {
  ? s {
    = r json t = mg jgt r k_message
    ? mg aviso mg { = a abre "Erro " N s " do conector." O 0 aviso a 0 } 0 }
    { = a abre "Sem ligação ao conector." O 0 aviso a 0 } }

# ===== estilos e arcos =====
: nome_estilo i>i e ? == e 0 "Equilibrado" ? == e 1 "Descoberta" ? == e 2 "Na moda" ? == e 3 "O meu gosto" "Audiófilo"
: estilo_json i>i e ? == e 0 "equilibrado" ? == e 1 "descoberta" ? == e 2 "moda" ? == e 3 "gosto" "audiofilo"
: idx_estilo i>i t ? tigual t k_v_descoberta 1 ? tigual t k_v_moda 2 ? tigual t k_gosto 3 ? tigual t k_v_audiofilo 4 0
: nome_arco i>i a ? == a 0 "Onda" ? == a 1 "Sobe" ? == a 2 "Acalma" "Sem arco"
: arco_json i>i a ? == a 0 "onda" ? == a 1 "sobe" ? == a 2 "desce" "plano"
: idx_arco i>i t ? tigual t k_v_sobe 1 ? tigual t k_v_desce 2 ? tigual t k_v_plano 3 0
: arco_val i>i a ? == a 0 1 ? == a 1 2 ? == a 2 3 0
: pporque i>i q ? == q 1 "o teu gosto" ? == q 2 "som" ? == q 3 "na moda" ? == q 4 "Claude" ? == q 5 "novidade" "fixada"
: porque_json i>i q ? == q 1 "gosto" ? == q 2 "qualidade" ? == q 3 "tendencia" ? == q 4 "claude" ? == q 5 "novidade" "fixa"
: cod_porque i>i t ? tigual t k_gosto 1 ? tigual t k_qualidade 2 ? tigual t k_tendencia 3 ? tigual t k_claude 4 ? tigual t k_novidade 5 ? tigual t k_fixa 6 0
# de dia (07h-20h, pela hora de Portugal no inverno; no verao difere uma hora) ou de noite
: e_dia >i { = h % / Y 108 0 0 3600000 24 && >= h 7 < h 20 }
: sugestao i>i q ? == q 0 "Faixas bem gravadas para testar o som do carro" ? == q 1 "Jazz para um domingo de manhã" ? == q 2 "O melhor de 2026 até agora, de vários géneros" ? == q 3 "Fado e música portuguesa nova" ? == q 4 "Soul e funk dos anos 70" ? == q 5 "Treino: energia sempre a subir" "Para conduzir à noite, calma e com graves"

# ===== estado da ligacao =====
: ligado >i { = e @ 3 ? e == jtipo jg e k_ligado 3 0 }
: acesso >i { = e @ 3 ? e ? jg e k_tu ligado 0 0 }

# ===== pedacos de HTML =====
# icones dos botoes (traco 24x24, na cor do texto): 1 ligar, 2 pedir, 3 enviar, 4 ouvir, 5 onda, 6 atualizar, 7 motor,
# 8 procurar, 9 apagar, 10 desligar, 11 esquecer, 12 juntar, 13 fixar, 14 tirar, 15 seguir, 16 guardar
: ic i>i n {
  "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">"
  ? == n 1 "<path d=\"M10 14a3.5 3.5 0 0 0 5 0l3.5-3.5a3.5 3.5 0 0 0-5-5L12 7\"/><path d=\"M14 10a3.5 3.5 0 0 0-5 0l-3.5 3.5a3.5 3.5 0 0 0 5 5L12 17\"/>"
  ? == n 2 "<path d=\"M12 3.5c.7 4.6 2.9 6.8 7.5 7.5-4.6.7-6.8 2.9-7.5 7.5-.7-4.6-2.9-6.8-7.5-7.5 4.6-.7 6.8-2.9 7.5-7.5z\"/>"
  ? == n 3 "<path d=\"M21 3 10.5 13.5\"/><path d=\"M21 3l-6.5 18-4-7.5L3 9.5z\"/>"
  ? == n 4 "<path d=\"M8 5.5v13l10.5-6.5z\" fill=\"currentColor\"/>"
  ? == n 5 "<path d=\"M2 12c2-5 4.5-5 6.5 0s4.5 5 6.5 0 4.5-5 6.5 0\"/>"
  ? == n 6 "<path d=\"M20 11a8 8 0 0 0-14-5l-2 2\"/><path d=\"M4 4v4h4\"/><path d=\"M4 13a8 8 0 0 0 14 5l2-2\"/><path d=\"M20 20v-4h-4\"/>"
  ? == n 7 "<path d=\"M13 2.5 4.5 13.5H11l-1 8 8.5-11H12z\"/>"
  ? == n 8 "<circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"m20 20-4.2-4.2\"/>"
  ? == n 9 "<path d=\"M4 7h16\"/><path d=\"M9 7V4.5h6V7\"/><path d=\"M6.5 7l1 12.5h9l1-12.5\"/><path d=\"M10 11v5M14 11v5\"/>"
  ? == n 10 "<path d=\"M12 3v8\"/><path d=\"M6.6 6.6a7.5 7.5 0 1 0 10.8 0\"/>"
  ? == n 11 "<path d=\"M9.5 4H5v16h4.5\"/><path d=\"M15 8l4 4-4 4\"/><path d=\"M19 12H9.5\"/>"
  ? == n 12 "<path d=\"M12 5v14M5 12h14\"/>"
  ? == n 13 "<path d=\"M9 3.5h6l-1 6 3.5 3.5h-11L10 9.5z\"/><path d=\"M12 13v7.5\"/>"
  ? == n 14 "<path d=\"M6.5 6.5l11 11M17.5 6.5l-11 11\"/>"
  ? == n 15 "<path d=\"M5 12h14\"/><path d=\"m13 6 6 6-6 6\"/>"
  "<path d=\"M5 12.5l4.5 4.5L19 7.5\"/>"
  "</svg>" 0 }
: pill >i ? ligado { "<button type=\"button\" class=\"mu-pill on\" data-onda=\"ir&#9;5\">" pjt jg @ 3 k_utilizador "</button>" 0 } { "<button type=\"button\" class=\"mu-pill off\" data-onda=\"ir&#9;5\">Tidal desligado</button>" 0 }
: carregar >i ? @ 3 "<p class=\"mu-nota\">A carregar…</p>" "<p class=\"mu-nota\">A ligar ao conector…</p>"
# qualidade do som pelas etiquetas do Tidal
: pqual i>i l { = c jprim l = h 0 = q 0 W c { = t jtxt c ? tigual t k_v_hires { = h 1 0 } ? tigual t k_v_lossless { = q 1 0 } 0 = c jprox c }
  ? h "<span class=\"mu-chip hires\">Hi-Res</span>" ? q "<span class=\"mu-chip lossless\">Sem perdas</span>" 0
  0 }
: qual_tags i>i l { = c jprim l = h 0 = q 0 = a 0
  W c { = t jtxt c ? tigual t k_v_hires { = h 1 0 } ? tigual t k_v_lossless { = q 1 0 } ? tigual t k_v_atmos { = a 1 0 } 0 = c jprox c }
  = v ? h 1000 ? q 750 350
  Mn 1000 + v ? a 100 0 }
# ano . genero . bpm . tom (Camelot) . duracao
: meta ii>i f g {
  = s 0
  = a jgi f k_ano ? a { N a = s 1 0 } 0
  ? tlen g { ? s " · " 0 pt g = s 1 0 } 0
  = b jgi f k_bpm ? b { ? s " · " 0 N b " bpm" = s 1 0 } 0
  = t jgi f k_tom ? t { ? s " · " 0 N + % - t 1 12 1 ? > t 12 "B" "A" = s 1 0 } 0
  = du jgi f k_duracao ? du { ? s " · " 0 pmin du 0 } 0
  0 }
# uma faixa: p posicao, f faixa (JSON), g genero, mo motivo, pq porque (1..6), po pontos, fx fixada, af a afinar, ci candidata
: linha iiiiiiiii>i p f g mo pq po fx af ci {
  "<li class=\"mu-faixa" ? fx " fixa" 0 ? && == @ 1 2 rej_tem jgt f k_id " fora" 0 "\"><span class=\"n\">" N + p 1 "</span><div>"
  ? af 0 { "<button type=\"button\" class=\"mu-faixa-a\" data-onda=\"sel&#9;" N p "\">" 0 }
  "<div class=\"t\">" pjt jg f k_titulo
  ? tlen jgt f k_versao { " <span class=\"mu-nota\">(" pjt jg f k_versao ")</span>" 0 } 0
  "</div><div class=\"a\">" partistas jg f k_artistas "</div><div class=\"m\">" meta f g "</div>"
  ? tlen mo { "<div class=\"mot\">" pt mo "</div>" 0 } 0
  ? af { "<div class=\"ctl\"><button type=\"button\" data-onda=\"fixar&#9;" N ci "\" aria-pressed=\"" ? fx "true" "false" "\">" ic 13 "fixar</button><button type=\"button\" data-onda=\"tirar&#9;" N ci "\">" ic 14 "tirar</button></div>" 0 }
    { "</button>" ? == @ 40 + p 1 { "<div class=\"mu-faixa-mais\"><button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"mais&#9;" pjt jg f k_id "\">" ic 5 "Mais como esta</button>" ? && == @ 1 2 acesso { "<button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"naoesta&#9;" pjt jg f k_id "\">" ? rej_tem jgt f k_id "Afinal fica" "Não esta" "</button>" 0 } 0 "</div>" 0 } 0 0 }
  "</div><div class=\"dir\">"
  ? jgt f k_url { "<a class=\"mu-tocar\" href=\"" pjt jg f k_url "\" target=\"_blank\" rel=\"noopener\" aria-label=\"Ouvir «" pjt jg f k_titulo "» no Tidal\">" ic 4 "</a>" 0 } 0
  pqual jg f k_tags
  ? pq { "<span class=\"why\">" pporque pq " " N / po 10 "</span>" 0 } 0
  "</div></li>" 0 }

# ===== boas-vindas (ligar o Tidal) =====
: campo_codigo >i { "<label class=\"mu-campo\"><span>Código de ligação</span><input data-onda=\"cod\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\" value=\"" pt @ 38 "\"></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"usar\">" ic 15 "Usar este código</button></div>" 0 }
: boas_vindas >i {
  = e @ 3
  = cod Y 105 k_g_codigo 0
  = ch Y 105 k_g_chave 0
  ? ~ == jtipo jg e k_clientId 3 {
      "<div class=\"mu-card boas\"><h3>Primeiro: a tua app no Tidal</h3><p>Em <a href=\"https://developer.tidal.com/dashboard\" target=\"_blank\" rel=\"noopener\">developer.tidal.com</a> cria uma app (grátis) e, nas definições dela:</p><ul class=\"mu-tend\"><li>Redirect URI: <code>" pjt jg e k_retorno "</code></li><li>Scopes: <code>user.read collection.read playlists.read playlists.write search.read recommendations.read</code></li></ul>"
      ? || cod && ch jg e k_tu {
          "<label class=\"mu-campo\"><span>Client ID da app</span><input data-onda=\"cid\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"copia-o do Tidal\" value=\"" pt @ 21 "\"></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"config\">" ic 15 "Guardar e continuar</button></div>" 0 }
        { "<p class=\"mu-nota\">Depois abre o link de ligação que o Claude te deu (termina em <code>?ligar=…</code>) para colares aqui o Client ID.</p>" 0 }
      "</div>" 0 }
    { ? && ch ~ jg e k_tu { "<div class=\"mu-card boas\"><h3>Este aparelho perdeu o acesso</h3><p>A chave guardada já não é válida. Cola aqui um código de ligação novo, que o Claude te dá.</p>" campo_codigo "</div>" 0 }
      ? cod { "<div class=\"mu-card boas\"><h3>Liga o teu Tidal</h3><p>Vais à página de login do Tidal, autorizas, e voltas aqui. As playlists passam a ser criadas na tua conta e o Maestro (o Claude) passa a ler o teu gosto.</p><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"ligar\">" ic 1 "Ligar ao Tidal</button></div></div>" 0 }
      { "<div class=\"mu-card boas\"><h3>" ? ligado "Liga este aparelho" "Liga o teu Tidal" "</h3><p>Num aparelho onde já entraste, vai a Ajustes → <b>Ligar outro aparelho</b> e cola aqui o código. Se é a primeira vez, abre o link do convite.</p>" campo_codigo "</div>" 0 } }
  0 }

# ===== Playlists =====
: npendentes i>i pd { = n 0 = c jprim pd W c { ? tigual jgt c k_estado k_v_pendente { = n + n 1 0 } 0 = c jprox c } n }
: pl_card i>i c {
  = ab tigual jgt c k_id @ 50
  "<div class=\"mu-pl" ? ab " aberta" 0 ? jgt c k_tidal " tidal" 0 "\">"
  = cs jg c $"capas" = nc jn cs
  ? nc { "<span class=\"mu-pl-capa" ? >= nc 4 " m4" 0 "\" aria-hidden=\"true\">" = e jprim cs = q 0 W && e < q 4 { "<img src=\"" pjt e "\" alt=\"\" loading=\"lazy\" decoding=\"async\">" = e jprox e = q + q 1 } "</span>" 0 } 0
  "<button type=\"button\" class=\"mu-pl-a\" data-onda=\"exp&#9;" pjt jg c k_id "\" aria-expanded=\"" ? ab "true" "false" "\"><div class=\"nm\">" ? == jtipo jg c $"rascunho" 3 { pjt jg c $"variante" " · " 0 } 0 pjt jg c k_nome "</div><div class=\"mt\">" N jgi c k_faixas " faixas · " pmin jgi c k_duracao " · " pdia jgt c k_criadaEm
  = av jg c $"avaliacao" ? av { = e jgt av $"etiqueta" ? || tigual e $"ainda cedo" tigual e $"sem sinais" 0 { " · " pt e 0 } 0 } 0
  ? == jtipo jg c $"renovar" 3 { " · ↻" 0 } 0
  "</div><svg class=\"chev\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"/></svg></button>"
  ? jgt c k_tidal { "<a class=\"mu-tocar\" href=\"" pjt jg c k_tidal "\" target=\"_blank\" rel=\"noopener\" aria-label=\"Ouvir «" pjt jg c k_nome "» no Tidal\">" ic 4 "</a>" 0 } 0
  ? ab { cx_aberta c 0 } 0
  "</div>" 0 }
# o cartao aberto: as faixas (ouvir 30 s, «nao esta»), o Tidal, abrir tudo e afinar com o Maestro. Tudo menos as faixas
# vem do indice, para o cartao ter logo o tamanho certo; as faixas chegam depois so para dentro de .mu-cx-xf (render_cx)
: cx_aberta i>i c {
  "<div class=\"mu-cx\">"
  ? pl_rasc c { "<p class=\"mu-nota\">Proposta — ainda não está no Tidal. Ouve um bocado de cada faixa (▶) e envia-a se gostares.</p>" 0 } 0
  "<div class=\"mu-cx-xf\">" cx_xf c "</div><div class=\"mu-acoes\">"
  = d @ 51 = td ? d jg d k_tidal 0
  ? && td == jtipo td 7 { "<a class=\"mu-btn peq\" href=\"" pjt jg td k_url "\" target=\"_blank\" rel=\"noopener\">" ic 4 "Ouvir no Tidal</a>" 0 }
    { ? jgt c k_tidal { "<a class=\"mu-btn peq\" href=\"" pjt jg c k_tidal "\" target=\"_blank\" rel=\"noopener\">" ic 4 "Ouvir no Tidal</a>" 0 }
      { "<button type=\"button\" class=\"mu-btn peq\" data-onda=\"enviar\">" ic 3 "Enviar para o Tidal</button>" 0 } }
  "<button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"abrir&#9;" pjt jg c k_id "\">Abrir</button></div>"
  "<div class=\"mu-cx-afinar\"><label class=\"mu-campo\"><span>Afinar com o Maestro</span><textarea data-onda=\"af-tx\" maxlength=\"500\" rows=\"2\" placeholder=\"Ex.: menos eletrónica, mais vozes femininas\">" pt @ 49 "</textarea></label><button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"afinar_pedir\">" ic 2 "Afinar</button></div>"
  "</div>" 0 }
# as faixas do cartao aberto: enquanto chegam, linhas cinzentas do mesmo tamanho (o cartao nao salta)
: cx_xf i>i c {
  = d @ 51
  ? ~ d {
    = n jgi c k_faixas ? > n 40 { = n 40 0 } 0 ? < n 1 { = n 6 0 } 0
    "<ol class=\"mu-xf\" aria-busy=\"true\" aria-label=\"A carregar as faixas\">"
    = p 0 W < p n { "<li class=\"sk\"><span class=\"cp\"></span><div class=\"tx\"><b>&nbsp;</b><span>&nbsp;</span></div><span class=\"mu-ouvir vazio\"></span><span class=\"mu-nao\"></span></li>" = p + p 1 }
    "</ol>" 0 } {
    "<ol class=\"mu-xf\">"
    = f jprim jg d k_faixas = p 0
    W f {
      = id jgt f k_id = fora rej_em d id
      = cv jgt jg @ 52 $"capas" id
      "<li" ? fora { " class=\"fora\"" 0 } 0 "><span class=\"cp\">" ? cv { "<img src=\"" pt cv "\" alt=\"\" loading=\"lazy\" decoding=\"async\">" 0 } 0 "</span><div class=\"tx\"><b>" pjt jg f k_titulo "</b><span>" partistas jg f k_artistas "</span></div>"
      = u jgt jg @ 52 $"previas" id
      ? u { "<button type=\"button\" class=\"mu-ouvir\" data-previa=\"" pt u "\" aria-label=\"Ouvir 30 segundos de «" pjt jg f k_titulo "»\">" ic 4 "</button>" 0 } { "<span class=\"mu-ouvir vazio\"></span>" 0 }
      "<button type=\"button\" class=\"mu-nao\" data-onda=\"naoesta&#9;" pt id "\" aria-pressed=\"" ? fora "true" "false" "\" aria-label=\"" ? fora "Afinal fica" "Não esta" "\">✕</button></li>"
      = f jprox f = p + p 1 }
    "</ol>"
    = nr jn jg d $"rejeitadas"
    ? nr { "<p class=\"mu-cx-fora\">" N nr ? == nr 1 " faixa com ✕ sai" " faixas com ✕ saem" " quando afinares.</p>" 0 } 0
    0 }
  0 }
# a playlist do cartao aberto, no indice
: pl_aberta >i { = r 0 ? && @ 4 tlen @ 50 { = c jprim @ 4 W && c ~ r { ? tigual jgt c k_id @ 50 { = r c 0 } 0 = c jprox c } 0 } 0 r }
# redesenha so as faixas do cartao aberto: a pagina nao treme e a caixa de afinar nao perde o teclado
: render_cx >i {
  = c pl_aberta
  ? c { = m marca = h tnovo 250000 O h cx_xf c O 0 ? Y 100 $".mu-pl.aberta .mu-cx-xf" h 0 render solta m 0 } render }
# agrupar a lista: 0 data, 1 tipo, 2 genero, 3 Tidal, 4 avaliacao
: nome_grp i>i q ? == q 1 "Tipo" ? == q 2 "Género" ? == q 3 "Tidal" ? == q 4 "Avaliação" "Data"
: dnum iii>i t i n { = v 0 = j 0 W < j n { = v + * v 10 - tbyte t + i j '0 = j + j 1 } v }
# dias desde 1970 de «AAAA-MM-DD...»
: dias_de i>i t {
  = y dnum t 0 4 = m dnum t 5 2 = dd dnum t 8 2
  = y - y ? <= m 2 1 0
  = era / y 400 = yoe - y * era 400
  = mm ? > m 2 - m 3 + m 9
  = doy + / + * 153 mm 2 5 - dd 1
  = doe + - + * yoe 365 / yoe 4 / yoe 100 doy
  - + * era 146097 doe 719468 }
: grp i>i c {
  = q @ 53
  ? == q 1 { ? == jtipo jg c $"renovar" 3 $"Atualizam-se sozinhas" ? tigual jgt c k_por $"app" $"Feitas por ti" ? tlen jgt c k_pedido $"Dos teus pedidos" $"Do Maestro" }
  ? == q 2 { = g jgt c k_genero ? && g tlen g g $"Vários géneros" }
  ? == q 3 { ? jgt c k_tidal $"No Tidal" $"Só na app" }
  ? == q 4 { = e jgt jg c $"avaliacao" $"etiqueta" ? || ~ e || tigual e $"ainda cedo" tigual e $"sem sinais" $"Ainda sem avaliação" ? tigual e $"resultou" $"Resultaram" ? tigual e $"boa" $"Boas" ? tigual e $"morna" $"Mornas" $"Não resultaram" }
  { = t jgt c k_criadaEm = dd - / Y 108 0 0 86400000 ? t dias_de t 0 ? <= dd 6 $"Esta semana" ? <= dd 30 $"Este mês" $"Mais antigas" } }
# c e a primeira do seu grupo (entre as que nao sao propostas)?
: grp_primeiro ii>i d c { = e jprim d = r 1 = k grp c W && e != e c { ? && ~ pl_rasc e tigual grp e k { = r 0 0 } 0 = e jprox e } r }
: grp_n ii>i d c { = e jprim d = n 0 = k grp c W e { ? && ~ pl_rasc e tigual grp e k { = n + n 1 0 } 0 = e jprox e } n }
: pl_rasc i>i c == jtipo jg c $"rascunho" 3
# c e a primeira proposta do seu grupo (o pedido) na lista d?
: pl_primeiro ii>i d c { = e jprim d = r 1 W && e != e c { ? && pl_rasc e tigual jgt e $"grupo" jgt c $"grupo" { = r 0 0 } 0 = e jprox e } r }
: pl_ngrupo ii>i d c { = e jprim d = n 0 W e { ? && pl_rasc e tigual jgt e $"grupo" jgt c $"grupo" { = n + n 1 0 } 0 = e jprox e } n }
: lista_pl i>i d {
  ? ~ jn d { "<div class=\"mu-card nada\"><h3>Ainda não há playlists</h3><p>O Maestro cria a primeira «Onda da semana» na próxima manhã. Ou faz já um pedido.</p><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"ir&#9;3\">" ic 2 "Fazer um pedido</button></div></div>" 0 }
  {
    # as propostas por escolher, agrupadas pelo pedido (abre-se uma para ver as faixas; envia-se a preferida para o Tidal)
    = c jprim d = np 0
    W c {
      ? && pl_rasc c pl_primeiro d c {
        ? ~ np { "<h2 class=\"mu-sec\">Propostas para escolher</h2>" 0 } 0 = np + np 1
        "<details class=\"mu-grupo\" open><summary><span class=\"tx\">" ? tlen jgt c k_pedido { "«" pjt jg c k_pedido "»" 0 } { "Propostas" 0 } "</span><span class=\"n\">" N pl_ngrupo d c " propostas<svg class=\"chev\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"/></svg></span></summary><div class=\"mu-lista-pl\">"
        = e jprim d W e { ? && pl_rasc e tigual jgt e $"grupo" jgt c $"grupo" { pl_card e 0 } 0 = e jprox e }
        "</div></details>" 0 } 0
      = c jprox c }
    = nf 0 = c jprim d W c { ? ~ pl_rasc c { = nf + nf 1 0 } 0 = c jprox c }
    ? nf {
      "<div class=\"mu-agrupar\"><span>Agrupar por</span><div class=\"mu-seg\">" = q 0 W < q 5 { "<button type=\"button\" data-onda=\"agrupar&#9;" N q "\" aria-pressed=\"" ? == q @ 53 "true" "false" "\">" nome_grp q "</button>" = q + q 1 } "</div></div>"
      = c jprim d
      W c {
        ? && ~ pl_rasc c grp_primeiro d c {
          "<section class=\"mu-grp\"><h2 class=\"mu-sec\">" pt grp c " <span>" N grp_n d c "</span></h2><div class=\"mu-lista-pl\">"
          = k grp c = e jprim d W e { ? && ~ pl_rasc e tigual grp e k { pl_card e 0 } 0 = e jprox e }
          "</div></section>" 0 } 0
        = c jprox c }
      0 } 0
    0 } }
: v_playlists >i {
  "<header class=\"mu-head\"><div><h1>Música</h1><div class=\"sub\">Playlists de qualidade para o teu Tidal</div></div>" pill "</header>"
  ? ~ @ 3 carregar {
    ? ~ acesso boas_vindas {
      = np npendentes @ 5
      ? > np 0 { "<button type=\"button\" class=\"mu-card mu-cartao\" data-onda=\"ir&#9;3\"><h3>" N np ? > np 1 " pedidos à espera do Maestro" " pedido à espera do Maestro" "</h3><p>O Maestro trata deles às 07:44 e às 18:44.</p></button>" 0 } 0
      ? @ 4 lista_pl @ 4 carregar } }
  0 }

# ===== uma playlist (e o Afinar) =====
: cn i>i i @ + @ 11 i
: cf i>i i @ + @ 12 i
: c_sin i>i i ? < i @ 37 jg cn i k_sinais 0
: art_txt i>i i ? < i @ 37 jgt c_sin i k_artista jtxt jprim jg cf i k_artistas
: gen_txt i>i i ? < i @ 37 jgt c_sin i k_genero jtxt jprim jg cf i k_generos
: mot_txt i>i i ? < i @ 37 jgt cn i k_motivo k_t_escolhida
: usaveis >i { = n 0 = i 0 W < i @ 35 { ? ~ @ + @ 18 i { = n + n 1 0 } 0 = i + i 1 } n }
: soma_dur i>i fx { = s 0 = c jprim fx W c { = s + s jgi c k_duracao = c jprox c } s }
: n_itens >i ? @ 6 @ 14 jn jg @ 4 k_faixas
: item_f i>i p ? @ 6 cf @ + @ 13 p jidx jg @ 4 k_faixas p
: item_g i>i p ? @ 6 gen_txt @ + @ 13 p jgt item_f p k_genero
: dur_itens >i { = s 0 = p 0 W < p n_itens { = s + s jgi item_f p k_duracao = p + p 1 } s }
: lista_doc i>i fx { = c jprim fx = p 0 W c { linha p c jgt c k_genero jgt c k_motivo cod_porque jgt c k_porque jgi c k_pontos 0 0 0 = c jprox c = p + p 1 } 0 }
: lista_afinada >i { = p 0 W < p @ 14 { = i @ + @ 13 p linha p cf i gen_txt i mot_txt i @ + @ 15 p @ + @ 32 p @ + @ 17 i 1 i = p + p 1 } 0 }
# barras de uma contagem (tx textos ou decadas, ct contagens), ordenadas, no maximo 6
: barras_arr iiiii>i tx ct n tot modo {
  "<div class=\"mu-mix\">"
  = feito A + n 1
  = q 0 W && < q 6 < q n {
    = b -1 = bv -1 = k 0 W < k n { ? && ~ @ + feito k > @ + ct k bv { = b k = bv @ + ct k 0 } 0 = k + k 1 }
    ! + feito b 1
    "<div class=\"mu-barra\"><span>"
    ? modo { ? @ + tx b { N @ + tx b "s" 0 } "?" } { ? tlen @ + tx b pt @ + tx b "?" }
    "</span><span class=\"b\"><i style=\"width:" N / + * 200 bv tot * 2 tot "%\"></i></span><span class=\"v\">" N bv "</span></div>"
    = q + q 1 }
  "</div>" 0 }
: mistura >i {
  = n n_itens
  ? n {
    = gt A + n 1 = gc A + n 1 = ng 0
    = dt A + n 1 = dc A + n 1 = nd 0
    = p 0 W < p n {
      = g item_g p
      = k 0 = ach -1 W && < k ng < ach 0 { ? tigual @ + gt k g { = ach k 0 } 0 = k + k 1 }
      ? < ach 0 { ! + gt ng g ! + gc ng 1 = ng + ng 1 0 } { ! + gc ach + @ + gc ach 1 0 }
      = a jgi item_f p k_ano = dv ? a * / a 10 10 0
      = k 0 = ach -1 W && < k nd < ach 0 { ? == @ + dt k dv { = ach k 0 } 0 = k + k 1 }
      ? < ach 0 { ! + dt nd dv ! + dc nd 1 = nd + nd 1 0 } { ! + dc ach + @ + dc ach 1 0 }
      = p + p 1 }
    barras_arr gt gc ng n 0
    barras_arr dt dc nd n 1
    0 } 0 }
: motor_txt >i { "motor Onda (WASM): " N @ 14 " faixas de " N usaveis " em " ? @ 33 { N @ 33 " ms" 0 } "menos de 1 ms" " · " pmin dur_itens " · custo das transições " N @ 16 0 }
: resultados >i {
  = r @ 19
  ? r {
    = l jg r k_faixas
    ? ~ jn l "<p class=\"mu-nota\">Nada encontrado.</p>" {
      "<ol class=\"mu-faixas\">" = c jprim l = q 0
      W && c < q 6 {
        "<li class=\"mu-faixa\"><span class=\"n\">" N + q 1 "</span><div><div class=\"t\">" pjt jg c k_titulo "</div><div class=\"a\">" partistas jg c k_artistas "</div><div class=\"m\">" meta c 0 "</div></div><div class=\"dir\"><button type=\"button\" class=\"mu-btn peq\" data-onda=\"juntar&#9;" N q "\">" ic 12 "juntar</button></div></li>"
        = c jprox c = q + q 1 }
      "</ol>" 0 } } 0
  0 }
: seg_af iiii>i nome n ini atual {
  = q ini W < q + ini n {
    "<button type=\"button\" data-onda=\"" ? == nome 1 "af-mx" ? == nome 2 "af-es" ? == nome 3 "af-ar" ? == nome 4 "pd-mx" ? == nome 5 "pd-es" "pd-ar" "&#9;" N q "\" aria-pressed=\"" ? == q atual "true" "false" "\">"
    ? || == nome 1 == nome 4 N q ? || == nome 2 == nome 5 nome_estilo q nome_arco q
    "</button>" = q + q 1 }
  0 }
: afinador >i {
  "<div class=\"mu-card mu-afinar\"><h3>Afinar com o motor Onda</h3><p>" N usaveis " candidatas. Muda as regras e o motor escolhe e ordena outra vez, aqui no telemóvel.</p>"
  "<label class=\"mu-campo\"><span>Faixas</span><div class=\"mu-range\"><input type=\"range\" data-onda=\"af-n\" min=\"5\" max=\"" N Mx 5 usaveis "\" value=\"" N @ 7 "\"><output id=\"af-nv\">" N @ 7 "</output></div></label>"
  "<div class=\"mu-campo\"><span>Máximo por artista</span><div class=\"mu-seg\" data-seg=\"maxArtista\">" seg_af 1 4 1 @ 8 "</div></div>"
  "<div class=\"mu-campo\"><span>Estilo</span><div class=\"mu-seg\" data-seg=\"estilo\">" seg_af 2 5 0 @ 9 "</div></div>"
  "<div class=\"mu-campo\"><span>Energia ao longo da playlist</span><div class=\"mu-seg\" data-seg=\"arco\">" seg_af 3 4 0 @ 10 "</div></div>"
  "<label class=\"mu-campo\"><span>Acrescentar do Tidal</span><input type=\"search\" data-onda=\"q\" placeholder=\"artista e título\" value=\"" pt @ 23 "\"></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"procurar\">" ic 8 "Procurar no Tidal</button></div><div id=\"af-res\">" resultados "</div>"
  "<div class=\"mu-motor\" id=\"af-motor\">" motor_txt "</div>"
  "<div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"guardar&#9;1\">" ic 3 ? == jtipo jg @ 4 k_tidal 7 "Atualizar no Tidal" "Guardar e enviar para o Tidal" "</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"guardar&#9;0\">" ic 16 "Só guardar na app</button></div></div>" 0 }
: v_playlist >i {
  "<button type=\"button\" class=\"mu-voltar\" data-onda=\"ir&#9;1\">‹ Playlists</button>"
  = d @ 4
  ? ~ d { ? && @ 3 ~ acesso boas_vindas carregar 0 } {
    = fx jg d k_faixas
    "<header class=\"mu-head\"><div><h1>" pjt jg d k_nome "</h1><div class=\"sub\">" N jn fx " faixas · " pmin soma_dur fx " · " pdia jgt d k_criadaEm " · " ? tigual jgt d k_por k_v_curador "✦ Maestro" "por ti" ? == jtipo jg jg d k_opcoes $"limpa" 3 { " · sem letras explícitas" 0 } 0 "</div></div><div class=\"mu-head-acoes\"><button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"renomear\">Mudar o nome</button><button type=\"button\" class=\"mu-btn perigo peq\" data-onda=\"apagar\">" ic 9 "Apagar</button></div></header>"
    ? == @ 28 2 { "<div class=\"mu-card mu-renomear\"><h3>Mudar o nome</h3><label class=\"mu-campo\"><span>Nome</span><input data-onda=\"rn-nome\" maxlength=\"60\" value=\"" pt @ 46 "\"></label><label class=\"mu-campo\"><span>Descrição (opcional)</span><textarea data-onda=\"rn-desc\" maxlength=\"300\">" pt @ 47 "</textarea></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"renomear_sim\">Guardar</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"nao\">Cancelar</button></div><p class=\"mu-nota\">Muda na app e, se lá estiver, no Tidal (o link fica o mesmo). Quando se atualiza sozinha, o nome que deres fica.</p></div>" 0 } 0
    ? == @ 28 1 { "<div class=\"mu-card mu-confirma\"><h3>Apagar esta playlist?</h3>"
        ? == jtipo jg d k_tidal 7 { "<p>Também está no teu Tidal.</p><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn perigo forte\" data-onda=\"apagar_tidal\">" ic 9 "Apagar no Tidal e na app</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"apagar_sim\">Só na app</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"nao\">Não</button></div>" 0 }
          { "<div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn perigo forte\" data-onda=\"apagar_sim\">" ic 9 "Sim, apagar</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"nao\">Não</button></div>" 0 }
        "</div>" 0 } 0
    ? pl_rasc d { "<div class=\"mu-card mu-proposta\"><p><b>Proposta «" pjt jg d $"variante" "»</b>" ? tlen jgt d k_pedido { " para «" pjt jg d k_pedido "»" 0 } 0 ". Ainda não está no Tidal: ouve as faixas (▶) e envia a que preferires.</p></div>" 0 } 0
    pl_correu d
    "<div class=\"mu-acoes\">"
    ? acesso { = td jg d k_tidal
        ? == jtipo td 7 { "<a class=\"mu-btn\" href=\"" pjt jg td k_url "\" target=\"_blank\" rel=\"noopener\">" ic 4 "Ouvir no Tidal</a>" 0 }
          { "<button type=\"button\" class=\"mu-btn\" data-onda=\"enviar\">" ic 3 "Enviar para o Tidal</button>" 0 } } 0
    ? ~ @ 6 { "<button type=\"button\" class=\"mu-btn sec\" data-onda=\"afinar\">" ic 5 "Afinar no telemóvel</button>" 0 } 0
    "</div>"
    ? tlen jgt d k_pedido { "<p class=\"mu-nota\">Pedido: «" pjt jg d k_pedido "»</p>" 0 } 0
    = rs ? tlen jgt d k_resumo jgt d k_resumo jgt d k_descricao
    ? tlen rs { "<div class=\"mu-card\"><h3>Porquê esta playlist</h3><p class=\"mu-resumo\">" pt rs "</p>"
        = tl jg d k_tendencias
        ? jn tl { "<ul class=\"mu-tend\">" = c jprim tl W c { "<li>" pjt c "</li>" = c jprox c } "</ul>" 0 } 0
        "</div>" 0 } 0
    ? @ 6 afinador 0
    "<h2 class=\"mu-sec\">Faixas</h2><ol class=\"mu-faixas\" id=\"faixas\">"
    ? @ 6 lista_afinada lista_doc fx
    "</ol><div class=\"mu-card\" style=\"margin-top:12px\"><h3>A mistura</h3>" mistura "</div>"
    ? && acesso ~ @ 6 { = nr jn jg d $"rejeitadas"
      "<div class=\"mu-card mu-afinar-maestro\"><h3>Afinar com o Maestro</h3><p class=\"mu-nota\">" ? nr { N nr " faixa(s) com «Não esta» (toca numa faixa para a marcar). " 0 } { "Toca numa faixa e marca «Não esta» nas que não gostas. " 0 }
      "Diz o que mudar e o Maestro refá-la na próxima corrida, no mesmo sítio" ? == jtipo jg d k_tidal 7 " e no mesmo link do Tidal" 0 ".</p><label class=\"mu-campo\"><span class=\"sr\">O que mudar</span><textarea data-onda=\"af-tx\" maxlength=\"500\" placeholder=\"Ex.: menos eletrónica, mais vozes femininas\">" pt @ 49 "</textarea></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn sec\" data-onda=\"afinar_pedir\">" ic 2 "Pedir para afinar</button></div></div>" 0 } 0
    0 }
  0 }

# o motor de curadoria (motor.onda) aqui dentro: escolhe e ordena as candidatas que nao foram tiradas
: energia_bpm i>i b ? b lim / + * 2000 - b 60 110 220 100 950 500
: afinar_correr >i {
  = t0 Y 108 0 0
  = mk marca
  = tot @ 35
  = u A + tot 1 = nu 0 = i 0
  W < i tot { ? ~ @ + @ 18 i { ! + u nu i = nu + nu 1 0 } 0 = i + i 1 }
  = c ctx_novo nu Mn @ 7 nu @ 8
  = e @ 9 = w 0 W < w 5 { cs c + 3 w @ + @ 36 + * e 5 w = w + w 1 }
  cs c 8 300 cs c 9 250 cs c 10 200
  cs c 11 arco_val @ 10
  = at A + nu 1 = na 0 = gt A + nu 1 = ng 0
  = j 0 W < j nu {
    = i @ + u j
    # artista e genero: ids densos pela ordem em que aparecem (sem nome: um artista so dela; sem genero: 0)
    = x art_txt i = id -1
    ? tlen x { = q 0 W && < q na < id 0 { ? tigual @ + at q x { = id q 0 } 0 = q + q 1 } 0 } 0
    ? < id 0 { ! + at na x = id na = na + na 1 0 } 0
    ap c 12 j Mn id nu
    = y gen_txt i = gi 0
    ? tlen y { = q 0 = gi -1 W && < q ng < gi 0 { ? tigual @ + gt q y { = gi + q 1 0 } 0 = q + q 1 }
        ? < gi 0 { ! + gt ng y = ng + ng 1 = gi ng 0 } 0 0 } 0
    ap c 13 j Mn gi nu
    ? < i @ 37 {
        = s c_sin i
        ap c 29 j lim jgi s k_gosto 0 1000 ap c 30 j lim jgi s k_qualidade 0 1000 ap c 31 j lim jgi s k_tendencia 0 1000
        ap c 32 j lim jgi s k_claude 0 1000 ap c 33 j lim jgi s k_novidade 0 1000 ap c 15 j lim jgi s k_energia 0 1000
        ap c 16 j lim jgi s k_bpm 0 400 ap c 17 j lim jgi s k_tom 0 24 ap c 14 j decada lim jgi s k_ano 0 2100
        ap c 18 j || == jtipo jg s k_fixa 3 @ + @ 17 i
        0 } {
        = f cf i = b lim jgi f k_bpm 0 400
        ap c 29 j 0 ap c 30 j qual_tags jg f k_tags ap c 31 j lim jgi f k_popularidade 0 1000 ap c 32 j 700 ap c 33 j 1000
        ap c 15 j energia_bpm b ap c 16 j b ap c 17 j lim jgi f k_tom 0 24 ap c 14 j decada lim jgi f k_ano 0 2100
        ap c 18 j 1
        0 }
    = j + j 1 }
  ! 16 curar c
  = m cg c 27 ! 14 m
  = p 0 W < p m { = j ag c 28 p ! + @ 13 p @ + u j ! + @ 15 p ag c 20 j ! + @ 32 p ag c 26 j = p + p 1 }
  solta mk
  ! 33 - Y 108 0 0 t0
  0 }
: afinar_abrir >i {
  = d @ 4
  = cs jg d k_candidatas = n jn cs
  ? ~ n { = a abre "Esta playlist não tem candidatas para afinar." O 0 aviso a 0 } {
    ! 37 n ! 35 n
    = cap + n 21
    ! 11 A cap ! 12 A cap ! 13 A cap ! 15 A cap ! 17 A cap ! 18 A cap ! 32 A cap
    = c jprim cs = i 0
    W c { ! + @ 11 i c ! + @ 12 i jg c k_faixa = c jprox c = i + i 1 }
    = op jg d k_opcoes
    = f jgi op k_faixas ! 7 ? && > f 0 < f n f n
    = mx jgi op k_maxArtista ! 8 ? > mx 0 mx 2
    ! 9 idx_estilo jgt op k_estilo
    ! 10 idx_arco jgt op k_arco
    ! 6 1
    afinar_correr
    render 0 } }
: parcial_afinar >i {
  = m marca
  = h tnovo 250000 O h lista_afinada O 0 Y 100 k_s_faixas h
  = g tnovo 40 O g N @ 7 O 0 Y 100 k_s_afnv g
  = x tnovo 800 O x motor_txt O 0 Y 100 k_s_afmotor x
  solta m }
: juntar_faixa i>i f {
  = id jgt f k_id
  = i 0 = ach -1 W && < i @ 35 < ach 0 { ? tigual jgt cf i k_id id { = ach i 0 } 0 = i + i 1 }
  ? && < ach 0 < @ 35 + @ 37 20 { = ach @ 35 ! + @ 11 ach 0 ! + @ 12 ach f ! 35 + @ 35 1 0 } 0
  ? >= ach 0 {
    ! + @ 17 ach 1 ! + @ 18 ach 0 ! 7 Mn + @ 7 1 usaveis
    ! 19 0 tvazio @ 23
    afinar_correr render
    = a abre "«" tpor jtxt jg f k_titulo "» entra (fixada)." O 0 aviso a 0 }
    { = a abre "Já não cabem mais faixas." O 0 aviso a 0 } }

# ===== escritas no conector =====
: ocupado >i ? @ 31 { = a abre "Um momento…" O 0 aviso a 1 } 0
: guardar_versao i>i tidal {
  ? ocupado 0 {
    ! 31 1 ! 34 ? tidal 9 4
    = r tnovo + 4000 * 40 @ 35
    O r "POST /api/playlists/" purl @ 30 "/versoes" P 10
    "{\"ordem\":[" = p 0 W < p @ 14 { ? p "," 0 N @ + @ 13 p = p + p 1 }
    "],\"porque\":[" = p 0 W < p @ 14 { ? p "," 0 P 34 porque_json @ + @ 15 p P 34 = p + p 1 }
    "],\"pontos\":[" = p 0 W < p @ 14 { ? p "," 0 N @ + @ 32 p = p + p 1 }
    "],\"extras\":[" = i @ 37 W < i @ 35 { ? > i @ 37 "," 0 pjs jgt cf i k_id = i + i 1 }
    "],\"opcoes\":{\"faixas\":" N @ 7 ",\"maxArtista\":" N @ 8 ",\"estilo\":\"" estilo_json @ 9 "\",\"arco\":\"" arco_json @ 10 "\"},\"custo\":" N @ 16 ",\"tidal\":" ? tidal "true" "false" "}"
    O 0
    busca r k_c_escrita
    = a abre ? tidal "A criar no Tidal…" "A guardar…" O 0 aviso a 0 } }
: enviar >i ? ocupado 0 { ! 31 1 ! 34 3 = r abre "POST /api/playlists/" purl @ 30 "/tidal" P 10 "{}" O 0 busca r k_c_escrita = a abre "A criar no Tidal…" O 0 aviso a 0 }
: apagar_pl i>i t ? ocupado 0 { ! 31 1 ! 34 ? t 11 5 = r abre "DELETE /api/playlists/" purl @ 30 ? t "?tidal=1" 0 O 0 busca r k_c_escrita 0 }
: mais_criar i>i b ? ocupado 0 { ! 31 1 ! 34 12 = r abre "POST /api/mais" P 10 "{\"faixa\":\"" tpor b "\"" ? == jtipo jg jg @ 4 k_opcoes $"limpa" 3 { ",\"limpa\":true" 0 } 0 "}" O 0 busca r k_c_escrita = a abre "A procurar faixas parecidas…" O 0 aviso a 0 }
# convidar alguem: o Worker devolve o link (serve uma vez); a mensagem para partilhar fica ja codificada em @42
: codaparelho_pedir >i ? ocupado 0 { ! 31 1 ! 34 14 = r abre "POST /api/aparelho/codigo" P 10 "{}" O 0 busca r k_c_escrita 0 }
: convidar_pedir >i ? ocupado 0 { ! 31 1 ! 34 13 = r abre "POST /api/convites" P 10 "{}" O 0 busca r k_c_escrita 0 }
: pedir_enviar >i ? ocupado 0 {
    ? < tlen @ 20 3 { = a abre "Escreve o que queres ouvir." O 0 aviso a 0 } {
      ! 31 1 ! 34 6
      = r tnovo + 600 * 7 tlen @ 20
      O r "POST /api/pedidos" P 10 "{\"texto\":" pjs @ 20 ",\"opcoes\":{\"faixas\":" N @ 24 ",\"maxArtista\":" N @ 25 ",\"estilo\":\"" estilo_json @ 26 "\",\"arco\":\"" arco_json @ 27 "\"" ? @ 45 { ",\"limpa\":true" 0 } 0 "}}" O 0
      busca r k_c_escrita 0 } }
: cancelar_ped i>i b ? ocupado 0 { ! 31 1 ! 34 7 = r abre "DELETE /api/pedidos/" purl b O 0 busca r k_c_escrita 0 }
: ligar_enviar >i ? ocupado 0 {
    ! 31 1 ! 34 2
    = cod Y 105 k_g_codigo 0
    = r tnovo + 400 * 7 tlen cod
    O r "POST /api/ligar" P 10 "{\"codigo\":" ? cod pjs cod "null" ",\"nome\":\"app Música\"}" O 0
    busca r k_c_escrita 0 }
: config_enviar >i ? ocupado 0 {
    ? ~ tlen @ 21 { = a abre "Cola o Client ID." O 0 aviso a 0 } {
      ! 31 1 ! 34 1
      = cod Y 105 k_g_codigo 0
      = r tnovo + 1200 * 7 tlen cod
      O r "POST /api/config" P 10 "{\"codigo\":" ? cod pjs cod "null" ",\"clientId\":" pjs @ 21 "}" O 0
      busca r k_c_escrita 0 } }
: aparelho_enviar >i ? ocupado 0 {
    ? < tlen @ 38 8 { = a abre "Cola o código de ligação." O 0 aviso a 0 } {
      ! 31 1 ! 34 10
      = r tnovo + 400 * 7 tlen @ 38
      O r "POST /api/aparelho" P 10 "{\"codigo\":" pjs @ 38 ",\"nome\":\"app Música\"}" O 0
      busca r k_c_escrita 0 } }
: desligar_enviar >i ? ocupado 0 { ! 31 1 ! 34 8 = r abre "POST /api/desligar" P 10 "{}" O 0 busca r k_c_escrita 0 }
: lido_escrita ii>i t s {
  = modo @ 34 ! 34 0 ! 31 0
  = r json t
  ? || == s 200 == s 201 {
    ? == modo 1 { = a abre "Client ID guardado. Agora liga o Tidal." O 0 aviso a busca k_p_estado k_c_estado 0 }
    ? == modo 2 { = u jgt r k_url ? u { = q tnovo + tlen u 8 O q "IR " tpor u O 0 busca q k_c_nada 0 } 0 0 }
    ? == modo 3 { ? == @ 1 1 { ! 51 r busca k_p_playlists k_c_pl 0 } { ! 4 r 0 } ! 28 0 render = a abre "Criada no Tidal." O 0 aviso a 0 }
    ? || == modo 4 == modo 9 { ! 4 r tcopia @ 30 jgt r k_id 70 ! 6 0 ! 28 0 render = a abre ? == modo 9 "Guardada no Tidal." "Guardada na app." O 0 aviso a 0 }
    ? == modo 14 { = c jgt r k_g_codigo ? c { tcopia @ 43 c 40 = w abre "Abre a Música (na app do ecrã principal, se a usares) e cola este código em «Código de ligação»: " tpor c " — serve uma vez, durante 24 h." O 0 = x abre purl w O 0 tcopia @ 44 x 580 render = a abre "Código criado: usa-o no outro aparelho." O 0 aviso a 0 } 0 0 }
    ? == modo 13 { = l jgt r k_url ? l { tcopia @ 41 l 200 = w abre "Experimenta a Música: playlists de qualidade no teu Tidal, feitas pelo Claude. Abre este link no iPhone (serve uma vez): " tpor l O 0 = x abre purl w O 0 tcopia @ 42 x 880 render = a abre "Convite criado: envia o link." O 0 aviso a 0 } 0 0 }
    ? == modo 17 { ? == @ 1 1 { ! 51 r render_cx 0 } { ! 4 r render 0 } 0 }
    ? == modo 18 { tvazio @ 49 render = a abre "Pedido de afinação enviado: o Maestro refá-la na próxima corrida." O 0 aviso a 0 }
    ? == modo 16 { ! 4 r ! 28 0 render = a abre ? == jtipo jg r k_tidal 7 "Nome mudado na app e no Tidal." "Nome mudado." O 0 aviso a 0 }
    ? == modo 15 { ! 4 r render = a abre ? == jtipo jg r $"renovar" 3 "Passa a atualizar-se sozinha toda a semana." "Deixa de se atualizar sozinha." O 0 aviso a 0 }
    ? == modo 12 { tcopia @ 30 jgt r k_id 70 ir 2 = a abre "Criada no Tidal — já a podes ouvir." O 0 aviso a 0 }
    ? == modo 5 { ir 1 = a abre "Apagada da app." O 0 aviso a 0 }
    ? == modo 11 { ir 1 = a abre "Apagada no Tidal e na app." O 0 aviso a 0 }
    ? == modo 6 { tvazio @ 20 busca k_p_pedidos k_c_ped render = a abre "Pedido feito — o Maestro trata dele na próxima corrida." O 0 aviso a 0 }
    ? == modo 7 { busca k_p_pedidos k_c_ped = a abre "Pedido cancelado." O 0 aviso a 0 }
    ? == modo 8 { ir 5 = a abre "Tidal desligado." O 0 aviso a 0 }
    ? == modo 10 { = ch jgt r k_g_chave ? ch { Y 106 k_g_chave ch tvazio @ 38 ir 1 = a abre "Este aparelho fica com acesso." O 0 aviso a 0 } 0 } 0 }
    { ! 28 0 render erro_ped t s 0 }
  0 }

# ===== Pedir =====
: lista_pedidos i>i pd {
  = c jprim pd = q 0
  W && c < q 12 {
    = op jg c k_opcoes
    = fe tigual jgt c k_estado k_v_feito
    "<div class=\"mu-pedido\"><div><div class=\"tx\">«" pjt jg c k_texto "»</div><div class=\"mt\">"
    ? fe { "feito a " pdia jgt c k_feitoEm 0 } { "à espera · " pdia jgt c k_criadoEm 0 }
    " · " N jgi op k_faixas " faixas · " nome_estilo idx_estilo jgt op k_estilo "</div></div>"
    ? && fe jgt c k_playlist { "<div class=\"mu-mini\">"
        ? jgt c k_tidal { "<a class=\"mu-btn peq\" href=\"" pjt jg c k_tidal "\" target=\"_blank\" rel=\"noopener\">" ic 4 "Ouvir</a>" 0 } 0
        "<button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"abrir&#9;" pjt jg c k_playlist "\">Ver</button></div>" 0 }
      { ? tigual jgt c k_estado k_v_pendente { "<button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"cancelar&#9;" pjt jg c k_id "\">Cancelar</button>" 0 } 0 }
    "</div>"
    = c jprox c = q + q 1 }
  0 }
: v_pedir >i {
  "<header class=\"mu-head\"><div><h1>Pedir</h1><div class=\"sub\">Ao Maestro, que pesquisa e cria no teu Tidal</div></div>" pill "</header>"
  ? && @ 3 ~ acesso boas_vindas 0
  "<div class=\"mu-card\"><h3>O que te apetece ouvir?</h3><label class=\"mu-campo\"><span class=\"sr\">Pedido</span><textarea data-onda=\"ptx\" maxlength=\"500\" placeholder=\"Ex.: jazz dos anos 60 bem gravado para a viagem de sábado\">" pt @ 20 "</textarea></label>"
  # o botao logo a seguir ao texto: com o teclado aberto (iPhone) fica a vista
  "<div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"pedir\"" ? acesso 0 " disabled" ">" ic 2 "Pedir ao Maestro</button></div><p class=\"mu-nota\">O Maestro prepara 2 ou 3 propostas às 07:44 e às 18:44; escolhes a que vai para o Tidal.</p>"
  # as opcoes ficam escondidas (uma linha com o resumo); "Mudar" mostra-as
  ? @ 39 {
      "<div class=\"mu-opcoes\"><span>Opções</span><button type=\"button\" class=\"mu-mais\" data-onda=\"opcoes\">Fechar</button></div>"
      "<label class=\"mu-campo\"><span>Faixas</span><div class=\"mu-range\"><input type=\"range\" data-onda=\"pd-n\" min=\"10\" max=\"60\" step=\"5\" value=\"" N @ 24 "\"><output id=\"pd-nv\">" N @ 24 "</output></div></label>"
      "<div class=\"mu-campo\"><span>Máximo por artista</span><div class=\"mu-seg\">" seg_af 4 4 1 @ 25 "</div></div>"
      "<div class=\"mu-campo\"><span>Estilo</span><div class=\"mu-seg\">" seg_af 5 5 0 @ 26 "</div></div>"
      "<div class=\"mu-campo\"><span>Energia ao longo da playlist</span><div class=\"mu-seg\">" seg_af 6 4 0 @ 27 "</div></div>"
      "<div class=\"mu-campo\"><span>Letras</span><div class=\"mu-seg\"><button type=\"button\" data-onda=\"pd-lp&#9;0\" aria-pressed=\"" ? @ 45 "false" "true" "\">Todas</button><button type=\"button\" data-onda=\"pd-lp&#9;1\" aria-pressed=\"" ? @ 45 "true" "false" "\">Sem letras explícitas</button></div></div>" 0 }
    { "<div class=\"mu-opcoes\"><span>" N @ 24 " faixas · até " N @ 25 " por artista · " nome_estilo @ 26 " · " nome_arco @ 27 ? @ 45 { " · sem letras explícitas" 0 } 0 "</span><button type=\"button\" class=\"mu-mais\" data-onda=\"opcoes\">Mudar</button></div>" 0 }
  "<div class=\"mu-ideias\"><span>Ideias</span></div>"
  # as ideias que o Maestro escreveu (as de dia de dia, as de noite à noite); sem elas, as de sempre
  "<div class=\"mu-chips\">" = n 0
  ? @ 48 { = c jprim jg @ 48 $"ideias" = q 0 W && c < n 7 { = mo jgt c $"momento" ? || tigual mo $"sempre" tigual mo ? e_dia $"dia" $"noite" { = pq jgt c $"porque" "<button type=\"button\" class=\"mu-chip" ? && pq tlen pq { " ideia\" data-onda=\"idea&#9;" N q "\"><b>" pjt jg c $"texto" "</b><span>" pt pq "</span>" 0 } { "\" data-onda=\"idea&#9;" N q "\">" pjt jg c $"texto" 0 } "</button>" = n + n 1 0 } 0 = c jprox c = q + q 1 } 0 } 0
  ? ~ n { = q 0 W < q 7 { "<button type=\"button\" class=\"mu-chip\" data-onda=\"sug&#9;" N q "\">" sugestao q "</button>" = q + q 1 } 0 } 0
  "</div></div>"
  ? jn @ 5 { "<h2 class=\"mu-sec\">Os teus pedidos</h2><div class=\"mu-card\">" lista_pedidos @ 5 "</div>" 0 } 0
  0 }

# ===== Gosto =====
: barra_j iii>i c modo mx { "<div class=\"mu-barra\"><span>" ? modo { N jgi c k_decada "s" 0 } pjt jg c k_nome "</span><span class=\"b\"><i style=\"width:" N / + * 200 jgi c k_n mx * 2 mx "%\"></i></span><span class=\"v\">" N jgi c k_n "</span></div>" 0 }
: barras_j ii>i l modo {
  = mx 1 = c jprim l W c { = mx Mx mx jgi c k_n = c jprox c }
  = n jn l
  "<div class=\"mu-mix\">"
  ? modo {
    = feito A + n 1 = q 0
    W && < q 8 < q n {
      = b -1 = bv 100000 = k 0 = c jprim l
      W c { ? && ~ @ + feito k < jgi c k_decada bv { = b k = bv jgi c k_decada 0 } 0 = c jprox c = k + k 1 }
      ! + feito b 1
      barra_j jidx l b 1 mx
      = q + q 1 }
    0 } { = c jprim l = q 0 W && c < q 8 { barra_j c 0 mx = c jprox c = q + q 1 } 0 }
  "</div>" 0 }
: v_gosto >i {
  = p @ 4
  "<header class=\"mu-head\"><div><h1>O teu gosto</h1><div class=\"sub\">" ? p { N jn jg p k_favoritas " favoritas · atualizado " pdia jgt p k_geradoEm 0 } "Das tuas favoritas no Tidal" "</div></div>" pill "</header>"
  ? ~ @ 3 carregar {
    ? ~ acesso boas_vindas {
      ? ~ p carregar {
        "<div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn sec\" data-onda=\"atualizar\">" ic 6 "Atualizar do Tidal</button></div>"
        ? @ 11 { v_tend @ 11 0 } 0
        = r jg p k_resumo
        ? jn jg r k_artistas { "<div class=\"mu-card\"><h3>Artistas que mais aparecem</h3>" barras_j jg r k_artistas 0 "</div>" 0 } 0
        ? jn jg r k_decadas { "<div class=\"mu-card\"><h3>Décadas</h3>" barras_j jg r k_decadas 1 "</div>" 0 } 0
        ? jn jg r k_generos { "<div class=\"mu-card\"><h3>Géneros (etiquetas do Tidal)</h3>" barras_j jg r k_generos 0 "</div>" 0 } 0
        = ql jg r k_qualidade
        ? jn ql { "<div class=\"mu-card\"><h3>Qualidade das favoritas</h3><div class=\"mu-chips\">" = c jprim ql W c { "<span class=\"mu-chip\">" pjt jg c k_q " · " N jgi c k_n "</span>" = c jprox c } "</div></div>" 0 } 0
        = ar jg p k_artistas
        ? jn ar { "<div class=\"mu-card\"><h3>Artistas que segues</h3><div class=\"mu-chips\">" = c jprim ar = q 0 W && c < q 40 { "<span class=\"mu-chip\">" pjt jg c k_nome "</span>" = c jprox c = q + q 1 } "</div></div>" 0 } 0
        "<h2 class=\"mu-sec\">Favoritas mais recentes</h2><ol class=\"mu-faixas\">"
        = fv jg p k_favoritas
        ? jn fv { = c jprim fv = q 0 W && c < q 25 { linha q c jtxt jprim jg c k_generos 0 0 0 0 0 0 = c jprox c = q + q 1 } 0 } "<li class=\"mu-vazio\">Sem favoritas.</li>"
        "</ol>"
        = pl jg p k_playlists
        ? jn pl { "<h2 class=\"mu-sec\">As tuas playlists no Tidal</h2><div class=\"mu-card\">" = c jprim pl = q 0 W && c < q 20 { "<div class=\"mu-pedido\"><div class=\"tx\">" pjt jg c k_nome "</div><a class=\"mu-btn sec peq\" href=\"" pjt jg c k_url "\" target=\"_blank\" rel=\"noopener\">Abrir</a></div>" = c jprox c = q + q 1 } "</div>" 0 } 0
        0 } } }
  0 }

# ===== Como correu (o conector avalia-a sozinho) e «atualizar sozinha» =====
: pl_correu i>i d {
  = a jg d $"avaliacao" = rv == jtipo jg d $"renovar" 3
  ? || a acesso {
    "<div class=\"mu-card mu-correu\">"
    ? a {
      = e jgt a $"etiqueta"
      "<h3>Como correu</h3><p>"
      ? || tigual e $"ainda cedo" tigual e $"sem sinais" { ? tigual e $"ainda cedo" "Ainda é cedo." "Ainda sem sinais." 0 } { "<b>" pt e "</b> · nota " N jgi a $"nota" 0 }
      = g jn jg a $"guardadas" ? g { " · guardaste " N g 0 } 0
      = t jn jg a $"tiradas" ? t { " · tiraste " N t 0 } 0
      ? jgi a $"juntadas" { " · juntaste " N jgi a $"juntadas" 0 } 0
      ? jn jg a $"eco" { " · nas tuas mixes: " partistas jg a $"eco" 0 } 0
      "</p><p class=\"mu-nota\">Sem perguntar nada: as faixas que guardas nas favoritas, as que tiras ou juntas no Tidal, e os artistas que o Tidal passa a pôr nas tuas mixes.</p>" 0 } 0
    ? acesso {
      "<div class=\"mu-interruptor\"><div><b>Atualizar sozinha</b><span class=\"mu-nota\">Toda a semana o Maestro renova-a com o mesmo critério, no mesmo link do Tidal: ficam as que guardaste, saem as que tiraste."
      ? jgt d $"renovadaEm" { " Última: " pdia jgt d $"renovadaEm" "." 0 } 0
      "</span></div><button type=\"button\" class=\"mu-btn sec peq\" data-onda=\"renovar\" aria-pressed=\"" ? rv "true" "false" "\">" ? rv "Ligado" "Desligado" "</button></div>" 0 } 0
    "</div>" 0 } 0
  0 }
# a faixa (id) esta marcada com «nao esta» na playlist aberta?
: rej_em ii>i d id { = c jprim jg d $"rejeitadas" = r 0 W && c ~ r { = r tigual jtxt c id = c jprox c } r }
: rej_tem i>i id rej_em ? == @ 1 1 @ 51 @ 4 id
# abre (ou fecha) o cartao de uma playlist na lista: um de cada vez; pede as faixas e as pre-escutas
: exp_alternar i>i b {
  ! 51 0 ! 52 0
  ? tigual b @ 50 { tvazio @ 50 render 0 } {
    tcopia @ 50 b 70 tcopia @ 30 b 70 render
    = u abre "/api/playlists/" purl b O 0 busca u $"lido_exp"
    = v abre "/api/playlists/" purl b "/previas" O 0 busca v $"lido_prev" 0 } }
: naoesta_enviar i>i b ? ocupado 0 { ! 31 1 ! 34 17 = r abre "POST /api/playlists/" purl @ 30 "/rejeitar" P 10 "{\"faixa\":" pjs b ",\"fora\":" ? rej_tem b "false" "true" "}" O 0 busca r k_c_escrita 0 }
: afinar_maestro >i ? ocupado 0 { ! 31 1 ! 34 18 = r tnovo + 400 * 7 tlen @ 49 O r "POST /api/playlists/" purl @ 30 "/afinar" P 10 "{\"texto\":" pjs @ 49 "}" O 0 busca r k_c_escrita 0 }
: renomear_enviar >i ? ocupado 0 {
    ? < tlen @ 46 1 { = a abre "Escreve um nome para a playlist." O 0 aviso a 0 } {
      ! 31 1 ! 34 16
      = r tnovo + 400 * 7 + tlen @ 46 tlen @ 47
      O r "POST /api/playlists/" purl @ 30 "/nome" P 10 "{\"nome\":" pjs @ 46 ",\"descricao\":" pjs @ 47 "}" O 0
      busca r k_c_escrita 0 } }
: renovar_pedir >i ? ocupado 0 { ! 31 1 ! 34 15 = r abre "POST /api/playlists/" purl @ 30 "/renovar" P 10 "{\"ativo\":" ? == jtipo jg @ 4 $"renovar" 3 "false" "true" "}" O 0 busca r k_c_escrita 0 }

# ===== Tendencias: o que se esta a ouvir (as tabelas que o conector recolhe todos os dias) =====
: tend_estado i>i t ? tigual t $"sobe" { "a subir" 0 } ? tigual t $"nova" { "nova" 0 } ? tigual t $"dura" { "dura" 0 } 0
# uma linha: o lugar, a cancao, o artista, o que se sabe dela; o play procura-a no Tidal
: tend_li ii>i c fonte {
  "<li class=\"mu-faixa\"><span class=\"n\">" N jgi c $"pos" "</span><div><div class=\"t\">" pjt jg c k_titulo "</div><div class=\"a\">" pjt jg c k_artista "</div><div class=\"m\">"
  ? fonte { pjt jg c $"fonte" " · n.º " N jgi c $"pos" 0 } 0
  = e jgt c k_estado ? && e tlen e { ? fonte " · " 0 "<b>" tend_estado e "</b>" ? && tigual e $"sobe" jgi c $"semana" { " (era " N jgi c $"semana" ".º)" 0 } 0 0 } 0
  ? fonte { " · " pjt jg c $"porque" 0 } 0
  "</div></div><div class=\"dir\"><a class=\"mu-tocar\" href=\"https://tidal.com/search?q=" purl jtxt jg c k_artista P '+ purl jtxt jg c k_titulo
  "\" target=\"_blank\" rel=\"noopener\" aria-label=\"Procurar «" pjt jg c k_titulo "» no Tidal\">" ic 4 "</a></div></li>" 0 }
: v_tend i>i t {
  "<h2 class=\"mu-sec\">O que se está a ouvir</h2>"
  ? ~ jgi t $"dias" { "<div class=\"mu-card\"><p class=\"mu-nota\">O conector guarda as tabelas do Apple Music e do Deezer uma vez por dia. As primeiras aparecem amanhã; o que sobe e o que dura vê-se ao fim de uma semana.</p></div>" 0 } {
    "<p class=\"mu-nota mu-tend-nota\">Tabelas do Apple Music e do Deezer · " N jgi t $"dias" " dia(s) de histórico. «A subir»: ganhou 10 lugares ou mais numa semana; «dura»: 3 semanas ou mais na tabela.</p>"
    = l jg t $"paraTi"
    ? jn l { "<div class=\"mu-card\"><h3>Para ti</h3><ol class=\"mu-faixas\">" = c jprim l = q 0 W && c < q 8 { tend_li c 1 = c jprox c = q + q 1 } "</ol></div>" 0 } 0
    = f jprim jg t $"fontes"
    W f {
      "<div class=\"mu-card\"><h3>" pjt jg f k_nome "</h3><ol class=\"mu-faixas\">"
      # o que sobe (ou, sem nada a subir, o topo)
      = q 0 = c jprim jg f $"itens" W && c < q 5 { ? tigual jgt c k_estado $"sobe" { tend_li c 0 = q + q 1 0 } 0 = c jprox c }
      ? ~ q { = c jprim jg f $"itens" W && c < q 5 { tend_li c 0 = c jprox c = q + q 1 } 0 } 0
      "</ol></div>"
      = f jprox f }
    0 } 0 }

# ===== Ajustes =====
: rr i>i i % * i 2654435761 1000
: testar_motor >i {
  = m marca
  = t0 Y 108 0 0
  = n 60
  = c ctx_novo n 30 2
  = w 0 W < w 5 { cs c + 3 w @ + @ 36 w = w + w 1 }
  cs c 8 300 cs c 9 250 cs c 10 200 cs c 11 1
  = i 0 W < i n {
    ap c 12 i % i 25 ap c 13 i + 1 % i 5 ap c 14 i decada + 1950 % * i 7 75
    ap c 29 i rr i ap c 30 i 750 ap c 31 i rr + i 7 ap c 32 i rr + i 3 ap c 33 i rr + i 11
    ap c 15 i rr + i 5 ap c 16 i + 70 % * i 13 100 ap c 17 i + 1 % * i 5 24 ap c 18 i 0
    = i + i 1 }
  curar c
  = ms - Y 108 0 0 t0
  = h tnovo 300 O h N cg c 27 " faixas escolhidas de 60 e ordenadas em " ? ms { N ms " ms" 0 } "menos de 1 ms" ", aqui no telemóvel." O 0
  Y 100 k_s_ajm h
  solta m }
: v_ajustes >i {
  "<header class=\"mu-head\"><div><h1>Ajustes</h1></div>" pill "</header>"
  = e @ 3
  ? ~ e carregar {
    "<div class=\"mu-card\"><h3>Tidal</h3>"
    ? ligado { "<dl class=\"mu-kv\"><dt>Conta</dt><dd>" pjt jg e k_utilizador " (" pjt jg e k_pais ")</dd><dt>Desde</dt><dd>" pdia jgt e k_ligadoEm "</dd><dt>Biblioteca</dt><dd>" N jgi e k_playlists " playlists · " N jgi e k_pedidos " pedidos à espera</dd></dl>" 0 } "<p>Não está ligado.</p>"
    "<div class=\"mu-acoes\">"
    ? || jg e k_tu Y 105 k_g_codigo 0 { "<button type=\"button\" class=\"mu-btn sec\" data-onda=\"ligar\">" ic 1 ? ligado "Ligar outra vez" "Ligar ao Tidal" "</button>" 0 } 0
    ? && ligado jg e k_tu { ? == @ 28 2 "<button type=\"button\" class=\"mu-btn perigo\" data-onda=\"desligar_sim\">Sim, desligar</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"nao\">Não</button>" { "<button type=\"button\" class=\"mu-btn perigo\" data-onda=\"desligar\">" ic 10 "Desligar o Tidal</button>" 0 } 0 } 0
    "</div>"
    ? ~ == jtipo jg e k_clientId 3 { "<p class=\"mu-nota\">Falta o Client ID no conector. Redirect URI a registar em developer.tidal.com: <code>" pjt jg e k_retorno "</code></p>" 0 } 0
    "</div>"
    = ch Y 105 k_g_chave 0
    "<div class=\"mu-card\"><h3>Este aparelho</h3><p>" ? ch ? jg e k_tu "Tem acesso à tua biblioteca e ao teu Tidal." "Tem uma chave que já não é válida." "Ainda não tem acesso." "</p>"
    ? ch { "<div class=\"mu-acoes\">" ? == @ 28 3 "<button type=\"button\" class=\"mu-btn perigo\" data-onda=\"esquecer_sim\">Sim, esquecer</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"nao\">Não</button>" { "<button type=\"button\" class=\"mu-btn perigo\" data-onda=\"esquecer\">" ic 11 "Esquecer este aparelho</button>" 0 } "</div>" 0 } 0
    # ligar outro aparelho da mesma pessoa (a app do ecra principal do iOS tem o seu armazem): um codigo de uma vez
    ? && ch jg e k_tu {
        ? tlen @ 43 { "<p>No outro aparelho (ou na app do ecrã principal), abre a Música e cola este código. Serve uma vez, durante 24 h.</p><p class=\"mu-codigo\">" pt @ 43 "</p>" 0 } 0
        "<div class=\"mu-acoes\">" ? tlen @ 44 { "<a class=\"mu-btn\" href=\"https://wa.me/?text=" tpor @ 44 "\" target=\"_blank\" rel=\"noopener\">Enviar por WhatsApp</a>" 0 } 0 "<button type=\"button\" class=\"mu-btn sec\" data-onda=\"ligar_outro\">" ic 1 ? tlen @ 43 "Criar outro código" "Ligar outro aparelho" "</button></div>" 0 } 0
    "</div>"
    ? == jtipo jg e k_dono 3 { "<div class=\"mu-card\"><h3>Partilhar a Música</h3><p>Cada pessoa liga o seu Tidal e tem as suas playlists e pedidos; o Maestro trata de todos.</p>"
        ? tlen @ 41 { "<label class=\"mu-campo\"><span>Link do convite (serve uma vez, durante 14 dias)</span><input readonly value=\"" pt @ 41 "\"></label><div class=\"mu-acoes\"><a class=\"mu-btn\" href=\"https://wa.me/?text=" tpor @ 42 "\" target=\"_blank\" rel=\"noopener\">Enviar por WhatsApp</a><a class=\"mu-btn sec\" href=\"mailto:?subject=Convite%20para%20a%20M%C3%BAsica&amp;body=" tpor @ 42 "\">Email</a></div><button type=\"button\" class=\"mu-mais\" data-onda=\"convidar\">Criar outro convite</button>" 0 }
          { "<div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn\" data-onda=\"convidar\">" ic 15 "Convidar alguém</button></div>" 0 }
        "</div>" 0 } 0
    "<div class=\"mu-card\"><h3>Conector de dados</h3><label class=\"mu-campo\"><span>Endereço</span><input data-onda=\"px\" value=\"" pt @ 22 "\" inputmode=\"url\" autocapitalize=\"off\" spellcheck=\"false\"></label><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn sec\" data-onda=\"px-ok\">Guardar</button><button type=\"button\" class=\"mu-btn sec\" data-onda=\"px-rep\">Repor</button></div></div>"
    "<div class=\"mu-card\"><h3>Motor de curadoria</h3><p>Esta app é toda em <b>Onda</b>, a linguagem que criaste: os ecrãs, o estado e o motor que escolhe e ordena as faixas (<code>motor.onda</code>) correm aqui no telemóvel, em WebAssembly, pelo anfitrião das apps Onda. O mesmo motor corre na tarefa agendada, e o juiz confirma que dá o mesmo, ao bit, em todas as formas.</p><div class=\"mu-acoes\"><button type=\"button\" class=\"mu-btn sec\" data-onda=\"motor\">" ic 7 "Testar o motor</button></div><p class=\"mu-motor\" id=\"aj-motor-r\"></p></div>"
    "<p class=\"mu-nota\">Música 2.16.2 · conector " pjt jg e k_versao " · <a href=\"https://github.com/nelsonsous/escolaplay/tree/main/musica\" target=\"_blank\" rel=\"noopener\">código</a></p>" 0 }
  0 }

# ===== navegacao e desenho =====
: ativo i>i v ? == @ 1 2 == v 1 == v @ 1
: nb i>i v { "<button type=\"button\" data-onda=\"ir&#9;" N v "\"" ? ativo v " aria-current=\"page\"" 0 ">" 0 }
: nav >i {
  nb 1 "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 6h11M4 11h11M4 16h7\"/><circle cx=\"17.5\" cy=\"16.5\" r=\"2.5\"/><path d=\"M20 16.5V5l2 1\"/></svg><span>Playlists</span></button>"
  nb 3 "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3.5c.7 4.6 2.9 6.8 7.5 7.5-4.6.7-6.8 2.9-7.5 7.5-.7-4.6-2.9-6.8-7.5-7.5 4.6-.7 6.8-2.9 7.5-7.5z\"/></svg><span>Pedir</span></button>"
  nb 4 "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z\"/></svg><span>Gosto</span></button>"
  nb 5 "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h10M18 7h2M4 17h4M12 17h8\"/><circle cx=\"16\" cy=\"7\" r=\"2\"/><circle cx=\"10\" cy=\"17\" r=\"2\"/></svg><span>Ajustes</span></button>"
  0 }
: render >i {
  = m marca
  = h tnovo 250000
  O h
  = v @ 1
  ? == v 1 v_playlists ? == v 2 v_playlist ? == v 3 v_pedir ? == v 4 v_gosto v_ajustes
  O 0
  Y 100 k_s_body h
  = g tnovo 4000
  O g nav O 0
  Y 100 k_s_nav g
  solta m }
# muda de vista: solta tudo o que a vista anterior reservou e pede o estado (e depois os dados)
: ir i>i v {
  solta @ 2
  = q 3 W <= q 19 { ! q 0 = q + q 1 }
  ! 28 0 = q 31 W <= q 35 { ! q 0 = q + q 1 } ! 37 0 ! 40 0 ! 48 0 ! 51 0 ! 52 0 tvazio @ 50
  ! 1 v
  render
  busca k_p_estado k_c_estado
  0 }
: abrir i>i b { tcopia @ 30 b 70 ir 2 }
: carregar_vista >i {
  = v @ 1
  ? acesso {
    ? == v 1 { busca k_p_playlists k_c_pl busca k_p_pedidos k_c_ped 0 }
    ? == v 2 { = u abre "/api/playlists/" purl @ 30 O 0 busca u k_c_doc 0 }
    ? == v 3 { busca k_p_pedidos k_c_ped busca $"/api/ideias" $"lido_ideias" 0 }
    ? == v 4 { busca k_p_perfil k_c_perfil busca $"/api/tendencias" $"lido_tend" 0 } 0 } 0
  0 }

# ===== respostas do conector =====
: lido_estado ii>i t s { ? == s 200 { ! 3 json t render carregar_vista 0 } { erro_ped t s 0 } 0 }
: lido_pl ii>i t s ? == @ 1 1 { ? == s 200 { ! 4 json t render 0 } { erro_ped t s 0 } } 0
: lido_ped ii>i t s ? || == @ 1 1 == @ 1 3 { ? == s 200 { ! 5 json t render 0 } 0 } 0
: lido_doc ii>i t s ? == @ 1 2 {
    ? == s 200 { = d json t ? tigual jgt d k_id @ 30 { ! 4 d render 0 } 0 0 }
      { erro_ped t s ? == s 404 ir 1 0 0 } } 0
: lido_perfil ii>i t s ? == @ 1 4 { ? == s 200 { ! 4 json t render 0 } { erro_ped t s 0 } } 0
: lido_exp ii>i t s ? && == @ 1 1 == s 200 { = d json t ? tigual jgt d k_id @ 50 { ! 51 d render_cx 0 } 0 0 } 0
: lido_prev ii>i t s ? && == @ 1 1 == s 200 { ! 52 json t render_cx 0 } 0
: lido_ideias ii>i t s ? && == @ 1 3 == s 200 { ! 48 json t render 0 } 0
: lido_tend ii>i t s ? && == @ 1 4 == s 200 { ! 11 json t render 0 } 0
: lido_pesq ii>i t s ? && == @ 1 2 @ 6 { ? == s 200 { ! 19 json t render 0 } { erro_ped t s 0 } } 0

# ===== eventos =====
: clique i>i t {
  = a tcampo t 0 = b tcampo t 1
  = fica 0
  ? tigual a k_a_ir { ir tint b = fica 1 0 }
  ? tigual a k_a_abrir { abrir b = fica 1 0 }
  ? tigual a k_a_enviar { enviar 0 }
  ? tigual a k_a_afinar { afinar_abrir = fica 1 0 }
  ? tigual a k_a_apagar { ! 28 1 render 0 }
  ? tigual a k_a_apagar_sim { apagar_pl 0 0 }
  ? tigual a k_a_apagar_tidal { apagar_pl 1 0 }
  ? tigual a k_a_opcoes { ! 39 ~ @ 39 render 0 }
  ? tigual a k_a_sel { = i + tint b 1 ! 40 ? == @ 40 i 0 i render 0 }
  ? tigual a k_a_mais { mais_criar b 0 }
  ? tigual a k_a_convidar { convidar_pedir 0 }
  ? tigual a k_a_ligar_outro { codaparelho_pedir 0 }
  ? tigual a k_a_nao { ! 28 0 render 0 }
  ? tigual a k_a_fixar { = i tint b ! + @ 17 i ~ @ + @ 17 i afinar_correr render 0 }
  ? tigual a k_a_tirar { = i tint b ! + @ 18 i 1 ! + @ 17 i 0 afinar_correr render 0 }
  ? tigual a k_a_afmx { ! 8 tint b afinar_correr render 0 }
  ? tigual a k_a_afes { ! 9 tint b afinar_correr render 0 }
  ? tigual a k_a_afar { ! 10 tint b afinar_correr render 0 }
  ? tigual a k_a_procurar { ? < tlen @ 23 2 { = m abre "Escreve pelo menos 2 letras." O 0 aviso m 0 } { = u tnovo + 40 * 3 tlen @ 23 O u "/api/pesquisa?q=" purl @ 23 O 0 busca u k_c_pesq = m abre "A procurar no Tidal…" O 0 aviso m 0 } }
  ? tigual a k_a_juntar { = r @ 19 = f ? r jidx jg r k_faixas tint b 0 ? f juntar_faixa f 0 0 }
  ? tigual a k_a_guardar { guardar_versao tint b 0 }
  ? tigual a k_a_sug { tvazio @ 20 O @ 20 sugestao tint b O 0 render 0 }
  ? tigual a k_a_pdmx { ! 25 tint b render 0 }
  ? tigual a k_a_pdes { ! 26 tint b render 0 }
  ? tigual a k_a_pdar { ! 27 tint b render 0 }
  ? tigual a $"pd-lp" { ! 45 tint b render 0 }
  ? tigual a $"renovar" { renovar_pedir 0 }
  ? tigual a $"renomear" { tcopia @ 46 jgt @ 4 k_nome 250 tcopia @ 47 jgt @ 4 k_descricao 1250 ! 28 2 render 0 }
  ? tigual a $"renomear_sim" { renomear_enviar 0 }
  ? tigual a $"naoesta" { naoesta_enviar b 0 }
  ? tigual a $"exp" { exp_alternar b 0 }
  ? tigual a $"agrupar" { ! 53 tint b Y 106 $"agrupar" b render 0 }
  ? tigual a $"afinar_pedir" { afinar_maestro 0 }
  ? tigual a $"idea" { = c jidx jg @ 48 $"ideias" tint b ? c { tcopia @ 20 jgt c $"texto" 1990 = e jgt c k_estilo ? e { ! 26 idx_estilo e 0 } 0 = q jgt c k_arco ? q { ! 27 idx_arco q 0 } 0 render 0 } 0 0 }
  ? tigual a k_a_pedir { pedir_enviar 0 }
  ? tigual a k_a_cancelar { cancelar_ped b 0 }
  ? tigual a k_a_ligar { ligar_enviar 0 }
  ? tigual a k_a_config { config_enviar 0 }
  ? tigual a k_a_atualizar { busca k_p_fresco k_c_perfil = m abre "A ler do Tidal…" O 0 aviso m 0 }
  ? tigual a k_a_desligar { ! 28 2 render 0 }
  ? tigual a k_a_desligar_sim { desligar_enviar 0 }
  ? tigual a k_a_esquecer { ! 28 3 render 0 }
  ? tigual a k_a_esquecer_sim { Y 106 k_g_chave 0 ir 5 = m abre "Aparelho esquecido." O 0 aviso m = fica 1 0 }
  ? tigual a k_a_pxok { Y 106 k_g_proxy @ 22 ir 5 = m abre "Conector guardado." O 0 aviso m = fica 1 0 }
  ? tigual a k_a_pxrep { Y 106 k_g_proxy 0 tcopia @ 22 k_t_proxy 390 ir 5 = m abre "Conector reposto." O 0 aviso m = fica 1 0 }
  ? tigual a k_a_motor { testar_motor 0 }
  ? tigual a k_a_usar { aparelho_enviar 0 } 0
  ? fica 0 solta t }
: campo i>i t {
  = a tcampo t 0 = b tcampo t 1
  ? tigual a k_f_cid { tcopia @ 21 b 110 0 }
  ? tigual a k_f_ptx { tcopia @ 20 b 1990 0 }
  ? tigual a k_f_q { tcopia @ 23 b 290 0 }
  ? tigual a k_f_px { tcopia @ 22 b 390 0 }
  ? tigual a k_f_cod { tcopia @ 38 b 90 0 }
  ? tigual a $"rn-nome" { tcopia @ 46 b 250 0 }
  ? tigual a $"rn-desc" { tcopia @ 47 b 1250 0 }
  ? tigual a $"af-tx" { tcopia @ 49 b 1990 0 }
  ? tigual a k_f_afn { ? @ 6 { ! 7 tint b afinar_correr parcial_afinar 0 } 0 }
  ? tigual a k_f_pdn { ! 24 tint b = h tnovo 8 O h N @ 24 O 0 Y 100 k_s_pdnv h 0 } 0
  solta t }

