# Conselheiro em Onda — publicar (o publicar.mjs): valida a análise escrita pelo Claude e grava-a no KV.
#   correr.mjs publicar /tmp/conselheiro/analise.json [/tmp/conselheiro/dados.json]
# Grava advice:<data>, advice:latest e advice:lessons (formato 2: um veredicto por ativo do dados.json, convicção
# 0–100 por prazo, níveis, o porquê, e a classificação por prazo). Os erros saem todos, pela ordem do JS.

#k k_dados0 /tmp/conselheiro/dados.json
#k k_rowsmapnf (dados.rows || []).map is not a function
#k k_umapnf (uniRows || []).map is not a function

# new Map(lista.map((r) => [r.s, r])): as chaves (SameValueZero) e os valores, pela ordem da 1.ª vez
: pu_mapa i>i l {
  ? ~ _js_ehlst l cs_lanca k_TypeError k_rowsmapnf 0
  = ks _js_lst _js_len l = vs _js_lst _js_len l = j 0
  W < j _js_len l {
    = r _js_it l j = s cs_getx r k_s
    = i -1 = m 0 W && < i 0 < m _js_len ks { ? _js_svz _js_it ks m s = i m 0 = m + m 1 }
    ? < i 0 { _js_push ks s _js_push vs r 0 } { ! + @ + vs 3 i r 0 }
    = j + j 1 }
  = mp _js_lst 2 _js_push mp ks _js_push mp vs }
: pu_mget ii>i mp s { = ks _js_it mp 0 = i -1 = m 0 W && < i 0 < m _js_len ks { ? _js_svz _js_it ks m s = i m 0 = m + m 1 } ? < i 0 1 _js_it _js_it mp 1 i }
: pu_mtem ii>i mp s != pu_mget mp s 1
# o FAM[k] (k: o ToPropertyKey) ou undefined (1)
: pu_fam i>i k { = v _js_oget cs_c k_FAM _js_str k v }
# um campo de lista com o índice: `${nome}[${i}]${resto}`
: pu_ni iii>i nome i resto { _an_abre 0 _tx_p nome P '[ N i P '] ? resto _tx_p resto 0 _an_fecha }
#k k_ps .s
#k k_pname .name
#k k_pamount .amount
#k k_pwhy .why
#k k_plan0 plan
#k k_risks0 risks
#k k_tldr0 tldr
#k k_movers0 movers
#k k_lessons0 lessons
: pu_lista ii>i a k { = v _js_get a k ? _js_ehlst v v _js_lst 0 }
# buildAdvice(a, dados, uniRows): o out (g_res) e os erros (g_errs)
: pu_build iii>i a dados uni {
  ? || ~ _js_v a ~ || _js_ehobj a _js_ehlst a {
      cs_eini "a análise tem de ser um objeto JSON" cs_efim 0 } {
  = drows cs_getx dados k_rows
  = rows pu_mapa ? _js_v drows drows _js_lst 0
  = ul ? _js_v uni uni _js_lst 0 ? ~ _js_ehlst ul cs_lanca k_TypeError k_umapnf 0
  = un pu_mapa ul
  = o _js_obj 16
  _js_oset o k_v _js_num 2.
  _js_oset o k_date cs_hoje
  _js_oset o k_generatedAt cs_iso
  _js_oset o k_headline cs_str _js_get a k_headline 160 k_headline 1
  _js_oset o k_market cs_str _js_get a k_market 1400 k_market 1
  _js_oset o k_planNote cs_str _js_get a k_planNote 160 k_planNote 0
  = pl pu_lista a k_plan = n Mn 6 _js_len pl = l _js_lst n = j 0
  W < j n {
    = x _js_it pl j = e _js_obj 4
    _js_oset e k_s cs_str cs_getx x k_s 24 pu_ni k_plan0 j k_ps 1
    _js_oset e k_name cs_str _js_get x k_name 60 pu_ni k_plan0 j k_pname 0
    _js_oset e k_amount cs_str _js_get x k_amount 30 pu_ni k_plan0 j k_pamount 1
    _js_oset e k_why cs_str _js_get x k_why 220 pu_ni k_plan0 j k_pwhy 0
    _js_push l e = j + j 1 }
  _js_oset o k_plan l
  = acts _js_lst 64 _js_oset o k_actions acts
  = rank _js_obj 3 _js_oset o k_rank rank
  = rk pu_lista a k_risks = n Mn 6 _js_len rk = l _js_lst n = j 0
  W < j n { _js_push l cs_str _js_it rk j 240 pu_ni k_risks0 j 0 1 = j + j 1 }
  _js_oset o k_risks l
  = tl pu_lista a k_tldr = n Mn 3 _js_len tl = ltl _js_lst n = j 0
  W < j n { _js_push ltl cs_str _js_it tl j 120 pu_ni k_tldr0 j 0 1 = j + j 1 }
  _js_oset o k_tldr ltl
  = mv pu_lista a k_movers = n Mn 10 _js_len mv = l _js_lst n = j 0
  W < j n {
    = x _js_it mv j = e _js_obj 2
    _js_oset e k_s cs_str cs_getx x k_s 24 pu_ni k_movers0 j k_ps 1
    _js_oset e k_why cs_str _js_get x k_why 260 pu_ni k_movers0 j k_pwhy 1
    _js_push l e = j + j 1 }
  _js_oset o k_movers l
  _js_oset o k_review cs_str _js_get a k_review 1400 k_review 0
  = le pu_lista a k_lessons = n Mn 15 _js_len le = lle _js_lst n = j 0
  W < j n { _js_push lle cs_str _js_it le j 240 pu_ni k_lessons0 j 0 1 = j + j 1 }
  _js_oset o k_lessons lle
  ? == _js_len _js_oget o k_plan 0 { cs_eini "plan vazio: diz sempre o que fazer com o plano do mês" cs_efim } 0
  ? == _js_len ltl 0 { cs_eini "tldr vazio: escreve o resumo em 3 linhas curtas (mercado · plano · atenção)" cs_efim } 0
  # um veredicto por ativo
  = av _js_get a k_actions = list ? _js_ehlst av av _js_lst 0
  ? ~ _js_ehlst av { cs_eini "actions tem de ser a lista dos veredictos (um por ativo)" cs_efim } 0
  = seen _js_lst 64 = j 0
  W < j _js_len list {
    = x _js_it list j
    = s ? _js_v x _js_get x k_s x = r pu_mget rows s
    _an_abre 0 "actions[" N j "] " ? _js_v s _js_ps s P '? = p _an_fecha
    ? && == r 1 ~ pu_mtem un s { cs_eini _tx_p p ": ativo desconhecido (não está no dados.json nem na lista da TR)" cs_efim } {
      ? _js_inc seen s { cs_eini _tx_p p ": repetido" cs_efim } {
        _js_push seen s
        = ref && != r 1 _js_eht _js_get r k_kind k_ref
        = v pu_norm x p ref ? != r 1 _js_get r k_price 2
        = ru ? != r 1 _js_get r k_rule 1
        ? && && != r 1 _js_v ru && != pu_fam ru 1 != pu_fam _js_get v k_key 1 {
            _js_oset v k_alg ru
            _an_abre 0 _tx_p p ".algWhy" = nm _an_fecha
            = w cs_str _js_get x k_algWhy 300 nm 0
            ? && ~ _js_eq pu_fam _js_get v k_key pu_fam ru _tx_branco w {
                = ra _js_get r k_ruleAction = ra ? _js_v ra ra cs_alabel _js_str ru
                cs_eini _tx_p p ": o teu veredicto (" _js_ps _js_get v k_action ") discorda do sinal automático (" _js_ps ra "): explica porquê em algWhy (até 300 caracteres)" cs_efim } 0
            ? ~ _tx_branco w _js_oset v k_algWhy w 0 0 } 0
        _js_push acts v 0 } }
    = j + j 1 }
  = ex 0 = j 0 W < j _js_len acts { ? ~ pu_mtem rows _js_get _js_it acts j k_s = ex + ex 1 0 = j + j 1 }
  ? > ex 8 { cs_eini "no máximo 8 ativos de fora das listas da app; vieram " N ex cs_efim } 0
  = rk0 _js_it rows 0 = mi _js_lst 8 = j 0 W < j _js_len rk0 { = s _js_it rk0 j ? ~ _js_inc seen s _js_push mi s 0 = j + j 1 }
  ? _js_len mi {
      cs_eini "faltam " N _js_len mi " ativos em actions (a app mostra o veredicto em todos): " = j 0 W < j _js_len mi { ? j ", " 0 _js_ps _js_it mi j = j + j 1 } cs_efim } 0
  # a classificação do Claude por prazo: só o que se compra
  = inv _js_lst 64 = j 0
  W < j _js_len acts {
    = x _js_it acts j = r pu_mget rows _js_get x k_s
    ? && ~ _js_inc cs_c k_REF_KEYS _js_get x k_key ~ && != r 1 _js_eht _js_get r k_kind k_ref _js_push inv x 0
    = j + j 1 }
  = ra _js_get a k_rank = rr ? && _js_v ra || _js_ehobj ra _js_ehlst ra ra _js_obj 0
  = hz cs_c k_HZ = i 0
  W < i 3 {
    = h _js_it hz i = gv _js_get rr h
    ? || _js_nulo gv && _js_ehlst gv == _js_len gv 0 {
        = f _js_lst 16 = j 0 W < j _js_len inv { = x _js_it inv j ? _js_fin _js_get x h _js_push f x 0 = j + j 1 }
        ! g_cmph h cs_ordena f 40
        = l _js_lst 10 = j 0 W < j Mn 10 _js_len f { _js_push l _js_get _js_it f j k_s = j + j 1 }
        _js_oset rank h l 0 } {
      ? ~ _js_ehlst gv { cs_eini "rank." _tx_p h " tem de ser uma lista de símbolos" cs_efim } {
        = l _js_lst 15 = pv 0 = j 0
        W < j Mn 15 _js_len gv {
          = s _js_it gv j
          = x 0 = m 0 W && ~ x < m _js_len inv { ? _js_eq _js_get _js_it inv m k_s s = x _js_it inv m 0 = m + m 1 }
          ? ~ x { cs_eini "rank." _tx_p h P '[ N j "]: " _js_ps s " não está em actions (ou é referência)" cs_efim } {
            ? _js_inc l s { cs_eini "rank." _tx_p h ": " _js_ps s " repetido" cs_efim } {
              ? && && pv _js_fin _js_get x h && _js_fin _js_get pv h > _js_f _js_get x h _js_f _js_get pv h {
                  cs_eini "rank." _tx_p h ": " _js_ps s " (" _js_ps _js_get x h ") atrás de " _js_ps _js_get pv k_s " (" _js_ps _js_get pv h "): ordena pela convicção ou ajusta-a" cs_efim } 0
              _js_push l s = pv x 0 } }
          = j + j 1 }
        _js_oset rank h l 0 } }
    = i + i 1 }
  # os preços no momento do conselho (em euros; a referência na sua unidade)
  = pr _js_obj 64 = dl ? _js_v drows drows _js_lst 0 = j 0
  W < j _js_len dl {
    = r _js_it dl j = pe _js_get r k_priceEur = p ? _js_nulo pe _js_get r k_price pe
    ? _js_fin p _js_oset pr _js_str _js_get r k_s p 0
    = j + j 1 }
  _js_oset o k_prices pr
  ! g_res o 0 } }
# normVerdict com as opções do publicar (scores 'req', plan)
: pu_norm iiii>i x p ref price cs_norm x p ref price 1 1
# o comparador do auto-rank (cs_cmp 40): y[h] - x[h]
: pu_cmp iii>f k x y - _js_tonum _js_get y @ g_cmph _js_tonum _js_get x @ g_cmph
: pu_corre >i {
  ! g_scr 5
  = f _an_arg 1
  ? || ~ f == _tx_len f 0 { _an_fd 2 "uso: publicar.mjs analise.json [dados.json]" P 10 _an_volta _an_sair 2 } 0
  = df _an_arg 2 = df ? df df k_dados0
  = a cs_lejson f
  = dados cs_lejson df
  = uf cs_junta cs_dirname df k_universojson
  = ur ? _an_existe uf { = u cs_lejson uf = r cs_getx u k_rows ? _js_v r r _js_lst 0 } _js_lst 0
  ! g_res 0
  pu_build a dados ur
  = e @ g_errs
  ? _js_len e { _an_fd 2 "Análise inválida (" N _js_len e "):\n- " = j 0 W < j _js_len e { ? j "\n- " 0 _tx_pu _js_it e j = j + j 1 } P 10 _an_volta _an_sair 1 } 0
  ! g_pout @ g_res
  _an_abre 0 "advice:" _tx_p _js_oget @ g_res k_date ! g_pk _an_fecha
  ! g_ph 1
  ? cs_kvput @ g_pk @ g_pout 0 cs_passo }
: pu_passo >i { = p @ g_ph ? == p 1 pu_p1 ? == p 2 pu_p2 ? == p 3 pu_p3 0 }
: pu_p1 >i { cs_rkvput @ g_pk cs_lancase ! g_ph 2 ~ cs_kvput k_advicelatest @ g_pout }
: pu_p2 >i { cs_rkvput k_advicelatest cs_lancase ! g_ph 3 ~ cs_kvput k_advicelessons _js_oget @ g_pout k_lessons }
: pu_p3 >i {
  cs_rkvput k_advicelessons cs_lancase
  = o @ g_pout
  "Publicado advice:" _tx_p _js_oget o k_date " (" N _js_len _js_oget o k_actions " ativos, " N _js_len _js_oget o k_plan " linhas de plano, "
  N _js_len _js_oget o k_lessons " lições; mais fortes a médio prazo: "
  = m _js_oget _js_oget o k_rank k_mid = j 0 W < j Mn 3 _js_len m { ? j ", " 0 _js_pu _js_it m j = j + j 1 } ")." P 10
  _an_sair 0 }
