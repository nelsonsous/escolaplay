  xqs 3 0
  0 }
: aic ii>i r v ? >= aimc v 3 alitp r v 0 aimm r v
: afc ii>i r b { = m afimm b ? >= m 0 x4 | | 0x1E601000 << m 13 r ? == b 0 afmovxd r 31 ? >= aimc b 2 alitp r b 1 { aimm 9 b afmovxd r 9 } }
