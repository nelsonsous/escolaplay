# operacoes de memoria, E/S e campos (produzem RI), despacho e saida
: cld >i { = p cx ckint p = r nt 0 ir 24 r p 0 0 0 0 r }
: cst >i { = p cx = v cx ckint p ckint v ir 25 0 p v 0 0 0 v }
: cldf >i { = p cx ckint p = r nt 1 ir 26 r p 0 0 0 0 r }
: cstf >i { = p cx = v cx ckint p ckflt v ir 27 0 p v 0 0 0 v }
: calc >i { = n cx ckint n = r nt 0 ir 28 r n 0 0 0 0 r }
: cput >i { = x cx ckint x ir 29 0 x 0 0 0 0 x }
: crd >i { = r nt 0 ir 30 r 0 0 0 0 0 r }
: cnum >i { = x cx ckint x ir 31 0 x 0 0 0 0 x }
: cgf >i { = x cx ckflt x ir 32 0 x 0 0 0 0 x }
: csnk >i { = p cx ckint p ir 33 0 p 0 0 0 0 p }
: cac >i { = r nt 0 ir 34 r 0 0 0 0 0 r }
: cav >i { = a cx = b cx ckint a ckint b = r nt 0 ir 35 r a b 0 0 0 r }
: cex >i { = c cx ckint c ir 36 0 c 0 0 0 0 c }
: ctm >i { = r nt 0 ir 37 r 0 0 0 0 0 r }
: csys >i { = c cx = a cx = b cx ckint c ckint a ckint b = r nt 0 ir 42 r c a b 0 0 r }
: fref i>i m {
  = i @ 7
  ? >= i @ 4 { ebeg "falta funcao" eend } 0
  ! 7 + i 1
  = k ? tkk i -1 ffun i
  ? < k 0 { ! 7 i ebeg "esperava funcao" eend } 0
  ? < @ fe k 2 m { ebeg "funcao com poucos parametros" eend } 0
  edge k
  k }
: ce >i {
  = d cx
  = n cx
  ckint d
  ckint n
  = k fref 1
  ? fpt k 0 { ebeg "indice deve ser inteiro" eend } 0
  = a cargs k 1
  ? isx lowE d n k a { ir 38 0 d n k a - @ fe k 2 1 d } }
: cs >i {
  = n cx
  ckint n
  = k fref 1
  ? fpt k 0 { ebeg "indice deve ser inteiro" eend } 0
  = a cargs k 1
  ? isx lowS n k a { = r nt @ fe k 3 ir 39 r n k a - @ fe k 2 1 0 r } }
: cd >i {
  = w cx
  = h cx
  ckint w
  ckint h
  = k fref 2
  ? || != fpt k 0 fpt k 1 @ fe k 3 { ebeg "funcao de pixel invalida" eend } 0
  = a cargs k 2
  ? isx lowD w h k a { = r nt 0 ir 40 r w h k a - @ fe k 2 2 r } }
: mlib >i && || || == @ 12 0 isw isx != tc @ fe @ 13 0 0 '_
: mlibp >i && || || || == @ 12 0 isw isx isjs != tc @ fe @ 13 0 0 '_
: cml2 i>i c { = a cx = b cx ckflt a ckflt b = q A 2 ! q a ! + q 1 b = k fby c ? < k 0 { ebeg "falta a matematica" eend } 0 = r rcall k q 2 edge k r }
: cml i>i c { = a cx ckflt a = q A 1 ! q a = k fby c ? < k 0 { ebeg "falta a matematica" eend } 0 = r rcall k q 1 edge k r }
: litv i>i p ? == @ p 2 @ + p 2 tokval @ + p 2
: blit ii>i p t && == @ + p 1 t || == @ p 2 && == @ p 1 ~ tty t
: cbw >i {
  = a cx
  = b cx
  ckint a
  ckint b
  = r nt 1
  = p + @ 18 * - @ 19 1 8
  = q - p 8
  ? && && >= @ 19 2 blit p b blit q a
    { = vb litv p = va litv q ! 19 - @ 19 2 ir 44 r & va 4294967295 & vb 4294967295 0 0 0 }
    { ir 43 r a b 0 0 0 }
  r }
: usesm >i {
  = p @ 1
  = e + @ 1 @ 2
  = r 0
  = st 0
  W && ~ r < + p 1 e {
    = c @ p
    = d @ + p 1
    = ini || == p @ 1 isws @ - p 1
    ? st
      { ? == c 92 = p + p 1 ? == c 34 = st 0 0 }
      { ? && == c 39 ini = p + p 1
        ? == c 34 = st 1
        ? && == c 35 ini { W && < p e != @ p 10 = p + p 1 }
        ? && || || && == c 'S == d 'n && == c 'C == d 's || || && == c 'E == d 'x && == c 'L == d 'g || && == c 'P == d 'w && == c 'A == d 't
             && ini || == + p 2 e isws @ + p 2 = r 1 0 }
    = p + p 1 }
  r }
: cop i>i i {
  = o tcode i
  ? isar o cbin i 2
  ? isbi o cbin i 0
  ? iscm o ccmp i
  ? == o k2 '& '& cand
  ? == o k2 '| '| cor
  ? == o '~ cnot
  ? == o 'F cun 0 0 1
  ? == o 'I cun 1 1 0
  ? == o k2 'S 'q cun 2 1 1
  ? == o k2 'S 'n ? mlib cml k3 '_ 's 'n cun 3 1 1
  ? == o k2 'C 's ? mlib cml k3 '_ 'c 's cun 4 1 1
  ? == o k2 'E 'x ? mlib cml k3 '_ 'x 'p cun 5 1 1
  ? == o k2 'L 'g ? mlib cml k3 '_ 'l 'g cun 6 1 1
  ? == o k2 'B 'h cun 11 1 0
  ? == o k2 'B 'l cun 12 1 0
  ? == o k2 'B 'w cbw
  ? == o k2 'F 'l cun 7 1 1
  ? == o k2 'A 'b cun 8 1 1
  ? == o k2 'P 'w ? mlibp cml2 k3 '_ 'p 'w cbf 9
  ? == o k2 'A 't ? mlib cml2 k3 '_ 'a 't cbf 10
  ? == o k2 'M 'n cmm 0
  ? == o k2 'M 'x cmm 1
  ? == o '? cif
  ? == o 'W cwh
  ? == o '{ cblk
  ? == o '= cset
  ? == o '@ cld
  ? == o '! cst
  ? == o k2 '@ 'f cldf
  ? == o k2 '! 'f cstf
  ? == o 'A calc
  ? == o 'P cput
  ? == o 'R crd
  ? == o 'N cnum
  ? == o 'G cgf
  ? == o 'O csnk
  ? == o k2 'A 'c cac
  ? == o k2 'A 'v cav
  ? == o 'X cex
  ? == o 'T ctm
  ? == o 'E ce
  ? == o 'S cs
  ? == o 'D cd
  ? == o 'Y csys
  { ! 7 i ebeg "operacao desconhecida" eend } }
: rdall >i {
  = s @ 1
  = n 0
  = c R
  W >= c 0 { ? >= n 1000000 { ebeg "fonte grande demais" eend } 0 ! + s n c = n + n 1 = c R }
  ! 2 n }
: ismain i>i k { = t @ fe k 0 && == tkl t 4 && && == tc t 0 'm == tc t 1 'a && == tc t 2 'i == tc t 3 'n }
: argeq i>i k {
  = t @ fe k 0
  = l tkl t
  = j 0
  = r 1
  W && r < j l { ? != tc t j Av 2 j = r 0 0 = j + j 1 }
  && r == Av 2 l 0 }
: emitf i>i k { ew @ fe k 6 - @ fe k 7 @ fe k 6 ew @ fe k 8 - @ fe k 9 @ fe k 8 }
: outc >i {
  prel
  = k 0
  W < k @ 6 { sighdr k ";\n" = k + k 1 }
  = k 0
  W < k @ 6 { emitf k = k + k 1 }
  "int main(int c,char**v){oinit(c,v);I r=f_main();oflush();return (int)r;}\n" }
: reach >i {
  = e -1
  = k 0
  W < k @ 6 { ? argeq k = e k 0 = k + k 1 }
  ? < e 0 { ebeg "funcao de entrada desconhecida" eend } 0
  ? || || < @ fe e 2 2 != fpt e 0 fpt e 1 @ fe e 3 { ebeg "funcao de pixel invalida" eend } 0
  ! fe e 10 1
  = ch 1
  W ch {
    = ch 0
    = j 0
    W < j @ 15 {
      = p + @ 14 * j 2
      ? && @ fe @ p 10 ~ @ fe @ + p 1 10 { ! fe @ + p 1 10 1 = ch 1 } 0
      = j + j 1 } }
  e }
: outj >i {
  = e reach
  = k 0
  "const obv=new DataView(new ArrayBuffer(8));function obh(x){obv.setFloat64(0,x);return obv.getInt32(0);}"
  "function obl(x){obv.setFloat64(0,x);return obv.getUint32(4);}function obw(h,l){obv.setInt32(0,h);obv.setUint32(4,l);return obv.getFloat64(0);}\n"
  W < k @ 6 { ? @ fe k 10 emitf k 0 = k + k 1 }
  "return f_" etx @ fe e 0 ";\n" }
: outg >i {
  = e reach
  "#version 300 es\nprecision highp float;\nprecision highp int;\nuniform float u[8];\nout vec4 oc;\n"
  "int obh(float x){return floatBitsToInt(x);}\nint obl(float x){return 0;}\nfloat obw(int h,int l){return intBitsToFloat(h);}\n"
  = k 0
  W < k @ 6 { ? @ fe k 10 { sighdr k ";\n" } 0 = k + k 1 }
  = k 0
  W < k @ 6 { ? @ fe k 10 emitf k 0 = k + k 1 }
  "void main(){int c=f_" etx @ fe e 0
  ? fpt e 0 "(floor(gl_FragCoord.x),u[2]-1.0-floor(gl_FragCoord.y)" "(int(gl_FragCoord.x),int(u[2])-1-int(gl_FragCoord.y)"
  = j 2
  W < j @ fe e 2 { ? fpt e j { ",u[" N - j 2 "]" } { ",int(u[" N - j 2 "])" } = j + j 1 }
  ");oc=vec4(float((c>>16)&255),float((c>>8)&255),float(c&255),255.0)/255.0;}\n" }
: main >i {
  ! 12 ? && == Av 1 0 '- == Av 1 1 'g 1 ? && == Av 1 0 '- == Av 1 1 'j 2 ? && == Av 1 0 '- == Av 1 1 'w 3 ? && == Av 1 0 '- == Av 1 1 'x 4 ? && == Av 1 0 '- == Av 1 1 'c 5 ? && == Av 1 0 '- == Av 1 1 'v 6 0
  ! 1 A 1000000
  rdall
  ? || isw isx { ! 23 + @ 1 @ 2 O 23 wrt O 0 ! 2 - @ 23 @ 1 ! 20 64 ! 21 A 40000 ! 22 0 } 0
  ? && || || || == @ 12 0 isw isx isjs usesm { ! 23 + @ 1 @ 2 O 23 wmat O 0 ! 2 - @ 23 @ 1 } 0
  ! 3 A + 3 * 3 @ 2
  ! 5 A 120000
  ! 8 A 40000
  ! 10 A 400000
  ! 14 A 400000
  ! 16 A 3000000
  ! 17 A 1500000
  ! 18 A 800000
  lex
  pre
  = m 0
  = k 0
  W < k @ 6 { ? && ismain k && == @ fe k 2 0 == @ fe k 3 0 = m 1 0 = k + k 1 }
  ? || m && && != @ 12 0 ~ isw ~ isx 0 { ebeg "falta : main >i" eend }
  ? || isx isc inlf 0
  ? isc ! 50 xtab 0
  ? isx { ! 26 A 10000 ! 28 A 400000 ! 29 0 xpre } 0
  ? isx { ! 34 A 420000 ! 35 A 20000 ! 36 A 420000 ! 37 A 420000 ! 38 A 420000 ! 39 A 200008 ! 40 A 20000 ! 42 A 420000 ! 43 A 420000 ! 46 A 10000 ! 47 A 10000 ! 50 xtab ! 51 A 420000 ! 52 A 420000 ! 56 A 420000 ! 57 A 420000 ! 58 A 420000 ! 59 A 420000 ! 60 A 420000 ! 61 A 32 xqs 0 A 1680000 xqs 1 A 100000 xqs 2 A 420000 xqs 6 A 420000 xqs 8 A 800000 xqs 9 A 420000 xqs 10 A 100000 xqs 11 A 20000 xqs 13 A 100000 xqs 14 A 20000 xqs 16 A 20000 } 0
  ? isc outz
    { = k 0
      W < k @ 6 { cfun k = k + k 1 }
      ? isx outx ? isw outw ? isjs outj ? @ 12 outg outc }
  0 }
