: k_texto >i @ + @ 0 47
: k_estado >i @ + @ 0 48
: k_feitoEm >i @ + @ 0 49
: k_criadoEm >i @ + @ 0 50
: k_playlist >i @ + @ 0 51
: k_favoritas >i @ + @ 0 52
