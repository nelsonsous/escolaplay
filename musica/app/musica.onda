  ? mesmo a $"abrir" { abrir b = fica 1 0 }
  ? mesmo a $"enviar" { enviar 0 }
  ? mesmo a $"afinar" { afinar_abrir = fica 1 0 }
  ? mesmo a $"apagar" { ! 28 1 render 0 }
  ? mesmo a $"apagar_sim" { apagar_pl 0 0 }
  ? mesmo a $"apagar_tidal" { apagar_pl 1 0 }
  ? mesmo a $"opcoes" { ! 39 ~ @ 39 render 0 }
  ? mesmo a $"sel" { = i + _tx_int b 1 ! 40 ? == @ 40 i 0 i render 0 }
  ? mesmo a $"mais" { mais_criar b 0 }
  ? mesmo a $"convidar" { convidar_pedir 0 }
  ? mesmo a $"ligar_outro" { codaparelho_pedir 0 }
  ? mesmo a $"nao" { ! 28 0 render 0 }
  ? mesmo a $"fixar" { = i _tx_int b ! + @ 17 i ~ @ + @ 17 i afinar_correr render 0 }
  ? mesmo a $"tirar" { = i _tx_int b ! + @ 18 i 1 ! + @ 17 i 0 afinar_correr render 0 }
  ? mesmo a $"af-mx" { ! 8 _tx_int b afinar_correr render 0 }
  ? mesmo a $"af-es" { ! 9 _tx_int b afinar_correr render 0 }
  ? mesmo a $"af-ar" { ! 10 _tx_int b afinar_correr render 0 }
  ? mesmo a $"procurar" { ? < _tx_len @ 23 2 { aviso $"Escreve pelo menos 2 letras." 0 } { = u _tx_abre + 40 * 3 _tx_len @ 23 `/api/pesquisa?q={ purl @ 23 }` _tx_fecha u _an_buscar u $"lido_pesq" aviso $"A procurar no Tidal…" 0 } }
  ? mesmo a $"juntar" { = r @ 19 = f ? r idx r.faixas _tx_int b 0 Se f juntar_faixa f 0 }
  ? mesmo a $"guardar" { guardar_versao _tx_int b 0 }
  ? mesmo a $"sug" { tvazio @ 20 Oc @ 20 1990 sugestao _tx_int b O 0 render 0 }
  ? mesmo a $"pd-mx" { ! 25 _tx_int b render 0 }
  ? mesmo a $"pd-es" { ! 26 _tx_int b render 0 }
  ? mesmo a $"pd-ar" { ! 27 _tx_int b render 0 }
  ? mesmo a $"pd-lp" { ! 45 _tx_int b render 0 }
  ? mesmo a $"renovar" { renovar_pedir 0 }
  ? mesmo a $"renomear" { tcopia @ 46 txt _ar_get @ 4 $"nome" 250 tcopia @ 47 txt _ar_get @ 4 $"descricao" 1250 ! 28 2 render 0 }
  ? mesmo a $"renomear_sim" { renomear_enviar 0 }
  ? mesmo a $"naoesta" { naoesta_enviar b 0 }
  ? mesmo a $"exp" { tvazio @ 54 exp_alternar b 0 }
  ? mesmo a $"ouvir" { ouvir b 0 }
  ? mesmo a $"avisos" { render Se _tx_len b aviso b }
  ? mesmo a $"recarregar" { _an_esquecer carregar_vista 0 }
  ? mesmo a $"apagarl" { tcopia @ 54 b 70 tvazio @ 50 ! 51 0 ! 52 0 render 0 }
  ? mesmo a $"apagarl_n" { tvazio @ 54 render 0 }
  ? mesmo a $"apagarl_s" { tcopia @ 30 b 70 apagar_pl 0 0 }
  ? mesmo a $"apagarl_t" { tcopia @ 30 b 70 apagar_pl 1 0 }
  ? mesmo a $"filtro" {
      = q - _tx_b b 0 48
      ? || == q 0 && && == q @ 53 == - _tx_len b 1 _tx_len @ 59 tigualem b 1 @ 59 { ! 53 0 tvazio @ 59 0 }
        { ! 53 q tvazio @ 59 Oc @ 59 79 = j 1 W < j _tx_len b { P _tx_b b j = j + j 1 } O 0 0 }
      render 0 }
  ? mesmo a $"juntar_modo" { ! 56 1 tvazio @ 58 tvazio @ 50 ! 51 0 ! 52 0 tvazio @ 54 render 0 }
  ? mesmo a $"juntar_nao" { ! 56 0 tvazio @ 58 render 0 }
  ? mesmo a $"esc" { esc_alt b 0 }
  ? mesmo a $"juntar_sim" { juntar_enviar 0 }
  ? mesmo a $"afinar_pedir" { afinar_maestro 0 }
  ? mesmo a $"idea" { = c idx _ar_get @ 48 $"ideias" _tx_int b Se c { tcopia @ 20 txt c.texto 1990 = e txt c.estilo Se e ! 26 idx_estilo e = q txt c.arco Se q ! 27 idx_arco q render } }
  ? mesmo a $"pedir" { pedir_enviar 0 }
  ? mesmo a $"cancelar" { cancelar_ped b 0 }
  ? mesmo a $"ligar" { ligar_enviar 0 }
  ? mesmo a $"config" { config_enviar 0 }
  ? mesmo a $"atualizar" { _an_buscar $"/api/perfil?fresco=1" $"lido_perfil" aviso $"A ler do Tidal…" 0 }
  ? mesmo a $"desligar" { ! 28 2 render 0 }
  ? mesmo a $"desligar_sim" { desligar_enviar 0 }
  ? mesmo a $"esquecer" { ! 28 3 render 0 }
  ? mesmo a $"esquecer_sim" { _an_gravar $"chave" 0 ir 5 aviso $"Aparelho esquecido." = fica 1 0 }
  ? mesmo a $"px-ok" { _an_gravar $"proxy" @ 22 ir 5 aviso $"Conector guardado." = fica 1 0 }
  ? mesmo a $"px-rep" { _an_gravar $"proxy" 0 tcopia @ 22 $"https://musica.mercados-proxy.workers.dev" 390 ir 5 aviso $"Conector reposto." = fica 1 0 }
  ? mesmo a $"motor" { testar_motor 0 }
  Se mesmo a $"usar" aparelho_enviar
  ? fica 0 _me_solta t }
: campo i>i t {
  = a _tx_campo t 0 9 = b _tx_campo t 1 9
  ? mesmo a $"cid" { tcopia @ 21 b 110 0 }
  ? mesmo a $"ptx" { tcopia @ 20 b 1990 0 }
  ? mesmo a $"q" { tcopia @ 23 b 290 0 }
  ? mesmo a $"px" { tcopia @ 22 b 390 0 }
  ? mesmo a $"cod" { tcopia @ 38 b 90 0 }
  ? mesmo a $"rn-nome" { tcopia @ 46 b 250 0 }
  ? mesmo a $"rn-desc" { tcopia @ 47 b 1250 0 }
  ? mesmo a $"af-tx" { tcopia @ 49 b 1990 0 }
  ? mesmo a $"af-n" { Se @ 6 { ! 7 _tx_int b afinar_correr parcial_afinar } }
  Se mesmo a $"pd-n" { ! 24 _tx_int b = h _ht_ini 8 N @ 24 _ht_poe $"#pd-nv" h }
  _me_solta t }

# ===== arranque =====
: main >i {
  _me_lb
  ! 36 A 25
  = w @ 36
  ! + w 0 300 ! + w 1 200 ! + w 2 200 ! + w 3 300 ! + w 4 100
  ! + w 5 150 ! + w 6 200 ! + w 7 150 ! + w 8 350 ! + w 9 400
  ! + w 10 150 ! + w 11 150 ! + w 12 500 ! + w 13 250 ! + w 14 150
  ! + w 15 550 ! + w 16 150 ! + w 17 50 ! + w 18 200 ! + w 19 0
  ! + w 20 150 ! + w 21 500 ! + w 22 50 ! + w 23 300 ! + w 24 100
  ! 20 _tx_novo 2000 ! 21 _tx_novo 120 ! 22 _tx_novo 400 ! 23 _tx_novo 300 ! 30 _tx_novo 80 ! 38 _tx_novo 100 ! 41 _tx_novo 220 ! 42 _tx_novo 900 ! 43 _tx_novo 40 ! 44 _tx_novo 600 ! 46 _tx_novo 260 ! 47 _tx_novo 1300 ! 49 _tx_novo 2000 ! 50 _tx_novo 80 ! 54 _tx_novo 80 ! 55 _tx_novo 1000 ! 57 _tx_novo 80 ! 58 _tx_novo 400 ! 59 _tx_novo 80
  ! 53 0 ! 56 0
  ! 24 30 ! 25 2 ! 26 0 ! 27 0
  = px _an_ler $"proxy"
  ? px { tcopia @ 22 px 390 0 } { tcopia @ 22 $"https://musica.mercados-proxy.workers.dev" 390 0 }
