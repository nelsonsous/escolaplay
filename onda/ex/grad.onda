# Autodiff AUTOMATICO: o operador B gera a derivada f'(x) de um elemento de mapa por diferenciacao simbolica
# (numeros duais) da mesma arvore que o xvan valida (+ - * / sobre x e constantes). A derivada de uma arvore
# destas e outra arvore destas -> B compila para um laco em RI que corre em C, x86 e WASM, igual ao bit.
#   B d n f a   ->   d[i] = f'(a[i])
# Aqui conferimos o f' automatico contra diferencas finitas centradas (verdade de terreno). O automatico e
# EXATO; as diferencas finitas e que tem erro O(e^2). uso: ./onda run ex/grad.onda [n]
: g ii>f i a { = x @f + a i + 0.1 * x + 0.2 * x + 0.3 * x + 0.4 * x + 0.5 * x + 0.6 * x + 0.7 * x 0.8 }
: encher ii>i p n { = i 0 W < i n { !f + p i F + % i 7 1 = i + i 1 } p }
: shift iiif>i p a n e { = i 0 W < i n { !f + p i + @f + a i e = i + i 1 } p }
: natoi i>i a { = v 0 = j 0 = c Av a 0 W && >= c '0 <= c '9 { = v + * v 10 - c '0 = j + j 1 = c Av a j } v }
: main >i {
  = n ? >= Ac 2 natoi 1 8
  = a encher A n n
  = dd A n
  B dd n g a                                         # <- autodiff: dd[i] = g'(a[i]), gerado por diferenciacao simbolica
  = e 0.0001
  = ap shift A n a n e
  = am shift A n a n - 0.0 e
  = gp A n  E gp n g ap
  = gm A n  E gm n g am
  "grad n=" N n "\n"
  = i 0
  W < i n {
    = fd / - @f + gp i @f + gm i * 2.0 e
    "x=" G @f + a i " fprime=" G @f + dd i " fd=" G fd "\n"
    = i + i 1 }
  0 }
