  agT 10 dd aaddlsl 17 28 10 3
  = lo @ + p 6
  ? > lo 0
    { agT 9 - lo 1 ascvtf 0 9 aimm 10 0x3FF0000000000000 afmovxd 24 10 afadd 24 0 24 x4 0x6E180700 }
    { aimm 9 0 afmovxd 0 31 aimm 10 0x3FF0000000000000 afmovxd 24 10 x4 0x6E180700 }
  aimm 10 0x4000000000000000 x4 | | 0x4E080C00 << 10 5 24
  vfbin 2 '+ 16 0 24
  aimm 10 0x4010000000000000 x4 | | 0x4E080C00 << 10 5 24
  = l0 @ 16
  aaddi 10 9 4 acmp 10 14 = pe @ 16 abcc 0xC 0
  ! st 15 = r asbody k a 2 2 4 0 st aaddlsl 12 17 9 3 x4 | | 0x3D800000 << 12 5 r
  ! st 15 = r asbody k a 2 18 20 16 st aaddlsl 12 17 9 3 x4 | | | 0x3D800000 << 1 10 << 12 5 r
  vfbin 2 '+ 0 0 24 vfbin 2 '+ 16 16 24
  aaddi 9 9 4 ab - l0 @ 16
  apbc pe 0xC
  = l1 @ 16
  acmp 9 14 = pt @ 16 abcc 0xA 0
  ascvtf 0 9
  ! st 15 = r asbody k a 1 2 4 0 st astrdx r 17 9
  aaddi 9 9 1 ab - l1 @ 16
  apbc pt 0xA
  ! 7 s7
  0 }
: asum i>i p {
  = d @ + p 1
  = n @ + p 2
  = k @ + p 3
  = a @ + p 4
  = s7 @ 7
  = st A 1
  ! @ 54 0
  ! + @ 52 8 0
  ! 53 0 ! st 15 asbody k a 2 2 4 0 st
  ! 53 1
  agT 14 n
  = lo @ + p 5
  ? > lo 0
    { agT 9 - lo 1 ascvtf 0 9 aimm 10 0x3FF0000000000000 afmovxd 24 10 afadd 24 0 24 x4 0x6E180700 }
    { aimm 9 0 afmovxd 0 31 aimm 10 0x3FF0000000000000 afmovxd 24 10 x4 0x6E180700 }
  aimm 10 0x4000000000000000 x4 | | 0x4E080C00 << 10 5 24
  vfbin 2 '+ 16 0 24
