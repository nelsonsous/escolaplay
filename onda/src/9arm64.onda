# literais inteiros como imediatos: add/sub #imm12, cmp #imm12, lsl/asr #imm6. 58: o literal so tem usos imediatos (nao se
# materializa nem ocupa registo)
: alit i>i t { = j @ + @ 47 t ? || < j 0 != @ + @ 46 t 1 0 { = q + @ 18 * j 8 = k @ q || == k 2 && == k 1 ~ tty t } }
: alitv i>i t { = q + @ 18 * @ + @ 47 t 8 ? == @ q 2 @ + q 2 tokval @ + q 2 }
: afold i>i p {
  = k @ p
  = c @ + p 4
  ? && == k 8 ~ tty @ + p 1
    ? alit c { = v alitv c = o opof @ + p 2
      ? || == o '+ == o '- || asmi v asmi - 0 v
      ? || == o k2 '< '< == o k2 '> '> && >= v 0 < v 64
      ? || || == o '& == o '| == o '^ >= alogi v 0 0 } 0
  ? && == k 9 ~ tty @ + p 3 ? alit c asmi alitv c 0 0 }
: aimf >i {
  = nt @ 11
  = v 0
  W < v + nt @ 9 { ! + @ 58 v 0 = v + v 1 }
  = t 0
  W < t nt {
    ? && alit t > @ + @ 45 t 0 {
      = u 0
      = i 0
      W < i @ 19 { = p + @ 18 * i 8 ? && afold p == @ + p 4 t = u + u 1 0 = i + i 1 }
      ? && == u @ + @ 45 t == @ + @ 35 t t ! + @ 58 t 1 0 } 0
    = t + t 1 }
  0 }
: asubi iii>i rd rn imm x4 | | | 0xD1000000 << imm 10 << rn 5 rd
: asmi i>i v && >= v 0 || < v 4096 && == & v 0xFFF 0 < v 16777216
: aenc12 i>i v ? < v 4096 << v 10 | << 1 22 << >> v 12 10
: aaddx iii>i rd rn v x4 | | | 0x91000000 aenc12 v << rn 5 rd
: asubx iii>i rd rn v x4 | | | 0xD1000000 aenc12 v << rn 5 rd
: acmpx ii>i rn v x4 | | | 0xF1000000 aenc12 v << rn 5 31
# mascara de uns contiguos (positiva) -> immr<<6 | imms do imediato logico de 64 bits (N=1), ou -1
: alogi i>i v {
  ? <= v 0 -1 {
    = p 0
    W == & >> v p 1 0 = p + p 1
    = t >> v p
    = n 0
    W & t 1 { = n + n 1 = t >> t 1 }
    ? t -1 | << & - 64 p 63 6 - n 1 } }
: aopi iiii>i o r x v {
  ? == o '+ ? asmi v aaddx r x v asubx r x - 0 v
  ? == o '- ? asmi v asubx r x v aaddx r x - 0 v
  ? == o k2 '< '< x4 | | | | 0xD3400000 << & - 64 v 63 16 << - 63 v 10 << x 5 r
  ? == o k2 '> '> x4 | | | 0x9340FC00 << v 16 << x 5 r
  x4 | | | ? == o '& 0x92400000 ? == o '| 0xB2400000 0xD2400000 << alogi v 10 << x 5 r }
# bloco de literais por funcao (ldr x/d, =const: 1 instrucao em vez de 3-5). xq 0 valores 1 n 2 correcoes 3 n
: aimc i>i v { = n 1 = j 16 W < j 64 { ? & >> v j 0xffff = n + n 1 0 = j + j 16 } n }
: alitp iii>i rt v fl {
  = n xq 1
  = r -1
  = j 0
  W && < r 0 < j n { ? == @ + xq 0 j v = r j 0 = j + j 1 }
  ? && < r 0 < n 8000 { ! + xq 0 n v xqs 1 + n 1 = r n } 0
  ? < r 0 { ? fl { aimm 9 v afmovxd rt 9 } aimm rt v }
    { = m xq 3 ! + xq 2 * m 2 @ 16 ! + xq 2 + * m 2 1 r xqs 3 + m 1 x4 | ? fl 0x5C000000 0x58000000 rt } }
: apool >i {
  ? xq 1 {
    = b @ 16
    = j 0 W < j xq 1 { x8 @ + xq 0 j = j + j 1 }
    = m 0
    W < m xq 3 {
      = pos @ + xq 2 * m 2
      = i @ + xq 2 + * m 2 1
      = w | | | @ pos << @ + pos 1 8 << @ + pos 2 16 << @ + pos 3 24
      xput4 pos | & w 0xFF00001F << & / - + b * 8 i pos 4 0x7FFFF 5
      = m + m 1 } } 0
