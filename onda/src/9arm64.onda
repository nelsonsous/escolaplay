  apbc pe 0xC
  vfbin 2 '+ 1 1 17 x4 0x7E70D821
  = l1 @ 16
  acmp 9 14 = pt @ 16 abcc 0xA 0
  ascvtf 0 9
  ! st 15 = r asbody k a 1 2 4 0 st afadd 1 1 r
  aaddi 9 9 1 ab - l1 @ 16
  apbc pt 0xA
  asTf 1 d
  ! 7 s7
  0 }

# --- pilha de ciclos (nested W): @63 = array; [0] = profundidade; cada moldura = (inicio, pos_do_cbz) ---
: adep >i @ @ 63
: afrm i>i i + @ 63 + 1 * i 4
: a21 >i { = d adep = f afrm d ! f @ 16 ! + f 1 -1 ! + f 2 -1 ! + f 3 -1 ! @ 63 + d 1 }
: a22 i>i p {
  = a @ + p 2
  = f afrm - adep 1
  ? afl p
    { ? == @ - p 8 11 { ! + f 1 aipop ! + f 2 aipop } { ! + f 1 aipop ap19 aipop ! + f 2 -1 } }
    { = x ? >= @ 49 0 0 aox 9 a ! + f 1 @ 16 abr x ! + f 2 -1 }
  ! + f 3 @ 16 }
: a23 >i {
  = f afrm - adep 1
  = c1 @ + f 1
  = c2 @ + f 2
  = e1 -1
  = e2 -1
  ? arotok f { = r arot f = e1 @ r = e2 @ + r 1 } ? atdup @ f 0 ab - @ f @ 16
  ? >= c1 0 ap19 c1 0
  ? >= c2 0 ap19 c2 0
  ? >= e1 0 ap19 e1 0
  ? >= e2 0 ap19 e2 0
  ! @ 63 - adep 1 }
# duplicacao da cauda num salto para tras: o salto vai dar a poucas instrucoes e a um salto condicional ja resolvido
# -- copiam-se, e so a saida paga um salto (no ciclo da recursao com acumulador)
: atdup i>i t {
  = p t
  W && < p + t 32 && == abk arw p 0 ~ amau arw p = p + p 4
  = w arw p
  ? || || != abk w 1 >= p + t 32 == abim w 0 0 {
    = g + p * 4 abim w
    ? && >= g t <= g p 0 {
      = j t
      W < j p { x4 arw j = j + j 4 }
      x4 abset w / - g @ 16 4
      ab - + p 4 @ 16
      1 } } }
# rotacao dos ciclos: em vez de saltar para o teste no inicio, o fim do ciclo repete o teste (curto, sem nada relativo
# ao pc alem dos saltos) e volta ao corpo com a condicao invertida -- um salto por volta em vez de dois
: arw i>i p | | | @ p << @ + p 1 8 << @ + p 2 16 << @ + p 3 24
: abk i>i w ? == & w 0xFF000010 0x54000000 1 ? == & w 0x7E000000 0x34000000 1 ? == & w 0xFC000000 0x14000000 2 0
: abim i>i w ? == abk w 2 { = v & w 0x3FFFFFF ? >= v 0x2000000 - v 0x4000000 v } { = v & >> w 5 0x7FFFF ? >= v 0x40000 - v 0x80000 v }
: abset ii>i w o ? == abk w 2 | & w 0xFC000000 & o 0x3FFFFFF | & w 0xFF00001F << & o 0x7FFFF 5
: amau i>i w || || || == & w 0x3B000000 0x18000000 == & w 0x1F000000 0x10000000 || == & w 0xFC000000 0x94000000 == & w 0xFE000000 0xD6000000 || == & w 0xFFE0001F 0xD4000001 == & w 0x7E000000 0x36000000
: arotok i>i f {
  = t @ f
  = b @ + f 3
  = c1 @ + f 1
  = c2 @ + f 2
  = ok && > b t <= - b t 64
  ? ok = ok || == - b 4 c1 == - b 4 c2 0
  = p t
  W && ok < p b {
    = w arw p
    ? || == p c1 == p c2 = ok == abk w 1 { ? amau w = ok 0 { ? > abk w 0 = ok != abim w 0 0 } }
    = p + p 4 }
  ok }
: arot i>i f {
  = t @ f
  = b @ + f 3
  = c1 @ + f 1
  = c2 @ + f 2
  = r A 2
  ! r -1
  ! + r 1 -1
  = q0 @ 16
  = p t
  W < p b {
    = w arw p
    = q @ 16
    ? == p - b 4
      { = v ? == & w 0xFF000000 0x54000000 ^ w 1 ^ w 0x01000000 x4 abset v / - b q 4 }
      { ? || == p c1 == p c2
          { x4 w ? < @ r 0 ! r q ! + r 1 q }
          { ? > abk w 0
              { = g + p * 4 abim w
                = ng ? && >= g t < g b + q0 - g t g
                x4 abset w / - ng q 4 }
              x4 w } }
    = p + p 4 }
  r }

# tabela de chamadas: @64[0] = n; cada par (posicao do bl no buffer, indice da funcao alvo). Corrigida no outa.
: acsrec ii>i pos fi { = c @ @ 64 = b + @ 64 + 1 * c 2 ! b pos ! + b 1 fi ! @ 64 + c 1 }
# despacho de syscall em linha (Y a b c): a=numero logico, b/c=args; resultado em d. 0=escrever, 2=sair,
# 7=brk (devolve o limite fixo de M). svc #0 x8 no Linux (-a); svc #0x80 x16 no macOS (-m). Escreve byte a
# byte (o byte vai para M[-8]) -- simples e correto; o benchmark usa o codigo de saida, nao a impressao.
: arb >i - amw 8704
# palavras de M: 2^31 (16 GiB virtuais, so se ocupa o que se usa) no Mac (-m); 2^25 (256 MiB) no ELF do Linux (-a)
: amw >i ? ismo 2147483648 33554432
: ascn i>i r ? ismo { aimm 16 r asvc80 } { aimm 8 r x4 0xD4000001 }
# escrever(fd 1, M[arg1..], arg2): cada char ocupa um slot; junta-os em blocos de ate 4096 bytes na pilha
: aswr >i {
  amovr 3 1 amovr 4 2 aimm 5 0
  asubsp 4096
  = wo @ 16
  acmp 5 4 = pwe @ 16 abcc 0xA 0
  aimm 6 0
  = wi @ 16
  aimm 10 4096 acmp 6 10 = pf1 @ 16 abcc 0xA 0
  acmp 5 4 = pf2 @ 16 abcc 0xA 0
  aadd 10 3 5 aldrx 11 28 10 x4 0x38266BEB
  aaddi 6 6 1 aaddi 5 5 1 ab - wi @ 16
  apbc pf1 0xA apbc pf2 0xA
  aimm 0 1 aaddi 1 31 0 amovr 2 6 ascn ? ismo 4 64
  ab - wo @ 16
  apbc pwe 0xA
  aaddsp 4096
  amovr 0 4 }
# ler 1 byte de fd 0: buffer de 64 KiB no fim de M (slot arb). Num programa com R (ou Y), x27 = posicao fica fora do
# alocador (@67) durante o programa todo; o fim fica em M[-14] (so muda ao encher). Caminho rapido: adr, ldur, cmp,
# salto (nao tomado) e ldrb com pos-incremento. 0/0 no arranque: o primeiro R enche o buffer.
: aldur iii>i rt rn off x4 | | | 0xF8400000 << & off 0x1FF 12 << rn 5 rt
: astur iii>i rt rn off x4 | | | 0xF8000000 << & off 0x1FF 12 << rn 5 rt
: asrd >i {
  = fi pfind -2
  ? < fi 0 { = fi pnew -2 @ 13 } 0
  # adr x17, depois do ldrb; x16 = fim (M[-14]); cmp x27, x16; b.hs _rs (enche, le o byte e volta por x17); ldrb
  x4 0x100000B1
  aldur 16 28 -112
  acmp 27 16
  acsrec @ 16 fi x4 0x54000002
  x4 0x38401760 }
# _rs (campo 12 = -2): o caminho lento do R, fora de linha. read(0, buffer, 64 KiB); x27 = inicio, M[-14] = fim; le o
# byte; volta por x17. No fim do ficheiro x0 = -1. O caminho rapido em linha nao tem saltos tomados.
: arsn i>i k {
  O 16
  ! fe k 8 @ 16
  aimm 0 0 aimm 10 arb aaddlsl 1 28 10 3 aimm 2 65536 ascn ? ismo 3 63
  acmpi 0 0 = rz @ 16 abcc 0xD 0
  aimm 10 arb aaddlsl 27 28 10 3 aadd 10 27 0 astur 10 28 -112
  x4 0x38401760 x4 0xD61F0220
  apbc rz 0xD
  aimm 0 -1 x4 0xD61F0220
  ! fe k 9 @ 16
  O 0 }
# _fm (campo 12 = -6): Fm p o. Abre o ficheiro cujo caminho esta em M[p..] (um byte por palavra, terminado por 0) e
# mapeia-o inteiro (mmap, so leitura) em M a partir da palavra o (tem de ser multiplo de 2048 = uma pagina). Devolve o
# tamanho em bytes, ou -1. As paginas carregam a pedido: um modelo de GB fica disponivel sem copia nem espera.
: afmn i>i k {
  O 16
  ! fe k 8 @ 16
  amovr 9 1
  x4 0xD11003FF
  aaddlsl 2 28 0 3
  aaddi 3 31 0
  = lpk @ 16
  x4 0xF8408445 x4 0x38001465
  x4 | | 0xB5000000 << & / - lpk @ 16 4 0x7FFFF 5 5
  aaddi 0 31 0 aimm 1 0 aimm 2 0 ascn ? ismo 5 5
  = ferr @ 16 abcc 0x2 0
  amovr 10 0
  amovr 0 10 aimm 1 0 aimm 2 2 ascn ? ismo 199 199
  amovr 11 0
  aaddlsl 0 28 9 3 amovr 1 11 aimm 2 1 aimm 3 18 amovr 4 10 aimm 5 0 ascn ? ismo 197 197
  = merr @ 16 abcc 0x2 0
  amovr 0 10 ascn ? ismo 6 6
  x4 0x911003FF amovr 0 11 x4 0xD65F03C0
  apbc ferr 0x2 apbc merr 0x2
  x4 0x911003FF aimm 0 -1 x4 0xD65F03C0
  ! fe k 9 @ 16
  O 0 }
# _pb (campo 12 = -5): Pb p n. write(1, &M[p], n) ate escrever tudo (em pedacos de ate 1 GiB); x0 = p, x1 = n.
: apbn i>i k {
  O 16
  ! fe k 8 @ 16
  aaddlsl 3 28 0 3 amovr 5 1 amovr 4 1
  = lp @ 16
  acmpi 5 0 = d1 @ 16 abcc 0xD 0
  aimm 0 1 amovr 1 3 amovr 2 5 aimm 10 1073741824 x4 0xEB0A005F x4 0x9A8AB042
  ascn ? ismo 4 64
  acmpi 0 0 = d2 @ 16 abcc 0xD 0
  aadd 3 3 0 x4 0xCB0000A5
  ab - lp @ 16
  apbc d1 0xD apbc d2 0xD
  amovr 0 4 x4 0xD65F03C0
  ! fe k 9 @ 16
  O 0 }
# _rp (campo 12 = -4): Rp p n. Le n bytes do stdin, CRUS (8 por palavra), para a memoria a partir de M[p]: primeiro o
# que resta no buffer do R, depois read() direto para o destino (sem copia). x0 = p, x1 = n; devolve os bytes lidos.
: arpn i>i k {
  O 16
  ! fe k 8 @ 16
  aaddlsl 3 28 0 3 aimm 4 0 amovr 5 1
  = lp @ 16
  acmp 4 5 = d1 @ 16 abcc 0xA 0
  aldur 8 28 -112
  x4 0xCB1B0106
  acmpi 6 0 = dr @ 16 abcc 0x0 0
  # do buffer: m = min(n - c, disponivel); c += m; copia m bytes
  x4 0xCB0400A7 x4 0xEB0600FF x4 0x9A86B0E6 aadd 4 4 6
  = il @ 16
  x4 0x38401769 x4 0x38001469 x4 0xF10004C6
  abcc 0x1 - il @ 16
  ab - lp @ 16
  # buffer vazio: read(0, destino, min(n - c, 1 GiB)) direto
  apbc dr 0x0
  aimm 0 0 amovr 1 3 x4 0xCB0400A2 aimm 10 1073741824 x4 0xEB0A005F x4 0x9A8AB042
  ascn ? ismo 3 63
  acmpi 0 0 = d2 @ 16 abcc 0xD 0
  aadd 3 3 0 aadd 4 4 0
  ab - lp @ 16
  apbc d1 0xA apbc d2 0xD
  amovr 0 4 x4 0xD65F03C0
  ! fe k 9 @ 16
  O 0 }
# _rb (campo 12 = -3): Rb p n. Copia ate n bytes do stdin para M[p..] (um byte por palavra), pelo mesmo buffer do R
# (x27; fim em M[-14]); enche-o com read() quando se esgota. x0 = p, x1 = n; devolve em x0 quantos leu (menos de n so no fim).
: arbn i>i k {
  O 16
  ! fe k 8 @ 16
  aaddlsl 3 28 0 3 aimm 4 0 amovr 5 1
  = lp @ 16
  acmp 4 5 = d1 @ 16 abcc 0xA 0
  aldur 8 28 -112
  acmp 27 8 = hv @ 16 abcc 0x3 0
  aimm 0 0 aimm 10 arb aaddlsl 1 28 10 3 aimm 2 65536 ascn ? ismo 3 63
  acmpi 0 0 = d2 @ 16 abcc 0xD 0
  aimm 10 arb aaddlsl 27 28 10 3 aadd 8 27 0 astur 8 28 -112
  apbc hv 0x3
  # m = min(n - c, fim - pos); c += m; copia m bytes
  x4 0xCB0400A6 x4 0xCB1B0107 x4 0xEB0700DF x4 0x9A87B0C6 aadd 4 4 6
  # 16 bytes de cada vez em NEON: ldr q0; uxtl 8b->8h->4s->2d; st1 de 4 registos (64 bytes) duas vezes
  = vl @ 16
  x4 0xF10040DF
  = vs @ 16 abcc 0xB 0
  x4 0x3CC10760 x4 0x2F08A401 x4 0x6F08A402 x4 0x2F10A423 x4 0x6F10A424 x4 0x2F10A445 x4 0x6F10A446
  x4 0x2F20A470 x4 0x6F20A471 x4 0x2F20A492 x4 0x6F20A493 x4 0x2F20A4B4 x4 0x6F20A4B5 x4 0x2F20A4D6 x4 0x6F20A4D7
  x4 0x4C9F2C70 x4 0x4C9F2C74 x4 0xD10040C6
  ab - vl @ 16
  apbc vs 0xB
  # o resto (0..15 bytes), um a um
  acmpi 6 0 abcc 0x0 - lp @ 16
  = il @ 16
  x4 0x38401769 x4 0xF8008469 x4 0xF10004C6
  abcc 0x1 - il @ 16
  ab - lp @ 16
  apbc d1 0xA apbc d2 0xD
  amovr 0 4 x4 0xD65F03C0
  ! fe k 9 @ 16
  O 0 }
: asex >i { amovr 0 1 ascn ? ismo 1 93 }
: asbk >i aimm 0 arb
: asac >i { aimm 10 -9 aldrx 0 28 10 }
# Av i j: byte j do argumento i (0 fora dos limites ou depois do fim); argv em M[-10]
: asav >i {
  aimm 0 0 aimm 10 -9 aldrx 11 28 10
  acmpi 1 0 = v1 @ 16 abcc 0xB 0
  acmp 1 11 = v2 @ 16 abcc 0xA 0
  acmpi 2 0 = v3 @ 16 abcc 0xB 0
  aimm 10 -10 aldrx 11 28 10 aldrx 11 11 1
  aimm 10 0
  = vl @ 16
  acmp 10 2 = v4 @ 16 abcc 0xA 0
  x4 0x386A696C = v5 @ 16 x4 0xB400000C
  aaddi 10 10 1 ab - vl @ 16
  apbc v4 0xA
  x4 0x38626960
  apbc v1 0xB apbc v2 0xA apbc v3 0xB xput4 v5 | | 0xB4000000 << & / - @ 16 v5 4 0x7FFFF 5 12 }
# T: microssegundos (gettimeofday: 116 no macOS, 169 no Linux) -> struct em M[-12..-11]
: astm >i {
  aimm 10 -12 aaddlsl 0 28 10 3 aimm 1 0 aimm 2 0
  ascn ? ismo 116 169
  aimm 10 -12 aldrx 11 28 10 aimm 10 -11 aldrx 12 28 10 x4 0x2A0C03EC
  aimm 10 1000000 amul 11 11 10 aadd 0 11 12 }
: as1 i>i op ? == op 0 aswr ? == op 1 asrd ? == op 2 asex ? == op 7 asbk ? == op 3 asac ? == op 4 asav ? == op 6 astm aimm 0 0
# syscall Y (a = numero logico em x0 se op < 0; args em x1/x2; resultado em x0). Com a operacao conhecida a compilacao,
# so a rotina dela; senao o despachante completo. 0 escrever, 1 ler, 2 sair, 3 argc, 4 Av, 6 tempo, 7 brk.
: asc i>i op {
  ? >= op 0 as1 op {
    = q A 8
    = c 0
    W < c 7 { = o ? == c 0 0 ? == c 1 1 ? == c 2 2 ? == c 3 7 ? == c 4 3 ? == c 5 4 6 acmpi 0 o ! + q c @ 16 abcc 0 0 = c + c 1 }
    aimm 0 0
    = e A 8
    ! e @ 16 ab 0
    = c 0
    W < c 7 { = o ? == c 0 0 ? == c 1 1 ? == c 2 2 ? == c 3 7 ? == c 4 3 ? == c 5 4 6 apbc @ + q c 0 as1 o ! + e + c 1 @ 16 ab 0 = c + c 1 }
    = c 0
    W < c 8 { apb @ + e c = c + c 1 }
    0 } }
: ains0 i>i p {
  = k @ p
  = d @ + p 1
  = a @ + p 2
  = b @ + p 3
  = c @ + p 4
  ? == k 1 ? || @ + @ 58 d == aloc d -3 0 { ? tty d { = r adf 0 d afc r afbits a afd r d } { = r adx 9 d aic r tokval a afx r d } }
  ? == k 2 ? || @ + @ 58 d == aloc d -3 0 { = r adx 9 d aic r a afx r d }
  ? == k 4 { ? tty d { = r adf 0 d afmovxd r 31 afd r d } { = r adx 9 d aimm r 0 afx r d } }
  ? == k 5 amvv d + @ 11 b
  ? == k 6 amvv + @ 11 c b
  ? == k 8 { = o opof a ? tty d
    { = ii / - p @ 18 8
      = m @ + @ 51 ii
      ? == m -2 0
      ? >= m 0 {
        = q + @ 18 * m 8
        = mt @ + q 1
        = ad ? == c mt b c
        = x aod 0 @ + q 3 = y aod 1 @ + q 4 = z aod 2 ad = r adf 0 d
        x4 | | | | ? == o '+ 0x1F400000 ? == ad c 0x1F608000 0x1F408000 << y 16 << z 10 << x 5 r
        afd r d }
      { = x aod 0 b = y aod 1 c = r adf 0 d
      ? == o '+ afadd r x y ? == o '- afsub r x y ? == o '* afmul r x y ? == o '/ afdiv r x y { ebeg "operador real ainda nao em -a" eend } afd r d } }
    ? afold p { = x aox 9 b = r adx 9 d aopi o r x alitv c afx r d }
    { = x aox 9 b = y aox 10 c = r adx 9 d
      ? == o '+ aadd r x y ? == o '- asub r x y ? == o '* amul r x y ? == o '/ asdiv r x y
      ? == o '% { asdiv 11 x y amsub r 11 y x } ? == o '& aand r x y ? == o '| aorr r x y
      ? == o '^ aeor r x y ? == o k2 '< '< alsl r x y ? == o k2 '> '> aasr r x y
      { ebeg "operador ainda nao em -a" eend } afx r d } }
  ? == k 9 { = z afz p ? tty b { = x aod 0 b = y aod 1 c afcmp x y ? z ! 49 afcc opof a { = r adx 9 d acset r ^ afcc opof a 1 afx r d } } { = x aox 9 b ? afold p acmpx x alitv c { = y aox 10 c acmp x y } ? z ! 49 acc opof a { = r adx 9 d acset r ^ acc opof a 1 afx r d } } }
  ? == k 15 { ? == a 0 { = x aox 9 b = r adf 0 d ascvtf r x afd r d } ? == a 1 { = x aod 0 b = r adx 9 d afcvtzs r x afx r d }
    ? == a 2 { agTf 0 b x4 0x1E61C000 asTf 0 d } ? == a 7 { agTf 0 b x4 0x1E654000 asTf 0 d } ? == a 8 { agTf 0 b x4 0x1E60C000 asTf 0 d }
    ? == a 11 { = x aox 9 b = r adx 9 d x4 | | 0x9360FC00 << x 5 r afx r d } ? == a 12 { = x aox 9 b = r adx 9 d x4 | | 0x2A0003E0 << x 16 r afx r d }
    ? || == a 3 == a 4 { agTf 0 b aimm 9 0x3FC45F306DC9C883 afmovxd 1 9 afmul 2 0 1 x4 0x1E644042
      aimm 9 0x401921FB54442D18 afmovxd 1 9 x4 0x1F418040 aimm 9 0x3CB1A62633145C07 afmovxd 1 9 x4 0x1F418040
      acallf fby ? == a 3 k3 '_ 's 'n k3 '_ 'c 's asTf 0 d }
    { ebeg "funcao matematica ainda nao em -a: " N a eend } }
  ? == k 43 { = x aox 9 a = y aox 10 b x4 | 0x2A0003EA << y 16 x4 | | 0xAA008149 << x 16 0 asV 9 d }
  ? == k 44 ? == aloc d -3 0 { = bt | << a 32 b ? tty d { = r adf 0 d afc r bt afd r d } { = r adx 9 d aic r bt afx r d } }
  ? == k 45 0
  ? == k 3 { = q sreg a aimm 0 q aimm 1 slen a acallf aro 's }
  ? == k 60 { = x aox 9 a amovr 1 x aimm 2 c = q @ 16 x4 0x10000000 acsrec q b acallf pfind 1 }
  ? == k 21 a21
  ? == k 22 a22 p
  ? == k 23 a23
  ? == k 24 { = x aox 9 a = r adx 10 d aldrx r 28 x afx r d }
  ? == k 46 { = x aox 9 a = r adx 9 d aaddlsl r 28 x 3 afx r d }
  ? == k 47 { = x aox 9 a = bb aox 11 c = r adx 10 d aldrx r bb x afx r d }
  ? == k 48 { = x aox 9 a = y aox 10 b = bb aox 11 c astrx y bb x }
  ? == k 49 { = x aox 9 a = bb aox 11 c = r adf 0 d aldrdx r bb x afd r d }
  ? == k 50 { = x aox 9 a = y aod 0 b = bb aox 11 c astrdx y bb x }
  ? == k 25 { = x aox 9 a = y aox 10 b astrx y 28 x }
  ? == k 26 { = x aox 9 a = r adf 0 d aldrdx r 28 x afd r d }
  ? == k 27 { = x aox 9 a = y aod 0 b astrdx y 28 x }
  ? == k 10 ? afl p { = x ? >= @ 49 0 0 aox 9 a = q @ 16 abr x aipush q } { aimm 9 0 asT 9 d = x aox 9 a = p @ 16 x4 | 0xB4000000 x aipush p }
  ? == k 11 ? afl p { = x ? >= @ 49 0 0 aox 9 a = q @ 16 abr x aipush q } { agT 9 a acmpi 9 0 acset 9 0 asT 9 d apcbz aipop }
  ? == k 12 ? afl p { = x ? >= @ 49 0 0 aox 9 a = q @ 16 abrt x aipush q } { aimm 9 1 asT 9 d = x aox 9 a = p @ 16 x4 | 0xB5000000 x aipush p }
  ? == k 13 ? afl p { = x ? >= @ 49 0 0 aox 9 a = q @ 16 abr x aipush q } { agT 9 a acmpi 9 0 acset 9 0 asT 9 d apcbnz aipop }
  ? == k 14 { = x aox 9 a acmpi x 0 = r adx 9 d acset r 1 afx r d }
  ? == k 17 { ? tty b { = x aod 0 b = y aod 1 c afcmp x y = r adf 0 d x4 | | | | 0x1E600C00 << y 16 << ? a 0xC 0x4 12 << x 5 r afd r d } { = x aox 9 b = y aox 10 c acmp x y = r adx 9 d acsel r x y ? a 0xC 0xB afx r d } }
  ? == k 18 ? afl p { ? == @ - p 8 11 aipush -2 { = fp aipop ap19 aipop aipush fp aipush -1 } } { = x ? >= @ 49 0 0 aox 9 a = q @ 16 abr x aipush q aipush -1 }
  ? == k 19 { astod d a = q @ 16 ab 0 = m - 0 aipop W > m 0 { ap19 aipop = m - m 1 } aipush q }
  ? == k 20 { astod d a apb aipop }
  ? == k 28 { agT 0 a acallf aro 'a asT 0 d }
  ? == k 66 {
    # Qe: x9 = &w (nibbles), x1 = escalas bf16 de w (depois dos n/2 bytes), x10 = &x, x11 = escalas de x, x12 = blocos
    = ra aox 9 a aaddlsl 9 28 ra 3
    = rb aox 10 b aaddlsl 10 28 rb 3
    = rc aox 11 c aasri 12 rc 5 aasri 1 rc 1 aadd 1 9 1 aadd 11 10 rc
    x4 0x9E6703E0 x4 0x4F00E507
    = lq @ 16
    x4 0x3CC10521 x4 0x4F0C5422 x4 0x6F0C0442 x4 0x6F0C0423 x4 0x6E278442 x4 0x6E278463 x4 0xACC11544
    x4 0x6F00E406 x4 0x4E849446 x4 0x4E859466 x4 0x4EB1B8C6 x4 0x0F20A4C6 x4 0x5E61D8C6
    x4 0x78402422 x4 0x53103C42 x4 0x1E270041 x4 0x1E22C021 x4 0x1E6108C6
    x4 0xFC408561 x4 0x1F4100C0 x4 0xF100058C
    abcc 0x1 - lq @ 16
    = r adf 0 d ? != r 0 x4 | 0x1E604000 r 0 afd r d }
  ? == k 64 {
    # Qd: x9 = &w, x10 = &x, x11 = escalas (depois dos n bytes de x), x12 = n/32 blocos; soma em d0
    = ra aox 9 a aaddlsl 9 28 ra 3
    = rb aox 10 b aaddlsl 10 28 rb 3
    = rc aox 11 c aasri 12 rc 5 aadd 11 10 rc
    x4 0x9E6703E0
    = lq @ 16
    x4 0xACC10921 x4 0xACC11143 x4 0x6F00E405 x4 0x4E839425 x4 0x4E849445 x4 0x4EB1B8A5 x4 0x0F20A4A5 x4 0x5E61D8A5
    x4 0xFC408566 x4 0x1F4600A0 x4 0xF100058C
    abcc 0x1 - lq @ 16
    = r adf 0 d ? != r 0 x4 | 0x1E604000 r 0 afd r d }
  ? == k 67 { = fi pfind -6 ? < fi 0 { = fi pnew -6 @ 13 } 0 agT 0 a agT 1 b acallf fi asT 0 d }
  ? == k 65 { = fi pfind -5 ? < fi 0 { = fi pnew -5 @ 13 } 0 agT 0 a agT 1 b x4 0xA9BF07E0 acallf fby k3 '_ 'f 'l x4 0xA8C107E0 acallf fi asT 0 d }
  ? == k 62 { = fi pfind -3 ? < fi 0 { = fi pnew -3 @ 13 } 0 agT 0 a agT 1 b acallf fi asT 0 d }
  ? == k 63 { = fi pfind -4 ? < fi 0 { = fi pnew -4 @ 13 } 0 agT 0 a agT 1 b acallf fi asT 0 d }
  ? == k 29 { agT 0 a acallf aro 'p }
  ? == k 31 { agT 0 a acallf aro 'n }
  ? == k 32 { agTf 0 a acallf aro 'f }
  ? == k 33 { agT 9 a aimm 10 -2 astrx 9 28 10 }
  ? == k 36 { agT 0 a acallf fby k3 '_ 'e 'x }
  ? == k 30 { asc 1 asT 0 d }
  ? == k 34 { asc 3 asT 0 d }
  ? == k 35 { agT 1 a agT 2 b asc 4 asT 0 d }
  ? == k 37 { asc 6 asT 0 d }
  ? == k 42 { ? alit a { agT 1 b agT 2 c asc alitv a } { agT 0 a agT 1 b agT 2 c asc -1 } asT 0 d }
  ? == k 7 {
    = xc 0 = dc 0 = j 0
    W < j c { = arg @ + b j ? fpt a j { agTf dc arg = dc + dc 1 } { agT xc arg = xc + xc 1 } = j + j 1 }
    acsrec @ 16 a
    abl 0
    ? @ fe a 3 { asTf 0 d } { asT 0 d } }
  ? == k 53 amap p
  ? == k 54 asum p
  ? == k 59 aemap p
  ? == k 56 ! 57 @ 16
  ? == k 55 ? atdup @ 57 0 ab - @ 57 @ 16
  ? == k 41 { ? tty a { agTf 0 a } { agT 0 a } aepilog }
  { ebeg "operacao ainda nao suportada em -a (kind " N k ")" eend } }
# chamada a uma funcao pura da biblioteca matematica (_sn _cs _xp _lg _at _pw): a LICM pode tira-la de um ciclo
: apurec i>i p {
  = k @ + p 2
  || || || || || aisnm k 3 '_ 's 'n aisnm k 3 '_ 'c 's aisnm k 3 '_ 'x 'p aisnm k 3 '_ 'l 'g aisnm k 3 '_ 'a 't aisnm k 3 '_ 'p 'w }
: aisnm iiiii>i k n a b c { = t @ fe k 0 && == tkl t n && && == tc t 0 a == tc t 1 b == tc t 2 c }
# _pd (escrever a imagem do D) em codigo nativo no arm64: esvazia o buffer de saida (_fl), passa os pixeis a bytes num
# bloco de 4 KiB na pilha e escreve-o com uma syscall por bloco (o _pd em Onda chamava o _op 3 vezes por pixel)
: apdn i>i k {
  O 16
  ! fe k 8 @ 16
  x4 0xA9BE7BFD x4 0xA90153F3
  amovr 19 0 amovr 20 1
  acallf fby k3 '_ 'f 'l
  aimm 12 4096 x4 0xCB2C63FF
  aimm 3 0
  = lo @ 16
  acmp 3 20 = pd @ 16 abcc 0xA 0
  aimm 6 0
  = li @ 16
  acmp 3 20 = pf1 @ 16 abcc 0xA 0
  acmpi 6 4093 = pf2 @ 16 abcc 0xC 0
  aadd 10 19 3 aldrx 11 28 10
  x4 0xD350FD6C x4 0x38266BEC aaddi 6 6 1
  x4 0xD348FD6C x4 0x38266BEC aaddi 6 6 1
  x4 0x38266BEB aaddi 6 6 1
  aaddi 3 3 1 ab - li @ 16
  apbc pf1 0xA apbc pf2 0xC
  aimm 0 1 aaddi 1 31 0 amovr 2 6 ascn ? ismo 4 64
  ab - lo @ 16
  apbc pd 0xA
  aimm 12 4096 x4 0x8B2C63FF
  aimm 0 0
  x4 0xA94153F3 x4 0xA8C27BFD aret
  ! fe k 9 @ 16
  O 0 }
# --- _pr (paralelo, so -m): x0 = condutora, x1 = n, x2 = modo (bit 0: E ou S; bits 1..8: n de inteiros; bit 9: S; bits 10..: limiar). Em serie se for
# pouco (E com menos de 4096, D com menos de 2 linhas), se o destino do E for um dos argumentos inteiros (pode ler o
# que escreve) ou se houver 1 cpu. Senao cria cpus-1 threads (pthread_create) e todas correm _pwk: blocos de max(1,
# n/64) tirados de um contador com ldaddal, ate acabar; depois pthread_join. As chamadas a libSystem vao para @66.
: apair iiii>i op a b o x4 | | | | op << & / o 8 0x7F 15 << b 10 << 31 5 a
: aasri iii>i rd rn sh x4 | | | 0x9340FC00 << sh 16 << rn 5 rd
: aldsl ii>i r s { aimm 10 pjs s aldrx r 28 10 }
: astsl ii>i r s { aimm 10 pjs s astrx r 28 10 }
: aextc i>i s { = q @ 16 x4 0x94000000 = n @ @ 66 ! + @ 66 + 1 * n 2 q ! + @ 66 + 2 * n 2 s ! @ 66 + n 1 }
: ablr i>i r x4 | 0xD63F0000 << r 5
: aprn i>i k {
  O 16
  ! fe k 8 @ 16
  apair 0xA9800000 29 30 -64
  apair 0xA9000000 19 20 16
  apair 0xA9000000 21 22 32
  apair 0xA9000000 23 24 48
  amovr 19 0 amovr 20 1 amovr 21 2
  astsl 19 0 astsl 20 1
  aimm 9 0 astsl 9 2
  aasri 9 20 6 acmpi 9 1 aimm 10 1 acsel 9 10 9 0xB
  x4 | | 0x92400000 << 21 5 10 = pmn @ 16 x4 | 0xB4000000 10
  # bloco minimo: min(256, limiar) -- as funcoes pesadas (com ciclos) repartem-se em blocos pequenos
  aasri 10 21 10 acmpi 10 256 aimm 12 256 acsel 10 12 10 0xC acmp 9 10 acsel 9 10 9 0xB
  ap19 pmn
  astsl 9 3
  aadd 11 20 9 asubi 11 11 1 asdiv 11 11 9 astsl 11 39
  x4 | | 0x92400000 << 21 5 9
  = pz @ 16 x4 | 0xB4000000 9
  aasri 10 21 10 acmp 20 10 = ps1 @ 16 abcc 0xB 0
  aldsl 11 4 aasri 12 21 1 x4 0x92401D8C aimm 13 0
  = la @ 16
  acmp 13 12 = pa1 @ 16 abcc 0xA 0
  aimm 10 pjs 6 aadd 10 10 13 aldrx 14 28 10
  acmp 14 11 = ps2 @ 16 abcc 0x0 0
  aaddi 13 13 1 ab - la @ 16
  ap19 pa1
  ap19 pz
  acmpi 20 2 = ps3 @ 16 abcc 0xB 0
  aldsl 22 38
  = ph @ 16 x4 | 0xB5000000 22
  aimm 0 58 aextc 0 amovr 22 0
  acmpi 22 16 aimm 10 16 acsel 22 10 22 0xC
  acmpi 22 1 aimm 10 1 acsel 22 10 22 0xB
  astsl 22 38
  ap19 ph
  acmpi 22 1 = ps4 @ 16 abcc 0xD 0
  aldsl 23 42
  = pp @ 16 x4 | 0xB5000000 23
  aimm 23 1
  = lc @ 16
  acmp 23 22 = pc1 @ 16 abcc 0xA 0
  aimm 10 pjs 22 aadd 10 10 23 aaddlsl 0 28 10 3
  aimm 1 0
  = pad @ 16 x4 0x10000002
  amovr 3 28
  aextc 1
  aaddi 23 23 1 ab - lc @ 16
  ap19 pc1
  asubi 23 22 1 astsl 23 42
  ap19 pp
  aimm 10 pjs 40 aaddlsl 9 28 10 3
  aldsl 10 40 aaddi 10 10 1 x4 | | 0xC89FFC00 << 9 5 10
  aimm 10 pjs 43 aaddlsl 9 28 10 3
  x4 | | 0xC8DFFC00 << 9 5 10
  = pz2 @ 16 x4 | 0xB4000000 10
  aimm 0 0x101 aimm 10 pjs 40 aaddlsl 1 28 10 3 aimm 2 0 aextc 4
  ap19 pz2
  amovr 0 28
  = pbl @ 16 x4 0x94000000
  aimm 10 pjs 40 aaddlsl 9 28 10 3
  aldsl 10 40 aaddi 10 10 1 x4 | | 0xC89FFC00 << 9 5 10
  aimm 10 pjs 41 aaddlsl 9 28 10 3
  = lj @ 16
  x4 | | 0xC8DFFC00 << 9 5 10
  x4 | | 0xB5000000 << & / - lj @ 16 4 0x7FFFF 5 10
  = dn @ 16
  aimm 0 0
  apair 0xA9400000 19 20 16
  apair 0xA9400000 21 22 32
  apair 0xA9400000 23 24 48
  apair 0xA8C00000 29 30 64
  aret
  ap19 ps1 ap19 ps2 ap19 ps3 ap19 ps4
  # em serie o E e o D fazem uma so chamada (bloco = n); o S (bit 9) fica com os mesmos blocos do paralelo
  = p9 @ 16 x4 0x374800B5
  astsl 20 3
  xput4 p9 | 0x37480015 << & / - @ 16 p9 4 0x3FFF 5
  amovr 0 28 = pb2 @ 16 x4 0x94000000 ab - dn @ 16
  # _pwk(x0 = base de M): tira blocos do contador ate acabar (convencao do C: guarda x19..x21 e x28)
  = pwk @ 16
  xput4 pbl | 0x94000000 & / - @ 16 pbl 4 0x3FFFFFF
  xput4 pb2 | 0x94000000 & / - @ 16 pb2 4 0x3FFFFFF
  apair 0xA9800000 29 30 -48
  apair 0xA9000000 19 20 16
  apair 0xA9000000 21 28 32
  amovr 28 0
  = lw @ 16
  aimm 10 pjs 2 aaddlsl 9 28 10 3
  aldsl 11 3
  x4 | | | 0xF8E00000 << 11 16 << 9 5 12
  aldsl 13 1
  acmp 12 13 = pw1 @ 16 abcc 0xA 0
  aadd 1 12 11 acmp 1 13 acsel 1 13 1 0xC
  amovr 0 12 aldsl 14 0 ablr 14
  ab - lw @ 16
  ap19 pw1
  apair 0xA9400000 21 28 32
  apair 0xA9400000 19 20 16
  apair 0xA8C00000 29 30 48
  aimm 0 0
  aret
  # _pwt(x0 = base de M): cada thread do conjunto vive o programa todo (criadas so na 1a chamada paralela; 42 =
  # quantas). Geracao (40) impar = trabalho aberto, par = fechado. A thread espera em wfe ate ~100 us (chamadas
  # seguidas: acorda em microssegundos); depois dorme no sistema (__ulock_wait sobre a geracao; 43 = quantas dormem,
  # a principal so chama __ulock_wake se houver). Com trabalho novo entra (41 = ativas), confirma que a geracao nao
  # mudou (senao sai) e corre _pwk. A principal abre, faz a sua parte, fecha e so espera pelas ativas.
  = o - @ 16 pad
  xput4 pad | | 0x10000002 << & o 3 29 << & >> o 2 0x7FFFF 5
  apair 0xA9800000 29 30 -48
  apair 0xA9000000 19 20 16
  apair 0xA9000000 21 28 32
  amovr 28 0
  aimm 19 0
  = lt @ 16
  x4 | 0xD53BE040 20 aaddi 20 20 2400
  aimm 10 pjs 40 aaddlsl 9 28 10 3
  x4 0xD50320BF
  = lv @ 16
  x4 0xD503205F
  x4 | | 0xC85FFC00 << 9 5 10
  = pt @ 16 x4 0x3600000A
  acmp 10 19 = pg @ 16 abcc 0x1 0
  xput4 pt | 0x3600000A << & / - @ 16 pt 4 0x3FFF 5
  x4 | 0xD53BE040 11 acmp 11 20 abcc 0x3 - lv @ 16
  aimm 11 1 aimm 10 pjs 43 aaddlsl 12 28 10 3 x4 | | | 0xF8E00000 << 11 16 << 12 5 13
  aimm 10 pjs 40 aaddlsl 1 28 10 3
  x4 | | 0xC8DFFC00 << 1 5 2
  = pt2 @ 16 x4 0x36000002
  acmp 2 19 = ps5 @ 16 abcc 0x1 0
  xput4 pt2 | 0x36000002 << & / - @ 16 pt2 4 0x3FFF 5
  x4 0x2A0203E2 aimm 0 1 aimm 3 0 aextc 3
  ap19 ps5
  aimm 11 -1 aimm 10 pjs 43 aaddlsl 12 28 10 3 x4 | | | 0xF8E00000 << 11 16 << 12 5 13
  ab - lt @ 16
  ap19 pg
  amovr 19 10
  aimm 11 1
  aimm 10 pjs 41 aaddlsl 9 28 10 3
  x4 | | | 0xF8E00000 << 11 16 << 9 5 12
  aimm 10 pjs 40 aaddlsl 9 28 10 3
  x4 | | 0xC8DFFC00 << 9 5 10
  acmp 10 19 = pq @ 16 abcc 0x1 0
  amovr 0 28
  x4 | 0x94000000 & / - pwk @ 16 4 0x3FFFFFF
  ap19 pq
  aimm 11 -1
  aimm 10 pjs 41 aaddlsl 9 28 10 3
  x4 | | | 0xF8E00000 << 11 16 << 9 5 12
  ab - lt @ 16
  ! fe k 9 @ 16
  O 0 }
: afun i>i k {
  ? && isa aisnm k 3 '_ 'p 'd apdn k afun0 k }
: afun0 i>i k {
  = np @ fe k 2
  ? > np 8 { ebeg "mais de 8 parametros ainda nao em -a" eend } 0
  # invariantes fora dos ciclos (a mesma passagem de RI do x86) e depois os registos
  atre k
  atail
  acse
  xlicm
  # ponteiros-base (a mesma passagem do x86: 46 = base, 47..50 = acessos [base + i*8]) e outra vez a LICM
  ? xbase xlicm 0
  ara k
  O 16
  ! fe k 8 @ 16
  xqs 7 @ 16
  aprolog
  = xc 0
  = dc 0
  = j 0
  W < j np { ? fpt k j { asLf dc j = dc + dc 1 } { asL xc j = xc + xc 1 } = j + j 1 }
  = j 0
  xqs 1 0
  xqs 3 0
  W < j @ 19 { ains + @ 18 * j 8 = j + j 1 }
  apool
  ! fe k 9 @ 16
  O 0 }
: amain >i { = k 0 = r -1 W < k @ 6 { ? ismain k = r k 0 = k + k 1 } r }
# --- Mach-O (-m): o MESMO codigo-maquina do -a, mas num executavel nativo do Mac (Apple Silicon). M vem de um
# mmap no arranque (sem segmento fixo). Syscalls do macOS: numero em x16, svc #0x80 (write 4, exit 1, mmap 197).
: ismo >i && == Av 1 0 '- == Av 1 1 'm
: amovr ii>i rd rn x4 | | 0xAA0003E0 << rn 16 rd
: asvc80 >i x4 0xD4001001
: az i>i n { = j 0 W < j n { P 0 = j + j 1 } 0 }
# arranque comum (depois de x28 = base de M): guarda argc/argv (x21/x22) em M[-9]/M[-10], poe o ponteiro de
# alocacao M[-1] a seguir as strings (@20, como o x86) e copia o bloco de dados (as strings, M[64..@20)) que vai
# no fim do codigo para M. O endereco do bloco e relativo ao pc (bl +4 -> x30), logo vale em qualquer endereco.
# Devolve a posicao do aimm a corrigir com (inicio do bloco - posicao do mov x9,x30).
: apimm iii>i p rd v {
  xput4 p | | 0xD2800000 << & v 0xffff 5 rd
  xput4 + p 4 | | | 0xF2800000 << 1 21 << & >> v 16 0xffff 5 rd
  xput4 + p 8 | | | 0xF2800000 << 2 21 << & >> v 32 0xffff 5 rd
  xput4 + p 12 | | | 0xF2800000 << 3 21 << & >> v 48 0xffff 5 rd }
: ainit >i {
  aimm 10 -9 astrx 21 28 10
  aimm 10 -10 astrx 22 28 10
  aimm 9 @ 20 aimm 10 -1 astrx 9 28 10
  abl 4
  amovr 9 30
  = dp @ 16
  aimm4 10 0
  aadd 9 9 10
  aimm 10 512 aadd 10 28 10
  aimm 11 - @ 20 64
  = l @ 16
  = pc @ 16 x4 0xB400000B
  x4 0xF840852C x4 0xF800854C x4 0xD100056B
  ab - l @ 16
  xput4 pc | 0xB400000B << & / - @ 16 pc 4 0x7FFFF 5
  dp }
# bloco de dados: as strings registadas (sreg), cada uma em palavras de 8 bytes, pela ordem dos enderecos
: adata >i { = j 0 W < j @ 22 { wchr @ + @ 21 * j 2 = j + j 1 } 0 }
: aftot >i { = t 0 = k 0 W < k @ 6 { = t + t - @ fe k 9 @ fe k 8 = k + k 1 } t }
# corrige o bl da entrada para _go e os bl entre funcoes (@64; posicoes no buffer 16, contiguas na saida)
: abls iii>i estart elen blp {
  = mi fby k3 '_ 'g 'o
  = moff elen
  = k 0 W < k mi { = moff + moff - @ fe k 9 @ fe k 8 = k + k 1 }
  xput4 blp | 0x94000000 & / - moff - blp estart 4 0x3FFFFFF
  = nc @ @ 64
  = c 0
  W < c nc {
    = pos @ + @ 64 + 1 * c 2
    = fi @ + @ 64 + 2 * c 2
    = o - @ fe fi 8 pos
    ? == & arw pos 0x9F000000 0x10000000
      { xput4 pos | | 0x10000000 << & o 3 29 | << & >> o 2 0x7FFFF 5 & arw pos 31 }
      ? == & arw pos 0xFF000010 0x54000000
        { xput4 pos | & arw pos 0xFF00001F << & / o 4 0x7FFFF 5 }
        { xput4 pos | 0x94000000 & / o 4 0x3FFFFFF }
    = c + c 1 }
  0 }
# entrada -m: argc/argv (x0/x1 do _main) -> x21/x22; mmap M -> x28; arranque comum; bl _go; exit(x0)
: aentm >i {
  amovr 21 0 amovr 22 1
  aimm 0 0 aimm 1 * amw 8 aimm 2 3 aimm 3 4098 aimm 4 -1 aimm 5 0 aimm 16 197 asvc80
  amovr 28 0 aaddi 28 28 128 aimm 27 0
  = dp ainit
  abl 0
  aimm4 16 1 asvc80
  dp }
# -m emite um OBJETO Mach-O (MH_OBJECT) com o MESMO codigo-maquina do -a (entrada mmap + funcoes + dados), e um
# simbolo _main na entrada. O clang linka-o num executavel valido do Mac: `clang prog.o -o prog` -- a validacao
# estrita, a assinatura e o __LINKEDIT ficam a cargo da toolchain do sistema; o codigo e todo escrito pela Onda.
: outm >i {
  O 16
  = estart @ 16
  = dp aentm
  = elen - @ 16 estart
  O 0
  abls estart elen - + estart elen 24
  = ft aftot
  apimm dp 10 - + elen ft - - dp 4 estart
  = clen + + elen ft * 8 - @ 20 64
  = coff 232
  = nr ? > @ 66 0 @ @ 66 0
  = rel + coff clen
  = so + rel * 8 nr
  = pad ? nr & so 7 0
  = so + so pad
  = ns ? nr 6 1
  = sto + so * 16 ns
  # cabecalho (32): magic, arm64, subtype 0, filetype 1 (OBJECT), ncmds 3, sizeofcmds 200
  x4 0xFEEDFACF x4 0x0100000C x4 0 x4 1 x4 3 x4 200 x4 0 x4 0
  # LC_SEGMENT_64 (72) sem nome + 1 seccao __text,__TEXT (80)
  x4 0x19 x4 152 az 16
  x8 0 x8 clen x8 coff x8 clen x4 7 x4 7 x4 1 x4 0
  P '_ P '_ P 't P 'e P 'x P 't az 10 P '_ P '_ P 'T P 'E P 'X P 'T az 10
  x8 0 x8 clen x4 coff x4 2 x4 ? nr rel 0 x4 nr x4 0x80000400 x4 0 x4 0 x4 0
  # LC_SYMTAB (24): symoff, nsyms 1, stroff, strsize 7
  x4 2 x4 24 x4 so x4 ns x4 sto x4 ? nr 74 7
  # LC_BUILD_VERSION (24): macOS, minos 11.0, sdk 11.0, sem ferramentas (o ld deixa de avisar)
  x4 0x32 x4 24 x4 1 x4 0x000B0000 x4 0x000B0000 x4 0
  # codigo: entrada + corpo de cada funcao + dados
  ew estart elen
  = k 0 W < k @ 6 { ew @ fe k 8 - @ fe k 9 @ fe k 8 = k + k 1 }
  adata
  # relocacoes BRANCH26 (pcrel, 4 bytes, externas) das chamadas a libSystem: simbolos 1 _sysconf 2 _pthread_create 3 _pthread_join 4 ___ulock_wait 5 ___ulock_wake
  = j 0
  W < j nr { x4 - + elen @ + @ 66 + 1 * j 2 @ fe 0 8 x4 | + 1 @ + @ 66 + 2 * j 2 0x2D000000 = j + j 1 }
  ? pad x4 0 0
  # simbolo _main (externo, seccao 1, valor 0) + tabela de strings "\0_main\0"
  x4 1 P 15 P 1 P 0 P 0 x8 0
  ? nr { x4 7 P 1 P 0 P 0 P 0 x8 0 x4 16 P 1 P 0 P 0 P 0 x8 0 x4 32 P 1 P 0 P 0 P 0 x8 0 x4 46 P 1 P 0 P 0 P 0 x8 0 x4 60 P 1 P 0 P 0 P 0 x8 0 } 0
  P 0 P '_ P 'm P 'a P 'i P 'n P 0
  ? nr { "_sysconf" P 0 "_pthread_create" P 0 "_pthread_join" P 0 "___ulock_wait" P 0 "___ulock_wake" P 0 } 0
  0 }
# -mx / -mfx: o EXECUTAVEL do Mac escrito pela Onda, sem o clang. O mesmo codigo do -m, mais: __PAGEZERO, __TEXT,
# __DATA (__got, so com threads), __LINKEDIT; o dyld e a libSystem (LC_LOAD_DYLINKER/LC_LOAD_DYLIB, entrada por
# LC_MAIN); as chamadas a libSystem vao a stubs (adrp/ldr/br) que leem o __got, preenchido pelo dyld (opcodes de
# bind); e a assinatura ad-hoc (CodeDirectory SHA-256 por pagina de 4 KiB), obrigatoria no arm64.
: ismx >i && ismo || == Av 1 2 'x == Av 1 3 'x
: al4 ii>i x a * / + x - a 1 a a
: xb4 i>i v { P & >> v 24 255 P & >> v 16 255 P & >> v 8 255 P & v 255 }
: xb8 i>i v { xb4 >> v 32 xb4 & v 4294967295 }
: hsr ii>i x n & | >> x n << x - 32 n 4294967295
: hsk >i {
  = k A 64
