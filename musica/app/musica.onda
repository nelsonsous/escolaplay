: k_s_afnv >i @ + @ 0 84
: k_s_pdnv >i @ + @ 0 85
: k_s_ajm >i @ + @ 0 86
: k_ev_click >i @ + @ 0 87
: k_ev_input >i @ + @ 0 88
: k_c_clique >i @ + @ 0 89
: k_c_campo >i @ + @ 0 90
: k_c_estado >i @ + @ 0 91
: k_c_pl >i @ + @ 0 92
: k_c_ped >i @ + @ 0 93
: k_c_doc >i @ + @ 0 94
: k_c_perfil >i @ + @ 0 95
: k_c_pesq >i @ + @ 0 96
: k_c_escrita >i @ + @ 0 97
: k_c_fim >i @ + @ 0 98
: k_c_nada >i @ + @ 0 99
: k_p_estado >i @ + @ 0 100
