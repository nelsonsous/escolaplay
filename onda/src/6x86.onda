: outx >i {
  = j 0
  W < j @ 29 { = q + @ 28 * j 2 = p @ q = k @ + q 1 = t ? < k 0 @ 30 @ fe k 8 xput4 p - t + p 4 = j + j 1 }
  = cb @ 31
  = cs - @ 16 cb
  = fs + 176 cs
  = mo * 4096 / + fs 4095 4096
  = dw + 80 - @ 20 64
  P 127 P 'E P 'L P 'F P 2 P 1 P 1 P 0 x4 0 x4 0
