# Música: a app, toda em Onda — uma «app em Onda» (onda/rt/anfitriao.js corre-a no browser), na Onda fluida: moldes
# (`…{ código }…`), o ponto (c.nome), a fala (esct, txt, int, mesmo, Se, L…) e moldes com nome (aviso`…`, pede`…` m).
# Monta-se com a biblioteca da Onda e o motor de curadoria (musica/onda/compilar.mjs, que tira as entradas da fonte):
#   cat onda/lib/{memoria,texto,…,fala}.onda musica/onda/motor.onda musica/app/musica.onda | ondac -w main clique …
# O main prepara o estado; cada clique, campo e resposta da rede chama uma função daqui. A casca (musica.js) só
# trata do que a Onda não tem como porta: a chave do aparelho nos pedidos ao conector, os pedidos que escrevem
# («MÉTODO caminho» + nova linha + corpo JSON), sair para o login do Tidal («IR url») e o regresso dele.
#
# Globais (M[1..59] são da app; M[63] é da biblioteca):
#   fixos (criados no main): 1 vista (1 playlists, 3 pedir, 5 ajustes — três separadores; a 4, o gosto, é agora um
#     cartão dos Ajustes: @18 aberto, @4 o perfil e @11 as tendências),
#     2 base do monte (navegar solta tudo o que veio depois), 20 texto do pedido, 21 client id, 22 conector,
#     23 pesquisa, 24..27 pedido: faixas, max por artista, estilo, arco, 29 relogio do aviso, 30 id da playlist,
#     36 pesos dos estilos, 38 codigo de ligacao (colado), 45 pedido sem letras explicitas, 46 47 nome e descricao
#     a mudar, 48 as ideias do Maestro (da vista Pedir; a zero ao navegar), 49 o que afinar (texto),
#     50 a playlist aberta na lista (id), 51 o documento dela, 52 as pre-escutas dela, 53 filtro: por o que (0 todas,
#     1 tipo, 2 genero, 3 Tidal, 4 avaliacao), 59 filtro: qual (texto), 56 a escolher para juntar, 58 as escolhidas
#     («,id,id,»)
#   da folha de uma playlist (na vista 1): 50 o id da que está aberta, 51 o documento, 52 as pré-escutas e as capas,
#     28 o «⋯» (1 a perguntar se apaga, 2 a mudar o nome, 4 aberto; nos Ajustes: 2 desligar, 3 esquecer, 5 apagar a conta), 40 a faixa aberta (posição + 1), 55 o que toca,
#     60 a faixa que está a ser trocada (posição + 1) e 61 a candidata que entra (0: espera-se uma parecida do Tidal),
#     6 o afinar (0 fechado, 1 aberto, 2 com mudanças; ver «afinar na folha»), 62 a procura de «acrescentar uma faixa»
#   da vista (a zero ao navegar): 3 estado, 4 dados da vista, 5 pedidos, 12 a vista que está desenhada (ver `render`),
#     35 o relógio da espera viva e 0 até quando (ver `espera_viva`),
#     19 a procura de faixas, 28 a confirmar,
#     31 ocupado, 33 ms do motor, 34 escrita em curso; o afinar (na folha): 6 7 8 9 10 11 13 14 15 16 17 32 37

# ===== utilitarios =====
: tvazio i>i d { ! d + d 1 0 }
: tcopia iii>i d s mx { = n Mn _tx_len s mx L j n ! + + d 1 j _tx_b s j ! d + + d 1 n 0 }
: hexd i>i h P ? < h 10 + 48 h + 87 h
: hexm i>i h P ? < h 10 + 48 h + 55 h
# o texto t como string JSON, com aspas e escapes
: pjs i>i t {
  P 34
  = n _tx_len t L j n {
    = c _tx_b t j
    ? || == c 34 == c 92 { P 92 P c 0 } ? < c 32 { P 92 P 'u P '0 P '0 hexd / c 16 hexd % c 16 0 } P c }
  P 34 0 }
# o texto t codificado para um URL (percent-encoding)
: purl i>i t {
  = n _tx_len t L j n {
    = c _tx_b t j
    = ok || && >= c 'a <= c 'z && >= c 'A <= c 'Z
    = ok || ok && >= c '0 <= c '9
    = ok || ok || == c '- == c '_
    = ok || ok || == c '. == c '~
    ? ok P c { P '% hexm / c 16 hexm % c 16 0 } } }
# "2026-11-07T..." -> 7/11
: dd ii>i t j + * - _tx_b t j '0 10 - _tx_b t + j 1 '0
: pdia i>i t Se >= _tx_len t 10 `{ N dd t 8 }/{ N dd t 5 }`
# segundos -> "25 min" ou "1 h 05 min"
: pmin i>i s ? >= s 3600 { `{ N / s 3600 } h ` = r / + % s 3600 30 60 `{ Se < r 10 "0" }{ N r } min` } `{ N Mx 1 / + s 30 60 } min`
: partistas i>i l { = c pri l = s 0 W c { Se s ", " esct txt c = s 1 = c seg c } }

# ===== aviso (toast) =====
: aviso i>i t {
  = m _me_marca
  = h _ht_ini + _tx_len t 80 `<div class="mu-toast on">{ esct t }</div>{ _ht_poe $"#mu-aviso" h }`
  Se @ 29 _an_parar @ 29
  ! 29 _an_relogio 3800 $"fim_aviso"
  _me_solta m }
: fim_aviso i>i z { Se @ 29 _an_parar @ 29 ! 29 0 = h _tx_novo 4 _an_html $"#mu-aviso" h _me_solta h }
: nada ii>i t s 0
: erro_ped ii>i t s {
  ? s {
    = r _ar_json t = mg txt r.message
    ? mg aviso mg { aviso`Erro { N s } do conector.` 0 } 0 }
    { aviso $"Sem ligação ao conector." 0 } }

# ===== estilos e arcos =====
: nome_estilo i>i e ? == e 0 "Equilibrado" ? == e 1 "Descoberta" ? == e 2 "Na moda" ? == e 3 "O meu gosto" "Audiófilo"
: estilo_json i>i e ? == e 0 "equilibrado" ? == e 1 "descoberta" ? == e 2 "moda" ? == e 3 "gosto" "audiofilo"
: idx_estilo i>i t ? mesmo t $"descoberta" 1 ? mesmo t $"moda" 2 ? mesmo t $"gosto" 3 ? mesmo t $"audiofilo" 4 0
: nome_arco i>i a ? == a 0 "Onda" ? == a 1 "Sobe" ? == a 2 "Acalma" "Sem arco"
: arco_json i>i a ? == a 0 "onda" ? == a 1 "sobe" ? == a 2 "desce" "plano"
: idx_arco i>i t ? mesmo t $"sobe" 1 ? mesmo t $"desce" 2 ? mesmo t $"plano" 3 0
: arco_val i>i a ? == a 0 1 ? == a 1 2 ? == a 2 3 0
: porque_json i>i q ? == q 1 "gosto" ? == q 2 "qualidade" ? == q 3 "tendencia" ? == q 4 "claude" ? == q 5 "novidade" "fixa"
# de dia (07h-20h, pela hora de Portugal no inverno; no verao difere uma hora) ou de noite
# de dia (7h–20h) pela hora local: a casca guarda no armazém o fuso do aparelho («fuso», minutos a somar ao UTC)
: e_dia >i { = fz _an_ler $"fuso" = mn ? fz _tx_int fz 0 = h % / + _an_agora * mn 60000 3600000 24 && >= h 7 < h 20 }
: sugestao i>i q ? == q 0 "Faixas bem gravadas para testar o som do carro" ? == q 1 "Jazz para um domingo de manhã" ? == q 2 "O melhor de 2026 até agora, de vários géneros" ? == q 3 "Fado e música portuguesa nova" ? == q 4 "Soul e funk dos anos 70" ? == q 5 "Treino: energia sempre a subir" "Para conduzir à noite, calma e com graves"

# ===== estado da ligacao =====
: ligado >i { = e @ 3 ? e == tipo e.ligado 3 0 }
: acesso >i { = e @ 3 ? e ? e.tu ligado 0 0 }

# ===== pedacos de HTML =====
# icones dos botoes (traco 24x24, na cor do texto): 1 ligar, 2 pedir, 3 enviar, 4 ouvir, 5 onda, 6 atualizar, 7 motor,
# 8 procurar, 9 apagar, 10 desligar, 11 esquecer, 12 juntar, 13 fixar, 14 tirar, 15 seguir, 16 guardar, 17 aviso
: ic i>i n {
  `<svg viewBox="0 0 24 24" aria-hidden="true">`
  ? == n 1 `<path d="M10 14a3.5 3.5 0 0 0 5 0l3.5-3.5a3.5 3.5 0 0 0-5-5L12 7"/><path d="M14 10a3.5 3.5 0 0 0-5 0l-3.5 3.5a3.5 3.5 0 0 0 5 5L12 17"/>`
  ? == n 2 `<path d="M12 3.5c.7 4.6 2.9 6.8 7.5 7.5-4.6.7-6.8 2.9-7.5 7.5-.7-4.6-2.9-6.8-7.5-7.5 4.6-.7 6.8-2.9 7.5-7.5z"/>`
  ? == n 3 `<path d="M21 3 10.5 13.5"/><path d="M21 3l-6.5 18-4-7.5L3 9.5z"/>`
  ? == n 4 `<path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/>`
  ? == n 5 `<path d="M2 12c2-5 4.5-5 6.5 0s4.5 5 6.5 0 4.5-5 6.5 0"/>`
  ? == n 6 `<path d="M20 11a8 8 0 0 0-14-5l-2 2"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14 5l2-2"/><path d="M20 20v-4h-4"/>`
  ? == n 7 `<path d="M13 2.5 4.5 13.5H11l-1 8 8.5-11H12z"/>`
  ? == n 8 `<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>`
  ? == n 9 `<path d="M4 7h16"/><path d="M9 7V4.5h6V7"/><path d="M6.5 7l1 12.5h9l1-12.5"/><path d="M10 11v5M14 11v5"/>`
  ? == n 10 `<path d="M12 3v8"/><path d="M6.6 6.6a7.5 7.5 0 1 0 10.8 0"/>`
  ? == n 11 `<path d="M9.5 4H5v16h4.5"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9.5"/>`
  ? == n 12 `<path d="M12 5v14M5 12h14"/>`
  ? == n 14 `<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>`
  ? == n 15 `<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>`
  ? == n 17 `<path d="M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>`
  `<path d="M5 12.5l4.5 4.5L19 7.5"/>`
  "</svg>" }
: pill >i ? ligado `<button type="button" class="mu-pill on" data-onda="ir&#9;5">{ esct txt _ar_get @ 3 $"utilizador" }</button>` `<button type="button" class="mu-pill off" data-onda="ir&#9;5">Tidal desligado</button>`
: carregar >i ? @ 3 `<p class="mu-nota mu-a-carregar">A carregar…</p>` `<p class="mu-nota mu-a-carregar">A ligar ao conector…</p>`

# ===== boas-vindas (ligar o Tidal) =====
: campo_codigo >i `<label class="mu-campo"><span>Código de ligação</span><input data-onda="cod" autocapitalize="off" autocomplete="off" spellcheck="false" value="{ esct @ 38 }"></label><div class="mu-acoes"><button type="button" class="mu-btn" data-onda="usar">{ ic 15 }Usar este código</button></div>`
: boas_vindas >i {
  = e @ 3
  = cod _an_ler $"codigo"
  = ch _an_ler $"chave"
  ? ~ == tipo e.clientId 3 {
      `<div class="mu-card boas"><h3>Primeiro: a tua app no Tidal</h3><p>Em <a href="https://developer.tidal.com/dashboard" target="_blank" rel="noopener">developer.tidal.com</a> cria uma app (grátis) e, nas definições dela:</p><ul class="mu-tend"><li>Redirect URI: <code>{ esct txt e.retorno }</code></li><li>Scopes: <code>user.read collection.read playlists.read playlists.write search.read recommendations.read</code></li></ul>`
      ? || cod && ch e.tu {
          `<label class="mu-campo"><span>Client ID da app</span><input data-onda="cid" autocapitalize="off" autocomplete="off" spellcheck="false" placeholder="copia-o do Tidal" value="{ esct @ 21 }"></label><div class="mu-acoes"><button type="button" class="mu-btn" data-onda="config">{ ic 15 }Guardar e continuar</button></div>` }
        `<p class="mu-nota">Depois abre o link de ligação que recebeste (termina em <code>?ligar=…</code>) para colares aqui o Client ID.</p>`
      "</div>" }
    { ? && ch ~ e.tu `<div class="mu-card boas"><h3>Este aparelho perdeu o acesso</h3><p>A chave guardada já não é válida. Cola aqui um código de ligação novo.</p>{ campo_codigo }</div>`
      ? cod `<div class="mu-card boas"><h3>Liga o teu Tidal</h3><p>Vais à página de login do Tidal, autorizas, e voltas aqui. As playlists passam a ser criadas na tua conta.</p><p>{ txt_ia } <a href="privacidade.html">Privacidade</a></p><div class="mu-acoes"><button type="button" class="mu-btn" data-onda="ligar_c">{ ic 1 }Concordo e ligar ao Tidal</button></div></div>`
      `<div class="mu-card boas"><h3>{ ? ligado "Liga este aparelho" "Liga o teu Tidal" }</h3><p>Num aparelho onde já entraste, vai a Ajustes → <b>Ligar outro aparelho</b> e cola aqui o código. Se é a primeira vez, abre o link do convite.</p>{ campo_codigo }</div>` } }

# ===== Playlists =====
# os pedidos à espera do Maestro ficam no cimo da lista das playlists (é para lá que vão quando ficam prontos): o que
# se pediu, quando, e cancelar (o botão, ou arrastar para a esquerda). Um pedido de afinação não aparece aqui: vê-se
# na playlist dele (o selo no cartão e a linha «à espera do Maestro» na folha, com o seu cancelar)
: ped_novo i>i c && mesmo txt c.estado $"pendente" ~ c.afinar
: espera i>i pd { = n 0 = c pri pd W c { Se ped_novo c = n + n 1 = c seg c }
  Se n {
    `<section class="mu-espera"><h2 class="mu-sec">À espera do Maestro <span>{ N n }</span></h2><div class="mu-card mu-pedidos">`
    = c pri pd
    W c { Se ped_novo c { = op c.opcoes
        `<div class="mu-pedido" data-chave="{ esct txt c.id }" data-esq="cancelar&#9;{ esct txt c.id }" data-esq-rotulo="Cancelar"><div><div class="tx">«{ esct txt c.texto }»</div><div class="mt">pedido a { pdia txt c.criadoEm } · { N int op.faixas } faixas · { nome_estilo idx_estilo txt op.estilo }</div></div><button type="button" class="mu-btn sec peq" data-onda="cancelar&#9;{ esct txt c.id }">Cancelar</button></div>` }
      = c seg c }
    `</div><p class="mu-nota">{ ? == tipo _ar_get @ 3 $"naHora" 3 "O Maestro é chamado quando pedes: costuma demorar uns minutos." "O Maestro trata deles às 07:44 e às 18:44." } As playlists aparecem aqui e no teu Tidal.</p></section>` } }
# a playlist (id) tem uma afinação pedida, ainda à espera do Maestro?
: afina_pend i>i id { = r 0 = c pri @ 5 W && c ~ r { Se && mesmo txt c.estado $"pendente" mesmo txt c.afinar.playlist id = r ? == tipo c.afinar.rever 3 2 1 = c seg c } r }
# arrastar um cartão para a esquerda (a casca) pede para o apagar: a pergunta aparece no lugar do cartão
# o nome da proposta (a variante) antes do nome, se o nome ainda nao o tiver (o Maestro as vezes ja o junta)
: tmin i>i c ? && >= c 65 <= c 90 + c 32 c
: tcontem_ci ii>i t p { = n _tx_len t = m _tx_len p = r 0 = i 0
  W && ~ r <= + i m n { = k 1 = j 0 W && k < j m { = k == tmin _tx_b t + i j tmin _tx_b p j = j + j 1 } = r k = i + i 1 } r }
: var_pref i>i c { = v txt c.variante Se && && pl_rasc c _tx_len v ~ tcontem_ci txt c.nome v `{ esct v } · ` }
: pl_card i>i c ? @ 56 pl_esc c ? && _tx_len @ 54 mesmo txt c.id @ 54 { pl_apagar c 0 } { pl_cartao c 0 }
: pl_apagar i>i c {
  = id txt c.id
  `<div class="mu-pl mu-pl-apagar" role="group" aria-label="Apagar"><div class="tx"><b>Apagar «{ var_pref c }{ esct txt c.nome }»?</b><span>`
  ? txt c.tidal "Também está no teu Tidal." "Sai da app."
  `</span></div><div class="mu-acoes">`
  ? txt c.tidal `<button type="button" class="mu-btn perigo forte peq" data-onda="apagarl_t&#9;{ esct id }">{ ic 9 }No Tidal e na app</button><button type="button" class="mu-btn sec peq" data-onda="apagarl_s&#9;{ esct id }">Só na app</button>`
    `<button type="button" class="mu-btn perigo forte peq" data-onda="apagarl_s&#9;{ esct id }">{ ic 9 }Apagar</button>`
  `<button type="button" class="mu-btn sec peq" data-onda="apagarl_n">Não</button></div></div>` }
: pl_cartao i>i c {
  = ab mesmo txt c.id @ 50
  `<div class="mu-pl{ Se ab " aberta" }{ Se txt c.tidal " tidal" }" data-chave="{ esct txt c.id }"{ ? ab 0 ` data-esq="apagarl&#9;{ esct txt c.id }" data-esq-rotulo="Apagar"` }>`
  = cs c.capas = nc quantos cs
  Se nc { `<span class="mu-pl-capa{ Se >= nc 4 " m4" }" aria-hidden="true">` = e pri cs = q 0 W && e < q 4 { `<img src="{ esct txt e }" alt="" loading="lazy" decoding="async">` = e seg e = q + q 1 } "</span>" }
  `<button type="button" class="mu-pl-a" data-onda="exp&#9;{ esct txt c.id }" aria-expanded="{ ? ab "true" "false" }"><div class="nm">{ var_pref c }{ esct txt c.nome }</div><div class="mt">{ N int c.faixas } faixas · { pmin int c.duracao } · { pdia txt c.criadaEm }`
  = av c.avaliacao Se av { = e txt av.etiqueta ? || mesmo e $"ainda cedo" mesmo e $"sem sinais" 0 { ` · { esct e }` 0 } }
  Se == tipo c.renovar 3 " · ↻"
  = ap afina_pend txt c.id Se ap ` · <span class="mu-pedida">{ ? == ap 2 "o Maestro vai revê-la" "afinação pedida" }</span>`
  Se ~ txt c.tidal " · só na app"
  # afinada (ou revista, as parecidas do Tidal) pelo Maestro nos últimos 7 dias: um selo, para se ver logo na lista
  = fa txt c.afinadaEm Se fa Se <= - / _an_agora 86400000 dias_de fa 7 ` · <span class="mu-afinada">✓ { ? mesmo fa txt c.revistaEm "revista" "afinada" } a { pdia fa }</span>`
  `</div><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>`
  Se txt c.tidal `<a class="mu-tocar" href="{ esct txt c.tidal }" target="_blank" rel="noopener" aria-label="Ouvir «{ esct txt c.nome }» no Tidal">{ ic 4 }</a>`
  Se ab folha c
  "</div>" }
# ===== a folha de uma playlist: o único sítio onde se mexe nela =====
# Sobe de baixo e ocupa o ecrã; ao fechar desce e a lista fica onde estava. Cada pedaço tem a sua função e o seu
# lugar, e um evento redesenha só os que mudam (refolha): a folha não salta nem perde o teclado.
#   .mu-folha-cv a capa · .mu-fo-tx o nome · .mu-fo-gerir o «⋯» (mudar o nome, atualizar sozinha, apagar) ·
#   .mu-fo-acoes os botões · .mu-fo-afina o afinar (com .mu-af-graf o gráfico e .mu-af-guarda o guardar) ·
#   .mu-cx-xf as faixas · .mu-fo-junta acrescentar uma faixa · .mu-fo-sobre o porquê, como correu e a mistura ·
#   .mu-fo-hist os pedidos
# c é a playlist no índice (está lá logo: a folha abre com o tamanho certo); d = @51 é o documento, que chega a
# seguir com as faixas, e @52 as pré-escutas e as capas. @28: 1 a perguntar se apaga, 2 a mudar o nome, 4 o «⋯»
# aberto. @40: a faixa aberta (posição + 1).
: folha i>i c {
  `<div class="mu-folha" role="dialog" aria-modal="true" aria-label="{ esct txt c.nome }">`
  `<div class="mu-folha-topo"><button type="button" class="mu-fechar" data-onda="exp&#9;{ esct txt c.id }" aria-label="Fechar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><button type="button" class="mu-mais" data-onda="menu" aria-label="Mais opções"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></button></div>`
  `<div class="mu-folha-cab"><div class="mu-folha-cv">{ cx_capa c }</div><div class="tx mu-fo-tx">{ fo_tx c }</div></div>`
  `<div class="mu-cx"><div class="mu-fo-gerir">{ fo_gerir c }</div><div class="mu-acoes mu-fo-acoes">{ fo_acoes c }</div><div class="mu-fo-afina">{ fo_afina c }</div><div class="mu-cx-xf">{ fo_faixas c }</div><div class="mu-fo-junta">{ fo_junta c }</div><div class="mu-fo-sobre">{ fo_sobre c }</div><div class="mu-fo-hist">{ Se @ 51 hist_pl @ 51 }</div></div></div>` }
# o nome e o resumo (do documento, quando ele já chegou: um nome acabado de mudar ou uma faixa tirada veem-se logo)
: dur_de i>i fx { = s 0 = f pri fx W f { = s + s int f.duracao = f seg f } s }
: fo_tx i>i c { = d @ 51 = nm ? d txt d.nome 0
  = nf ? d quantos d.faixas int c.faixas = du ? d dur_de d.faixas int c.duracao
  `<h2>{ var_pref c }{ esct ? _tx_len nm nm txt c.nome }</h2><p>{ N nf }{ ? == nf 1 " faixa" " faixas" } · { pmin du } · { pdia txt c.criadaEm } · { ? mesmo txt ? d d.por c.por $"curador" "✦ Maestro" ? mesmo txt c.origem $"parecidas" "parecidas do Tidal" "por ti" }{ Se d Se == tipo d.opcoes.limpa 3 " · sem letras explícitas" }</p>` }
# a playlist está no Tidal? (pelo documento, quando já chegou — acabada de lá pôr —, ou pelo índice)
: no_tidal i>i c { = d @ 51 || && d == tipo d.tidal 7 > _tx_len txt c.tidal 0 }
# o «⋯»: mudar o nome, atualizar sozinha e apagar; e, por cima das faixas, o aviso de que só está na app
: fo_gerir i>i c { = d @ 51
  Se ~ no_tidal c `<p class="mu-nota">Só está na app. Põe-na no Tidal para a ouvires lá.</p>`
  ? == @ 28 2 `<div class="mu-card mu-renomear"><h3>Mudar o nome</h3><label class="mu-campo"><span>Nome</span><input data-onda="rn-nome" maxlength="60" value="{ esct @ 46 }"></label><label class="mu-campo"><span>Descrição (opcional)</span><textarea data-onda="rn-desc" maxlength="300">{ esct @ 47 }</textarea></label><div class="mu-acoes"><button type="button" class="mu-btn" data-onda="renomear_sim">Guardar</button><button type="button" class="mu-btn sec" data-onda="nao">Cancelar</button></div><p class="mu-nota">Muda na app e, se lá estiver, no Tidal (o link fica o mesmo). Quando se atualiza sozinha, o nome que deres fica.</p></div>`
  ? == @ 28 1 { `<div class="mu-card mu-confirma"><h3>Apagar esta playlist?</h3>`
      ? txt c.tidal `<p>Também está no teu Tidal.</p><div class="mu-acoes"><button type="button" class="mu-btn perigo forte" data-onda="apagar_tidal">{ ic 9 }Apagar no Tidal e na app</button><button type="button" class="mu-btn sec" data-onda="apagar_sim">Só na app</button><button type="button" class="mu-btn sec" data-onda="nao">Não</button></div>`
        `<div class="mu-acoes"><button type="button" class="mu-btn perigo forte" data-onda="apagar_sim">{ ic 9 }Sim, apagar</button><button type="button" class="mu-btn sec" data-onda="nao">Não</button></div>`
      "</div>" }
  Se == @ 28 4 { = rv == tipo ? d d.renovar c.renovar 3
      `<div class="mu-card mu-menu"><button type="button" class="mu-btn sec" data-onda="renomear">Mudar o nome</button>`
      `<div class="mu-interruptor"><div><b>Atualizar sozinha</b><span class="mu-nota">Toda a semana o Maestro renova-a com o mesmo critério, no mesmo link do Tidal: ficam as que guardaste, saem as que tiraste.{ Se d Se txt d.renovadaEm ` Última: { pdia txt d.renovadaEm }.` }</span></div><button type="button" class="mu-btn sec peq" data-onda="renovar" aria-pressed="{ ? rv "true" "false" }">{ ? rv "Ligado" "Desligado" }</button></div>`
      `<button type="button" class="mu-btn perigo" data-onda="apagar">{ ic 9 }Apagar</button></div>` } }
# os botões: ouvir no Tidal (ou pôr lá) e afinar; a afinar, dão lugar ao cartão do afinar
: fo_acoes i>i c Se ~ @ 6 { = d @ 51 = td ? d d.tidal 0
  ? && td == tipo td 7 `<a class="mu-btn peq" href="{ esct txt td.url }" target="_blank" rel="noopener">{ ic 4 }Ouvir no Tidal</a>`
    { ? txt c.tidal `<a class="mu-btn peq" href="{ esct txt c.tidal }" target="_blank" rel="noopener">{ ic 4 }Ouvir no Tidal</a>`
      `<button type="button" class="mu-btn peq" data-onda="enviar">{ ic 3 }Pôr no Tidal</button>` }
  Se d `<button type="button" class="mu-btn sec peq" data-onda="afinar">{ ic 5 }Afinar</button>` }
# o porquê da playlist, como correu (o conector avalia-a sozinho) e a mistura: fechado até se querer ver
: fo_sobre i>i c { = d @ 51
  Se d {
    = rs ? _tx_len txt d.resumo txt d.resumo txt d.descricao
    = a d.avaliacao
    `<details class="mu-sobre"><summary>Sobre esta playlist<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>`
    Se _tx_len rs { `<h3>Porquê esta playlist</h3><p class="mu-resumo">{ esct rs }</p>`
        = tl d.tendencias
        Se quantos tl { `<ul class="mu-tend">` = e pri tl W e { `<li>{ esct txt e }</li>` = e seg e } "</ul>" } }
    Se a {
      = et txt a.etiqueta
      "<h3>Como correu</h3><p>"
      ? || mesmo et $"ainda cedo" mesmo et $"sem sinais" { ? mesmo et $"ainda cedo" "Ainda é cedo." "Ainda sem sinais." } { `<b>{ esct et }</b> · nota { N int a.nota }` 0 }
      = g quantos a.guardadas Se g ` · guardaste { N g }`
      = t quantos a.tiradas Se t ` · tiraste { N t }`
      Se int a.juntadas ` · juntaste { N int a.juntadas }`
      Se quantos a.eco ` · nas tuas mixes: { partistas a.eco }`
      `</p><p class="mu-nota">Sem perguntar nada: as faixas que guardas nas favoritas, as que tiras ou juntas no Tidal, e os artistas que o Tidal passa a pôr nas tuas mixes.</p>` }
    `<h3>A mistura</h3>{ mistura_de d.faixas }</details>` } }
# a capa grande da folha: as 4 primeiras capas diferentes das faixas (160 px), ou 1; enquanto nao chegam, as do indice
: cx_img i>i u `<img src="{ esct u }" alt="" decoding="async">`
: cx_capa i>i c {
  = d @ 51 = cs _ar_get @ 52 $"capas" = a 0 = b 0 = e 0 = g 0 = n 0
  Se && d cs { = f pri d.faixas W && f < n 4 {
      = u txt _ar_get cs txt f.id
      Se u { = rep 0
        Se a Se mesmo u a = rep 1 Se b Se mesmo u b = rep 1 Se e Se mesmo u e = rep 1
        Se ~ rep { ? == n 0 { = a u 0 } { ? == n 1 { = b u 0 } { ? == n 2 { = e u 0 } { = g u 0 } } } = n + n 1 } }
      = f seg f } }
  ? >= n 4 `<div class="mu-folha-capa m4">{ cx_img a }{ cx_img b }{ cx_img e }{ cx_img g }</div>`
    { ? n `<div class="mu-folha-capa">{ cx_img a }</div>`
      { = ci c.capas = nc quantos ci
        `<div class="mu-folha-capa{ Se >= nc 4 " m4" }">` = f pri ci = q 0 W && f < q 4 { `<img src="{ esct txt f }" alt="" decoding="async">` = f seg f = q + q 1 } "</div>" } } }
# Tidal × Maestro: no «Mais como esta», o Tidal faz a lista (as parecidas) e o Maestro revê-a. Depois da revisão, a
# história diz quantas das do Tidal ficaram e quantas entraram, o que guardaste nas favoritas de cada lado, e deixa
# ouvir as do Tidal que saíram e voltar a pô-las (entram no fim, também no Tidal)
: do_tidal ii>i d id { = r 0 = f pri d.doTidal.faixas W && f ~ r { = r mesmo txt f.id id = f seg f } r }
: tem_cmp i>i d ? d && quantos d.doTidal.faixas _tx_len txt d.revistaEm 0
: cmp_tidal i>i d {
  = dt d.doTidal.faixas = nt quantos dt = fic 0
  = f pri dt W f { Se na_doc d txt f.id = fic + fic 1 = f seg f }
  = nov - quantos d.faixas fic = ns - nt fic
  `<span class="mu-mudou mu-cmp-n">Das { N nt } do Tidal { ? == fic 0 "não ficou nenhuma" ? == fic 1 "ficou 1" `ficaram { N fic }` } · { ? == nov 0 "sem novas" ? == nov 1 "entrou 1 nova" `entraram { N nov } novas` }</span>`
  = a d.avaliacao
  Se a { = gt 0 = gn 0 = g pri a.guardadas
    W g { ? do_tidal d txt g.id { = gt + gt 1 0 } { = gn + gn 1 0 } = g seg g }
    Se + gt gn `<span class="mu-mudou">Guardaste nas favoritas: { N gt } do Tidal · { N gn } das novas</span>` }
  Se ns {
    `<details class="mu-cmp"><summary>Ouvir { ? == ns 1 "a do Tidal que saiu" `as { N ns } do Tidal que saíram` }<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><ol class="mu-xf">`
    = f pri dt W f { Se ~ na_doc d txt f.id cmp_linha f = f seg f }
    `</ol><p class="mu-nota">«+» volta a pôr a faixa no fim da playlist, também no Tidal.</p></details>` } }
: cmp_linha i>i f {
  = id txt f.id = cv txt _ar_get _ar_get @ 52 $"capas" id = u txt _ar_get _ar_get @ 52 $"previas" id
  `<li data-chave="t{ esct id }"><span class="cp">{ Se cv `<img src="{ esct cv }" alt="" loading="lazy" decoding="async">` }</span><div class="tx"><b>{ esct txt f.titulo }</b><span>{ partistas f.artistas }</span></div>`
  ? u { = tc mesmo u @ 55 `<button type="button" class="mu-ouvir{ Se tc " a-tocar" }" data-onda="ouvir&#9;{ esct u }" aria-pressed="{ ? tc "true" "false" }" aria-label="{ ? tc "Parar" "Ouvir 30 segundos de" } «{ esct txt f.titulo }»">{ ic 4 }</button>` } `<span class="mu-ouvir vazio"></span>`
  `<button type="button" class="mu-trocar" data-onda="repor_t&#9;{ esct id }" aria-label="Voltar a pôr «{ esct txt f.titulo }»">{ ic 12 }</button></li>` }
# o pedido que fez a playlist e as afinações pedidas depois (à espera ou feitas), por ordem
: hist_pl i>i d {
  = af d.afinacoes = na quantos af
  Se || _tx_len txt d.pedido na {
    `<div class="mu-hist"><h3>{ ? na "Pedidos desta playlist" "O teu pedido" }</h3><ol>`
    Se _tx_len txt d.pedido `<li><span class="q">«{ esct txt d.pedido }»</span><span class="m">O pedido · { pdia txt d.criadaEm }</span></li>`
    = c pri af
    W c {
      = nr int c.rejeitadas = rv == tipo c.rever 3
      `<li{ ? _tx_len txt c.feitoEm 0 ` class="espera"` }><span class="q">{ ? rv "Rever as parecidas do Tidal" ? _tx_len txt c.texto `«{ esct txt c.texto }»` `Sem { N nr }{ ? > nr 1 " faixas que tiraste" " faixa que tiraste" }` }</span><span class="m">{ ? rv "Revisão" "Afinação" } · `
      ? _tx_len txt c.feitoEm { `feita a { pdia txt c.feitoEm }` 0 } "à espera do Maestro"
      `{ Se && nr _tx_len txt c.texto ` · sem { N nr } que tiraste` }{ Se && ~ _tx_len txt c.feitoEm _tx_len txt c.pedido ` · <button type="button" class="mu-ligacao" data-onda="cancelar&#9;{ esct txt c.pedido }">Cancelar</button>` }</span>`
      # a revisão de uma lista do Tidal: a comparação Tidal × Maestro; nas outras, o que mudou (quantas entraram e
      # saíram, e as primeiras novas)
      ? && && rv _tx_len txt c.feitoEm quantos d.doTidal.faixas { cmp_tidal d 0 } {
      Se c.entraram { = ne int c.entraram = ns int c.sairam
          `<span class="mu-mudou">{ ? || ne ns { N ne ? == ne 1 " nova, " " novas, " N ns ? == ns 1 " saiu" " saíram" } "Sem faixas novas" }`
          = nv c.novas `{ Se quantos nv { ": " = e pri nv W e { esct txt e = e seg e Se e " · " } } }</span>` } 0 }
      "</li>"
      = c seg c }
    "</ol></div>" } }
# as faixas: capa, título e artista, ouvir 30 s e ⇄ trocar. Enquanto não chegam, linhas cinzentas do mesmo tamanho (a
# folha não salta). Tocar no título abre a linha: tirar e «Mais como esta». Arrastar a linha para a esquerda tira-a.
# A faixa que está a ser trocada (@60 = posição + 1) mostra já a que entra (@61, a candidata que o motor escolheu)
# a afinar pelas regras (o afinar aberto e a playlist com candidatas): as linhas passam a ter o alfinete
: afr >i && @ 6 > @ 37 0
: fo_faixas i>i c {
  = d @ 51
  ? ~ d {
    = n int c.faixas Se > n 40 = n 40 Se < n 1 = n 6
    `<ol class="mu-xf" aria-busy="true" aria-label="A carregar as faixas">`
    L p n `<li class="sk"><span class="cp"></span><div class="tx"><b>&nbsp;</b><span>&nbsp;</span></div><span class="mu-ouvir vazio"></span><span class="mu-ouvir vazio"></span></li>`
    "</ol>" } {
    `<ol class="mu-xf{ Se afr " a-afinar" }">`
    Se == @ 6 2 L p @ 14 { = ci @ + @ 13 p = g _ar_get cn ci $"faixa" af_linha g ci ~ na_doc d txt g.id }
    = f ? == @ 6 2 0 pri d.faixas = p 0
    W f ? afr { af_linha f cand_de d txt f.id 0 = f seg f = p + p 1 } {
      = id txt f.id = ab == @ 40 + p 1 = tr == @ 60 + p 1
      # a trocar: a linha já mostra a que entra (se o motor a escolheu aqui); sem ela, espera pela parecida do Tidal
      # (a chave da linha é a faixa que se vê: a que entra é uma linha nova, e fica a mesma quando a troca é gravada)
      = g ? && tr @ 61 _ar_get @ 61 $"faixa" f
      = cv txt _ar_get _ar_get @ 52 $"capas" txt g.id
      `<li{ Se tr ` class="a-trocar"` } data-chave="{ esct txt g.id }" data-esq="tirarf&#9;{ esct id }" data-esq-rotulo="Tirar"><span class="cp">{ Se cv `<img src="{ esct cv }" alt="" loading="lazy" decoding="async">` }</span><button type="button" class="tx" data-onda="sel&#9;{ N p }" aria-expanded="{ ? ab "true" "false" }"><b>{ esct txt g.titulo }</b><span>{ ? && tr ~ @ 61 "A procurar uma parecida…" partistas g.artistas }</span></button>`
      = u txt _ar_get _ar_get @ 52 $"previas" txt g.id
      ? && u ~ tr { = tc mesmo u @ 55 `<button type="button" class="mu-ouvir{ Se tc " a-tocar" }" data-onda="ouvir&#9;{ esct u }" aria-pressed="{ ? tc "true" "false" }" aria-label="{ ? tc "Parar" "Ouvir 30 segundos de" } «{ esct txt f.titulo }»">{ ic 4 }</button>` } `<span class="mu-ouvir vazio"></span>`
      `<button type="button" class="mu-trocar" data-onda="trocar&#9;{ N p }" aria-label="Trocar «{ esct txt f.titulo }» por outra"{ Se tr ` aria-busy="true"` }><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h11l-3-3M17 16H6l3 3"/></svg></button>`
      Se && ab ~ tr `<div class="mu-xf-mais"><button type="button" class="mu-btn perigo peq" data-onda="tirarf&#9;{ esct id }">{ ic 14 }Tirar</button><button type="button" class="mu-btn sec peq" data-onda="mais&#9;{ esct id }">{ ic 5 }Mais como esta</button><span class="mu-nota">«Mais como esta» cria outra playlist no Tidal com as faixas parecidas; o Maestro revê-a na corrida seguinte.</span></div>`
      "</li>"
      = f seg f = p + p 1 }
    "</ol>"
    Se ~ afr troca_nota d } }
# milissegundos desde 1970 de «AAAA-MM-DDTHH:MM:SS…» (UTC)
: ms_de i>i t ? < _tx_len t 19 0 + * dias_de t 86400000 * 1000 + + * dnum t 11 2 3600 * dnum t 14 2 60 dnum t 17 2
# a última troca ou faixa tirada (nos últimos 10 minutos, se o conector ainda guarda a faixa que saiu), com «Desfazer»
: troca_ult i>i d { = e 0 = c pri d.trocas W c { = e c = c seg c } ? && e && e.faixa < - _an_agora ms_de txt e.em 600000 e 0 }
: tit_de ii>i d id { = r 0 = f pri d.faixas W && f ~ r { Se mesmo txt f.id id = r txt f.titulo = f seg f } r }
: troca_nota i>i d { = e troca_ult d
  Se e { `<p class="mu-xf-nota">`
    ? _tx_len txt e.entra `Trocaste «{ esct txt e.titulo }» por «{ esct tit_de d txt e.entra }».` `Tiraste «{ esct txt e.titulo }».`
    ` <button type="button" data-onda="desfazer">{ ? _tx_len txt e.entra "Desfazer" "Repor" }</button></p>` } }
# a playlist do cartao aberto, no indice
: pl_aberta >i { = r 0 Se && @ 4 _tx_len @ 50 { = c pri @ 4 W && c ~ r { Se mesmo txt c.id @ 50 = r c = c seg c } } r }
# Desenha-se com o _ht_muda: no ecrã só muda o que é diferente (as capas não piscam, a lista não salta, o que está a
# meio de uma animação continua); cada item de uma lista leva data-chave, para se saber qual é qual.
# redesenha pedaços da folha aberta sem mexer no resto (m, somados: 1 o nome, 2 o «⋯», 4 os botões, 8 as faixas,
# 16 o porquê e os pedidos, 32 a capa, 128 o afinar (com a caixa do Maestro), 256 só o gráfico e o guardar do
# afinar, 512 acrescentar uma faixa). Se a folha ainda não está no ecrã, desenha tudo
: refolha i>i m {
  = c pl_aberta
  ? ~ c render {
    = mk _me_marca = ok 1
    Se & m 8 { = h _ht_ini 250000 fo_faixas c = ok _ht_muda $".mu-folha .mu-cx-xf" h }
    Se && ok & m 1 { = h _ht_ini 3000 fo_tx c = ok _ht_muda $".mu-folha .mu-fo-tx" h }
    Se && ok & m 2 { = h _ht_ini 8000 fo_gerir c = ok _ht_muda $".mu-folha .mu-fo-gerir" h }
    Se && ok & m 4 { = h _ht_ini 3000 fo_acoes c = ok _ht_muda $".mu-folha .mu-fo-acoes" h }
    Se && ok & m 16 { = h _ht_ini 40000 fo_sobre c = ok _ht_muda $".mu-folha .mu-fo-sobre" h = h _ht_ini 40000 Se @ 51 hist_pl @ 51 _ht_muda $".mu-folha .mu-fo-hist" h }
    Se && ok & m 32 { = h _ht_ini 4000 cx_capa c = ok _ht_muda $".mu-folha .mu-folha-cv" h }
    Se && ok & m 128 { = h _ht_ini 40000 fo_afina c = ok _ht_muda $".mu-folha .mu-fo-afina" h }
    Se && && ok & m 256 @ 6 { = h _ht_ini 30000 af_graf = ok _ht_muda $".mu-folha .mu-af-graf" h = h _ht_ini 3000 af_guarda _ht_muda $".mu-folha .mu-af-guarda" h }
    Se && ok & m 512 { = h _ht_ini 20000 fo_junta c = ok _ht_muda $".mu-folha .mu-fo-junta" h }
    _me_solta mk
    ? ok 0 render } }
# a lista agrupa-se pela data; os filtros mostram so um tipo, genero, Tidal ou avaliacao (q: 0 data, 1 tipo, 2 genero,
# 3 Tidal, 4 avaliacao)
: dnum iii>i t i n { = v 0 L j n = v + * v 10 - _tx_b t + i j '0 v }
# dias desde 1970 de «AAAA-MM-DD...»
: dias_de i>i t {
  = y dnum t 0 4 = m dnum t 5 2 = dd dnum t 8 2
  = y - y ? <= m 2 1 0
  = era / y 400 = yoe - y * era 400
  = mm ? > m 2 - m 3 + m 9
  = doy + / + * 153 mm 2 5 - dd 1
  = doe + - + * yoe 365 / yoe 4 / yoe 100 doy
  - + * era 146097 doe 719468 }
: grpq ii>i c q {
  ? == q 1 { ? == tipo c.renovar 3 $"Atualizam-se sozinhas" ? mesmo txt c.por $"app" $"Feitas por ti" ? _tx_len txt c.pedido $"Dos teus pedidos" $"Do Maestro" }
  ? == q 2 { = g txt c.genero ? && g _tx_len g g $"Vários géneros" }
  ? == q 3 { ? txt c.tidal $"No Tidal" $"Só na app" }
  ? == q 4 { = e txt c.avaliacao.etiqueta ? || ~ e || mesmo e $"ainda cedo" mesmo e $"sem sinais" $"Ainda sem avaliação" ? mesmo e $"resultou" $"Resultaram" ? mesmo e $"boa" $"Boas" ? mesmo e $"morna" $"Mornas" $"Não resultaram" }
  { = t txt c.criadaEm = dd - / _an_agora 86400000 ? t dias_de t 0 ? <= dd 6 $"Esta semana" ? <= dd 30 $"Este mês" $"Mais antigas" } }
: grp i>i c grpq c 0
# passa no filtro escolhido?
: pl_vis i>i c ? @ 53 mesmo grpq c @ 53 @ 59 1
# c e a primeira do seu grupo (entre as que se veem)?
: grp_primeiro ii>i d c { = e pri d = r 1 = k grp c W && e != e c { Se && pl_vis e mesmo grp e k = r 0 = e seg e } r }
: grp_n ii>i d c { = e pri d = n 0 = k grp c W e { Se && pl_vis e mesmo grp e k = n + n 1 = e seg e } n }
# os filtros: um botao por valor que existe (com quantas tem), por esta ordem: Tidal, tipo, avaliacao, genero
: chip_prim iii>i d c q { = e pri d = r 1 = k grpq c q W && e != e c { Se mesmo grpq e q k = r 0 = e seg e } r }
: chip_n iii>i d c q { = e pri d = n 0 = k grpq c q W e { Se mesmo grpq e q k = n + n 1 = e seg e } n }
: chips_pl ii>i d nf {
  `<div class="mu-filtros" role="toolbar" aria-label="Filtrar"><button type="button" class="mu-chip-f" data-onda="filtro&#9;0" aria-pressed="{ ? @ 53 "false" "true" }">Todas <span>{ N nf }</span></button>`
  L i 4 {
    = q ? == i 0 3 ? == i 1 1 ? == i 2 4 2
    = c pri d
    W c {
      Se chip_prim d c q {
        = n chip_n d c q = l grpq c q = at && == q @ 53 mesmo l @ 59
        # um filtro que deixa tudo na mesma nao vale a pena (a nao ser o que esta escolhido, para o poder tirar)
        Se || < n nf at `<button type="button" class="mu-chip-f" data-onda="filtro&#9;{ N q }{ esct l }" aria-pressed="{ ? at "true" "false" }">{ esct l } <span>{ N n }</span></button>` }
      = c seg c } }
  "</div>" }
# juntar playlists: escolhem-se (as escolhidas ficam em @58 como «,id,id,») e o conector junta-as numa nova
: tigualem iii>i t i p { = m _tx_len p = r 1 = j 0 W && r < j m { = r == _tx_b t + i j _tx_b p j = j + j 1 } r }
: ttemid ii>i t p { = n _tx_len t = m _tx_len p = r 0 = i 1
  W && ~ r < + i m n { Se && == _tx_b t - i 1 44 == _tx_b t + i m 44 = r tigualem t i p = i + i 1 } r }
: n_esc i>i d { = n 0 = c pri d W c { Se ttemid @ 58 txt c.id = n + n 1 = c seg c } n }
: esc_alt i>i id {
  = d @ 4 = ja ttemid @ 58 id
  ? && ~ ja >= n_esc d 10 { aviso $"No máximo 10 playlists de cada vez." 0 } {
    = s _tx_abre 400 ","
    = c pri d
    W c { = e txt c.id = x ttemid @ 58 e Se ? mesmo e id ~ x x { crut e P 44 } = c seg c }
    _tx_fecha s tcopia @ 58 s 390 render 0 } }
: pl_esc i>i c {
  = id txt c.id = sim ttemid @ 58 id
  `<button type="button" class="mu-pl mu-pl-esc{ Se sim " sim" }" data-onda="esc&#9;{ esct id }" aria-pressed="{ ? sim "true" "false" }">`
  = cs c.capas Se quantos cs `<span class="mu-pl-capa" aria-hidden="true"><img src="{ esct txt pri cs }" alt="" loading="lazy" decoding="async"></span>`
  `<span class="mu-pl-a"><span class="nm">{ esct txt c.nome }</span><span class="mt">{ N int c.faixas } faixas · { pmin int c.duracao }</span></span>`
  `<span class="mu-esc-v" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></button>` }
: barra_juntar i>i d {
  = n n_esc d
  `<div class="mu-juntar-barra" role="region" aria-label="Juntar playlists"><span>{ ? n { N n ? > n 1 " escolhidas" " escolhida" } "Escolhe 2 ou mais" }</span>`
  `<button type="button" class="mu-btn sec peq" data-onda="juntar_nao">Cancelar</button><button type="button" class="mu-btn peq" data-onda="juntar_sim"{ Se < n 2 " disabled" }>{ ic 12 }Juntar</button></div>` }
: juntar_enviar >i ? ocupado 0 {
    = d @ 4
    ? < n_esc d 2 { aviso $"Escolhe pelo menos 2 playlists." 0 } {
      = r _tx_abre 1200 `POST /api/juntar{ P 10 }\{"ids":[`
      = c pri d = k 0
      W c { = e txt c.id Se ttemid @ 58 e { Se k "," pjs e = k 1 } = c seg c }
      `]\}`
      pede _tx_fecha r 19
      aviso $"A juntar…" 0 } }
: pl_rasc i>i c == tipo c.rascunho 3
: lista_pl i>i d {
  ? ~ quantos d `<div class="mu-card nada"><h3>Ainda não há playlists</h3><p>O Maestro cria a primeira «Onda da semana» na próxima manhã. Ou faz já um pedido.</p><div class="mu-acoes"><button type="button" class="mu-btn" data-onda="ir&#9;3">{ ic 2 }Fazer um pedido</button></div></div>`
  {
    = nf quantos d
    `<div class="mu-lista-topo"><span>{ ? @ 56 "Escolhe as playlists a juntar" "As tuas playlists" }</span>`
    `{ Se && ~ @ 56 >= nf 2 `<button type="button" class="mu-btn sec peq" data-onda="juntar_modo">{ ic 12 }Juntar</button>` }</div>`
    Se > nf 1 chips_pl d nf
    = nv 0 = c pri d W c { Se pl_vis c = nv + nv 1 = c seg c }
    Se ~ nv `<p class="mu-nota">Nenhuma playlist com este filtro.</p>`
    = c pri d
    W c {
      Se && pl_vis c grp_primeiro d c {
        `<section class="mu-grp" data-chave="g-{ esct grp c }"><h2 class="mu-sec">{ esct grp c } <span>{ N grp_n d c }</span></h2><div class="mu-lista-pl">`
        = k grp c = e pri d W e { Se && pl_vis e mesmo grp e k pl_card e = e seg e }
        "</div></section>" }
      = c seg c }
    Se @ 56 barra_juntar d } }
: v_playlists >i {
  `<header class="mu-head"><div><h1>Música</h1><div class="sub">Playlists de qualidade para o teu Tidal</div></div>{ pill }</header>`
  ? ~ @ 3 carregar {
    ? ~ acesso boas_vindas {
      Se ~ @ 56 espera @ 5
      ? @ 4 lista_pl @ 4 carregar } }
  0 }

# ===== afinar na folha: o motor de curadoria escolhe e ordena outra vez, aqui no telemóvel =====
# @6: 0 fechado, 1 aberto (ainda se vê a playlist guardada), 2 com mudanças (vê-se o que o motor escolheu). As opções:
# @7 n.º de faixas, @8 máximo por artista, @9 estilo, @10 arco. @11 as candidatas (nós), @17 as fixadas (por
# candidata). O resultado: @13 a ordem (índices das candidatas), @14 quantas, @15 o porquê, @32 os pontos, @16 o
# custo. As faixas que saíram da playlist (tiradas ou trocadas) ficam de fora.
: cn i>i i @ + @ 11 i
# barras de uma contagem (tx textos ou decadas, ct contagens), ordenadas, no maximo 6
: barras_arr iiiii>i tx ct n tot modo {
  `<div class="mu-mix">`
  = feito A + n 1
  = q 0 W && < q 6 < q n {
    = b -1 = bv -1 L k n Se && ~ @ + feito k > @ + ct k bv { = b k = bv @ + ct k }
    ! + feito b 1
    `<div class="mu-barra"><span>`
    ? modo { ? @ + tx b `{ N @ + tx b }s` "?" } { ? _tx_len @ + tx b esct @ + tx b "?" }
    `</span><span class="b"><i style="width:{ N / + * 200 bv tot * 2 tot }%"></i></span><span class="v">{ N bv }</span></div>`
    = q + q 1 }
  "</div>" }
# a mistura de uma playlist: quantas faixas de cada género e de cada década. Conta-se uma faixa de cada vez
# (mix_ini, mix_mais com o género e o ano, mix_fim desenha as barras); @11..@16 do afinador não se tocam: as contas
# ficam num bloco próprio [gt, gc, ng, dt, dc, nd, n]
: mix_ini i>i n { = b A 7 ! b A + n 1 ! + b 1 A + n 1 ! + b 3 A + n 1 ! + b 4 A + n 1 b }
: mix_mais iii>i b g a {
  = gt @ b = gc @ + b 1 = ng @ + b 2
  = k 0 = ach -1 W && < k ng < ach 0 { Se mesmo @ + gt k g = ach k = k + k 1 }
  ? < ach 0 { ! + gt ng g ! + gc ng 1 ! + b 2 + ng 1 0 } { ! + gc ach + @ + gc ach 1 0 }
  = dt @ + b 3 = dc @ + b 4 = nd @ + b 5 = dv ? a * / a 10 10 0
  = k 0 = ach -1 W && < k nd < ach 0 { Se == @ + dt k dv = ach k = k + k 1 }
  ? < ach 0 { ! + dt nd dv ! + dc nd 1 ! + b 5 + nd 1 0 } { ! + dc ach + @ + dc ach 1 0 }
  ! + b 6 + @ + b 6 1 }
: mix_fim i>i b Se @ + b 6 { barras_arr @ b @ + b 1 @ + b 2 @ + b 6 0 barras_arr @ + b 3 @ + b 4 @ + b 5 @ + b 6 1 }
: mistura_de i>i fx { = b mix_ini quantos fx = f pri fx W f { mix_mais b txt f.genero int f.ano = f seg f } mix_fim b }
: seg_af iiii>i nome n ini atual {
  = q ini W < q + ini n {
    `<button type="button" data-onda="{ ? == nome 1 "af-mx" ? == nome 2 "af-es" ? == nome 3 "af-ar" ? == nome 4 "pd-mx" ? == nome 5 "pd-es" "pd-ar" }&#9;{ N q }" aria-pressed="{ ? == q atual "true" "false" }">`
    ? || == nome 1 == nome 4 N q ? || == nome 2 == nome 5 nome_estilo q nome_arco q
    "</button>" = q + q 1 } }
# o contexto do motor para as candidatas do documento d marcadas em us (1 = entra na conta), a escolher k, com o
# máximo por artista mx, o estilo e e o arco a; fx (ou 0) diz as fixadas. Os ids do artista e do género são densos,
# pela ordem em que aparecem (sem nome: um artista só dela; sem género: 0). Na casa 34 do contexto fica o mapa:
# posição no contexto → índice da candidata
: ctx_cands iiiiiii>i d us fx k mx e a {
  = ks d.candidatas = n quantos ks
  = nu 0 L i n Se @ + us i = nu + nu 1
  = c ctx_novo nu Mn k nu mx
  L w 5 cs c + 3 w @ + @ 36 + * e 5 w
  cs c 8 300 cs c 9 250 cs c 10 200
  cs c 11 arco_val a
  = mp A + nu 1 cs c 34 mp
  = at A + nu 1 = na 0 = gt A + nu 1 = ng 0
  = x pri ks = i 0 = j 0
  W x {
    Se @ + us i {
      = s x.sinais
      = t txt s.artista = id -1
      Se _tx_len t { = q 0 W && < q na < id 0 { Se mesmo @ + at q t = id q = q + q 1 } }
      Se < id 0 { ! + at na t = id na = na + na 1 }
      ap c 12 j Mn id nu
      = y txt s.genero = gi 0
      Se _tx_len y { = q 0 = gi -1 W && < q ng < gi 0 { Se mesmo @ + gt q y = gi + q 1 = q + q 1 }
          Se < gi 0 { ! + gt ng y = ng + ng 1 = gi ng } }
      ap c 13 j Mn gi nu
      ap c 29 j lim int s.gosto 0 1000 ap c 30 j lim int s.qualidade 0 1000 ap c 31 j lim int s.tendencia 0 1000
      ap c 32 j lim int s.claude 0 1000 ap c 33 j lim int s.novidade 0 1000 ap c 15 j lim int s.energia 0 1000
      ap c 16 j lim int s.bpm 0 400 ap c 17 j lim int s.tom 0 24 ap c 14 j decada lim int s.ano 0 2100
      ap c 18 j || == tipo s.fixa 3 ? fx @ + fx i 0
      ! + mp j i
      = j + j 1 }
    = x seg x = i + i 1 }
  c }
# as candidatas que contam: as que não saíram da playlist (1 em cada casa); devolve o vetor
: af_usam i>i d { = us A + quantos d.candidatas 1 = x pri d.candidatas = i 0 W x { Se ~ fora_de d txt x.faixa.id ! + us i 1 = x seg x = i + i 1 } us }
: af_usaveis i>i d { = n 0 = x pri d.candidatas W x { Se ~ fora_de d txt x.faixa.id = n + n 1 = x seg x } n }
# o motor: escolhe e ordena com as opções de agora; o resultado fica em @13.. (o que se reservou aqui volta ao monte)
: afina_correr >i {
  = t0 _an_agora = mk _me_marca
  = d @ 51
  = c ctx_cands d af_usam d @ 17 @ 7 @ 8 @ 9 @ 10
  ! 16 curar c
  = m cg c 27 ! 14 m = mp cg c 34
  L p m { = j ag c 28 p ! + @ 13 p @ + mp j ! + @ 15 p ag c 20 j ! + @ 32 p ag c 26 j }
  _me_solta mk
  ! 33 - _an_agora t0
  0 }
# abrir o afinar: em cima, a caixa para pedir ao Maestro; por baixo, as regras (as opções são as da playlist;
# enquanto não se mexe em nada vê-se a playlist como está). Sem candidatas, fica só a caixa do Maestro
: afina_abrir >i {
  = d @ 51
  Se d {
    = n quantos d.candidatas
    ! 37 n ! 11 A + n 1 ! 13 A + n 1 ! 15 A + n 1 ! 17 A + n 1 ! 32 A + n 1
    = x pri d.candidatas = i 0 W x { ! + @ 11 i x = x seg x = i + i 1 }
    = op d.opcoes = us af_usaveis d
    = f int op.faixas ! 7 ? && > f 0 < f us f us
    = mx int op.maxArtista ! 8 ? > mx 0 mx 2
    ! 9 idx_estilo txt op.estilo ! 10 idx_arco txt op.arco
    ! 6 1 ! 14 0 ! 40 0 ! 62 0
    refolha 652 } }
# mudou uma opção ou uma fixada: o motor corre e a folha mostra o resultado (o gráfico, a lista e o «Guardar»)
: afina_muda i>i m { ! 6 2 afina_correr refolha m }
# a faixa (id) está na playlist guardada?
: na_doc ii>i d id { = r 0 = f pri d.faixas W && f ~ r { = r mesmo txt f.id id = f seg f } r }
# o gráfico da energia: a de cada faixa pela ordem (a linha cheia) e o arco pedido (o tracejado), e por baixo as
# contas — quantas faixas, quanto dura, e o que entra e sai em relação à playlist guardada
: af_graf >i {
  = d @ 51 = m ? == @ 6 2 @ 14 quantos d.faixas
  = v A + m 1 = du 0 = en 0
  ? == @ 6 2 { L p m { = x cn @ + @ 13 p ! + v p int x.sinais.energia = du + du int x.faixa.duracao Se ~ na_doc d txt x.faixa.id = en + en 1 } 0 }
    { = f pri d.faixas = p 0 W f { = j cand_de d txt f.id ! + v p ? >= j 0 int _ar_get _ar_get cn j $"sinais" $"energia" 500 = du + du int f.duracao = f seg f = p + p 1 } 0 }
  `<svg class="mu-graf" viewBox="0 0 320 76" preserveAspectRatio="none" role="img" aria-label="A energia ao longo da playlist">`
  = a arco_val @ 10
  Se a { = al A + m 1 L p m ! + al p alvo a p m `<path class="alvo" d="{ _gr_curva al m 320 76 8 0 1000 0 }"/>` }
  `<path class="area" d="{ _gr_curva v m 320 76 8 0 1000 1 }"/><path class="linha" d="{ _gr_curva v m 320 76 8 0 1000 0 }"/></svg>`
  `<p class="mu-nota"><span id="af-conta">{ N m }{ ? == m 1 " faixa" " faixas" } · { pmin du }</span>{ Se == @ 6 2 { = sa - + quantos d.faixas en m ` · { N en }{ ? == en 1 " entra" " entram" }, { N sa }{ ? == sa 1 " sai" " saem" }` } }</p>` }
: af_guarda >i { = d @ 51
  `<button type="button" class="mu-btn" data-onda="af-guardar"{ Se != @ 6 2 " disabled" }>{ ic 3 }{ ? == tipo d.tidal 7 "Guardar no Tidal" "Guardar" }</button><button type="button" class="mu-btn sec" data-onda="af-fechar">{ ? == @ 6 2 "Cancelar" "Fechar" }</button>` }
# o afinar na folha: o gráfico, quatro escolhas (estilo, energia, quantas faixas, quantas por artista) e guardar
: fo_afina i>i c Se @ 6 { = us af_usaveis @ 51
  `<div class="mu-card mu-afina"><h3>Afinar</h3>`
  # por palavras: o Maestro refaz a playlist com o que se pede (no mesmo sítio e no mesmo link do Tidal)
  `<div class="mu-cx-afinar"><label class="mu-campo"><span>Diz ao Maestro o que mudar</span><textarea data-onda="af-tx" maxlength="500" rows="2" placeholder="Ex.: menos eletrónica, mais vozes femininas">{ esct @ 49 }</textarea></label><button type="button" class="mu-btn sec peq" data-onda="afinar_pedir">{ ic 2 }Pedir ao Maestro</button></div>`
  # pelas regras: o motor escolhe e ordena outra vez, aqui no telemóvel (só com as candidatas que a playlist guarda)
  ? ~ us `<div class="mu-acoes mu-af-guarda"><button type="button" class="mu-btn sec" data-onda="af-fechar">Fechar</button></div>` {
    `<p class="mu-nota mu-af-ou">Ou muda tu as regras: o motor escolhe e ordena outra vez, aqui no telemóvel. O alfinete de uma faixa segura-a na playlist.</p>`
    `<div class="mu-af-graf">{ af_graf }</div>`
    `<div class="mu-campo"><span>Estilo</span><div class="mu-seg" data-seg="estilo">{ seg_af 2 5 0 @ 9 }</div></div>`
    `<div class="mu-campo"><span>Energia ao longo da playlist</span><div class="mu-seg" data-seg="arco">{ seg_af 3 4 0 @ 10 }</div></div>`
    `<label class="mu-campo"><span>Faixas</span><div class="mu-range"><input type="range" data-onda="af-n" min="{ N Mn 5 us }" max="{ N us }" value="{ N @ 7 }"><output id="af-nv">{ N @ 7 }</output></div></label>`
    `<div class="mu-campo"><span>Máximo por artista</span><div class="mu-seg" data-seg="maxArtista">{ seg_af 1 4 1 @ 8 }</div></div>`
    `<div class="mu-acoes mu-af-guarda">{ af_guarda }</div>` }
  "</div>" }
# uma faixa da folha a afinar: capa, título, artista e o alfinete (fixar)
: af_linha iii>i f ci nova {
  = id txt f.id = cv txt _ar_get _ar_get @ 52 $"capas" id = fx ? >= ci 0 @ + @ 17 ci 0
  `<li class="af{ Se fx " fixa" }{ Se nova " nova" }" data-chave="{ esct id }" data-id="{ esct id }"><span class="cp">{ Se cv `<img src="{ esct cv }" alt="" loading="lazy" decoding="async">` }</span><div class="tx"><b>{ esct txt f.titulo }</b><span>{ Se nova `<i>nova</i> · ` }{ partistas f.artistas }</span></div><span class="mu-ouvir vazio"></span>`
  ? >= ci 0 `<button type="button" class="mu-fixar" data-onda="fixar&#9;{ N ci }" aria-pressed="{ ? fx "true" "false" }" aria-label="{ ? fx "Deixar de fixar" "Fixar" } «{ esct txt f.titulo }»"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5h6l-1 6 3.5 3.5h-11L10 9.5z"/><path d="M12 13v7.5"/></svg></button>` `<span class="mu-ouvir vazio"></span>`
  "</li>" }
# uma faixa encontrada no Tidal (a música de partida e «Acrescentar uma faixa»): a capa, o título (com a versão), quem
# toca, o álbum e o ano, os 30 s de pré-escuta (▶) e o botão de escolher (acao) — para se reconhecer a certa
: res_linha iiii>i x q acao rot {
  = cv txt x.capa = u txt x.previa = vs txt x.versao
  `<li><span class="cp">{ Se _tx_len cv `<img src="{ esct cv }" alt="" loading="lazy" decoding="async">` }</span><div class="tx"><b>{ esct txt x.titulo }{ Se _tx_len vs ` <i>({ esct vs })</i>` }</b><span>{ partistas x.artistas }{ Se _tx_len txt x.album ` · { esct txt x.album }` }{ Se int x.ano ` · { N int x.ano }` }</span></div>`
  ? _tx_len u { = tc mesmo u @ 55 `<button type="button" class="mu-ouvir{ Se tc " a-tocar" }" data-onda="ouvir&#9;{ esct u }" aria-pressed="{ ? tc "true" "false" }" aria-label="{ ? tc "Parar" "Ouvir 30 segundos de" } «{ esct txt x.titulo }»">{ ic 4 }</button>` } `<span class="mu-ouvir vazio"></span>`
  `<button type="button" class="mu-trocar" data-onda="{ esct acao }&#9;{ N q }" aria-label="{ esct rot } «{ esct txt x.titulo }»">{ ic 12 }</button></li>` }
# acrescentar uma faixa do Tidal: procura-se (artista e título) e a escolhida entra no fim da playlist, logo
: fo_junta i>i c Se && @ 51 ~ @ 6 {
  ? ~ @ 62 `<button type="button" class="mu-junta-a" data-onda="junta_abre">{ ic 12 }Acrescentar uma faixa</button>` {
    `<div class="mu-junta"><label class="mu-campo"><span>Acrescentar do Tidal</span><input type="search" data-onda="q" placeholder="artista e título" value="{ esct @ 23 }"></label><div class="mu-acoes"><button type="button" class="mu-btn sec peq" data-onda="procurar">{ ic 8 }Procurar no Tidal</button><button type="button" class="mu-btn sec peq" data-onda="junta_abre">Fechar</button></div><div id="af-res">`
    = r @ 19
    Se r { = l r.faixas
      ? ~ quantos l `<p class="mu-nota">Nada encontrado.</p>` {
        `<ol class="mu-xf">` = x pri l = q 0
        W && x < q 6 {
          res_linha x q $"juntar" $"Acrescentar"
          = x seg x = q + q 1 }
        "</ol>" } }
    "</div></div>" } }
: junta_faixa i>i q ? ocupado 0 { = r @ 19 = f ? r idx r.faixas q 0
  Se f pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"entra":{ pjs txt f.id }\}` 23 }

# ===== escritas no conector =====
: ocupado >i ? @ 31 { aviso $"Um momento…" 1 } 0
# uma escrita: r é «MÉTODO caminho» (com corpo: nova linha e o JSON) e m o que se está a fazer — o lido_escrita trata
# a resposta por ele (1 config, 2 ligar, 3 enviar, 4/9 guardar versão, 5/11 apagar, 6 pedir, 7 cancelar, 8 desligar,
# 10 aparelho, 12 mais, 13 convite, 14 código de aparelho, 15 renovar, 16 renomear, 18 afinar, 19 juntar, 20 trocar,
# 21 tirar, 22 desfazer, 23 acrescentar, 26 voltar a pôr uma das do Tidal)
: pede ii>i r m { ! 31 1 ! 34 m _an_buscar r $"lido_escrita" }
# guardar o que o motor escolheu: a app manda só a decisão (a ordem, o porquê e os pontos, por índice das candidatas)
# e o conector monta a playlist — na app e, se ela lá está, no Tidal (a mesma playlist, no mesmo link)
: guardar_versao >i ? ocupado 0 {
    = d @ 51 = nt == tipo d.tidal 7
    = r _tx_abre + 4000 * 40 @ 37 `POST /api/playlists/{ purl @ 30 }/versoes` P 10
    `\{"ordem":[` L p @ 14 { Se p "," N @ + @ 13 p }
    `],"porque":[` L p @ 14 { Se p "," P 34 porque_json @ + @ 15 p P 34 }
    `],"pontos":[` L p @ 14 { Se p "," N @ + @ 32 p }
    `],"opcoes":\{"faixas":{ N @ 7 },"maxArtista":{ N @ 8 },"estilo":"{ estilo_json @ 9 }","arco":"{ arco_json @ 10 }"\},"custo":{ N @ 16 },"tidal":{ ? nt "true" "false" }\}`
    pede _tx_fecha r ? nt 9 4
    aviso ? nt $"A gravar no Tidal…" $"A guardar…" 0 }
: enviar >i ? ocupado 0 { pede`POST /api/playlists/{ purl @ 30 }/tidal{ P 10 }\{\}` 3 aviso $"A criar no Tidal…" 0 }
: apagar_pl i>i t ? ocupado 0 { pede`DELETE /api/playlists/{ purl @ 30 }{ Se t "?tidal=1" }` ? t 11 5 0 }
: mais_criar i>i b ? ocupado 0 { pede`POST /api/mais{ P 10 }\{"faixa":"{ crut b }"{ Se == tipo _ar_get _ar_get @ 51 $"opcoes" $"limpa" 3 `,"limpa":true` }\}` 12 aviso $"A procurar faixas parecidas…" 0 }
# convidar alguem: o Worker devolve o link (serve uma vez); a mensagem para partilhar fica ja codificada em @42
: codaparelho_pedir >i ? ocupado 0 { pede`POST /api/aparelho/codigo{ P 10 }\{\}` 14 0 }
: convidar_pedir >i ? ocupado 0 { pede`POST /api/convites{ P 10 }\{\}` 13 0 }
: pedir_enviar >i ? ocupado 0 {
    ? < _tx_len @ 20 3 { aviso $"Escreve o que queres ouvir." 0 } {
      = s @ 19
      = r _tx_abre + 600 * 7 _tx_len @ 20 `POST /api/pedidos{ P 10 }\{"texto":{ pjs @ 20 },{ Se pd_tem s `"partida":{ pjs txt s.id },` }"opcoes":\{"faixas":{ N @ 24 },"maxArtista":{ N @ 25 },"estilo":"{ estilo_json @ 26 }","arco":"{ arco_json @ 27 }"{ Se @ 45 `,"limpa":true` }\}\}`
      pede _tx_fecha r 6 0 } }
: cancelar_ped i>i b ? ocupado 0 { pede`DELETE /api/pedidos/{ purl b }` 7 0 }
# c = 1: a pessoa carregou em «Concordo e ligar» (autoriza o Maestro, uma IA de terceiros, a ler o seu perfil de gosto)
: ligar_enviar i>i c ? ocupado 0 {
    = cod _an_ler $"codigo"
    = r _tx_abre + 400 * 7 _tx_len cod `POST /api/ligar{ P 10 }\{"codigo":{ ? cod pjs cod "null" },"nome":"app Música"{ Se c `,"consente":true` }\}`
    pede _tx_fecha r 2 0 }
# o que se diz antes de pedir a autorização (aqui diz-se quem é a IA: é a quem os dados vão)
: txt_ia >i "O Maestro é uma inteligência artificial (o Claude, da Anthropic). Para escolher música para ti, lê as tuas favoritas, os artistas que segues, as tuas playlists e o teu nome de utilizador do Tidal."
: consentir_enviar >i ? ocupado 0 { pede`POST /api/consentir{ P 10 }\{\}` 25 0 }
: config_enviar >i ? ocupado 0 {
    ? ~ _tx_len @ 21 { aviso $"Cola o Client ID." 0 } {
      = cod _an_ler $"codigo"
      = r _tx_abre + 1200 * 7 _tx_len cod `POST /api/config{ P 10 }\{"codigo":{ ? cod pjs cod "null" },"clientId":{ pjs @ 21 }\}`
      pede _tx_fecha r 1 0 } }
: aparelho_enviar >i ? ocupado 0 {
    ? < _tx_len @ 38 8 { aviso $"Cola o código de ligação." 0 } {
      = r _tx_abre + 400 * 7 _tx_len @ 38 `POST /api/aparelho{ P 10 }\{"codigo":{ pjs @ 38 },"nome":"app Música"\}`
      pede _tx_fecha r 10 0 } }
: desligar_enviar >i ? ocupado 0 { pede`POST /api/desligar{ P 10 }\{\}` 8 0 }
# apagar a conta: o conector apaga tudo o que guarda da pessoa; este aparelho fica sem chave
: conta_apagar >i ? ocupado 0 { pede`DELETE /api/conta` 24 aviso $"A apagar a conta…" 0 }
: lido_escrita ii>i t s {
  _an_esquecer
  = modo @ 34 ! 34 0 ! 31 0
  = r _ar_json t
  ? || == s 200 == s 201 {
    ? == modo 1 { aviso $"Client ID guardado. Agora liga o Tidal." _an_buscar $"/api/estado" $"lido_estado" 0 }
    ? == modo 2 { = u txt r.url Se u { = q _tx_abre + _tx_len u 8 `IR { crut u }` _tx_fecha q _an_buscar q $"nada" } }
    ? == modo 3 { ! 51 r ! 28 0 refolha 6 _an_buscar $"/api/playlists" $"lido_pl" aviso $"Criada no Tidal." 0 }
    # guardar o afinar: a playlist nova vem na resposta e o afinar fecha
    ? || == modo 4 == modo 9 { ! 51 r ! 6 0 refolha 159
      _an_buscar`/api/playlists/{ purl @ 30 }/previas` $"lido_prev" _an_buscar $"/api/playlists" $"lido_pl"
      aviso ? == modo 9 $"Guardada no Tidal." $"Guardada." 0 }
    # voltar a pôr uma das do Tidal (26): entra no fim; sai da lista das que saíram
    ? == modo 26 { ! 51 r refolha 25
      _an_buscar`/api/playlists/{ purl @ 30 }/previas` $"lido_prev" _an_buscar $"/api/playlists" $"lido_pl"
      aviso $"Voltou a entrar, no fim da playlist." 0 }
    # acrescentar uma faixa (23): entra no fim; a procura fecha
    ? == modo 23 { ! 51 r ! 19 0 ! 62 0 tvazio @ 23 refolha 521
      _an_buscar`/api/playlists/{ purl @ 30 }/previas` $"lido_prev" _an_buscar $"/api/playlists" $"lido_pl"
      aviso $"Faixa acrescentada." 0 }
    ? == modo 14 { = c txt r.codigo Se c { tcopia @ 43 c 40 = w texto`Abre a Música (na app do ecrã principal, se a usares) e cola este código em «Código de ligação»: { crut c } — serve uma vez, durante 24 h.` = x _tx_abre 1800 purl w _tx_fecha x tcopia @ 44 x 580 render aviso $"Código criado: usa-o no outro aparelho." } }
    ? == modo 13 { = l txt r.url Se l { tcopia @ 41 l 200 = w texto`Experimenta a Música: playlists de qualidade no teu Tidal, feitas por uma IA que aprende o teu gosto. Abre este link no iPhone (serve uma vez): { crut l }` = x _tx_abre 1800 purl w _tx_fecha x tcopia @ 42 x 880 render aviso $"Convite criado: envia o link." } }
    # trocar (20), tirar (21) e desfazer (22): a playlist nova vem na resposta; pedem-se as capas e as pré-escutas
    # das faixas novas e o índice (a lista por baixo e a duração)
    ? && >= modo 20 <= modo 22 { ! 51 r ! 60 0 ! 61 0 refolha 9
      _an_buscar`/api/playlists/{ purl @ 30 }/previas` $"lido_prev" _an_buscar $"/api/playlists" $"lido_pl" 0 }
    ? == modo 19 { ! 56 0 tvazio @ 58 ! 53 0 tvazio @ 59 _an_buscar $"/api/playlists" $"lido_pl" render aviso`Juntas em «{ crut txt r.nome }» — { N quantos r.faixas } faixas, já no teu Tidal.` 0 }
    ? == modo 18 { tvazio @ 49 Se != @ 6 2 ! 6 0 refolha 652
      # (os pedidos também: o cartão da playlist passa a dizer «afinação pedida»)
      _an_buscar $"/api/pedidos" $"lido_ped"
      Se _tx_len @ 50 _an_buscar`/api/playlists/{ purl @ 30 }` $"lido_exp"
      aviso ? == tipo r.naHora 3 $"Pedido de afinação enviado: o Maestro já foi chamado." $"Pedido de afinação enviado: o Maestro refá-la na próxima corrida." 0 }
    ? == modo 16 { ! 51 r ! 28 0 refolha 3 _an_buscar $"/api/playlists" $"lido_pl" aviso ? == tipo r.tidal 7 $"Nome mudado na app e no Tidal." $"Nome mudado." 0 }
    ? == modo 15 { ! 51 r refolha 2 _an_buscar $"/api/playlists" $"lido_pl" aviso ? == tipo r.renovar 3 $"Passa a atualizar-se sozinha toda a semana." $"Deixa de se atualizar sozinha." 0 }
    # «mais como esta»: a playlist nova abre-se logo, na lista
    # (o `ir` solta o monte, e a resposta com ele: o que se quer dela lê-se antes)
    ? == modo 12 { = rv quantos r.afinacoes tcopia @ 30 txt r.id 70 ir 1 abre_folha @ 30 aviso ? rv $"Criada no Tidal com as parecidas. O Maestro vai revê-la." $"Criada no Tidal — já a podes ouvir." 0 }
    ? == modo 5 { ir 1 aviso $"Apagada da app." 0 }
    ? == modo 11 { ir 1 aviso $"Apagada no Tidal e na app." 0 }
    # pedido feito: vai-se para a lista das playlists, onde ele fica à espera (no cimo)
    # (o `ir` solta o monte, e a resposta com ele: o que se quer dela lê-se antes)
    ? == modo 6 { = nh == tipo r.naHora 3 = cr == tipo r.criada 7 tvazio @ 20 ir 1
      aviso ? cr ? nh $"Já está no teu Tidal. O Maestro foi chamado para a rever com o teu pedido." $"Já está no teu Tidal. O Maestro revê-a com o teu pedido na próxima corrida."
        ? nh $"Pedido feito — o Maestro já foi chamado: costuma demorar uns minutos." $"Pedido feito — o Maestro trata dele na próxima corrida." 0 }
    # cancelado: sai da lista; se era uma afinação, sai também da folha da playlist
    ? == modo 7 { _an_buscar $"/api/pedidos" $"lido_ped" Se _tx_len @ 50 _an_buscar`/api/playlists/{ purl @ 30 }` $"lido_exp" aviso $"Pedido cancelado." 0 }
    ? == modo 8 { ir 5 aviso $"Tidal desligado." 0 }
    ? == modo 25 { _an_buscar $"/api/estado" $"lido_estado" aviso $"Autorização guardada." 0 }
    ? == modo 24 { _an_gravar $"chave" 0 ! 28 0 ir 1 aviso $"Conta apagada: o conector já não guarda nada sobre ti." 0 }
    Se == modo 10 { = ch txt r.chave Se ch { _an_gravar $"chave" ch tvazio @ 38 ir 1 aviso $"Este aparelho fica com acesso." } } }
    { ! 28 0 ! 60 0 ! 61 0 tvazio @ 54
      # o codigo guardado (de um convite ou link ja usado) nao serve: esquece-o, para aparecer o campo do codigo
      Se && == modo 2 == s 401 _an_gravar $"codigo" 0
      # com a folha aberta redesenham-se só os pedaços dela (a página toda fazia a folha subir outra vez)
      ? && == @ 1 1 _tx_len @ 50 refolha 143 render
      erro_ped t s 0 } }

# ===== Pedir =====
# começar por uma música (opcional): procura-se no Tidal (a mesma pesquisa de «Acrescentar uma faixa», a mesma caixa
# @23) e escolhe-se uma; com ela, a playlist nasce logo no Tidal com as parecidas e o Maestro revê-a com o pedido.
# Os resultados ficam em @19; a escolhida passa a ser @19 (a faixa, com «id»). Mudar de vista esquece as duas.
: pd_tem i>i s ? s _tx_len txt s.id 0
: pd_partida >i {
  = s @ 19
  ? pd_tem s {
      = cv txt s.capa
      `<div class="mu-partida"><span class="cp">{ Se _tx_len cv `<img src="{ esct cv }" alt="" decoding="async">` }</span><div class="tx"><span>Começa por</span><b>«{ esct txt s.titulo }»</b><span>{ partistas s.artistas }</span></div><button type="button" class="mu-btn sec peq" data-onda="pd_sem_x" aria-label="Não começar por «{ esct txt s.titulo }»">Tirar</button></div>` }
    {
      `<details class="mu-partida-d"{ Se s " open" }><summary>{ ic 12 }Começar por uma música<span>opcional</span></summary>`
      `<div class="mu-junta"><label class="mu-campo"><span class="sr">Música de partida</span><input type="search" data-onda="q" placeholder="artista e título" value="{ esct @ 23 }"></label><div class="mu-acoes"><button type="button" class="mu-btn sec peq" data-onda="procurar">{ ic 8 }Procurar no Tidal</button></div>`
      Se s { = l s.faixas
        ? ~ quantos l `<p class="mu-nota">Nada encontrado. Escreve o nome do artista e o da música, por exemplo «Gabriela KATSEYE».</p>` {
          `<ol class="mu-xf">` = x pri l = q 0
          W && x < q 8 { res_linha x q $"pd_sem" $"Começar por" = x seg x = q + q 1 }
          "</ol>" } }
      "</div></details>" } }
: v_pedir >i {
  `<header class="mu-head"><div><h1>Pedir</h1><div class="sub">Ao Maestro, que pesquisa e cria no teu Tidal</div></div>{ pill }</header>`
  Se && @ 3 ~ acesso boas_vindas
  `<div class="mu-card"><h3>O que te apetece ouvir?</h3><label class="mu-campo"><span class="sr">Pedido</span><textarea data-onda="ptx" maxlength="500" placeholder="Ex.: jazz dos anos 60 bem gravado para a viagem de sábado">{ esct @ 20 }</textarea></label>`
  # o botao logo a seguir ao texto: com o teclado aberto (iPhone) fica a vista
  = pt pd_tem @ 19 = nh == tipo _ar_get @ 3 $"naHora" 3
  `<div class="mu-acoes"><button type="button" class="mu-btn" data-onda="pedir"{ ? acesso 0 " disabled" }>{ ic 2 }{ ? pt "Criar já no Tidal" "Pedir ao Maestro" }</button></div><p class="mu-nota">`
  ? pt `A playlist nasce já no teu Tidal com as parecidas da música de partida. O Maestro revê-a com o teu pedido { ? nh "daqui a poucos minutos" "às 07:44 ou às 18:44" }, no mesmo link, e dá-lhe nome.`
    `{ ? nh "O Maestro é chamado logo e cria a playlist em poucos minutos, no teu Tidal." "O Maestro cria a playlist às 07:44 ou às 18:44 e põe-na logo no teu Tidal." } Depois revês aqui: trocar faixas, mudar o estilo, afinar. Até lá, o pedido fica à espera no cimo da lista das playlists.`
  `</p>{ pd_partida }`
  # as opcoes ficam escondidas (uma linha com o resumo); "Mudar" mostra-as
  ? @ 39 {
      `<div class="mu-opcoes"><span>Opções</span><button type="button" class="mu-mais" data-onda="opcoes">Fechar</button></div>`
      `<label class="mu-campo"><span>Faixas</span><div class="mu-range"><input type="range" data-onda="pd-n" min="10" max="60" step="5" value="{ N @ 24 }"><output id="pd-nv">{ N @ 24 }</output></div></label>`
      `<div class="mu-campo"><span>Máximo por artista</span><div class="mu-seg">{ seg_af 4 4 1 @ 25 }</div></div>`
      `<div class="mu-campo"><span>Estilo</span><div class="mu-seg">{ seg_af 5 5 0 @ 26 }</div></div>`
      `<div class="mu-campo"><span>Energia ao longo da playlist</span><div class="mu-seg">{ seg_af 6 4 0 @ 27 }</div></div>`
      `<div class="mu-campo"><span>Letras</span><div class="mu-seg"><button type="button" data-onda="pd-lp&#9;0" aria-pressed="{ ? @ 45 "false" "true" }">Todas</button><button type="button" data-onda="pd-lp&#9;1" aria-pressed="{ ? @ 45 "true" "false" }">Sem letras explícitas</button></div></div>` }
    `<div class="mu-opcoes"><span>{ N @ 24 } faixas · até { N @ 25 } por artista · { nome_estilo @ 26 } · { nome_arco @ 27 }{ Se @ 45 " · sem letras explícitas" }</span><button type="button" class="mu-mais" data-onda="opcoes">Mudar</button></div>`
  `<div class="mu-ideias"><span>Ideias</span></div>`
  # as ideias que o Maestro escreveu (as de dia de dia, as de noite à noite); sem elas, as de sempre
  `<div class="mu-chips">` = n 0
  Se @ 48 { = c pri _ar_get @ 48 $"ideias" = q 0 W && c < n 7 { = mo txt c.momento Se || mesmo mo $"sempre" mesmo mo ? e_dia $"dia" $"noite" { = pq txt c.porque `<button type="button" class="mu-chip{ ? && pq _tx_len pq ` ideia" data-onda="idea&#9;{ N q }"><b>{ esct txt c.texto }</b><span>{ esct pq }</span>` { `" data-onda="idea&#9;{ N q }">{ esct txt c.texto }` 0 } }</button>` = n + n 1 } = c seg c = q + q 1 } }
  Se ~ n { L q 7 `<button type="button" class="mu-chip" data-onda="sug&#9;{ N q }">{ sugestao q }</button>` }
  "</div></div>" }

# ===== Gosto =====
# uma favorita: o número, o título, quem toca e ouvir no Tidal
: linha_fav ii>i p f `<li class="mu-faixa"><span class="n">{ N + p 1 }</span><div><div class="t">{ esct txt f.titulo }</div><div class="a">{ partistas f.artistas }</div></div><div class="dir">{ Se txt f.url `<a class="mu-tocar" href="{ esct txt f.url }" target="_blank" rel="noopener" aria-label="Ouvir «{ esct txt f.titulo }» no Tidal">{ ic 4 }</a>` }</div></li>`
: barra_j iii>i c modo mx `<div class="mu-barra"><span>{ ? modo `{ N int c.decada }s` esct txt c.nome }</span><span class="b"><i style="width:{ N / + * 200 int c.n mx * 2 mx }%"></i></span><span class="v">{ N int c.n }</span></div>`
: barras_j ii>i l modo {
  = mx 1 = c pri l W c { = mx Mx mx int c.n = c seg c }
  = n quantos l
  `<div class="mu-mix">`
  ? modo {
    = feito A + n 1 = q 0
    W && < q 8 < q n {
      = b -1 = bv 100000 = k 0 = c pri l
      W c { Se && ~ @ + feito k < int c.decada bv { = b k = bv int c.decada } = c seg c = k + k 1 }
      ! + feito b 1
      barra_j idx l b 1 mx
      = q + q 1 } } { = c pri l = q 0 W && c < q 8 { barra_j c 0 mx = c seg c = q + q 1 } }
  "</div>" }
: gosto_alternar >i { ! 18 ~ @ 18 Se && @ 18 ~ @ 4 { _an_buscam $"/api/perfil" $"lido_perfil" 300000 _an_buscam $"/api/tendencias" $"lido_tend" 300000 } render }
# o teu gosto (era um separador): um cartão dos Ajustes, fechado até se querer ver — só aí se pedem o perfil e as
# tendências ao conector. Aberto, mostra por baixo o que o separador mostrava. @18 aberto, @4 o perfil, @11 as tendências
: cartao_gosto >i {
  = p @ 4 = ab @ 18
  `<section class="mu-gosto"><div class="mu-card"><button type="button" class="mu-gosto-a" data-onda="gosto" aria-expanded="{ ? ab "true" "false" }"><span class="tx"><b>O teu gosto</b><span>{ ? p { `{ N quantos p.favoritas } favoritas · atualizado { pdia txt p.geradoEm }` 0 } "As tuas favoritas, o que se está a ouvir e as tuas playlists no Tidal" }</span></span><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button></div>`
  Se ab {
    ? ~ p carregar {
      `<div class="mu-acoes"><button type="button" class="mu-btn sec" data-onda="atualizar">{ ic 6 }Atualizar do Tidal</button></div>`
      Se @ 11 v_tend @ 11
      = r p.resumo
      Se quantos r.artistas `<div class="mu-card"><h3>Artistas que mais aparecem</h3>{ barras_j r.artistas 0 }</div>`
      Se quantos r.decadas `<div class="mu-card"><h3>Décadas</h3>{ barras_j r.decadas 1 }</div>`
      Se quantos r.generos `<div class="mu-card"><h3>Géneros (etiquetas do Tidal)</h3>{ barras_j r.generos 0 }</div>`
      = ql r.qualidade
      Se quantos ql { `<div class="mu-card"><h3>Qualidade das favoritas</h3><div class="mu-chips">` = c pri ql W c { `<span class="mu-chip">{ esct txt c.q } · { N int c.n }</span>` = c seg c } "</div></div>" }
      = ar p.artistas
      Se quantos ar { `<div class="mu-card"><h3>Artistas que segues</h3><div class="mu-chips">` = c pri ar = q 0 W && c < q 40 { `<span class="mu-chip">{ esct txt c.nome }</span>` = c seg c = q + q 1 } "</div></div>" }
      `<h2 class="mu-sec">Favoritas mais recentes</h2><ol class="mu-faixas">`
      = fv p.favoritas
      ? quantos fv { = c pri fv = q 0 W && c < q 25 { linha_fav q c = c seg c = q + q 1 } } `<li class="mu-vazio">Sem favoritas.</li>`
      "</ol>"
      = pl p.playlists
      Se quantos pl { `<h2 class="mu-sec">As tuas playlists no Tidal</h2><div class="mu-card">` = c pri pl = q 0 W && c < q 20 { `<div class="mu-pedido"><div class="tx">{ esct txt c.nome }</div><a class="mu-btn sec peq" href="{ esct txt c.url }" target="_blank" rel="noopener">Abrir</a></div>` = c seg c = q + q 1 } "</div>" }
      `<h2 class="mu-sec">Ajustes</h2>` } }
  "</section>" }

# ===== trocar uma faixa: o motor escolhe a substituta entre as candidatas que o Maestro deixou =====
# a faixa (id) saiu da playlist do documento d (tirada ou trocada)?
: fora_de ii>i d id { = c pri d.rejeitadas = r 0 W && c ~ r { = r mesmo txt c id = c seg c } r }
# a candidata (índice) cuja faixa tem o id t; -1 se não há
: cand_de ii>i d t { = x pri d.candidatas = j 0 = r -1 W && x < r 0 { Se mesmo txt x.faixa.id t = r j = x seg x = j + j 1 } r }
# a melhor substituta para a posição p da playlist do documento d: a candidata livre (não está na playlist nem saiu
# de lá) com mais pontos para o estilo da playlist, menos a repetição (artista, género, década: a pen do motor) e
# menos o que custa encaixá-la ali (a energia do arco nessa posição e as transições com as vizinhas: BPM, tom, época).
# Devolve o nó da candidata, ou 0 se não sobra nenhuma
: troca_escolhe ii>i d p {
  = n quantos d.candidatas = us A + n 1 L j n ! + us j 1
  = op d.opcoes = mx int op.maxArtista
  = c ctx_cands d us 0 n ? > mx 0 mx 2 idx_estilo txt op.estilo idx_arco txt op.arco
  L j n ap c 19 j base c j
  # as que estão na playlist contam como escolhidas (menos a que sai, que só fica fora); ant e dep são as vizinhas
  = ant -1 = dep -1 = f pri d.faixas = q 0
  W f { = j cand_de d txt f.id
    Se >= j 0 { ? == q p { ap c 21 j 1 0 } { escolhe c j ag c 19 j 0 }
        Se == q - p 1 = ant j Se == q + p 1 = dep j }
    = f seg f = q + q 1 }
  = r pri d.rejeitadas W r { = j cand_de d txt r Se >= j 0 ap c 21 j 1 = r seg r }
  = bi -1 = bv -1000000000 = mx cg c 2
  L j n Se && == ag c 21 j 0 < ag c 22 ag c 12 j mx {
      = t cpos c j p Se >= ant 0 = t + t trans c ant j Se >= dep 0 = t + t trans c j dep
      = v - - ag c 19 j pen c j / t 6
      Se > v bv { = bv v = bi j } }
  ? < bi 0 0 _ar_idx d.candidatas bi }
# trocar a faixa da posição p: a substituta vê-se logo (a escolha é do telemóvel) e grava-se a seguir, na app e no
# Tidal. Sem candidatas livres, pede-se ao conector uma faixa parecida do Tidal
: trocar_faixa i>i p ? ocupado 0 {
  = d @ 51 = f idx d.faixas p
  Se f {
    = x troca_escolhe d p
    ! 60 + p 1 ! 61 x ! 40 0
    refolha 8
    ? x pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"sai":{ pjs txt f.id },"entra":{ pjs txt x.faixa.id }\}` 20
      pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"sai":{ pjs txt f.id },"parecida":true\}` 20 } }
: repor_tidal i>i b ? ocupado 0 { pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"entra":{ pjs b }\}` 26 0 }
: tirar_faixa i>i b ? ocupado 0 { ! 40 0 pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"sai":{ pjs b }\}` 21 0 }
# desfazer a última: fica tudo como estava antes dela (a faixa que saiu volta ao sítio)
: desfazer >i ? ocupado 0 { pede`POST /api/playlists/{ purl @ 30 }/trocar{ P 10 }\{"desfazer":true\}` 22 0 }

# ===== a folha: abrir, fechar, ouvir e escrever =====
# abre a folha da playlist b: uma de cada vez; pede as faixas e as pré-escutas (ficam 10 minutos na memória do
# anfitrião: abrir outra vez não vai à rede)
: abre_folha i>i b {
  ! 51 0 ! 52 0 ! 28 0 ! 40 0 ! 60 0 ! 61 0 ! 6 0 ! 62 0 ! 19 0 tvazio @ 23
  tcopia @ 50 b 70 tcopia @ 30 b 70 tcopia @ 57 b 70 render
  = u texto`/api/playlists/{ purl b }`
  = cu _an_lembrar u 600000 ? cu { exp_doc cu 1 0 } { _an_buscar u $"lido_exp" 0 }
  = v texto`/api/playlists/{ purl b }/previas`
  = cv _an_lembrar v 600000 ? cv { exp_prev cv 1 0 } { _an_buscar v $"lido_prev" 0 } }
# tocar num cartão abre a folha; tocar no «fechar» (o mesmo id) fecha-a
: exp_alternar i>i b ? mesmo b @ 50 { ! 51 0 ! 52 0 ! 28 0 ! 40 0 ! 60 0 ! 61 0 ! 6 0 ! 62 0 ! 19 0 tvazio @ 50 render 0 } abre_folha b
# depois de mexer no «⋯» (@28): na folha redesenha-se só esse pedaço; nos Ajustes, a vista
: redes >i ? && == @ 1 1 _tx_len @ 50 refolha 2 render
# ouvir 30 s: um só leitor (o do anfitrião); tocar outra vez a que está a tocar pára-a
# o que tem ▶ volta a desenhar-se: as faixas da folha (e a história, com as do Tidal que saíram, e os resultados de
# «Acrescentar uma faixa») ou a vista «Pedir» (os resultados da música de partida)
: ouvir_ref >i { Se _tx_len @ 50 refolha + + 8 ? tem_cmp @ 51 16 0 ? @ 62 512 0 Se == @ 1 3 render 0 }
: ouvir i>i u { ? _an_som u { tcopia @ 55 u 900 0 } { tvazio @ 55 0 } ouvir_ref }
# o som parou sem ser pela app (acabou, erro): a app volta a saber o que está a tocar
: som_fim i>i z { = a _an_atocar ? a { tcopia @ 55 a 900 0 } { tvazio @ 55 0 } ouvir_ref }
: afinar_maestro >i ? ocupado 0 { = r _tx_abre + 400 * 7 _tx_len @ 49 `POST /api/playlists/{ purl @ 30 }/afinar{ P 10 }\{"texto":{ pjs @ 49 }\}` pede _tx_fecha r 18 0 }
: renomear_enviar >i ? ocupado 0 {
    ? < _tx_len @ 46 1 { aviso $"Escreve um nome para a playlist." 0 } {
      = r _tx_abre + 400 * 7 + _tx_len @ 46 _tx_len @ 47
      `POST /api/playlists/{ purl @ 30 }/nome{ P 10 }\{"nome":{ pjs @ 46 },"descricao":{ pjs @ 47 }\}`
      pede _tx_fecha r 16 0 } }
: renovar_pedir >i ? ocupado 0 { = d @ 51 = c pl_aberta = rv == tipo ? d d.renovar c.renovar 3 pede`POST /api/playlists/{ purl @ 30 }/renovar{ P 10 }\{"ativo":{ ? rv "false" "true" }\}` 15 0 }

# ===== Tendencias: o que se esta a ouvir (as tabelas que o conector recolhe todos os dias) =====
: tend_estado i>i t ? mesmo t $"sobe" "a subir" ? mesmo t $"nova" "nova" Se mesmo t $"dura" "dura"
# uma linha: o lugar, a cancao, o artista, o que se sabe dela; o play procura-a no Tidal
: tend_li ii>i c fonte {
  `<li class="mu-faixa"><span class="n">{ N int c.pos }</span><div><div class="t">{ esct txt c.titulo }</div><div class="a">{ esct txt c.artista }</div><div class="m">`
  Se fonte `{ esct txt c.fonte } · n.º { N int c.pos }`
  = e txt c.estado Se && e _tx_len e `{ Se fonte " · " }<b>{ tend_estado e }</b>{ Se && mesmo e $"sobe" int c.semana ` (era { N int c.semana }.º)` }`
  Se fonte ` · { esct txt c.porque }`
  `</div></div><div class="dir"><a class="mu-tocar" href="https://tidal.com/search?q={ purl txt c.artista }{ P '+ }{ purl txt c.titulo }`
  `" target="_blank" rel="noopener" aria-label="Procurar «{ esct txt c.titulo }» no Tidal">{ ic 4 }</a></div></li>` }
: v_tend i>i t {
  `<h2 class="mu-sec">O que se está a ouvir</h2>`
  ? ~ int t.dias `<div class="mu-card"><p class="mu-nota">O conector guarda as tabelas do Apple Music e do Deezer uma vez por dia. As primeiras aparecem amanhã; o que sobe e o que dura vê-se ao fim de uma semana.</p></div>` {
    `<p class="mu-nota mu-tend-nota">Tabelas do Apple Music e do Deezer · { N int t.dias } dia(s) de histórico. «A subir»: ganhou 10 lugares ou mais numa semana; «dura»: 3 semanas ou mais na tabela.</p>`
    = l t.paraTi
    Se quantos l { `<div class="mu-card"><h3>Para ti</h3><ol class="mu-faixas">` = c pri l = q 0 W && c < q 8 { tend_li c 1 = c seg c = q + q 1 } "</ol></div>" }
    = f pri t.fontes
    W f {
      `<div class="mu-card"><h3>{ esct txt f.nome }</h3><ol class="mu-faixas">`
      # o que sobe (ou, sem nada a subir, o topo)
      = q 0 = c pri f.itens W && c < q 5 { Se mesmo txt c.estado $"sobe" { tend_li c 0 = q + q 1 } = c seg c }
      Se ~ q { = c pri f.itens W && c < q 5 { tend_li c 0 = c seg c = q + q 1 } }
      "</ol></div>"
      = f seg f } } }

# ===== Ajustes =====
: rr i>i i % * i 2654435761 1000
: testar_motor >i {
  = m _me_marca
  = t0 _an_agora
  = n 60
  = c ctx_novo n 30 2
  L w 5 cs c + 3 w @ + @ 36 w
  cs c 8 300 cs c 9 250 cs c 10 200 cs c 11 1
  L i n {
    ap c 12 i % i 25 ap c 13 i + 1 % i 5 ap c 14 i decada + 1950 % * i 7 75
    ap c 29 i rr i ap c 30 i 750 ap c 31 i rr + i 7 ap c 32 i rr + i 3 ap c 33 i rr + i 11
    ap c 15 i rr + i 5 ap c 16 i + 70 % * i 13 100 ap c 17 i + 1 % * i 5 24 ap c 18 i 0 }
  curar c
  = ms - _an_agora t0
  = h _ht_ini 300 `{ N cg c 27 } faixas escolhidas de 60 e ordenadas em { ? ms `{ N ms } ms` "menos de 1 ms" }, aqui no telemóvel.{ _ht_poe $"#aj-motor-r" h }`
  _me_solta m }
# os avisos no telemóvel (Web Push): a casca liga-os, desliga-os e testa-os (botões data-avisos) e guarda no armazém
# «avisos» (ligados aqui) e «avisos_ok» (1 pode, ios = iPhone fora do ecrã principal, nativo = app de teste, 0 não pode)
: cartao_avisos >i {
  = ok _an_ler $"avisos_ok" = av _an_ler $"avisos"
  `<div class="mu-card" id="aj-avisos"><h3>Avisos</h3>`
  ? && ok mesmo ok $"1" {
      ? && av _tx_len av {
          `<p>Ligados neste telemóvel: chega um aviso quando a playlist de um pedido fica pronta no Tidal e quando o Maestro acaba uma afinação.</p><div class="mu-acoes"><button type="button" class="mu-btn sec" data-avisos="teste">{ ic 17 }Enviar um de teste</button><button type="button" class="mu-btn sec" data-avisos="desligar">Desligar</button></div>` }
        `<p>Recebe um aviso neste telemóvel quando a playlist de um pedido ficar pronta no Tidal e quando o Maestro acabar uma afinação.</p><div class="mu-acoes"><button type="button" class="mu-btn" data-avisos="ligar">{ ic 17 }Ligar os avisos</button></div>` }
    { ? && ok mesmo ok $"ios" "<p>No iPhone, os avisos só funcionam na app do ecrã principal: no Safari, toca em Partilhar e depois em <b>Adicionar ao ecrã principal</b>, e abre a Música por lá.</p>"
      { ? && ok mesmo ok $"nativo" "<p>Nesta app de teste não há avisos: numa app nativa precisam do programa pago da Apple. Liga-os na app do ecrã principal.</p>"
        "<p>Este browser não deixa enviar avisos.</p>" } }
  "</div>" }
: v_ajustes >i {
  `<header class="mu-head"><div><h1>Ajustes</h1></div>{ pill }</header>`
  = e @ 3
  ? ~ e carregar {
    Se acesso cartao_gosto
    `<div class="mu-card"><h3>Tidal</h3>`
    ? ligado `<dl class="mu-kv"><dt>Conta</dt><dd>{ esct txt e.utilizador } ({ esct txt e.pais })</dd><dt>Desde</dt><dd>{ pdia txt e.ligadoEm }</dd><dt>Biblioteca</dt><dd>{ N int e.playlists } playlists · { N int e.pedidos } pedidos à espera</dd></dl>` "<p>Não está ligado.</p>"
    `<div class="mu-acoes">`
    Se || e.tu _an_ler $"codigo" `<button type="button" class="mu-btn sec" data-onda="ligar">{ ic 1 }{ ? ligado "Ligar outra vez" "Ligar ao Tidal" }</button>`
    Se && ligado e.tu ? == @ 28 2 `<button type="button" class="mu-btn perigo" data-onda="desligar_sim">Sim, desligar</button><button type="button" class="mu-btn sec" data-onda="nao">Não</button>` `<button type="button" class="mu-btn perigo" data-onda="desligar">{ ic 10 }Desligar o Tidal</button>`
    "</div>"
    Se ~ == tipo e.clientId 3 `<p class="mu-nota">Falta o Client ID no conector. Redirect URI a registar em developer.tidal.com: <code>{ esct txt e.retorno }</code></p>`
    "</div>"
    = ch _an_ler $"chave"
    `<div class="mu-card"><h3>Este aparelho</h3><p>{ ? ch ? e.tu "Tem acesso à tua biblioteca e ao teu Tidal." "Tem uma chave que já não é válida." "Ainda não tem acesso." }</p>`
    Se ch `<div class="mu-acoes">{ ? == @ 28 3 `<button type="button" class="mu-btn perigo" data-onda="esquecer_sim">Sim, esquecer</button><button type="button" class="mu-btn sec" data-onda="nao">Não</button>` `<button type="button" class="mu-btn perigo" data-onda="esquecer">{ ic 11 }Esquecer este aparelho</button>` }</div>`
    # ligar outro aparelho da mesma pessoa (a app do ecra principal do iOS tem o seu armazem): um codigo de uma vez
    Se && ch e.tu {
        Se _tx_len @ 43 `<p>No outro aparelho (ou na app do ecrã principal), abre a Música e cola este código. Serve uma vez, durante 24 h.</p><p class="mu-codigo">{ esct @ 43 }</p>`
        `<div class="mu-acoes">{ Se _tx_len @ 44 `<a class="mu-btn" href="https://wa.me/?text={ crut @ 44 }" target="_blank" rel="noopener">Enviar por WhatsApp</a>` }<button type="button" class="mu-btn sec" data-onda="ligar_outro">{ ic 1 }{ ? _tx_len @ 43 "Criar outro código" "Ligar outro aparelho" }</button></div>` }
    "</div>"
    Se && ch e.tu cartao_avisos
    Se == tipo e.dono 3 { `<div class="mu-card"><h3>Partilhar a Música</h3><p>Cada pessoa liga o seu Tidal e tem as suas playlists e pedidos; o Maestro trata de todos.</p>`
        ? _tx_len @ 41 `<label class="mu-campo"><span>Link do convite (serve uma vez, durante 14 dias)</span><input readonly value="{ esct @ 41 }"></label><div class="mu-acoes"><a class="mu-btn" href="https://wa.me/?text={ crut @ 42 }" target="_blank" rel="noopener">Enviar por WhatsApp</a><a class="mu-btn sec" href="mailto:?subject=Convite%20para%20a%20M%C3%BAsica&amp;body={ crut @ 42 }">Email</a></div><button type="button" class="mu-mais" data-onda="convidar">Criar outro convite</button>`
          `<div class="mu-acoes"><button type="button" class="mu-btn" data-onda="convidar">{ ic 15 }Convidar alguém</button></div>`
        "</div>" }
    `<div class="mu-card"><h3>Conector de dados</h3><label class="mu-campo"><span>Endereço</span><input data-onda="px" value="{ esct @ 22 }" inputmode="url" autocapitalize="off" spellcheck="false"></label><div class="mu-acoes"><button type="button" class="mu-btn sec" data-onda="px-ok">Guardar</button><button type="button" class="mu-btn sec" data-onda="px-rep">Repor</button></div></div>`
    `<div class="mu-card"><h3>Motor de curadoria</h3><p>Esta app é toda em <b>Onda</b>, a linguagem que criaste: os ecrãs, o estado e o motor que escolhe e ordena as faixas (<code>motor.onda</code>) correm aqui no telemóvel, em WebAssembly, pelo anfitrião das apps Onda. O mesmo motor corre na tarefa agendada, e o juiz confirma que dá o mesmo, ao bit, em todas as formas.</p><div class="mu-acoes"><button type="button" class="mu-btn sec" data-onda="motor">{ ic 7 }Testar o motor</button></div><p class="mu-motor" id="aj-motor-r"></p></div>`
    # a conta: o que se guarda, e apagar tudo (pede-se aqui, na app)
    Se && ch e.tu {
      `<div class="mu-card mu-conta"><h3>A tua conta</h3><p>A Música guarda a ligação ao teu Tidal, o teu perfil de gosto, as playlists da app e os teus pedidos.</p>`
      Se ligado ? == tipo e.ia 3 `<p class="mu-nota">Autorizaste o Maestro (uma IA) a ler o teu perfil de gosto.</p>`
        `<p>{ txt_ia }</p><div class="mu-acoes"><button type="button" class="mu-btn sec" data-onda="consentir">Concordo</button></div>`
      ? == @ 28 5 `<p><b>Apagar tudo?</b> Sai a ligação ao Tidal, o perfil, as playlists da app, os pedidos e os avisos, e este aparelho deixa de ter acesso. As playlists que já estão no teu Tidal ficam lá. Não dá para desfazer.{ Se == tipo e.dono 3 " És quem montou a app: para voltares a entrar vais precisar de um código de ligação novo." }</p><div class="mu-acoes"><button type="button" class="mu-btn perigo forte" data-onda="conta_sim">{ ic 9 }Sim, apagar a minha conta</button><button type="button" class="mu-btn sec" data-onda="nao">Não</button></div>`
        `<div class="mu-acoes"><button type="button" class="mu-btn perigo" data-onda="conta">{ ic 9 }Apagar a minha conta</button></div>`
      "</div>" }
    `<p class="mu-nota">Música 2.37.0 · conector { esct txt e.versao } · <a href="privacidade.html">Privacidade</a> · <a href="apoio.html">Apoio</a> · <a href="https://github.com/nelsonsous/escolaplay/tree/main/musica" target="_blank" rel="noopener">código</a></p>` }
  0 }

# ===== navegacao e desenho =====
: nb i>i v `<button type="button" data-onda="ir&#9;{ N v }"{ Se == v @ 1 ` aria-current="page"` }>`
: nav >i {
  `{ nb 1 }<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h11M4 11h11M4 16h7"/><circle cx="17.5" cy="16.5" r="2.5"/><path d="M20 16.5V5l2 1"/></svg><span>Música</span></button>`
  `{ nb 3 }<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c.7 4.6 2.9 6.8 7.5 7.5-4.6.7-6.8 2.9-7.5 7.5-.7-4.6-2.9-6.8-7.5-7.5 4.6-.7 6.8-2.9 7.5-7.5z"/></svg><span>Pedir</span></button>`
  `{ nb 5 }<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg><span>Ajustes</span></button>` }
: render >i {
  = m _me_marca
  = h _ht_ini 250000
  = v @ 1
  ? == v 1 v_playlists ? == v 3 v_pedir v_ajustes
  # a mesma vista muda-se (só o que é diferente); uma vista nova desenha-se de raiz (começa limpa: o `ir` põe M[12] a zero)
  ? == v @ 12 _ht_muda $"#mu-body" h _ht_poe $"#mu-body" h
  ! 12 v
  = g _ht_ini 4000 nav _ht_muda $"#mu-nav" g
  _me_solta m }
# muda de vista: solta tudo o que a vista anterior reservou e pede o estado (e depois os dados)
: ir i>i v {
  # tocar outra vez no separador em que se está atualiza (esquece o que estava em memória)
  Se == v @ 1 _an_esquecer
  espera_para
  _me_solta @ 2
  = q 3 W <= q 19 { ! q 0 = q + q 1 }
  ! 28 0 = q 31 W <= q 35 { ! q 0 = q + q 1 } ! 37 0 ! 40 0 ! 48 0 ! 51 0 ! 52 0 ! 60 0 ! 61 0 ! 62 0 tvazio @ 50 tvazio @ 54 ! 56 0 tvazio @ 58 tvazio @ 23
  ! 1 v
  render
  # cada vista abre no topo (sem isto ficava onde a anterior estava, se as duas fossem altas)
  _an_rolar 0
  _an_buscam $"/api/estado" $"lido_estado" 60000
  0 }
: carregar_vista >i {
  = v @ 1
  Se acesso {
    ? == v 1 { _an_buscam $"/api/playlists" $"lido_pl" 30000 _an_buscam $"/api/pedidos" $"lido_ped" 30000 0 }
    Se == v 3 _an_buscam $"/api/ideias" $"lido_ideias" 300000 } }

# ===== respostas do conector =====
: lido_estado ii>i t s { ? == s 200 { ! 3 _ar_json t render carregar_vista 0 } { erro_ped t s 0 } }
# o índice das playlists: com a folha aberta, a lista por baixo espera (desenha-se ao fechar) e a folha fica onde está
: lido_pl ii>i t s Se == @ 1 1 ? == s 200 { ! 4 _ar_json t ? _tx_len @ 50 refolha 7 render 0 } { erro_ped t s 0 }
# os pedidos (para a lista das playlists): com a folha aberta não se redesenha a página (a folha voltava a subir);
# vêem-se ao fechá-la
: lido_ped ii>i t s Se && == @ 1 1 == s 200 { ! 5 _ar_json t Se ~ _tx_len @ 50 render espera_viva }
# a espera viva: com o Maestro na hora (o conector chama-o) e pedidos à espera, a app vai ver sozinha se ele já
# acabou — de 45 em 45 s, até 15 minutos — em vez de se ter de puxar a lista. @35 o relógio, @0 até quando.
: n_pend >i { = n 0 = c pri @ 5 W c { Se mesmo txt c.estado $"pendente" = n + n 1 = c seg c } n }
: espera_para >i { Se @ 35 { _an_parar @ 35 ! 35 0 } 0 }
: espera_viva >i {
  = n n_pend
  ? && && == tipo _ar_get @ 3 $"naHora" 3 n ~ @ 35 { ! 0 + _an_agora 900000 ! 35 _an_relogio 45000 $"espera_tic" 0 }
    Se ~ n espera_para }
: espera_tic i>i z {
  ? || != @ 1 1 > _an_agora @ 0 espera_para
    Se && ~ _tx_len @ 50 ~ @ 56 _an_buscar $"/api/pedidos" $"lido_ped_tic" }
: lido_ped_tic ii>i t s Se && && == @ 1 1 == s 200 @ 35 {
  = antes n_pend
  ! 5 _ar_json t
  Se < n_pend antes { _an_buscar $"/api/playlists" $"lido_pl" aviso $"O Maestro acabou: a playlist já está na lista." }
  Se ~ n_pend { espera_para Se ~ _tx_len @ 50 render } }
# (se o perfil não vier — o Tidal desligado, sem rede —, o cartão fecha-se em vez de ficar «A carregar…»)
: lido_perfil ii>i t s Se == @ 1 5 ? == s 200 { ! 4 _ar_json t render 0 } { Se ~ @ 4 { ! 18 0 render } erro_ped t s 0 }
: exp_doc ii>i t mem { = d _ar_json t Se mesmo txt d.id @ 50 { Se ~ mem { _an_guardar`/api/playlists/{ purl @ 50 }` t } ! 51 d refolha 575 } }
: exp_prev ii>i t mem Se mesmo @ 57 @ 50 { Se ~ mem { _an_guardar`/api/playlists/{ purl @ 50 }/previas` t } ! 52 _ar_json t refolha ? tem_cmp @ 51 56 40 }
: lido_exp ii>i t s Se && == @ 1 1 == s 200 exp_doc t 0
: lido_prev ii>i t s Se && == @ 1 1 == s 200 exp_prev t 0
: lido_ideias ii>i t s Se && == @ 1 3 == s 200 { ! 48 _ar_json t render }
: lido_tend ii>i t s Se && == @ 1 5 == s 200 { ! 11 _ar_json t render }
: lido_pesq ii>i t s {
  Se && == @ 1 1 _tx_len @ 50 ? == s 200 { ! 19 _ar_json t refolha 512 0 } { erro_ped t s 0 }
  Se == @ 1 3 ? == s 200 { ! 19 _ar_json t render 0 } { erro_ped t s 0 } }

# ===== eventos =====
: clique i>i t {
  = a _tx_campo t 0 9 = b _tx_campo t 1 9
  = fica 0
  ? mesmo a $"ir" { ir _tx_int b = fica 1 0 }
  ? mesmo a $"enviar" { enviar 0 }
  # (o que o afinar reserva — as candidatas, as fixadas, o resultado — tem de ficar para os eventos seguintes)
  ? mesmo a $"afinar" { afina_abrir = fica 1 0 }
  ? mesmo a $"af-fechar" { ! 6 0 refolha 652 0 }
  ? mesmo a $"af-guardar" { guardar_versao 0 }
  ? mesmo a $"junta_abre" { ! 62 ~ @ 62 ! 19 0 refolha 512 0 }
  ? mesmo a $"menu" { ! 28 ? == @ 28 4 0 4 refolha 2 0 }
  ? mesmo a $"apagar" { ! 28 1 redes 0 }
  ? mesmo a $"apagar_sim" { apagar_pl 0 0 }
  ? mesmo a $"apagar_tidal" { apagar_pl 1 0 }
  ? mesmo a $"opcoes" { ! 39 ~ @ 39 render 0 }
  ? mesmo a $"sel" { = i + _tx_int b 1 ! 40 ? == @ 40 i 0 i refolha 8 0 }
  ? mesmo a $"mais" { mais_criar b 0 }
  ? mesmo a $"convidar" { convidar_pedir 0 }
  ? mesmo a $"ligar_outro" { codaparelho_pedir 0 }
  ? mesmo a $"nao" { ! 28 0 redes 0 }
  # fixar: enquanto não há mudanças só se marca; depois, o motor corre outra vez com ela segura
  ? mesmo a $"fixar" { Se @ 6 { = i _tx_int b ! + @ 17 i ~ @ + @ 17 i Se == @ 6 2 afina_correr refolha 264 } 0 }
  ? mesmo a $"af-mx" { Se @ 6 { ! 8 _tx_int b afina_muda 136 } 0 }
  ? mesmo a $"af-es" { Se @ 6 { ! 9 _tx_int b afina_muda 136 } 0 }
  ? mesmo a $"af-ar" { Se @ 6 { ! 10 _tx_int b afina_muda 136 } 0 }
  ? mesmo a $"procurar" { ? < _tx_len @ 23 2 { aviso $"Escreve pelo menos 2 letras." 0 } { = u _tx_abre + 40 * 3 _tx_len @ 23 `/api/pesquisa?q={ purl @ 23 }{ Se == @ 1 3 "&unicas=1" }` _tx_fecha u _an_buscar u $"lido_pesq" aviso $"A procurar no Tidal…" 0 } }
  ? mesmo a $"juntar" { junta_faixa _tx_int b 0 }
  ? mesmo a $"pd_sem" { = r @ 19 = f ? r idx r.faixas _tx_int b 0 Se f { ! 19 f render } 0 }
  ? mesmo a $"pd_sem_x" { ! 19 0 render 0 }
  ? mesmo a $"sug" { tvazio @ 20 Oc @ 20 1990 sugestao _tx_int b O 0 render 0 }
  ? mesmo a $"pd-mx" { ! 25 _tx_int b render 0 }
  ? mesmo a $"pd-es" { ! 26 _tx_int b render 0 }
  ? mesmo a $"pd-ar" { ! 27 _tx_int b render 0 }
  ? mesmo a $"pd-lp" { ! 45 _tx_int b render 0 }
  ? mesmo a $"renovar" { renovar_pedir 0 }
  ? mesmo a $"renomear" { = d @ 51 = c pl_aberta tcopia @ 46 ? d txt d.nome txt c.nome 250 tcopia @ 47 txt d.descricao 1250 ! 28 2 refolha 2 0 }
  ? mesmo a $"renomear_sim" { renomear_enviar 0 }
  ? mesmo a $"trocar" { trocar_faixa _tx_int b 0 }
  ? mesmo a $"tirarf" { tirar_faixa b 0 }
  ? mesmo a $"repor_t" { repor_tidal b 0 }
  ? mesmo a $"desfazer" { desfazer 0 }
  ? mesmo a $"exp" { tvazio @ 54 exp_alternar b 0 }
  ? mesmo a $"ouvir" { ouvir b 0 }
  ? mesmo a $"avisos" { render Se _tx_len b aviso b }
  ? mesmo a $"recarregar" { _an_esquecer carregar_vista 0 }
  ? mesmo a $"apagarl" { tcopia @ 54 b 70 tvazio @ 50 ! 51 0 ! 52 0 render 0 }
  ? mesmo a $"apagarl_n" { tvazio @ 54 render 0 }
  ? mesmo a $"apagarl_s" { tcopia @ 30 b 70 apagar_pl 0 0 }
  ? mesmo a $"apagarl_t" { tcopia @ 30 b 70 apagar_pl 1 0 }
  ? mesmo a $"filtro" {
      = q - _tx_b b 0 48
      ? || == q 0 && && == q @ 53 == - _tx_len b 1 _tx_len @ 59 tigualem b 1 @ 59 { ! 53 0 tvazio @ 59 0 }
        { ! 53 q tvazio @ 59 Oc @ 59 79 = j 1 W < j _tx_len b { P _tx_b b j = j + j 1 } O 0 0 }
      render 0 }
  ? mesmo a $"juntar_modo" { ! 56 1 tvazio @ 58 tvazio @ 50 ! 51 0 ! 52 0 tvazio @ 54 render 0 }
  ? mesmo a $"juntar_nao" { ! 56 0 tvazio @ 58 render 0 }
  ? mesmo a $"esc" { esc_alt b 0 }
  ? mesmo a $"juntar_sim" { juntar_enviar 0 }
  ? mesmo a $"afinar_pedir" { afinar_maestro 0 }
  ? mesmo a $"idea" { = c idx _ar_get @ 48 $"ideias" _tx_int b Se c { tcopia @ 20 txt c.texto 1990 = e txt c.estilo Se e ! 26 idx_estilo e = q txt c.arco Se q ! 27 idx_arco q render } }
  ? mesmo a $"pedir" { pedir_enviar 0 }
  ? mesmo a $"cancelar" { cancelar_ped b 0 }
  ? mesmo a $"ligar" { ligar_enviar 0 0 }
  ? mesmo a $"ligar_c" { ligar_enviar 1 0 }
  ? mesmo a $"consentir" { consentir_enviar 0 }
  ? mesmo a $"config" { config_enviar 0 }
  ? mesmo a $"gosto" { gosto_alternar 0 }
  ? mesmo a $"atualizar" { _an_buscar $"/api/perfil?fresco=1" $"lido_perfil" aviso $"A ler do Tidal…" 0 }
  ? mesmo a $"desligar" { ! 28 2 render 0 }
  ? mesmo a $"desligar_sim" { desligar_enviar 0 }
  ? mesmo a $"conta" { ! 28 5 render 0 }
  ? mesmo a $"conta_sim" { conta_apagar 0 }
  ? mesmo a $"esquecer" { ! 28 3 render 0 }
  ? mesmo a $"esquecer_sim" { _an_gravar $"chave" 0 ir 5 aviso $"Aparelho esquecido." = fica 1 0 }
  ? mesmo a $"px-ok" { _an_gravar $"proxy" @ 22 ir 5 aviso $"Conector guardado." = fica 1 0 }
  ? mesmo a $"px-rep" { _an_gravar $"proxy" 0 tcopia @ 22 $"https://musica.mercados-proxy.workers.dev" 390 ir 5 aviso $"Conector reposto." = fica 1 0 }
  ? mesmo a $"motor" { testar_motor 0 }
  Se mesmo a $"usar" aparelho_enviar
  ? fica 0 _me_solta t }
: campo i>i t {
  = a _tx_campo t 0 9 = b _tx_campo t 1 9
  ? mesmo a $"cid" { tcopia @ 21 b 110 0 }
  ? mesmo a $"ptx" { tcopia @ 20 b 1990 0 }
  ? mesmo a $"q" { tcopia @ 23 b 290 0 }
  ? mesmo a $"px" { tcopia @ 22 b 390 0 }
  ? mesmo a $"cod" { tcopia @ 38 b 90 0 }
  ? mesmo a $"rn-nome" { tcopia @ 46 b 250 0 }
  ? mesmo a $"rn-desc" { tcopia @ 47 b 1250 0 }
  ? mesmo a $"af-tx" { tcopia @ 49 b 1990 0 }
  # o deslizador: o motor corre a cada passo; redesenha-se o gráfico, o guardar e a lista (o deslizador fica quieto)
  ? mesmo a $"af-n" { Se @ 6 { ! 7 _tx_int b afina_muda 264 = h _ht_ini 8 N @ 7 _ht_poe $"#af-nv" h } 0 }
  Se mesmo a $"pd-n" { ! 24 _tx_int b = h _ht_ini 8 N @ 24 _ht_poe $"#pd-nv" h }
  _me_solta t }

# ===== arranque =====
: main >i {
  _me_lb
  ! 36 A 25
  = w @ 36
  ! + w 0 300 ! + w 1 200 ! + w 2 200 ! + w 3 300 ! + w 4 100
  ! + w 5 150 ! + w 6 200 ! + w 7 150 ! + w 8 350 ! + w 9 400
  ! + w 10 150 ! + w 11 150 ! + w 12 500 ! + w 13 250 ! + w 14 150
  ! + w 15 550 ! + w 16 150 ! + w 17 50 ! + w 18 200 ! + w 19 0
  ! + w 20 150 ! + w 21 500 ! + w 22 50 ! + w 23 300 ! + w 24 100
  ! 20 _tx_novo 2000 ! 21 _tx_novo 120 ! 22 _tx_novo 400 ! 23 _tx_novo 300 ! 30 _tx_novo 80 ! 38 _tx_novo 100 ! 41 _tx_novo 220 ! 42 _tx_novo 900 ! 43 _tx_novo 40 ! 44 _tx_novo 600 ! 46 _tx_novo 260 ! 47 _tx_novo 1300 ! 49 _tx_novo 2000 ! 50 _tx_novo 80 ! 54 _tx_novo 80 ! 55 _tx_novo 1000 ! 57 _tx_novo 80 ! 58 _tx_novo 400 ! 59 _tx_novo 80
  ! 53 0 ! 56 0
  ! 24 30 ! 25 2 ! 26 0 ! 27 0
  = px _an_ler $"proxy"
  ? px { tcopia @ 22 px 390 0 } { tcopia @ 22 $"https://musica.mercados-proxy.workers.dev" 390 0 }
  _an_ouvir $"click" $"clique"
  _an_ouvir $"input" $"campo"
  _an_somfim $"som_fim"
  = av _an_ler $"aviso"
  ! 2 _me_marca
  ir 1
  Se av { aviso av _an_gravar $"aviso" 0 } }
