  ? && cu && >= k 0 <= k 22 * F n _nu_p10 k ? && cu && < k 0 >= k -22 / F n _nu_p10 - 0 k ? == n 0 0. {
    = dg + _me_lb 400 = nd 0 = x n = t 0 W > x 0 { = x / x 10 = t + t 1 }
    = j - t 1 = x n W >= j 0 { ! + dg j % x 10 = x / x 10 = j - j 1 }
    _nu_d2f dg t k } }
: _nu_s2n i>f t {
  = q + t 1 = e @ t
  W && < q e _tx_ews _tx_cp q = q + q _tx_nb
  # o fim sem os espaços: recua enquanto o último código é espaço
  = go 1 W && go > e q { = b - e 1 W && > b q == & @ b 192 128 = b - b 1 = go _tx_ews _tx_cp b ? go = e b 0 }
  ? >= q e 0. {
    = c0 @ q
    = r ? && == c0 '0 < + q 1 e { = c1 | @ + q 1 32 = base ? == c1 'x 16 ? == c1 'o 8 ? == c1 'b 2 0
        ? base _nu_s2nb + q 2 e base Bw 2146959360 1 } Bw 2146959360 1
    ? == Bh r 2146959360 {
      = neg 0 ? || == c0 '+ == c0 '- { = neg == c0 '- = q + q 1 0 } 0
      = v ? && == - e q 8 _nu_eh q $"Infinity" Bw 2146435072 0 _nu_s2nd q e
      ? neg * -1. v v } r } }
# o pedaço [q, e) da memória é o texto t?
: _nu_eh ii>i q t { = n _tx_len t = ok 1 = j 0 W && ok < j n { = ok == @ + q j _tx_b t j = j + j 1 } ok }
# decimal sem sinal em [q, e): algarismos, ponto, expoente (pelo menos um algarismo antes ou depois do ponto)
: _nu_s2nd ii>f q e {
  = dg + _me_lb 400 = nd 0 = ex 0 = st 0 = na 0
  W && < q e && >= @ q '0 <= @ q '9 {
    = d - @ q '0 = na + na 1
    ? < nd 780 { ? || > nd 0 d { ! + dg nd d = nd + nd 1 0 } 0 } { = ex + ex 1 = st || st d }
    = q + q 1 }
  ? && < q e == @ q '. {
      = q + q 1
      W && < q e && >= @ q '0 <= @ q '9 {
        = d - @ q '0 = na + na 1
        ? < nd 780 { ? || > nd 0 d { ! + dg nd d = nd + nd 1 0 } 0 = ex - ex 1 } { = st || st d }
        = q + q 1 } } 0
  = ok > na 0
  ? && && ok < q e || == @ q 'e == @ q 'E {
      = q + q 1 = sg 1
      ? && < q e || == @ q '+ == @ q '- { = sg ? == @ q '- -1 1 = q + q 1 } 0
      ? || >= q e || < @ q '0 > @ q '9 { = ok 0 0 } {
        = x 0 W && < q e && >= @ q '0 <= @ q '9 { = x ? < x 100000 + * x 10 - @ q '0 x = q + q 1 }
        = ex + ex * sg x } } 0
  ? || ~ ok < q e Bw 2146959360 0 {
    ? st { ! + dg nd 1 = nd + nd 1 = ex - ex 1 } 0
    ? == nd 0 0. _nu_d2f dg nd ex } }
# 0x 0o 0b: o valor exato, arredondado a 53 bits
: _nu_s2nb iii>f q e base {
  ? >= q e Bw 2146959360 0 {
    = b + _me_lb 64 _nu_bset b 0 = ok 1
    W && ok < q e { = c | @ q 32 = d ? && >= c '0 <= c '9 - c '0 ? && >= c 'a <= c 'f + 10 - c 'a 99 = ok < d base ? ok { _nu_bmul b base _nu_badd b d } 0 = q + q 1 }
    ? ~ ok Bw 2146959360 0 ? == @ b 0 0. _nu_b2f b 0 0 } }

# ---------- o Intl.NumberFormat('pt-PT') ----------
# arredonda, no lugar, os algarismos g do _nu_dig a d casas: metades para longe do zero
: _nu_iarr ii>i g d {
  = k @ g = n @ + g 1 = l + n d
  ? < l k {
      = up ? >= l 0 >= @ + g + 2 l 5 0
      = k ? < l 0 0 l
      ? up {
          = j - k 1
          W && >= j 0 == @ + g + 2 j 9 = j - j 1
          ? >= j 0 { ! + g + 2 j + 1 @ + g + 2 j = k + j 1 0 } { ! + g 2 1 = k 1 = n + n 1 0 } } 0 } 0
  ! g k ! + g 1 n 0 }
# escreve os algarismos g (k, com o ponto depois de n) com d casas e os milhares
: _nu_iimp iiii>i g k n d {
  ? <= n 0 P '0 { = j 0 W < j n {
      ? && >= n 5 && > j 0 == % - n j 3 0 { P 194 P 160 0 } 0
      P + '0 ? < j k @ + g + 2 j 0 = j + j 1 } 0 }
  ? > d 0 { P ', = p 1 W <= p d { = i + - n 1 p P + '0 ? && >= i 0 < i k @ + g + 2 i 0 = p + p 1 } 0 } 0
  0 }
# sem os zeros à direita das casas (o minimumFractionDigits 0); dá quantos ficam
: _nu_itira iii>i g k n { = q k W && > q ? > n 0 n 0 == @ + g + 1 q 0 = q - q 1 _nu_iimp g q n ? && > q 0 > q n - q n 0 q }
: _nu_intl fi>i x d {
  ? < Bh x 0 P '- 0
  = a Ab x
  ? == a 0. _nu_iimp 0 0 0 d { = g _nu_dig a _nu_iarr g d _nu_iimp g @ g @ + g 1 d } }
: _nu_intlm fi>i x d {
  ? < Bh x 0 P '- 0
  = a Ab x
  ? == a 0. P '0 { = g _nu_dig a _nu_iarr g d _nu_itira g @ g @ + g 1 0 } }
: _nu_iesc i>i m ? < m 3 0 ? < m 6 3 ? < m 9 6 ? < m 12 9 12
: _nu_compacto f>i x {
  ? < Bh x 0 P '- 0
  = a Ab x
  ? == a 0. P '0 {
    = g _nu_dig a = n @ + g 1 = m - n 1 = e _nu_iesc m
    ! + g 1 - n e
    _nu_iarr g 1
    = n2 @ + g 1
    ? > n2 - n e { = e2 _nu_iesc + m 1 ? != e2 e { = n2 - n2 - e2 e = e e2 0 } 0 } 0
    _nu_itira g @ g n2
    ? == e 3 { P 194 P 160 "mil" 0 } ? == e 6 { P 194 P 160 P 'M 0 } ? == e 9 { P 194 P 160 "mM" 0 } ? == e 12 { P 194 P 160 "Bi" 0 } 0
    0 } }
: _nu_k3 iii>i a b c + + * a 65536 * b 256 c
# o símbolo da moeda (código de 3 letras) no pt-PT do Chromium 153: os 21 que não são o próprio código
: _nu_simb i>i t {
  = h _nu_k3 _tx_b t 0 _tx_b t 1 _tx_b t 2
  ? == h _nu_k3 'E 'U 'R "€" ? == h _nu_k3 'U 'S 'D "US$" ? == h _nu_k3 'G 'B 'P "£" ? == h _nu_k3 'A 'U 'D "AU$"
  ? == h _nu_k3 'B 'R 'L "R$" ? == h _nu_k3 'C 'A 'D "CA$" ? == h _nu_k3 'C 'N 'Y "CN¥" ? == h _nu_k3 'H 'K 'D "HK$"
  ? == h _nu_k3 'I 'L 'S "₪" ? == h _nu_k3 'I 'N 'R "₹" ? == h _nu_k3 'J 'P 'Y "JP¥" ? == h _nu_k3 'K 'R 'W "₩"
  ? == h _nu_k3 'M 'X 'N "MX$" ? == h _nu_k3 'N 'Z 'D "NZ$" ? == h _nu_k3 'T 'H 'B "฿" ? == h _nu_k3 'T 'W 'D "NT$"
  ? == h _nu_k3 'V 'N 'D "₫" ? == h _nu_k3 'X 'A 'F "FCFA" ? == h _nu_k3 'X 'C 'D "EC$" ? == h _nu_k3 'X 'P 'F "CFPF"
  # F CFA, com U+202F
  ? == h _nu_k3 'X 'O 'F { P 'F P 226 P 128 P 175 "CFA" 0 }
  _tx_p t }
: _nu_moeda fii>i x d t { _nu_intl x d P 194 P 160 _nu_simb t }
