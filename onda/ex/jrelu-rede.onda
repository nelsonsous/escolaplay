# jrelu-rede : rede 2->8->1 com ocultos ReLU (Mx 0 z), TREINADA pelo operador interno J.
# Exercita o adjunto de min/max (it.81) num laço de treino real: `J gg loss pa` por exemplo.
# Prova que o operador interno ja treina redes ReLU de ponta a ponta. Gerado por web/jrelurede.gen.js.
: loss ffffffffffffffffffffffffffffffffffff>f w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 x y t * -1.0 + * t Lg + / 1.0 + 1.0 Ex * -1.0 + * w31 Mx 0.0 + + * w14 x * w15 y w23 + * w30 Mx 0.0 + + * w12 x * w13 y w22 + * w29 Mx 0.0 + + * w10 x * w11 y w21 + * w28 Mx 0.0 + + * w8 x * w9 y w20 + * w27 Mx 0.0 + + * w6 x * w7 y w19 + * w26 Mx 0.0 + + * w4 x * w5 y w18 + * w25 Mx 0.0 + + * w2 x * w3 y w17 + * w24 Mx 0.0 + + * w0 x * w1 y w16 w32 0.000000001 * - 1.0 t Lg + - 1.0 / 1.0 + 1.0 Ex * -1.0 + * w31 Mx 0.0 + + * w14 x * w15 y w23 + * w30 Mx 0.0 + + * w12 x * w13 y w22 + * w29 Mx 0.0 + + * w10 x * w11 y w21 + * w28 Mx 0.0 + + * w8 x * w9 y w20 + * w27 Mx 0.0 + + * w6 x * w7 y w19 + * w26 Mx 0.0 + + * w4 x * w5 y w18 + * w25 Mx 0.0 + + * w2 x * w3 y w17 + * w24 Mx 0.0 + + * w0 x * w1 y w16 w32 0.000000001
: pred fffffffffffffffffffffffffffffffffff>f w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 x y / 1.0 + 1.0 Ex * -1.0 + * w31 Mx 0.0 + + * w14 x * w15 y w23 + * w30 Mx 0.0 + + * w12 x * w13 y w22 + * w29 Mx 0.0 + + * w10 x * w11 y w21 + * w28 Mx 0.0 + + * w8 x * w9 y w20 + * w27 Mx 0.0 + + * w6 x * w7 y w19 + * w26 Mx 0.0 + + * w4 x * w5 y w18 + * w25 Mx 0.0 + + * w2 x * w3 y w17 + * w24 Mx 0.0 + + * w0 x * w1 y w16 w32
: main >i {
  = n 160 = dx A n = dy A n = dl A n
  = i 0 W < i n {
    = c % i 2 = th * 3.14159265 / F i F - n 1 = cs Cs th = sn Sn th
    = xr ? == c 0 cs - 1.0 cs = yr ? == c 0 sn - - 1.0 sn 0.5
    !f + dx i + * 0.08 - - * Sn * F + i 1 12.9898 43758.5453 Fl * Sn * F + i 1 12.9898 43758.5453 0.5 * - xr 0.5 1.3  !f + dy i + * 0.08 - - * Sn * F + i 2 12.9898 43758.5453 Fl * Sn * F + i 2 12.9898 43758.5453 0.5 * - yr 0.15 1.3  !f + dl i F c = i + i 1 }
  = w A 33 = g A 33 = pa A 36 = gg A 36
  = i 0 W < i 33 { !f + w i * 1.2 - - * Sn * F + i 1 12.9898 43758.5453 Fl * Sn * F + i 1 12.9898 43758.5453 0.5 = i + i 1 }
  = lr 0.7 = ep 0
  W < ep 5000 {
    = i 0 W < i 33 { !f + g i 0.0 = i + i 1 }
    = loss 0.0 = nc 0 = k 0
    W < k n {
      = xx @f + dx k = yy @f + dy k = tt @f + dl k
      = i 0 W < i 33 { !f + pa i @f + w i = i + i 1 }
      !f + pa 33 xx !f + pa 34 yy !f + pa 35 tt
      J gg loss pa
      = i 0 W < i 33 { !f + g i + @f + g i @f + gg i = i + i 1 }
      = pp pred @f + w 0 @f + w 1 @f + w 2 @f + w 3 @f + w 4 @f + w 5 @f + w 6 @f + w 7 @f + w 8 @f + w 9 @f + w 10 @f + w 11 @f + w 12 @f + w 13 @f + w 14 @f + w 15 @f + w 16 @f + w 17 @f + w 18 @f + w 19 @f + w 20 @f + w 21 @f + w 22 @f + w 23 @f + w 24 @f + w 25 @f + w 26 @f + w 27 @f + w 28 @f + w 29 @f + w 30 @f + w 31 @f + w 32 xx yy
      = loss + loss * -1.0 + * tt Lg + pp 0.000000001 * - 1.0 tt Lg + - 1.0 pp 0.000000001
      = nc + nc ? > pp 0.5 ? == 1 I tt 1 0 ? == 0 I tt 1 0  = k + k 1 }
    = i 0 W < i 33 { !f + w i - @f + w i * lr / @f + g i F n = i + i 1 }
    ? == % ep 1000 0 { "ep " N ep " perda " G / loss F n " precisao " G / F nc F n "\n" } 0  = ep + ep 1 }
  "final " G / F nc F n "\n" 0 }
