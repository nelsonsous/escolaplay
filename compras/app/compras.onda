# Compras: a app, toda em Onda (onda/rt/anfitriao.js corre-a no browser), na Onda fluida: moldes, o ponto e a fala.
# Volta 2: a lista da casa. Escreve-se o que falta («2 leites, pão e ovos»), cada coisa abre uma folha com os produtos
# parecidos em cada supermercado (o índice do conector) e escolhe-se o de cada um; a lista é a mesma em todos os
# telemóveis da casa (o código da casa) e abre sem rede.
# Volta 3: o preço de cada produto escolhido (o conector lê-o no site da cadeia) e o «Mais barato»: o total da lista em
# cada supermercado e se compensa dividir por duas lojas (as contas estão em app/onde.onda).
# Volta 4: o preço por quilo, por litro ou por unidade, e na folha o preço dos produtos parecidos, com o mais barato
# por quilo ou por litro à vista (para trocar de marca ou de embalagem); «Vou a este» arruma a lista por uma loja.
# Volta 5: escrever e encontrar. Enquanto se escreve aparecem os tipos de produto do catálogo («ág» → Água sem gás);
# tocar num abre a escolha: o tamanho, a marca (ou a marca branca 🏷) e o mais barato de cada supermercado, e «Juntar»
# põe na lista a coisa já com o produto de cada um.
# Monta-se com a biblioteca da Onda (compras/compilar.mjs). A casca (compras.js) só trata do que a Onda não tem como
# porta: a chave do aparelho nos pedidos ao conector e os pedidos que escrevem («MÉTODO caminho» + nova linha + corpo).
#
# O ESTADO GUARDADO (o armazém do browser, prefixo «compras:»): é ele que dura; cada evento lê o que precisa e solta
# no fim tudo o que reservou (o monte não cresce com o uso).
#   chave, codigo     o aparelho e o código da casa (do conector)
#   lista             a lista como o conector a mandou, com as mudanças deste telemóvel já aplicadas: {versao, itens}
#   pend              as mudanças por enviar (uma lista JSON de operações; ver compras/proxy/src/casa.js)
#   envio             as que vão no pedido em curso (se falhar, voltam para a frente da fila)
#   aberto            o id da coisa aberta na folha;  p:<cadeia>  a última procura nessa cadeia (o JSON do conector)
#   q:<cadeia>        os preços dos produtos dessa procura (/api/precos);  loja  a cadeia escolhida em «Vou a este»
#   sug               os tipos sugeridos para o que se está a escrever (/api/sugerir)
#   tk, tp            o tipo aberto na escolha e os produtos dele (/api/tipo);  fe, fm, tq  o tamanho, a marca
#                     («branca»: a marca própria) e a quantidade escolhidos
#   entrar            um código de casa vindo de um link (?casa=…);  url  o endereço da app (para o convite)
# GLOBAIS: 1 separador (0 lista, 1 mais barato, 2 casa)  3 um pedido de mudanças em curso  5 o campo «juntar»
#   (texto fixo, 400 bytes)  6 o campo do código (40 bytes)  7 o relógio  8 a última ida à rede falhou
#   9 a registar o aparelho  10 a entrar numa casa  11 12 contadores para os campos voltarem vazios  13 o relógio do aviso
#   14 o relógio da sugestão (espera que se pare de escrever)

# ---------- textos ----------
: minb i>i c ? && >= c 'A <= c 'Z + c 32 c
: vazio i>i t || == t 0 == _tx_len t 0
# copia até max bytes de t para o texto fixo d (sem cortar um carácter UTF-8 a meio)
: fixa iii>i d t max {
  = n _tx_len t Se > n max = n max
  W ? > n 0 && >= _tx_b t n 128 < _tx_b t n 192 0 = n - n 1
  L j n ! + + d 1 j _tx_b t j
  ! d + + d 1 n }
# um texto em JSON, com as aspas ("" se não há)
: pjs i>i t ? t _tx_pj t { P 34 P 34 }
# os bytes de t entre a e b em JSON, com as aspas
: pjs_sub iii>i t a b {
  P 34
  L k - b a {
    = c _tx_b t + a k
    ? || == c 34 == c 92 { P 92 P c } ? < c 32 P 32 P c }
  P 34 }
# um texto JSON de uma lista sem o último byte («]») ou sem o primeiro («[»)
: semfim i>i t L j - _tx_len t 1 P _tx_b t j
: semini i>i t { = n _tx_len t L j - n 1 P _tx_b t + j 1 }
# o código da casa como se lê: ABCD-2345
: pcod i>i c L j _tx_len c { Se == j 4 P '- P _tx_b c j }
# um id novo para uma coisa da lista: 8 letras e algarismos
: novoid >i L k 8 { = r _an_aleat 36 P ? < r 10 + '0 r + 'a - r 10 }

# ---------- as lojas da casa (volta 6) ----------
# as seis lojas que a casa pode escolher (as quatro com preços online, a Mercadona e o SPAR estimados)
: cad6 i>i k ? < k 4 cadeia k ? == k 4 $"mercadona" $"spar"
: nome6 i>i k ? < k 4 nomecad k ? == k 4 $"Mercadona" $"SPAR"
# a casa compra nesta cadeia? (sem lojas escolhidas: em todas)
: minha i>i c {
  = j _ar_json _an_ler $"casa"
  = r 1
  Se && j j.lojas { = r 0 = x pri j.lojas.cadeias W x { Se mesmo txt x c = r 1 = x seg x } }
  r }

# ---------- as cadeias ----------
: cadeia i>i k ? == k 0 $"continente" ? == k 1 $"pingodoce" ? == k 2 $"auchan" $"lidl"
: nomecad i>i k ? == k 0 $"Continente" ? == k 1 $"Pingo Doce" ? == k 2 $"Auchan" $"Lidl"

# ---------- a lista ----------
: alista >i _ar_json _an_ler $"lista"
: itens >i { = l alista ? l l.itens 0 }
: aberto_idx >i {
  = a _an_ler $"aberto" = r -1
  Se a { = c pri itens = i 0 W && c < r 0 { Se mesmo txt c.id a = r i = c seg c = i + i 1 } }
  r }
: item_aberto >i { = i aberto_idx ? >= i 0 idx itens i 0 }

# escreve um produto escolhido (o nó m, com o preço, se o conector já o mandou) e uma coisa da lista (o nó c) com as
# mudanças: qq a quantidade (0: a dela), ff riscada (-1: a dela), pc a cadeia cujo produto muda (0: nenhuma) e pn o
# produto novo (0: tira-o)
: pprod i>i m {
  `\{"id":{ pjs txt m.id },"nome":{ pjs txt m.nome },"url":{ pjs txt m.url }`
  Se m.cent `,"cent":{ N int m.cent }`
  Se m.antes `,"antes":{ N int m.antes }`
  Se m.unid `,"unid":{ pjs txt m.unid }`
  Se int m.esgotado `,"esgotado":1`
  Se m.nh `,"nh":{ pjs txt m.nh }`
  Se m.visto `,"visto":{ pjs txt m.visto }`
  Se m.uc `,"uc":{ N int m.uc },"ub":{ pjs txt m.ub }`
  Se int m.pr `,"pr":1`
  `\}` }
# o que a coisa é (c.e, da escolha) e a estimativa da Mercadona (c.est) passam como estão; mm: escolheu-se à mão
: pesp ii>i e mm `,"e":\{"k":{ pjs txt e.k }{ Se e.emb `,"emb":{ pjs txt e.emb }` }{ Se e.m `,"m":{ pjs txt e.m }` }{ Se e.w `,"w":{ pjs txt e.w }` }{ Se e.n `,"n":{ pjs txt e.n }` }{ Se || mm int e.mao `,"mao":1` }\}`
: pitem iiiiiii>i c qq ff pc pn sep mm {
  Se sep P 44
  `\{"id":{ pjs txt c.id },"t":{ pjs txt c.t },"q":{ N ? qq qq int c.q },"f":{ N ? >= ff 0 ff int c.f }`
  Se c.e pesp c.e mm
  Se c.est `,"est":{ N int c.est }`
  Se c.ests `,"ests":{ N int c.ests }`
  Se c.s `,"s":{ N int c.s }`
  `,"p":\{`
  = s 0 = m pri c.p
  W m {
    = k _ar_chave m
    Se ~ && pc mesmo k pc { Se s P 44 _tx_pj k P 58 pprod m = s 1 }
    = m seg m }
  Se pn { Se s P 44 _tx_pj pc P 58 pprod pn }
  `\}\}` }

# aplica a operação op (a árvore) à lista guardada — o mesmo que o conector faz (casa.js) — e grava-a
: aplica i>i op {
  = l alista
  = o _tx_b txt op.o 0 = id txt op.id
  = antes _an_ler $"lista"
  = h _tx_abre + 3000 ? antes _tx_len antes 0
  `\{"versao":{ N ? l int l.versao 0 },"itens":[`
  = s 0 = tem 0
  = c ? l pri l.itens 0
  W c {
    = este && id mesmo txt c.id id
    Se este = tem 1
    = fica 1
    Se && este == o 'x = fica 0
    Se && == o 'l int c.f = fica 0
    Se fica {
      = qq 0 = ff -1 = pc 0 = pn 0 = mm 0
      Se este {
        Se == o 'r = ff ? int op.f 1 0
        Se == o 'q = qq Mx 1 Mn 99 int op.q
        Se == o 'p { = pc txt op.c = pn ? == tipo op.p 7 op.p 0 = mm ~ int op.a } }
      pitem c qq ff pc pn s mm
      = s 1 }
    = c seg c }
  Se && == o 'j ~ tem {
    Se s P 44
    `\{"id":{ pjs id },"t":{ pjs txt op.t },"q":{ N Mx 1 Mn 99 int op.q },"f":0,"p":\{\}\}` }
  `]\}`
  _tx_fecha h
  _an_gravar $"lista" h }

# uma mudança (o texto JSON da operação): aplica-se já aqui, junta-se às que faltam enviar e envia-se
: faz i>i op {
  = a _ar_json op
  Se a {
    aplica a
    = p _an_ler $"pend"
    = nt _tx_abre + + 8 ? p _tx_len p 0 _tx_len op
    ? vazio p `[{ crut op }]` `{ semfim p },{ crut op }]`
    _tx_fecha nt
    _an_gravar $"pend" nt
    envia }
  0 }

# ---------- a rede ----------
: envia >i Se && ~ @ 3 _an_ler $"chave" {
  = p _an_ler $"pend"
  Se ~ vazio p {
    _an_gravar $"envio" p
    _an_gravar $"pend" 0
    ! 3 1
    _an_buscar`POST /api/lista{ P 10 }\{"ops":{ crut p }\}` $"lido_lista" } }
# a lista como está no conector (só se não há mudanças por enviar: essas vão primeiro)
: ver >i Se && ~ @ 3 _an_ler $"chave" _an_buscar $"/api/lista" $"lido_ver"
: sem_chave >i { _an_gravar $"chave" 0 aviso $"Este telemóvel perdeu a ligação à casa: a criar outra." registar }
: lido_lista ii>i t estado {
  ! 3 0
  ? == estado 200 {
      _an_gravar $"envio" 0
      ! 8 0
      # se entretanto se mudou mais alguma coisa, a lista daqui já a tem: envia-se primeiro, depois troca-se
      ? vazio _an_ler $"pend" { Se _ar_json t _an_gravar $"lista" t } envia
      0 } {
      # falhou: o que ia volta para a frente da fila
      = e _an_ler $"envio" = p _an_ler $"pend"
      Se ~ vazio e {
        = nt _tx_abre + + 8 _tx_len e ? p _tx_len p 0
        ? vazio p crut e `{ semfim e },{ semini p }`
        _tx_fecha nt
        _an_gravar $"pend" nt _an_gravar $"envio" 0 }
      ! 8 1
      Se == estado 401 sem_chave
      0 }
  desenha
  _me_solta t }
: lido_ver ii>i t estado {
  ? == estado 200 {
      ! 8 0
      Se && && ~ @ 3 vazio _an_ler $"pend" ~ mesmo t _an_ler $"lista" { Se _ar_json t { _an_gravar $"lista" t desenha } } 0 }
    { Se == estado 401 sem_chave Se == estado 0 { ! 8 1 desenha } 0 }
  _me_solta t }

# o aparelho: a primeira vez cria-se no conector, numa casa nova só dele
: registar >i Se ~ @ 9 { ! 9 1 _an_buscar`POST /api/aparelho{ P 10 }\{\}` $"lido_ap" }
: lido_ap ii>i t estado {
  ! 9 0
  = r _ar_json t
  ? && == estado 201 r { _an_gravar $"chave" txt r.chave _an_gravar $"codigo" txt r.casa.codigo ! 8 0 depois_da_chave } ! 8 1
  desenha
  _me_solta t }
: depois_da_chave >i { = e _an_ler $"entrar" ? e entrar e { envia ver pede_costume } }

# entrar noutra casa pelo código (o campo, ou um link ?casa=…)
: entrar i>i cod Se && ~ @ 10 _an_ler $"chave" {
  ! 10 1
  _an_buscar`POST /api/casa/entrar{ P 10 }\{"codigo":{ pjs cod }\}` $"lido_entrar" }
: lido_entrar ii>i t estado {
  ! 10 0
  _an_gravar $"entrar" 0
  = r _ar_json t
  ? && == estado 200 r {
      _an_gravar $"codigo" txt r.codigo
      ! 12 + @ 12 1 ! @ 6 + @ 6 1
      aviso`Entraste na casa { pcod txt r.codigo }. A lista passa a ser a mesma nos telemóveis da casa.`
      ! 1 0 envia ver 0 }
    { aviso ? == estado 404 $"Não há nenhuma casa com esse código." $"Não foi possível entrar na casa: tenta outra vez." 0 }
  desenha
  _me_solta t }

# a procura de uma coisa nos quatro supermercados (uma cadeia por pedido: o conector tem 10 ms de CPU para cada)
: procura i>i t L k 4 {
  _an_gravar texto`p:{ crut cadeia k }` 0
  _an_gravar texto`q:{ crut cadeia k }` 0
  _an_buscar`/api/procurar?cadeia={ crut cadeia k }&q={ _tx_uri t }` $"lido_proc" }
# com a procura de uma cadeia, pedem-se os preços dos produtos dela
: lido_proc ii>i t estado {
  Se == estado 200 { = r _ar_json t Se && r txt r.cadeia {
    _an_gravar texto`p:{ crut txt r.cadeia }` t
    = p pri r.produtos
    Se p {
      = h _tx_abre + 100 _tx_len t
      `POST /api/precos{ P 10 }\{"cadeia":{ pjs txt r.cadeia },"produtos":[`
      = s 0 W p { Se s P 44 pprod p = s 1 = p seg p }
      `]\}`
      _tx_fecha h
      _an_buscar h $"lido_precos" }
    dfolha } }
  _me_solta t }
: lido_precos ii>i t estado {
  Se == estado 200 { = r _ar_json t Se && r txt r.cadeia { _an_gravar texto`q:{ crut txt r.cadeia }` t dfolha } }
  _me_solta t }

# o relógio: de 15 em 15 s, envia o que falta ou vê se a casa mudou alguma coisa
: tique i>i z {
  = m _me_marca
  ? _an_ler $"chave" { ? vazio _an_ler $"pend" ver envia } registar
  _me_solta m }

# ---------- avisos ----------
: aviso i>i t {
  = h _ht_ini + 200 _tx_len t
  `<div class="toast" role="status">{ esct t }</div>`
  _ht_poe $"#aviso" h
  Se @ 13 _an_parar @ 13
  ! 13 _an_relogio 5000 $"tira_aviso" }
: tira_aviso i>i z { _an_parar @ 13 ! 13 0 _an_html $"#aviso" $"" 0 }

# ---------- o ecrã ----------
: dabas >i {
  = h _ht_ini 800
  `<button data-onda="aba:0"{ Se == @ 1 0 ` class="on"` }>Lista</button>`
  `<button data-onda="aba:1"{ Se == @ 1 1 ` class="on"` }>Mais barato</button>`
  `<button data-onda="aba:2"{ Se == @ 1 2 ` class="on"` }>Casa</button>`
  _ht_muda $"#abas" h }

# os supermercados com produto escolhido, com o preço para a quantidade («Continente 2,85 € · Lidl 2,55 €»)
: escolhas i>i c {
  = s 0
  L k 4 { = m _ar_get c.p cadeia k Se m {
    Se s ` · `
    crut nomecad k
    Se int m.pr ` 🏷`
    = p pc c k Se >= p 0 ` { eur p }`
    = s 1 } }
  # a Mercadona e o SPAR: o preço do teu talão (sem ≈) ou a estimativa (≈)
  Se && c.est minha $"mercadona" { Se s ` · ` `Mercadona { Se ~ c.estr `≈ ` }{ eur * Mx 1 int c.q int c.est }{ Se c.estr ` (talão)` }` = s 1 }
  Se && c.ests minha $"spar" { Se s ` · ` `SPAR { Se ~ c.estsr `≈ ` }{ eur * Mx 1 int c.q int c.ests }{ Se c.estsr ` (talão)` }` = s 1 }
  Se ~ s `Toca para escolher os produtos` }
# o texto para partilhar no WhatsApp (já no formato de um endereço)
: partilha i>i its {
  = t _tx_abre + 100 * 200 quantos its
  `Lista das compras:`
  = c pri its
  W c { Se ~ int c.f { P 10 `• { Se > int c.q 1 `{ N int c.q } × ` }{ crut txt c.t }` } = c seg c }
  _tx_fecha t
  _tx_uri t }

# a loja escolhida em «Vou a este» (o número da cadeia), ou -1
: loja >i { = l _an_ler $"loja" = r -1 Se l L k 4 Se mesmo l cadeia k = r k r }
# uma coisa da lista (o nó c, no lugar i); lj a loja escolhida (-1: nenhuma)
: ditem iii>i c i lj {
  = f int c.f
  `<li class="item{ Se f ` feito` }" data-chave="{ esc c.id }">`
  `<button class="caixa" data-onda="riscar:{ N i }" aria-label="{ ? f `Voltar a pôr` `Riscar` }">{ Se f `✓` }</button>`
  `<button class="texto" data-onda="abre:{ N i }"><b>{ Se > int c.q 1 `{ N int c.q } × ` }{ esc c.t }</b>`
  # o caminho na árvore (secção › tipo), com as cores da escolha; a secção só quando a lista não está por secções
  Se && c.e c.e.n `<small class="cam">{ Se >= lj 0 `<i class="n1">{ crut nomesec secd c }</i> › ` }<i class="n2">{ esc c.e.n }</i></small>`
  `<small>`
  ? < lj 0 resumo c { = p pc c lj ? >= p 0 `{ crut nomecad lj } { eur p }` `Sem preço no { crut nomecad lj }: toca para escolher` 0 }
  `</small>`
  Se && ~ f c.pk dpack c lj
  `</button>`
  Se ~ f `<span class="qtd-l"><button data-onda="qm:{ N i }" aria-label="Menos">−</button><button data-onda="qp:{ N i }" aria-label="Mais">+</button></span>`
  `<button class="tira" data-onda="tirai:{ N i }" aria-label="Tirar da lista">🗑</button></li>` }
# o resumo de uma coisa na lista: o mais barato das tuas lojas, e em quantas mais há (o resto vê-se ao tocar)
# a melhor forma de comprar a quantidade (packs.js): na loja escolhida, ou na primeira das tuas onde poupa
: dpack ii>i c lj {
  = k0 -1
  ? >= lj 0 { Se _ar_get c.pk cadeia lj = k0 lj 0 } { L k 3 Se && < k0 0 && minha cadeia k _ar_get c.pk cadeia k = k0 k 0 }
  Se >= k0 0 { = x _ar_get c.pk cadeia k0
    `<small class="pack">💡 No { crut nomecad k0 }, leva { esc x.como }: { eur int x.cent } (poupas { eur int x.poupa })</small>` }
  0 }
: resumo i>i c {
  = b -1 = bp 0 = n 0
  L k 4 Se minha cadeia k { = p pc c k Se >= p 0 { = n + n 1 Se || < b 0 < p bp { = b k = bp p } } }
  ? < b 0 { ? || c.est c.ests { Se && c.est minha $"mercadona" `Mercadona { Se ~ c.estr `≈ ` }{ eur * Mx 1 int c.q int c.est }` Se && c.ests ~ && c.est minha $"mercadona" Se minha $"spar" `SPAR { Se ~ c.estsr `≈ ` }{ eur * Mx 1 int c.q int c.ests }` 0 } `Tocar para escolher` 0 }
    { = m _ar_get c.p cadeia b
      `{ crut nomecad b }{ Se int m.pr ` 🏷` } { eur bp }{ Se > n 1 ` · mais { N - n 1 } { ? > n 2 `lojas` `loja` }` }` 0 }
  0 }
# o que costumas comprar (dos talões; /api/costume): o que está a acabar primeiro; o que já está na lista não aparece
: na_lista i>i t { = r 0 = c pri itens W && c ~ r { Se && ~ int c.f mesmo txt c.t t = r 1 = c seg c } r }
: pcostume >i {
  = j _ar_json _an_ler $"costume"
  = x ? j pri j.coisas 0 = i 0 = s 0
  W x {
    Se ~ na_lista txt x.t {
      Se ~ s { `<div class="costume"><h3>Costumas comprar</h3><div class="chips">` = s 1 }
      `<button class="chip{ Se int x.falta ` falta` }" data-onda="cost:{ N i }">+ { esc x.t }<small> { ? x.cada `a cada { N int x.cada } dias, há { N int x.ha }` `há { N int x.ha } dias` }</small></button>` }
    = x seg x = i + i 1 }
  Se s `</div></div>` }
: pede_costume >i Se _an_ler $"chave" _an_buscar $"/api/costume" $"lido_costume"
: lido_saude ii>i t estado {
  Se == estado 200 { _an_gravar $"saude" t desenha }
  _me_solta t }
# há quanto tempo («há 5 min», «há 2 h», «há 3 dias»)
: ha_tempo i>i m ? < m 60 `há { N m } min` ? < m 2880 `há { N / m 60 } h` `há { N / m 1440 } dias`
# a frescura dos preços de cada cadeia (a saúde da base, /api/saude): se uma deixou de dar preços, vê-se aqui
: dsaude >i {
  = j _ar_json _an_ler $"saude"
  Se && j pri j.cadeias {
    `<h3>Os preços</h3><ul class="saude">`
    = c pri j.cadeias
    W c { `<li class="{ ? mesmo txt c.estado $"ok" `ok` `aviso` }"><b>{ crut nomec txt c.cadeia }</b> { ? c.ultimo_preco { ha_tempo int c.ha 0 } `sem preços` }{ Se ~ mesmo txt c.estado $"ok" ` · ⚠ a ler com falhas` }</li>` = c seg c }
    `</ul><p class="nota">O conector relê os preços de cada supermercado ao longo do dia; se um ficar com ⚠, o site mudou e é preciso corrigi-lo.</p>` }
  0 }
: lido_costume ii>i t estado {
  Se == estado 200 { _an_gravar $"costume" t desenha }
  _me_solta t }
# as secções da lista (as mesmas do conector, seccoes.js)
: nomesec i>i s ? == s 0 $"Fruta e legumes" ? == s 1 $"Padaria" ? == s 2 $"Talho e peixaria" ? == s 3 $"Charcutaria e queijos" ? == s 4 $"Laticínios e ovos" ? == s 5 $"Mercearia" ? == s 6 $"Bebidas" ? == s 7 $"Congelados" ? == s 8 $"Limpeza" ? == s 9 $"Higiene e bebé" ? == s 10 $"Animais" $"Outros"
: secd i>i c ? c.s int c.s 11
# o que já está no carrinho (riscado): no fundo, fechado até se tocar
: dcarrinho ii>i feitos lj {
  Se feitos {
    = aberto _an_ler $"carrinho"
    `<h3 class="sec carrinho{ Se ~ aberto ` fechada` }"><button data-onda="carr:0" aria-expanded="{ ? aberto `true` `false` }">No carrinho <small>{ N feitos }</small></button></h3>`
    Se aberto {
      `<ul class="itens">`
      = c pri itens = i 0
      W c { Se int c.f ditem c i lj = c seg c = i + i 1 }
      `</ul>` } }
  0 }
# as secções em botões grandes, com um ícone (o modo simples): tocar mostra os tipos da secção
: icone i>i k ? == k 0 $"🥬" ? == k 1 $"🥖" ? == k 2 $"🥩" ? == k 3 $"🧀" ? == k 4 $"🥛" ? == k 5 $"🥫" ? == k 6 $"🧃" ? == k 7 $"🧊" ? == k 8 $"🧽" ? == k 9 $"🧴" ? == k 10 $"🐾" $"📦"
: dgrelha >i {
  `<div class="grelha" role="list">`
  L k 11 `<button data-onda="seca:{ N k }"><span aria-hidden="true">{ crut icone k }</span>{ crut nomesec k }</button>`
  `</div>` }
: dlista >i {
  = its itens
  = n ? its quantos its 0
  = lj loja
  = h _ht_ini + 4000 * 800 n
  = sp _an_ler $"simples"
  `<section class="lista{ Se sp ` simples` }">`
  # o modo simples (para quem não gosta de escrever): o que costumas comprar primeiro, as secções em botões grandes,
  # os tipos da secção por baixo, e só depois o campo de escrever (com a dica do microfone do teclado)
  Se sp { pcostume dgrelha `<div id="sug">` psug `</div>` }
  `<div class="junta"><input data-onda="junta" data-chave="j{ N @ 11 }" placeholder="{ ? sp `Ou escreve (o 🎤 do teclado deixa falar)` `O que falta? (ex.: 2 leites, pão, ovos)` }" aria-label="O que falta" autocomplete="off" enterkeyhint="done">`
  `<button class="botao" data-onda="juntar:0">Juntar</button></div>`
  Se ~ sp { `<div id="sug">` psug `</div>` }
  `<button class="botao natal" data-onda="natal:0">🎄 Cabaz de Natal <small>o melhor bacalhau, Porto, bolo-rei…</small></button>`
  Se @ 8 `<p class="rede">Sem ligação: as mudanças ficam neste telemóvel e seguem quando houver rede.</p>`
  ? == n 0 { `<p class="vazio">A lista está vazia. { ? sp `Toca numa secção ou no que costumas comprar.` `Escreve o que falta em casa, separado por vírgulas.` }</p>` Se ~ sp pcostume 0 } {
    Se >= lj 0 {
      = nr porriscar = c cobre lj
      `<div class="loja"><p><b>Vais ao { crut nomecad lj }: { eur total lj }</b>`
      Se < c nr `<small>{ N - nr c } { ? == - nr c 1 `coisa sem preço` `coisas sem preço` } aqui</small>`
      `</p><button class="botao fraco" data-onda="loja:9">Mudar</button></div>` }
    = feitos 0 = c pri its W c { = feitos + feitos int c.f = c seg c }
    ? >= lj 0 {
        # com uma loja escolhida: primeiro o que tem preço lá, depois o resto (o riscado no fim)
        `<ul class="itens">`
        L passo 2 {
          = c pri its = i 0
          W c {
            = tem >= pc c lj 0
            Se && ~ int c.f == tem == passo 0 ditem c i lj
            = c seg c = i + i 1 } }
        `</ul>`
        dcarrinho feitos lj 0 }
      {
        # por secções, pela ordem da loja (a secção vem do conector: seccoes.js); cada uma fecha-se com um toque
        L sc 12 {
          = ns 0 = c pri its W c { Se && ~ int c.f == secd c sc = ns + ns 1 = c seg c }
          Se ns {
            = fechada _an_ler texto`sec:{ N sc }`
            `<h3 class="sec{ Se fechada ` fechada` }"><button data-onda="sec:{ N sc }" aria-expanded="{ ? fechada `false` `true` }">{ crut nomesec sc } <small>{ N ns }</small></button></h3>`
            Se ~ fechada {
              `<ul class="itens">`
              = c pri its = i 0
              W c { Se && ~ int c.f == secd c sc ditem c i -1 = c seg c = i + i 1 }
              `</ul>` } } }
        dcarrinho feitos -1 0 }
    pcostume
    `<div class="acoes">`
    Se feitos `<button class="botao fraco" data-onda="limpar:0">Tirar os riscados ({ N feitos })</button>`
    `<a class="botao whats" target="_blank" rel="noopener" href="https://wa.me/?text={ partilha its }">Partilhar no WhatsApp</a>`
    `<label class="botao fraco talao">📷 Talão<input type="file" accept="image/*" data-talao hidden></label></div>`
    0 }
  `</section>`
  _ht_muda $"#vista" h }

: porriscar >i { = r 0 = c pri itens W c { Se ~ int c.f = r + r 1 = c seg c } r }
# os nomes das coisas que ficam na loja a (e não na b), separados por vírgulas
: nomes_em ii>i a b { = s 0 = c pri itens W c { Se && ~ int c.f na_a c a b { Se s `, ` esc c.t = s 1 } = c seg c } }
# dividir por duas lojas: o melhor par que tem tudo; mostra-se se nenhuma loja sozinha tem tudo, ou se poupa o bastante
: ddividir ii>i n pt {
  = ba -1 = bb -1 = bt 0
  L a 4 L b 4 Se && && < a b && minha cadeia a minha cadeia b == cobre2 a b n { = t total2 a b Se || < ba 0 < t bt { = ba a = bb b = bt t } }
  Se && >= ba 0 || < pt 0 >= - pt bt poupa_min {
    `<div class="dividir"><h3>{ ? < pt 0 `Para ter tudo, duas lojas` `Compensa ir a duas lojas` }</h3>`
    `<p><b>{ crut nomecad ba } e { crut nomecad bb }: { eur bt }</b>{ Se >= pt 0 ` — poupas { eur - pt bt }` }</p>`
    `<p class="nota">No { crut nomecad ba }: { nomes_em ba bb }.</p><p class="nota">No { crut nomecad bb }: { nomes_em bb ba }.</p></div>` }
  0 }
# a Mercadona, à parte: a estimativa (a marca branca do mesmo tipo e tamanho nas outras lojas), nunca «o mais barato»
: dmerc i>i n {
  = t 0 = c 0 = r 0 = x pri itens
  W x { Se && ~ int x.f x.est { = t + t * Mx 1 int x.q int x.est = c + c 1 Se x.estr = r + r 1 } = x seg x }
  Se && c minha $"mercadona" {
    `<div class="merc"><p><b>Mercadona { Se < r c `≈ ` }{ eur t }</b>{ Se < c n ` <small>(só { N c } de { N n } coisas)</small>` }</p>`
    `<p class="nota">{ Se r `{ N r } { ? == r 1 `coisa com o preço` `coisas com o preço` } do teu talão. ` }{ Se < r c `Estimativa: a marca branca do mesmo tipo e tamanho nas outras lojas (a Mercadona não publica os preços). Os talões vão corrigi-la.` }</p></div>` }
  = t 0 = c 0 = r 0 = x pri itens
  W x { Se && ~ int x.f x.ests { = t + t * Mx 1 int x.q int x.ests = c + c 1 Se x.estsr = r + r 1 } = x seg x }
  Se && c minha $"spar" {
    = j _ar_json _an_ler $"casa"
    `<div class="merc"><p><b>{ ? && j j.lojas.spar esc j.lojas.spar `SPAR` } { Se < r c `≈ ` }{ eur t }</b>{ Se < c n ` <small>(só { N c } de { N n } coisas)</small>` }</p>`
    `<p class="nota">{ Se r `{ N r } { ? == r 1 `coisa com o preço` `coisas com o preço` } do teu talão. ` }{ Se < r c `Estimativa: as marcas de fabricante do mesmo tipo e tamanho nas outras lojas (o SPAR não tem loja online). Os talões da tua loja vão corrigi-la.` }</p></div>` }
  0 }
: dmais >i {
  = h _ht_ini + 6000 * 300 quantos itens
  = n porriscar
  `<section class="mais"><h2>Mais barato</h2>`
  # embalagens diferentes: a ordem conta o preço pelo mesmo tamanho; o total é o que se paga
  = nc 0 = x pri itens W x { Se && ~ int x.f x.cmp = nc + nc 1 = x seg x }
  Se nc `<p class="nota">{ N nc } { ? == nc 1 `coisa tem` `coisas têm` } embalagens diferentes de loja para loja: a ordem compara o preço pelo mesmo tamanho (por litro ou quilo); o total é o que pagas.</p>`
  ? == n 0 `<p class="vazio">Não há nada por comprar na lista.</p>` {
    # quantos supermercados têm preço para tudo; o primeiro deles (na ordem de proxima) é o mais barato
    = completos 0 L k 4 Se && minha cadeia k == cobre k n = completos + completos 1
    # as cadeias onde a casa não compra ficam de fora (como já mostradas)
    = feitos 0 = pt -1 = nm 0
    L k 4 { ? minha cadeia k { = nm + nm 1 0 } { = feitos | feitos << 1 k 0 } }
    `<ul class="cadeias">`
    L r nm {
      = k proxima feitos
      = feitos | feitos << 1 k
      = c cobre k = t total k
      ? == c n {
          `<li class="{ ? < pt 0 `melhor` `tudo` }"><b>{ crut nomecad k }</b><span class="total">{ eur t }</span>`
          ? < pt 0 { = pt t `<small>{ ? > completos 1 `Mais barato` `O único com preço para tudo` }</small>` 0 }
            `<small>mais { eur - t pt }</small>`
          `<button class="ir" data-onda="loja:{ N k }">Vou a este</button></li>` 0 }
        { `<li class="parcial"><b>{ crut nomecad k }</b><span class="total">{ ? c eur t `—` }</span>`
          `<small>{ ? c `só { N c } de { N n } coisas com preço` `sem produtos escolhidos` }</small>`
          Se c `<button class="ir" data-onda="loja:{ N k }">Vou a este</button>`
          `</li>` 0 } }
    `</ul>`
    dmerc n
    ddividir n pt
    Se == completos 0 `<p class="nota">Para comparar, toca em cada coisa da lista e escolhe o produto de cada supermercado.</p>`
    0 }
  `<p class="nota">Os preços são os dos sites dos supermercados, vistos uma vez por dia; na loja podem ser outros, e os descontos de cartão não contam.</p></section>`
  _ht_muda $"#vista" h }

: convite i>i cod { = u _an_ler $"url" _tx_uri texto`Junta-te à nossa lista das compras: { ? u crut u `https://nelsonsous.github.io/escolaplay/compras/` }?casa={ crut cod }` }
: dcasa >i {
  = cod _an_ler $"codigo"
  = h _ht_ini 9000
  `<section class="casa"><h2>A tua casa</h2>`
  ? cod {
      `<p>Quem tiver este código vê e muda a mesma lista:</p><p class="codigo">{ pcod cod }</p>`
      `<a class="botao whats" target="_blank" rel="noopener" href="https://wa.me/?text={ convite cod }">Convidar pelo WhatsApp</a>` 0 }
    { ? @ 9 `<p>A preparar…</p>` `<p>Sem ligação ao conector.</p><button class="botao" data-onda="registar:0">Tentar outra vez</button>` 0 }
  dlojas
  # o horário da loja SPAR escolhida (do site do SPAR)
  = jh _ar_json _an_ler $"casa"
  Se && && jh jh.lojas jh.lojas.sparh `<p class="horario">🕘 <b>{ esc jh.lojas.spar }</b><br>Seg. a sex.: { esc jh.lojas.sparh.u }<br>Sábados: { esc jh.lojas.sparh.s }<br>Domingos: { esc jh.lojas.sparh.d }</p>`
  # o código postal: com ele, o conector vê de hora a hora se os produtos do Continente da lista há na tua zona
  = jc _ar_json _an_ler $"casa"
  `<h3>Stock do Continente na tua zona</h3><p class="nota">Com o código postal, o conector pergunta ao Continente que loja online serve a tua zona e vê, de hora a hora, se os produtos da lista estão lá disponíveis. O código postal só se usa para isto.</p>`
  `<div class="junta"><input data-onda="cpz" data-chave="cp{ N @ 12 }" placeholder="Código postal (ex.: 4780-521)" aria-label="Código postal" inputmode="numeric" autocomplete="postal-code" value="{ Se && jc jc.cp esc jc.cp }">`
  `<button class="botao" data-onda="cpg:0">Gravar</button></div>`
  Se && jc jc.zona `<p class="nota">✓ A tua zona: <b>{ esc jc.zona }</b>.</p>`
  # quantas pessoas há em casa: no talho e na peixaria, o mais barato escolhe-se entre as embalagens do tamanho certo
  = np ? && jc jc.pessoas int jc.pessoas 0
  `<h3>Quantas pessoas em casa?</h3><p class="nota">No talho e na peixaria, o mais barato escolhe-se entre as embalagens para a casa (duas refeições por pessoa), e não o pacote de 2 kg só por ser o mais barato ao quilo.</p><div class="chips">`
  `<button class="chip{ Se ~ np ` on` }" data-onda="pes:0">Não contar</button>`
  L i 6 { = n + i 1 `<button class="chip{ Se == np n ` on` }" data-onda="pes:{ N n }">{ N n }{ Se == n 6 `+` }</button>` }
  `</div>`
  dsaude
  = sp _an_ler $"simples"
  `<h3>Modo simples</h3><p class="nota">Letra e botões maiores, as secções com ícones e o que costumas comprar primeiro, para escolher sem escrever. Só neste telemóvel; a lista é a mesma.</p>`
  `<button class="botao{ Se ~ sp ` fraco` }" data-onda="simples:0" aria-pressed="{ ? sp `true` `false` }">{ ? sp `✓ Modo simples ligado (tocar para desligar)` `Ligar o modo simples` }</button>`
  `<h3>Entrar noutra casa</h3>`
  `<div class="junta"><input data-onda="codigo" data-chave="c{ N @ 12 }" placeholder="Código (ex.: ABCD-2345)" aria-label="Código de outra casa" autocomplete="off" autocapitalize="characters" enterkeyhint="go">`
  `<button class="botao" data-onda="entrar:0">Entrar</button></div>`
  `<p class="nota">O que está na tua lista junta-se à da outra casa.</p>`
  `<p class="nota">A lista guarda-se no conector da app (Cloudflare). Só a vê quem tem o código.</p></section>`
  _ht_muda $"#vista" h }

: dvista >i ? == @ 1 0 dlista ? == @ 1 1 dmais dcasa

# o preço de um produto (o nó m, escolhido ou de uma procura), para a folha («<s>1,05 €</s> 0,89 € · 0,89 €/l»)
: dpreco i>i m {
  ? && m m.cent {
      Se m.antes `<s>{ eur int m.antes }</s> `
      eur int m.cent
      ? m.uc ` · { eur int m.uc }/{ crut txt m.ub }` { Se m.unid ` · { esc m.unid }` 0 }
      Se int m.esgotado ` · { ? m.nh `não havia na loja (até { esc m.nh })` { ? int m.ez `esgotado na tua zona` `esgotado no site` } }` 1 }
    0 }
# o preço de um produto (pelo id) nos preços q de uma procura (o nó com .produtos), ou 0
: qpreco ii>i q id { = r 0 Se q { = p pri q.produtos W && p ~ r { Se mesmo txt p.id id = r p = p seg p } } r }
: unidade i>i ub ? mesmo ub $"kg" $"quilo" ? mesmo ub $"l" $"litro" $"unidade"
# o mais barato por quilo/litro/unidade entre o escolhido (ep, com o preço) e os da procura: o id dele, ou 0 (se
# não há pelo menos dois com a mesma medida para comparar)
: mais_barato iii>i ep r q {
  = ub 0 = melhor 0 = mu 0 = quantos 0
  Se && ep ep.uc { = ub txt ep.ub = melhor txt ep.id = mu int ep.uc = quantos 1 }
  = p ? r pri r.produtos 0
  W p {
    = x qpreco q txt p.id
    Se && x x.uc {
      Se ~ ub = ub txt x.ub
      Se && mesmo txt x.ub ub ~ && ep mesmo txt p.id txt ep.id {
        = quantos + quantos 1
        Se || ~ melhor < int x.uc mu { = melhor txt p.id = mu int x.uc } } }
    = p seg p }
  ? > quantos 1 melhor 0 }
# a folha de uma coisa: a quantidade e o produto de cada supermercado
: dcadeia ii>i c k {
  = ep _ar_get c.p cadeia k
  `<h3>{ crut nomecad k }</h3><div class="prods">`
  = r _ar_json _an_ler texto`p:{ crut cadeia k }`
  = q _ar_json _an_ler texto`q:{ crut cadeia k }`
  = mb mais_barato ep r q
  Se ep {
    `<button class="prod on" data-onda="esc:{ N + * k 100 99 }">✓ { esc ep.nome }<small>`
    ? ep.cent { dpreco ep ` · ` 0 } `a ver o preço… · `
    `tocar para tirar</small>`
    Se && mb mesmo mb txt ep.id `<em>o mais barato por { crut unidade txt ep.ub }</em>`
    `</button>`
    # «não havia na loja»: fica em falta 3 dias nesse supermercado (a troca passa ao seguinte); tocar outra vez desfaz
    `<button class="op-x nh" data-onda="nhv:{ N k }">{ ? ep.nh `↺ Afinal havia` `✗ Não havia na loja` }</button>` }
  ? && r mesmo txt r.q txt c.t {
      = p pri r.produtos = j 0
      ? p { W p {
              Se ~ && ep mesmo txt p.id txt ep.id {
                = x qpreco q txt p.id
                `<button class="prod" data-onda="esc:{ N + * k 100 j }">{ esc p.nome }`
                Se x `<small>{ dpreco x }</small>`
                Se && mb mesmo mb txt p.id `<em>o mais barato por { crut unidade txt x.ub }</em>`
                `</button>` }
              = p seg p = j + j 1 } 0 }
          `<p class="nota">Nada parecido neste supermercado.</p>`
      0 }
    { ? @ 8 `<p class="nota">Sem ligação.</p>` `<p class="nota">A procurar…</p>` 0 }
  `</div>` }
# ---------- o Cabaz de Natal (volta 10): 3 opções por parte, pela qualidade, pelo equilíbrio ou pelo preço ----------
: ntmodo >i { = m _an_ler $"ntm" ? m _tx_int m 1 }
: ntteto >i { = t _an_ler $"ntt" ? t _tx_int t 0 }
: ntteto_e i>i k ? == k 1 60 ? == k 2 100 ? == k 3 150 0
: ntloja i>i c ? mesmo c $"lugrade" $"Lugrade (produtor)" nomec c
: pede_natal >i {
  = m ntmodo = k ntteto
  _an_buscar texto`/api/natal?modo={ ? == m 0 `qualidade` { ? == m 2 `preco` `equilibrio` } }{ Se k `&teto={ N ntteto_e k }` }` $"lido_natal" 0 }
: lido_natal ii>i t estado {
  Se == estado 200 { _an_gravar $"nt" t L k 12 _an_gravar texto`ntc{ N k }` 0 desenha }
  _me_solta t }
# a opção escolhida de uma parte: a da pessoa (guardada +1) ou a que o conector pôs no cabaz
: ntesc ii>i p i { = c _an_ler texto`ntc{ N i }` ? c - _tx_int c 1 int p.escolha }
: ntop iiii>i o i jx e {
  `<button class="op{ Se == jx e ` on` }" data-onda="ntc:{ N + * i 10 jx }"><b>{ esc o.nome }</b>`
  `<span class="uc">{ ? o.uc `{ eur int o.uc }<i>/{ crut txt o.ub }</i>` `{ eur int o.cent }` }</span>`
  `<span class="pr">{ Se == jx e `✓ no cabaz · ` }{ crut ntloja txt o.cadeia } · { eur int o.cent }{ Se o.emb ` por { esc o.emb }` }</span>`
  `<span class="sinais">{ Se int o.propria `<i class="z">🏷 marca branca</i>` }`
  = z pri o.porque
  W z { = b _tx_b txt z 0 `<i class="{ ? == b 43 `p` { ? == b 226 `n` `z` } }">{ esc z }</i>` = z seg z }
  `</span></button>` 0 }
: dnatal >i {
  = j _ar_json _an_ler $"nt" = m ntmodo = k ntteto
  `<div class="veu" data-onda="ntf:0"></div><div class="cartao natal" role="dialog" aria-label="Cabaz de Natal"><button class="fechar" data-onda="ntf:0" aria-label="Fechar">✕</button>`
  `<h2>🎄 Cabaz de Natal</h2>`
  `<p class="nota">As 3 melhores opções de cada parte nas tuas lojas e nas lojas de produtor. Toca numa para a pôr no cabaz.</p>`
  `<div class="chips">`
  L x 3 `<button class="chip{ Se == x m ` on` }" data-onda="ntm:{ N x }" aria-pressed="{ ? == x m `true` `false` }">{ ? == x 0 `⭐ Qualidade` { ? == x 1 `⚖ Equilíbrio` `€ Preço` } }</button>`
  `</div><div class="chips">`
  L x 4 `<button class="chip{ Se == x k ` on` }" data-onda="ntt:{ N x }" aria-pressed="{ ? == x k `true` `false` }">{ ? x `até { N ntteto_e x } €` `Sem teto` }</button>`
  `</div>`
  ? ~ j `<p class="nota">A procurar…</p>` {
    = p pri j.partes = i 0 = tot 0
    W p {
      = off _an_ler texto`nto{ N i }`
      = e ntesc p i
      `<div class="parte{ Se off ` fora` }"><h3>{ esc p.icone } { esc p.nome }`
      Se pri p.opcoes `<span><button class="op-x" data-onda="ntv:{ N i }">🔎 Ver todos</button><button class="op-x" data-onda="nto:{ N i }">{ ? off `+ Pôr no cabaz` `Tirar` }</button></span>`
      `</h3>`
      Se ~ pri p.opcoes `<p class="nota">Ainda não há nas tuas lojas.</p>`
      Se && ~ off pri p.opcoes {
        `<div class="opcoes">`
        = o pri p.opcoes = jx 0
        W o { ntop o i jx e Se == jx e = tot + tot int o.cent = o seg o = jx + jx 1 }
        `</div>` }
      `</div>`
      = p seg p = i + i 1 }
    `<p class="total"><b>O cabaz: { eur tot }</b>{ Se && k > tot * 100 ntteto_e k ` <small>· acima do teto: escolhe opções mais baratas</small>` }</p>`
    `<p class="nota">{ esc j.aviso } Os preços são os dos sites; o da loja de produtor junta-se à lista como nota.</p>`
    0 }
  `<div class="acoes"><button class="botao fraco" data-onda="ntf:0">Fechar</button><button class="botao" data-onda="ntj:0">Juntar o cabaz à lista</button></div></div>`
  0 }
: ntjunta >i {
  = j _ar_json _an_ler $"nt"
  Se j {
    = p pri j.partes = i 0 = n 0
    W p {
      = o idx p.opcoes ntesc p i
      Se && ~ _an_ler texto`nto{ N i }` o {
        = id texto`{ novoid }`
        = pr int o.produtor
        = nm texto`{ crut txt o.tn }{ Se pr ` ({ crut ntloja txt o.cadeia })` }`
        faz texto`\{"o":"j","id":"{ crut id }","t":{ pjs nm },"q":1{ Se o.tipo `,"e":\{"k":{ pjs txt o.tipo },"n":{ pjs txt o.tn }\}` }\}`
        Se ~ pr faz texto`\{"o":"p","id":"{ crut id }","c":{ pjs txt o.cadeia },"p":\{"id":{ pjs txt o.id },"nome":{ pjs txt o.nome },"url":{ pjs txt o.url }\}\}`
        = n + n 1 }
      = p seg p = i + i 1 }
    _an_gravar $"natal" 0
    aviso texto`{ N n } coisas do cabaz juntas à lista.`
    ! @ 5 + @ 5 1 ! 11 + @ 11 1 }
  0 }

# ---------- as receitas (ciclo 3): o link de um vídeo (TikTok, YouTube) ou o texto colado → os ingredientes ----------
: pede_receita i>i t {
  _an_gravar $"receita" $"1" _an_gravar $"rcj" 0 _an_gravar $"rcerr" 0
  L k 30 _an_gravar texto`rco{ N k }` 0
  _an_buscar texto`POST /api/receita{ P 10 }\{"url":{ pjs t }\}` $"lido_receita" 0 }
: pede_receita_txt >i {
  = t _an_ler $"rctxt"
  Se t { _an_gravar $"rcj" 0 _an_gravar $"rcerr" 0 L k 30 _an_gravar texto`rco{ N k }` 0
    _an_buscar texto`POST /api/receita{ P 10 }\{"texto":{ pjs t }\}` $"lido_receita" }
  0 }
: lido_receita ii>i t estado {
  = j _ar_json t
  ? == estado 200 _an_gravar $"rcj" t { _an_gravar $"rcerr" ? && j j.erro texto`{ crut txt j.erro }` $"Sem ligação ao conector." 0 }
  desenha
  _me_solta t }
: rcfonte i>i f ? mesmo f $"tiktok" $"TikTok" ? mesmo f $"youtube" $"YouTube" $"texto"
: dreceita >i {
  = j _ar_json _an_ler $"rcj" = er _an_ler $"rcerr"
  `<div class="veu" data-onda="rcf:0"></div><div class="cartao receita" role="dialog" aria-label="Receita"><button class="fechar" data-onda="rcf:0" aria-label="Fechar">✕</button>`
  `<h2>🔗 Da receita para a lista</h2>`
  Se er `<p class="aviso">{ crut er }</p>`
  Se && ~ j ~ er `<p class="nota">A ler a receita…</p>`
  = n 0
  Se j {
    Se || j.prato j.titulo `<h3>{ esc ? j.prato j.prato j.titulo }</h3>`
    Se j.autor `<p class="nota">de { esc j.autor } no { crut rcfonte txt j.fonte }</p>`
    = i pri j.ingredientes = k 0
    ? i {
      `<p class="nota">Toca no que já tens em casa para não o juntar.</p><div class="chips rc">`
      W i { = fora _an_ler texto`rco{ N k }` Se ~ fora = n + n 1
        `<button class="chip{ Se ~ fora ` on` }" data-onda="rco:{ N k }" aria-pressed="{ ? fora `false` `true` }">{ ? fora `` `✓ ` }{ esc i.t }{ Se i.n `<small> { esc i.n }</small>` }</button>`
        = i seg i = k + k 1 }
      `</div>` 0 }
      `<p class="nota">{ ? int j.semLegenda `O { crut rcfonte txt j.fonte } não deixou ler a legenda deste vídeo.` `Não encontrei ingredientes.` } Copia a descrição do vídeo (ou o texto da receita de um site ou de uma mensagem) e cola-a aqui:</p>` }
  `<textarea data-onda="rctx" data-chave="rt{ N @ 12 }" rows="4" placeholder="Cola aqui o texto da receita" aria-label="Texto da receita"></textarea>`
  `<button class="botao fraco" data-onda="rct:0">Ler o texto</button>`
  `<div class="acoes"><button class="botao fraco" data-onda="rcf:0">Fechar</button>{ Se n `<button class="botao" data-onda="rcj:0">Juntar { N n } à lista</button>` }</div></div>`
  0 }
: rcjunta >i {
  = j _ar_json _an_ler $"rcj"
  Se j {
    = i pri j.ingredientes = k 0 = n 0
    W i { Se ~ _an_ler texto`rco{ N k }` { faz texto`\{"o":"j","id":"{ novoid }","t":{ pjs txt i.t },"q":1\}` = n + n 1 } = i seg i = k + k 1 }
    _an_gravar $"receita" 0 _an_gravar $"rctxt" 0
    aviso texto`{ N n } ingredientes juntos à lista.`
    ! @ 5 + @ 5 1 ! 11 + @ 11 1 }
  0 }

: dfolha >i {
  = h _ht_ini + + + 12000 ? _an_ler $"tp" * 2 _tx_len _an_ler $"tp" 0 ? _an_ler $"nt" * 3 _tx_len _an_ler $"nt" 0 ? _an_ler $"rcj" * 3 _tx_len _an_ler $"rcj" 0
  = c item_aberto
  Se _an_ler $"tk" dtipo
  Se && _an_ler $"natal" ~ _an_ler $"tk" dnatal
  Se && && _an_ler $"receita" ~ _an_ler $"natal" ~ _an_ler $"tk" dreceita
  Se && && && ~ _an_ler $"tk" ~ _an_ler $"natal" ~ _an_ler $"receita" c {
    `<div class="veu" data-onda="fecha:0"></div><div class="cartao" role="dialog" aria-label="{ esc c.t }"><button class="fechar" data-onda="fecha:0" aria-label="Fechar">✕</button>`
    `<h2>{ esc c.t }</h2>`
    `<div class="qtd"><button class="botao fraco" data-onda="menos:0" aria-label="Menos">−</button><b>{ N int c.q }</b><button class="botao fraco" data-onda="mais:0" aria-label="Mais">+</button></div>`
    `<p class="nota">Escolhe o produto de cada supermercado. O preço é o do site; o preço por quilo ou por litro serve para comparar embalagens e marcas.</p>`
    L k 4 dcadeia c k
    Se && c.e c.e.k `<button class="botao fraco ajustar" data-onda="ajusta:0">🔎 Ajustar: calibre, origem, marca e outras opções</button>`
    `<div class="acoes"><button class="botao fraco" data-onda="tirar:0">Tirar da lista</button><button class="botao" data-onda="fecha:0">Fechar</button></div></div>` }
  _ht_muda $"#folha" h }

: desenha >i { dabas dvista dfolha }

# ---------- os eventos ----------
# o separador do campo «juntar»: «,» «;» uma mudança de linha (1) ou « e » (3)
: sep iii>i t j n {
  = b _tx_b t j
  ? || || == b 44 == b 59 == b 10 1
    ? && && == b 32 < + j 2 n && == minb _tx_b t + j 1 'e == _tx_b t + j 2 32 3 0 }
# um pedaço do campo (de a a b): «2 leites» → juntar «leites» com 2; «7up» fica «7up»
: pedaco iii>i t a b {
  W && < a b == _tx_b t a 32 = a + a 1
  W && < a b == _tx_b t - b 1 32 = b - b 1
  = q 1 = d a = v 0
  W && < d b && >= _tx_b t d '0 <= _tx_b t d '9 { = v + * v 10 - _tx_b t d '0 = d + d 1 }
  Se && && > d a < d b || == _tx_b t d 32 || == minb _tx_b t d 'x == _tx_b t d 195 {
    # «2 leites», «2x leite», «2 × leite» (× é C3 97 em UTF-8)
    = q Mx 1 Mn 99 v
    Se == _tx_b t d 195 = d + d 2
    Se == minb _tx_b t d 'x = d + d 1
    W && < d b == _tx_b t d 32 = d + d 1
    = a d }
  Se < a b faz texto`\{"o":"j","id":"{ novoid }","t":{ pjs_sub t a b },"q":{ N q }\}`
  0 }
# ---------- onde moras e as tuas lojas (volta 6) ----------
: dlojas >i {
  = j _ar_json _an_ler $"casa"
  `<h3>Onde moras</h3><div class="junta"><input data-onda="local" data-chave="l{ N @ 12 }" value="{ Se && j j.local esc j.local }" placeholder="Localidade ou código postal" aria-label="Localidade" autocomplete="off" enterkeyhint="done">`
  `<button class="botao" data-onda="glocal:0">Guardar</button></div>`
  `<h3>As tuas lojas</h3><p class="nota">Só estas entram nas comparações.</p><div class="chips">`
  L k 6 `<button class="chip{ Se minha cad6 k ` on` }" data-onda="cad:{ N k }">{ crut nome6 k }</button>`
  `</div>`
  Se minha $"spar" {
    = q _ar_json _an_ler $"lojasq"
    `<h3>A tua loja SPAR</h3>`
    ? && q pri q.lojas {
        `<div class="chips">`
        = x pri q.lojas = i 0
        W && x < i 12 { `<button class="chip{ Se && j && j.lojas mesmo txt j.lojas.spar txt x.n ` on` }" data-onda="sparl:{ N i }">{ esc x.n }<small> { esc x.l }</small></button>` = x seg x = i + i 1 }
        `</div>` 0 }
      `<p class="nota">Escreve a localidade (ou o código postal) e guarda, para veres as lojas SPAR de lá.</p>` }
  0 }
# grava a localidade e as lojas: mexe (0 a 5) troca uma loja, -1 nenhuma; sp o índice da loja SPAR escolhida (-1: fica)
# o código postal da casa (para o stock do Continente na zona): grava (ou tira, vazio) e recebe a casa com a zona
: gravar_cp >i {
  = cp _an_ler $"cptxt"
  = h _tx_abre 200
  `POST /api/casa/cp{ P 10 }\{"cp":{ ? cp pjs cp `null` }\}`
  _tx_fecha h
  _an_buscar h $"lido_casa"
  0 }
: gravar_lojas ii>i mexe sp {
  = j _ar_json _an_ler $"casa"
  = lt _an_ler $"localtxt"
  = q _ar_json _an_ler $"lojasq"
  = ls ? && q >= sp 0 idx q.lojas sp 0
  = h _tx_abre 2000
  `POST /api/casa/lojas{ P 10 }\{"local":{ ? lt pjs lt ? && j j.local pjs txt j.local `null` },"cadeias":[`
  = s 0
  L k 6 { = on minha cad6 k Se == k mexe = on ~ on Se on { Se s P 44 `"{ crut cad6 k }"` = s 1 } }
  `]{ ? ls `,"spar":{ pjs txt ls.n }` { Se && j && j.lojas j.lojas.spar `,"spar":{ pjs txt j.lojas.spar }` 0 } }\}`
  _tx_fecha h
  _an_buscar h $"lido_casa"
  0 }
: lido_casa ii>i t estado {
  Se == estado 200 {
    _an_gravar $"casa" t
    = j _ar_json t
    Se && j j.local _an_buscar texto`/api/lojas?q={ _tx_uri txt j.local }` $"lido_lojas"
    desenha }
  Se == estado 400 aviso $"Escolhe pelo menos uma loja."
  _me_solta t }
: lido_lojas ii>i t estado {
  Se == estado 200 { _an_gravar $"lojasq" t desenha }
  _me_solta t }

# ---------- escrever e encontrar (volta 5) ----------
# há separadores no que se escreveu? (então são várias coisas, e não se sugere)
: tem_sep i>i t { = n _tx_len t = r 0 L j n Se sep t j n = r 1 r }
# os tipos sugeridos, para o que está no campo (sem a casca: dentro da lista e sozinho em #sug)
: psug >i {
  = t @ 5
  = ss _an_ler $"sugsec"
  ? ss {
      # os tipos de uma secção (a árvore: secção › tipo); «‹ Secções» volta às secções
      = s _ar_json _an_ler $"sug"
      `<nav class="caminho" aria-label="Onde estás"><button class="n0" data-onda="vsecs:1">‹ Todas</button><i>›</i><b class="n1 sec-n">{ crut nomesec _tx_int ss }</b></nav>`
      # no talho e na peixaria, os tipos em ramos (Carne, Picada e preparados, Peixe, Marisco), cada um com o título
      `<div class="sug" role="list">`
      = x ? s pri s.tipos 0 = i 0 = gr $""
      W x {
        Se && x.gr ~ mesmo txt x.gr gr { `</div><p class="sug-t">{ esc x.gr }</p><div class="sug" role="list">` = gr txt x.gr }
        `<button class="chip n2" data-onda="tipo:{ N i }">{ esc x.nome }</button>` = x seg x = i + i 1 }
      `</div>` 0 }
    { ? _an_ler $"vsecs" {
        `<div class="sug" role="list">`
        L k 12 `<button class="chip n1 sec-c" data-onda="seca:{ N k }">{ crut nomesec k } ›</button>`
        `</div>` 0 }
     { ? && > _tx_len t 1 ~ tem_sep t {
        = s _ar_json _an_ler $"sug"
        Se && s pri s.tipos {
          `<div class="sug" role="list">`
          = x pri s.tipos = i 0 = nc 0 = gr $""
          W && x < i 30 {
            Se && x.gr ~ mesmo txt x.gr gr { `</div><p class="sug-t">{ esc x.gr }</p><div class="sug" role="list">` = gr txt x.gr }
            # os cortes de um grupo («carne»: picanha, para estufar…) numa linha à parte, a amarelo, com o tipo por baixo
            Se && x.corte ~ nc { `</div><p class="sug-t">Cortes</p><div class="sug" role="list">` = nc 1 }
            ? x.sec `<button class="chip n1 sec-c" data-onda="seca:{ N int x.sec }">{ esc x.nome } ›</button>`
              { ? x.corte `<button class="chip n3c" data-onda="tipo:{ N i }">{ esc x.corte } <small>{ esc x.nome }</small></button>`
                  `<button class="chip n2" data-onda="tipo:{ N i }">{ esc x.nome }{ Se x.w ` <small class="n3">{ esc x.w }</small>` }</button>` 0 }
            = x seg x = i + i 1 }
          `</div>` } 0 }
      { Se && == _tx_len t 0 ~ _an_ler $"simples" `<div class="sug"><button class="chip" data-onda="vsecs:1">☰ Ver por secções</button></div>`
        0 } } }
  0 }
: dsug >i { = h _ht_ini 3000 psug _ht_muda $"#sug" h }
# espera que se pare de escrever (300 ms) e pergunta os tipos
: agenda >i { _an_gravar $"sugsec" 0 _an_gravar $"vsecs" 0 Se @ 14 _an_parar @ 14 ! 14 _an_relogio 300 $"sugere" }
: lido_seccao ii>i t estado {
  Se == estado 200 { _an_gravar $"sug" t dsug }
  _me_solta t }
: sugere i>i z {
  = m _me_marca
  _an_parar @ 14 ! 14 0
  = t @ 5
  ? && > _tx_len t 1 ~ tem_sep t { _an_gravar $"sugq" t _an_buscar texto`/api/sugerir?q={ _tx_uri t }` $"lido_sug" 0 } { _an_gravar $"sug" 0 dsug 0 }
  _me_solta m }
: lido_sug ii>i t estado {
  Se == estado 200 { _an_gravar $"sug" t dsug }
  _me_solta t }
: lido_tipo ii>i t estado {
  Se && == estado 200 _an_ler $"tk" {
    _an_gravar $"tp" t
    # juntar logo (o que se escreveu era concreto): o mais barato de cada supermercado, como o «Juntar à lista»
    ? _an_ler $"auto" { _an_gravar $"auto" 0 = tp _ar_json t = nm txt tp.nome juntat aviso texto`✓ Juntei { crut nm } (o mais barato de cada loja). Toca na lista para ajustar.` 0 } { dfolha 0 } }
  _me_solta t }
# passa nos filtros? fe o tamanho, fm a marca («branca»: a marca própria)
: passa iii>i p fe fm && && || ~ _an_ler $"fes" tem_e _an_ler $"fes" txt p.emb || ~ fm ? mesmo fm $"branca" int p.pr mesmo txt p.mk fm tem_w p
# a palavra escolhida (o corte ou a variante: «picada», «estufar») está no nome? (sem palavra: sim)
: tem_w i>i p && && && tem_p p _an_ler $"fw" tem_p p _an_ler $"fa" tem_p p _an_ler $"fp" tem_p p _an_ler $"fc"
: tem_p ii>i p w { ? w { = h _tx_abre + 4 _tx_len txt p.nk P 32 crut txt p.nk P 32 _tx_fecha h = x _tx_abre + 4 _tx_len w P 32 crut w P 32 _tx_fecha x >= _tx_acha h x 0 0 } 1 }
# o mais barato (por unidade de medida; a lista vem já por essa ordem) do tipo no supermercado k, ou 0
: melhor_em iiii>i tp k fe fm {
  = r 0 = q _an_ler texto`esc{ N k }`
  # a escolha à mão («Outras opções»), se ainda passa nos filtros; senão o mais barato
  Se q { = p pri tp.produtos W && p ~ r { Se && && mesmo txt p.c cadeia k mesmo txt p.id q passa p fe fm = r p = p seg p } }
  # «Escolher por: ⭐ Melhor nota» (ord, no vinho): o de nota mais alta que passa nos filtros (no empate, o mais barato,
  # que vem primeiro); sem nenhum com nota, o mais barato
  Se && ~ r _an_ler $"ord" { = mn 0 = p pri tp.produtos W p { Se && && mesmo txt p.c cadeia k passa p fe fm > int p.nt mn { = r p = mn int p.nt } = p seg p } }
  # as pessoas da casa (tp.lim, em gramas, no talho e na peixaria): primeiro o mais barato que cabe (sem peso, cabe)
  Se && ~ r tp.lim { = lm int tp.lim = p pri tp.produtos W && p ~ r { Se && && mesmo txt p.c cadeia k passa p fe fm <= int p.g lm = r p = p seg p } }
  Se ~ r { = p pri tp.produtos W && p ~ r { Se && mesmo txt p.c cadeia k passa p fe fm = r p = p seg p } }
  r }
# quantos produtos do supermercado k passam nos filtros
: conta_em iiii>i tp k fe fm { = n 0 = p pri tp.produtos W p { Se && mesmo txt p.c cadeia k passa p fe fm = n + n 1 = p seg p } n }
# as outras opções do supermercado k (até 14, as mais baratas por unidade primeiro); a escolhida (e) marcada. No talho e
# na peixaria arrumam-se por corte (os cortes pela ordem do mais barato de cada um), cada corte com o título
: dop1 iiii>i p k j e {
  `<button class="op{ Se mesmo txt p.id txt e.id ` on` }" data-onda="esco:{ N + * k 1000 j }"><b>{ esc p.nome }</b>`
  `<span class="uc">{ ? p.uc `{ eur int p.uc }<i>/{ crut txt p.ub }</i>` `{ eur int p.cent }` }</span>`
  `<span class="pr">{ Se mesmo txt p.id txt e.id `✓ escolhido · ` }Pagas { Se int p.aq `≈ ` }{ eur int p.cent }{ Se p.emb ` por { esc p.emb }` }</span>`
  dsinais p
  `</button>` 0 }
: dopcoes iiiii>i tp k fe fm e {
  `<div class="opcoes">`
  Se _an_ler texto`esc{ N k }` `<button class="op-x" data-onda="escx:{ N k }">↺ Voltar ao mais barato</button>`
  # os cortes que há (pela ordem em que aparecem, que é a do mais barato)
  = crs $"|" = p pri tp.produtos
  W p { Se && && mesmo txt p.c cadeia k passa p fe fm p.cr { Se ~ tem_e crs txt p.cr = crs texto`{ crut crs }{ crut txt p.cr }|` } = p seg p }
  = n 0
  ? > _tx_len crs 1 {
      = c pri tp.produtos = ds $"|"
      W c {
        Se && && mesmo txt c.c cadeia k passa c fe fm c.cr {
          # o primeiro produto de cada corte abre o grupo: o título e os do mesmo corte
          = cr txt c.cr
          Se ~ tem_e ds cr {
            `<p class="op-t">{ esc c.cr }</p>`
            = p pri tp.produtos = j 0 = m 0
            W && p < m 6 { Se && && mesmo txt p.c cadeia k passa p fe fm && p.cr mesmo txt p.cr cr { dop1 p k j e = m + m 1 = n + n 1 } = p seg p = j + j 1 }
            # o corte fica feito (não se repete)
            = ds texto`{ crut ds }{ crut cr }|` } }
        = c seg c }
      # os sem corte no fim, em «Outros»
      = p pri tp.produtos = j 0 = m 0
      W && p < m 6 {
        Se && && mesmo txt p.c cadeia k passa p fe fm ~ p.cr { Se ~ m `<p class="op-t">Outros</p>` dop1 p k j e = m + m 1 }
        = p seg p = j + j 1 } 0 }
    { = p pri tp.produtos = j 0
      W && p < n 14 { Se && mesmo txt p.c cadeia k passa p fe fm { dop1 p k j e = n + n 1 } = p seg p = j + j 1 } 0 }
  `</div>`
  0 }
# uma fila de escolhas do «corte ou variante» (as do grupo g; sem grupo: todas), com o título; fw a escolhida
# (ev: fa para o animal ou a espécie, fw para o corte e o uso; escolhida a espécie, só os cortes e usos dela)
: tem_a ii>i x fa { = r 0 = y pri x.a W && y ~ r { Se mesmo txt y fa = r 1 = y seg y } r }
# as filas de uma família (atributos.js: o vinho tem a região, a gama e a casta), com os filtros fa, fp e fc
# as melhores compras (atributos.js): para quem não percebe, a qualidade por euro. No vinho, pela nota dos críticos e
# dos concursos (notas.js: x.ct, a nota em x.p); sem nota, e nas outras famílias, pelo que o rótulo promete
# a fronteira tira-se dos candidatos (do mais barato para o mais caro) que passam nos filtros escolhidos (a região,
# o preço, a casta, o tamanho, a marca): cada um que vale mais do que todos os mais baratos entra (até 4)
: dmelhores i>i tp {
  = fe _an_ler $"fe" = fm _an_ler $"fm"
  = x pri tp.bcc = mx 0 = n 0 = ant -1 = cts 0
  W && x < n 4 {
    = p idx tp.produtos int x.i
    Se && && p > int x.p mx passa p fe fm {
      Se ~ n `<h3>🏅 Melhores compras</h3><ul class="bc">`
      = pr ? p.uc int p.uc int p.cent
      `<li data-onda="esco:{ N + * icad txt p.c 1000 int x.i }"><b>{ esc p.nome }</b><span class="total">{ eur int p.cent }</span>`
      ? int x.ct { = cts 1 `<small>{ crut nomec txt p.c } · { dnota int x.p x.nu } · ` } `<small>{ crut nomec txt p.c } · o rótulo diz: `
      = q pri x.porque = i 0
      W q { Se i `, ` `{ esc q }` = q seg q = i + i 1 }
      Se >= ant 0 ` · +{ eur - pr ant }{ Se p.ub `/{ crut txt p.ub }` } para subir de gama`
      `</small></li>`
      = mx int x.p = ant pr = n + n 1 }
    = x seg x }
  Se n { ? cts `</ul><p class="nota">★ é a nota dos críticos e dos concursos (de 0 a 100: revistas, guias, medalhas), recolhida pelo Ecónomo; toca na ★ para ler a fonte e no vinho para o escolher. Sem nota, conta o que o rótulo diz (Reserva, DOC…). Só garrafas (o bag-in-box e o garrafão ficam de fora) e só entre os que escolheste: nenhum outro vale mais por menos.</p>` `</ul><p class="nota">Pelo que o rótulo diz (Reserva, DOC, virgem extra, DOP, cura…), só entre os que escolheste: nenhum outro promete mais por menos. Não é uma nota de crítico.</p>` }
  dcotados tp fe fm
  0 }
# gramas em quilos, com vírgula («1,2»)
: kgtxt i>i g { = k / g 1000 = r / % g 1000 100 ? r texto`{ N k },{ N r }` texto`{ N k }` }
# o índice de uma cadeia (o contrário de «cadeia»: continente 0, pingodoce 1, auchan 2, lidl 3)
: icad i>i c ? mesmo c $"continente" 0 ? mesmo c $"pingodoce" 1 ? mesmo c $"auchan" 2 3
# a nota ★ e, se houver, a ligação para a notícia (abre fora da app; não escolhe o produto)
: dnota ii>i n u ? u `<a class="fonte" href="{ esc u }" target="_blank" rel="noopener" data-onda="fonte:0">★ { N n } ↗</a>` `★ { N n }`
# as sugestões no vinho: os mais bem cotados pela crítica (tp.bnt, do melhor para o pior) que passam nos filtros (até 3)
: dcotados iii>i tp fe fm {
  = x pri tp.bnt = n 0
  W && x < n 3 {
    = p idx tp.produtos int x
    Se && p passa p fe fm {
      Se ~ n `<h3>⭐ Os mais bem cotados</h3><ul class="bc">`
      `<li data-onda="esco:{ N + * icad txt p.c 1000 int x }"><b>{ esc p.nome }</b><span class="total">{ eur int p.cent }</span>`
      `<small>{ crut nomec txt p.c } · { dnota int p.nt p.nu } · { esc p.nr }</small></li>`
      = n + n 1 }
    = x seg x }
  Se n `</ul>`
  0 }
: dfilas i>i tp {
  = f pri tp.filas
  Se f { linha_w tp txt f.g txt f.t _an_ler $"fa" $"fa" = f seg f }
  Se f { linha_w tp txt f.g txt f.t _an_ler $"fp" $"fp" = f seg f }
  Se f { linha_w tp txt f.g txt f.t _an_ler $"fc" $"fc" = f seg f }
  Se f linha_w tp txt f.g txt f.t _an_ler $"fw" $"fw"
  0 }
: linha_w iiiii>i tp g titulo fw ev {
  = s 0 = x pri tp.palavras = i 0 = fa _an_ler $"fa"
  W x {
    Se && || ~ g && x.g mesmo txt x.g g || || ~ fa ~ x.a tem_a x fa {
      Se ~ s { `<h3>{ crut titulo }</h3><div class="chips n3"><button class="chip{ Se ~ fw ` on` }" data-onda="{ crut ev }:99">Todos</button>` = s 1 }
      `<button class="chip{ Se && fw mesmo fw txt x.w ` on` }" data-onda="{ crut ev }:{ N i }">{ esc ? x.r x.r x.w }</button>` }
    = x seg x = i + i 1 }
  Se s `</div>`
  0 }
# a fila dos tamanhos (fe o escolhido)
# os tamanhos escolhidos (podem ser vários: 6 L e 5 L, para ver qual compensa): fes «|6 L|5 L|», fer «6 L + 5 L», e fe
# o tamanho quando é um só (para a estimativa e para o que se junta)
: tem_e ii>i fes e { = h _tx_abre + 4 _tx_len fes crut fes _tx_fecha h = x _tx_abre + 4 _tx_len e P 124 crut e P 124 _tx_fecha x >= _tx_acha h x 0 0 }
: dtam ii>i tp fe {
  = fes _an_ler $"fes"
  Se pri tp.tamanhos {
    `<h3>Tamanho <small>(podes escolher vários)</small></h3><div class="chips n4"><button class="chip{ Se ~ fes ` on` }" data-onda="fe:99">Todos</button>`
    = e pri tp.tamanhos = i 0
    W e { `<button class="chip{ Se && fes tem_e fes txt e.e ` on` }" data-onda="fe:{ N i }">{ esc e.e }</button>` = e seg e = i + i 1 }
    `</div>` }
  0 }
# o que distingue o produto (para se ver que não se compara o mesmo): a marca ou a marca branca, e os sinais do nome
# a verde o que o põe acima (massa mãe, biológico), a vermelho o que o põe abaixo (congelado), a cinzento o resto
: dsinais i>i p {
  `<span class="sinais">{ ? int p.pr `<i class="z">🏷 marca branca</i>` { Se p.mk `<i class="z">{ esc p.mk }</i>` 0 } }`
  = z pri p.sq
  W z { `<i class="{ ? > int z.s 0 `p` { ? < int z.s 0 `n` `z` } }">{ ? > int z.s 0 `✚ ` { ? < int z.s 0 `− ` `` } }{ esc z.t }</i>` = z seg z }
  `</span>`
  0 }
: dtipo >i {
  = tp _ar_json _an_ler $"tp"
  = fe _an_ler $"fe" = fm _an_ler $"fm" = tq _an_ler $"tq"
  `<div class="veu" data-onda="fechat:0"></div><div class="cartao escolha{ Se _an_ler $"simples" ` simples` }" role="dialog" aria-label="Escolher o produto"><button class="fechar" data-onda="fechat:0" aria-label="Fechar">✕</button>`
  ? tp {
      # o caminho na árvore, uma cor por nível: Secção › Tipo › Variante › Tamanho › Marca; tocar num nível volta a ele
      = fw _an_ler $"fw"
      `<nav class="caminho" aria-label="Onde estás"><button class="n0" data-onda="cam:9">Todas</button><i>›</i>`
      `<button class="n1" data-onda="cam:0">{ esc tp.sn }</button><i>›</i><button class="n2" data-onda="cam:1">{ esc tp.nome }</button>`
      = fwr _an_ler $"fwr"
      = fa _an_ler $"fa" = far _an_ler $"far"
      Se fa `<i>›</i><button class="n3" data-onda="cam:2">{ esct ? far far fa }</button>`
      = fp _an_ler $"fp" = fpr _an_ler $"fpr"
      Se fp `<i>›</i><button class="n3" data-onda="cam:7">{ esct ? fpr fpr fp }</button>`
      = fc _an_ler $"fc" = fcr _an_ler $"fcr"
      Se fc `<i>›</i><button class="n3" data-onda="cam:8">{ esct ? fcr fcr fc }</button>`
      Se fw `<i>›</i><button class="n3" data-onda="cam:6">{ esct ? fwr fwr fw }</button>`
      = fer _an_ler $"fer"
      Se fer `<i>›</i><button class="n4" data-onda="cam:3">{ esct fer }</button>`
      Se fm `<i>›</i><b class="n5">{ esct ? mesmo fm $"branca" $"🏷 marca branca" fm }</b>`
      `</nav><h2>{ esc tp.nome }</h2>`
      `<div class="qtd"><button class="botao fraco" data-onda="tmenos:0" aria-label="Menos">−</button><b>{ ? tq crut tq `1` }</b><button class="botao fraco" data-onda="tmais:0" aria-label="Mais">+</button></div>`
      # no talho e na peixaria, os níveis da árvore pela ordem: a espécie ou o animal, o corte, o uso, e só depois o
      # tamanho; nos outros tipos, o tamanho primeiro e depois o corte ou a variante
      = x0 pri tp.palavras
      = fa _an_ler $"fa"
      ? && && x0 x0.g ~ tp.filas { linha_w tp $"animal" $"Espécie ou animal" fa $"fa" linha_w tp $"prod" $"Origem e preparação" _an_ler $"fp" $"fp" linha_w tp $"cal" $"Calibre" _an_ler $"fc" $"fc" linha_w tp $"corte" $"Corte" fw $"fw" linha_w tp $"uso" $"Para quê" fw $"fw" dtam tp fe 0 }
        { ? tp.filas { dfilas tp dtam tp fe 0 } { dtam tp fe Se x0 linha_w tp 0 $"Variante" fw $"fw" 0 } }
      `<h3>Marca</h3><div class="chips n5"><button class="chip{ Se ~ fm ` on` }" data-onda="fm:99">Qualquer</button>`
      Se int tp.brancas `<button class="chip{ Se && fm mesmo fm $"branca" ` on` }" data-onda="fm:98">🏷 Marca branca</button>`
      = x pri tp.marcas = i 0
      W x { `<button class="chip{ Se && fm mesmo fm txt x.m ` on` }" data-onda="fm:{ N i }">{ esc x.m }</button>` = x seg x = i + i 1 }
      `</div>`
      dmelhores tp
      # no vinho, escolher em cada supermercado pelo preço ou pela nota dos críticos (fica para os próximos tipos)
      = ord _an_ler $"ord"
      Se mesmo txt tp.fam $"vinho" {
        `<h3>Escolher por</h3><div class="chips"><button class="chip{ Se ~ ord ` on` }" data-onda="ord:0">💶 Mais barato</button>`
        `<button class="chip{ Se ord ` on` }" data-onda="ord:1">⭐ Melhor nota</button></div>` }
      ? && ord mesmo txt tp.fam $"vinho" `<h3>O melhor cotado em cada supermercado</h3><ul class="melhores">` `<h3>O mais barato em cada supermercado</h3><ul class="melhores">`
      Se tp.lim `<p class="nota">👥 Para { N int tp.pes } { ? == int tp.pes 1 `pessoa` `pessoas` }: o mais barato em embalagens até { ? >= int tp.lim 1000 `{ crut kgtxt int tp.lim } kg` `{ N int tp.lim } g` } (as pessoas mudam-se na Casa; escolher outra continua a dar).</p>`
      # só se comparam os preços na unidade do tipo (o quilo, o litro): o mais barato fica marcado; em grande o preço
      # por quilo, e por baixo o que se paga e por quanto
      = ub ? tp.ub txt tp.ub 0
      = mu -1
      = mk -1
      L k 4 { = p melhor_em tp k fe fm Se && && p p.uc && ub mesmo txt p.ub ub Se || < mu 0 < int p.uc mu { = mu int p.uc = mk k } }
      # o veredicto: onde fica mais barato por quilo (ou litro) e, se uma loja de produtor fica abaixo, quanto e com que portes
      Se >= mk 0 {
        = px pri tp.pd = pm 0
        W px {
          Se && && && ~ int px.esg tem_w px px.uc mesmo txt px.ub ub { ? pm { Se < int px.uc int pm.uc = pm px 0 } { = pm px 0 } }
          = px seg px }
        `<p class="veredicto">🏆 Mais barato por { crut unidade ub }: <b>{ crut nomecad mk }</b>, { eur mu }/{ crut ub }`
        Se && pm < int pm.uc mu ` · na loja <b>{ crut nomeprod txt pm.loja }</b> fica { N / - * 100 mu * 100 int pm.uc mu }% mais barato ({ eur int pm.uc }/{ crut ub }){ ? pm.po { ? int pm.po `, mais { eur int pm.po } de portes` `, sem portes` } `` }`
        `</p>` }
      L k 4 {
        = p melhor_em tp k fe fm
        ? p {
            = u && && p.uc ub mesmo txt p.ub ub
            ? u `<li{ Se == int p.uc mu ` class="melhor"` }><b>{ crut nomecad k }{ Se int p.pr ` 🏷` }</b><span class="total">{ eur int p.uc }<i>/{ crut ub }</i></span>`
              `<li><b>{ crut nomecad k }{ Se int p.pr ` 🏷` }</b><span class="total">{ eur int p.cent }</span>`
            # ao quilo (uma peça inteira): o que se paga é aproximado, pelo peso médio da peça
            `<small><b class="emb">Pagas { Se int p.aq `≈ ` }{ eur int p.cent }{ Se p.emb ` por { Se int p.aq `≈ ` }{ esc p.emb }` }</b>{ Se int p.aq ` · vende-se ao quilo` }`
            Se u { ? == int p.uc mu ` · o mais barato por { crut unidade ub }` { Se > mu 0 ` · +{ N / - * 100 int p.uc * 100 mu mu }% por { crut unidade ub }` 0 } }
            ` · { esc p.nome }{ Se p.nt ` · ★ { N int p.nt }` }</small>`
            dsinais p
            # no vinho, a nota dos que já o beberam (no Vivino: só a ligação para a pesquisa, não se lê o site)
            Se mesmo txt tp.fam $"vinho" {
              `<a class="mais-op vivino" href="https://www.vivino.com/search/wines?q={ crut _tx_uri txt p.nome }" target="_blank" rel="noopener">⭐ Nota no Vivino ↗</a>`
              `<a class="mais-op vivino" href="https://www.wine-searcher.com/find/{ crut _tx_uri txt p.nome }/1/portugal" target="_blank" rel="noopener">🍷 Outras lojas e crítica ↗</a>` }
            # outras opções neste supermercado: tocar abre a lista; escolher uma fica (à mão: a troca de hora a hora não a muda)
            = no conta_em tp k fe fm
            = ab ? _an_ler $"opc" _tx_int _an_ler $"opc" -1
            = q _an_ler texto`esc{ N k }`
            Se && q mesmo txt p.id q `<span class="mao">✋ escolhido por ti</span>`
            Se > no 1 `<button class="mais-op" data-onda="opc:{ N k }" aria-expanded="{ ? == ab k `true` `false` }">{ ? == ab k `Fechar as opções ▴` `Outras opções no { crut nomecad k } ({ N - no 1 }) ▾` }</button>`
            Se && == ab k > no 1 dopcoes tp k fe fm p
            `</li>` 0 }
          { Se || < k 3 conta_em tp k 0 0 `<li class="parcial"><b>{ crut nomecad k }</b><span class="total">—</span><small>Nada assim neste supermercado</small></li>` 0 } }
      dprodutores tp mu
      Se minha $"mercadona" dest tp fe 0 mu
      Se minha $"spar" dest tp fe 1 mu
      ? _an_ler $"subst" `</ul><div class="acoes"><button class="botao fraco" data-onda="tirars:0">🗑 Tirar da lista</button><button class="botao" data-onda="juntat:0">Guardar</button></div>`
        `</ul><div class="acoes"><button class="botao fraco" data-onda="fechat:0">Fechar</button><button class="botao" data-onda="juntat:0">Juntar à lista</button></div>`
      0 }
    `<p class="nota">A procurar…</p>`
  `</div>` }
# a Mercadona (q 0) e o SPAR (q 1) na escolha: o preço do teu talão dessa loja, se há; senão a estimativa do
# tamanho escolhido (ou do mais comum), na mesma unidade das outras linhas, com a base (o que há nas outras lojas)
# e o porquê. mu: o melhor preço por unidade das cadeias (para dizer quanto mais caro ou mais barato)
: nomecl i>i c ? mesmo c $"lidl" $"Lidl" c
: nomec i>i c ? mesmo c $"continente" $"Continente" ? mesmo c $"pingodoce" $"Pingo Doce" ? mesmo c $"auchan" $"Auchan" nomecl c
# o que o SPAR vende deste tipo (da lista de artigos do site, sem preços), dos tamanhos escolhidos: a marca SPAR primeiro,
# cada um com a estimativa (o mesmo produto noutra cadeia, ou a marca branca equivalente)
: dspar i>i tp {
  = fes _an_ler $"fes" = x pri tp.sa = n 0
  W && x < n 6 {
    Se || ~ fes && x.emb tem_e fes txt x.emb {
      Se ~ n `</small><div class="spar-art"><p class="t">No SPAR há:</p>`
      `<p><b>{ esc x.n }</b>{ Se int x.pr ` <i>marca SPAR</i>` }{ ? x.eq ` — ≈ { eur int x.eq } <span>({ esc x.como })</span>` ` — <span>sem estimativa</span>` }</p>`
      = n + n 1 }
    = x seg x }
  Se n `</div><small>`
  0 }
# as lojas online de produtores (a Lugrade…): à parte das cadeias, com os mesmos filtros (espécie, origem, corte),
# o preço por quilo e o que se paga; compra-se no site deles (com portes)
: nomeprod i>i l ? mesmo l $"lugrade" $"Lugrade" ? mesmo l $"riberalves" $"Riberalves" l
: dprodutores ii>i tp mu {
  = x pri tp.pd = n 0
  W && x < n 6 {
    Se && ~ int x.esg tem_w x {
      Se ~ n `<li class="prod-t"><b>Lojas de produtores (online)</b><small>Compra-se no site deles, com portes de envio; não entra no «Mais barato».</small></li>`
      `<li class="prod"><b>{ crut nomeprod txt x.loja }</b><span class="total">{ ? x.uc `{ eur int x.uc }<i>/{ crut txt x.ub }</i>` `{ eur int x.cent }` }</span>`
      `<small><b class="emb">Pagas { eur int x.cent }{ Se x.emb ` por ≈ { esc x.emb }` }{ Se x.po { ? int x.po ` + { eur int x.po } de portes` ` · sem portes` } }</b>{ Se && x.uc > mu 0 { ? > int x.uc mu ` · +{ N / - * 100 int x.uc * 100 mu mu }% por quilo` ` · { N / - * 100 mu * 100 int x.uc mu }% mais barato por quilo` } } · { esc x.nome }</small>`
      dsinais x
      Se x.pn `<small class="mesmo">Portes: { esc x.pn }</small>`
      Se x.mc `<small class="mesmo">A mesma marca no { crut nomec txt x.mc.c }{ Se x.mc.kg `, peça de ≈ { esc txt x.mc.kg } kg` }: <b>{ eur int x.mc.uc }/kg</b>{ ? < int x.mc.uc int x.uc ` (mais barato lá)` ` (mais caro lá)` }</small>`
      `<a class="mais-op" href="{ esc x.url }" target="_blank" rel="noopener">Ver no site ↗</a></li>`
      = n + n 1 }
    = x seg x }
  0 }
: dest iiii>i tp fe q mu {
  = j _ar_json _an_ler $"casa"
  = nome ? q ? && j j.lojas.spar txt j.lojas.spar $"SPAR" $"Mercadona"
  = real _ar_get tp.reais ? q $"spar" $"mercadona"
  ? real {
      `<li class="est real"><b>{ crut nome }</b><span class="total">{ eur int real.cent }</span><small><b class="emb">Pagaste { eur int real.cent }</b> · do teu talão de { crut txt real.dia }: «{ esc real.t }».</small></li>` 0 }
    {
      = ub ? tp.ub txt tp.ub 0
      = e0 ? fe fe ? q ? tp.est.sp txt tp.est.sp 0 ? tp.est.mp txt tp.est.mp 0
      = x 0 = e pri tp.est.tam
      Se e0 W && e ~ x { Se mesmo txt e.e e0 = x e = e seg e }
      = v ? x int ? q x.spar x.merc 0
      = uv ? x int ? q x.uspar x.umerc 0
      Se ~ x = uv int ? q tp.est.uc.spar tp.est.uc.merc
      # com um corte ou variante escolhida («carapau»), a estimativa é a desses produtos, por quilo (sem: não há)
      = fw _an_ler $"fw" Se ~ fw = fw _an_ler $"fa"
      Se fw { = x 0 = v 0 = uv 0 = y pri tp.est.w W y { Se mesmo txt y.w fw = uv int ? q y.spar y.merc = y seg y } }
      Se || v uv {
        ? && uv ub `<li class="est"><b>{ crut nome } ≈</b><span class="total">≈ { eur uv }<i>/{ crut ub }</i></span><small>`
          `<li class="est"><b>{ crut nome } ≈</b><span class="total">≈ { eur v }</span><small>`
        Se v `<b class="emb">Pagarias ≈ { eur v } por { crut e0 }</b>`
        Se && && uv ub > mu 0 { ? > uv mu ` · ≈ +{ N / - * 100 uv * 100 mu mu }% por { crut unidade ub }` { Se < uv mu ` · ≈ { N / - * 100 mu * 100 uv mu }% mais barato por { crut unidade ub }` 0 } }
        = b ? x ? q pri x.bs pri x.bm 0
        Se b { ` · com base em ` = s 0 W b { Se s `, ` `{ crut nomec txt b.c }{ Se ~ q ` 🏷` } { eur int b.cent }` = s 1 = b seg b } }
        `<br>`
        ? q `Estimativa: as marcas de fabricante do mesmo tipo e tamanho nas outras lojas. O SPAR não tem loja online e é franquiado: cada loja tem os seus preços. Os teus talões corrigem-na.{ dspar tp }`
          `Estimativa: a marca branca do mesmo tipo e tamanho no Continente, no Pingo Doce e no Auchan. A Mercadona não vende online em Portugal; não usamos preços de Espanha (o IVA e os preços são outros). Os teus talões corrigem-na.`
        `</small></li>` }
      0 }
  0 }
# tocar num nível do caminho: 9 todas as secções, 0 a secção (os tipos irmãos), 1 o tipo, 2 a variante, 3 o tamanho
: caminho i>i v {
  = tp _ar_json _an_ler $"tp"
  Se tp {
    ? >= v 9 { fecha_tipo _an_gravar $"sug" 0 _an_gravar $"sugsec" 0 _an_gravar $"vsecs" $"1" 0 }
    { ? == v 0 { = sx int tp.s fecha_tipo _an_gravar $"vsecs" 0 _an_gravar $"sug" 0 _an_gravar $"sugsec" texto`{ N sx }` _an_buscar texto`/api/seccao?s={ N sx }` $"lido_seccao" 0 }
      { _an_gravar $"fm" 0 Se ~ == v 3 { _an_gravar $"fe" 0 _an_gravar $"fes" 0 _an_gravar $"fer" 0 }
        Se || || < v 3 == v 7 == v 8 { _an_gravar $"fw" 0 _an_gravar $"fwr" 0 }
        Se || < v 3 == v 7 { _an_gravar $"fc" 0 _an_gravar $"fcr" 0 }
        Se < v 3 { _an_gravar $"fp" 0 _an_gravar $"fpr" 0 }
        Se < v 2 { _an_gravar $"fa" 0 _an_gravar $"far" 0 } 0 } } }
  0 }
: fecha_tipo >i { _an_gravar $"tk" 0 _an_gravar $"tp" 0 _an_gravar $"fe" 0 _an_gravar $"fes" 0 _an_gravar $"fer" 0 _an_gravar $"fm" 0 _an_gravar $"fw" 0 _an_gravar $"fwr" 0 _an_gravar $"fa" 0 _an_gravar $"far" 0 _an_gravar $"fp" 0 _an_gravar $"fpr" 0 _an_gravar $"fc" 0 _an_gravar $"fcr" 0 _an_gravar $"tq" 0 _an_gravar $"opc" 0 _an_gravar $"esc0" 0 _an_gravar $"esc1" 0 _an_gravar $"esc2" 0 _an_gravar $"esc3" 0 }
: abre_tipo i>i v {
  = s _ar_json _an_ler $"sug"
  = x ? s idx s.tipos v 0
  Se x {
    fecha_tipo
    _an_gravar $"tk" txt x.k
    Se x.w { ? x.ga { _an_gravar $"fa" txt x.w _an_gravar $"far" txt ? x.corte x.corte x.w 0 } { _an_gravar $"fw" txt x.w _an_gravar $"fwr" txt ? x.corte x.corte x.w 0 } }
    _an_buscar texto`/api/tipo?k={ _tx_uri txt x.k }` $"lido_tipo" }
  0 }
# tocar num tamanho junta-o aos escolhidos ou tira-o (refaz fes, fer e fe pela ordem dos tamanhos)
: muda_tam ii>i tp v {
  = fes _an_ler $"fes" = novo $"|" = rot $"" = n 0 = um 0
  = e pri tp.tamanhos = j 0
  W e {
    = esta tem_e ? fes fes $"" txt e.e
    Se ? == j v ~ esta esta { = novo texto`{ crut novo }{ crut txt e.e }|` = rot texto`{ Se n `{ crut rot } + ` }{ crut txt e.e }` = n + n 1 = um txt e.e }
    = e seg e = j + j 1 }
  ? n { _an_gravar $"fes" novo _an_gravar $"fer" rot _an_gravar $"fe" ? == n 1 um 0 0 } { _an_gravar $"fes" 0 _an_gravar $"fer" 0 _an_gravar $"fe" 0 0 }
  0 }
# um botão de tamanho (fe) ou de marca (fm): 99 tira o filtro, 98 é a marca branca
: filtro ii>i qual v {
  = tp _ar_json _an_ler $"tp"
  Se tp {
    ? == qual 0
      { ? == v 99 { _an_gravar $"fe" 0 _an_gravar $"fes" 0 _an_gravar $"fer" 0 0 } { muda_tam tp v 0 } 0 }
      { ? == v 99 _an_gravar $"fm" 0 ? == v 98 _an_gravar $"fm" $"branca" { = x idx tp.marcas v Se x _an_gravar $"fm" txt x.m 0 } 0 } }
  0 }
: tq_muda i>i d { = q _an_ler $"tq" = n Mx 1 Mn 99 + ? q _tx_int q 1 d _an_gravar $"tq" texto`{ N n }` 0 }
# juntar à lista a coisa escolhida, já com o produto de cada supermercado
: juntat >i {
  = tp _ar_json _an_ler $"tp"
  Se tp {
    = fe _an_ler $"fe" = fm _an_ler $"fm" = tq _an_ler $"tq"
    = id texto`{ novoid }`
    = fw _an_ler $"fw" = fwr _an_ler $"fwr" = fa _an_ler $"fa" = far _an_ler $"far" = fp _an_ler $"fp" = fpr _an_ler $"fpr" = fc _an_ler $"fc" = fcr _an_ler $"fcr"
    Se fc { = fp texto`{ Se fp `{ crut fp } ` }{ crut fc }` = fpr texto`{ Se fp `{ crut ? fpr fpr fp }, ` }{ crut ? fcr fcr fc }` }
    = ww texto`{ Se fa `{ crut fa } ` }{ Se fp `{ crut fp } ` }{ Se fw `{ crut fw }` }`
    = nome texto`{ crut txt tp.nome }{ Se || || fa fp fw ` ({ Se fa `{ crut ? far far fa }` }{ Se && fa || fp fw `, ` }{ Se fp `{ crut ? fpr fpr fp }` }{ Se && fp fw `, ` }{ Se fw `{ crut ? fwr fwr fw }` })` }{ Se _an_ler $"fer" ` { crut _an_ler $"fer" }` }{ Se fm ` { ? mesmo fm $"branca" `marca branca` crut fm }` }`
    faz texto`\{"o":"j","id":"{ crut id }","t":{ pjs nome },"q":{ N ? tq _tx_int tq 1 },"e":\{"k":{ pjs txt tp.k },"n":{ pjs txt tp.nome }{ Se fe `,"emb":{ pjs fe }` }{ Se fm `,"m":{ pjs fm }` }{ Se || || fa fp fw `,"w":{ pjs ww }` }\}\}`
    L k 4 { = p melhor_em tp k fe fm = q _an_ler texto`esc{ N k }` Se p faz texto`\{"o":"p","id":"{ crut id }","c":"{ crut cadeia k }"{ Se ~ && q mesmo txt p.id q `,"a":1` },"p":\{"id":{ pjs txt p.id },"nome":{ pjs txt p.nome },"url":{ pjs txt p.url }\}\}` }
    = sb _an_ler $"subst"
    Se sb { faz texto`\{"o":"x","id":{ pjs sb }\}` _an_gravar $"subst" 0 }
    fecha_tipo
    _an_gravar $"sug" 0 _an_gravar $"sugsec" 0 _an_gravar $"vsecs" 0
    ! @ 5 + @ 5 1 ! 11 + @ 11 1 }
  0 }

# o talão (a casca lê a fotografia e manda-a ao conector; aqui só o aviso e a lista outra vez): 0 a ler, 1 lido
: talao i>i v {
  ? == v 0 aviso $"A ler o talão…" {
    = r _ar_json _an_ler $"talao"
    ? && r r.erro aviso texto`Não consegui ler o talão: { crut txt r.erro }` {
      Se r aviso texto`Talão{ Se r.loja ` do { crut txt r.loja }` }: { eur int r.total } · { N quantos r.linhas } linhas{ Se int r.riscadas ` · { N int r.riscadas } riscadas na lista` }.`
      ver pede_costume 0 } 0 }
  0 }
# juntar o que se escreveu. Uma coisa só, que a app reconhece (as sugestões já vieram para este texto): se é concreta
# («bifes de frango», «azeite»: o primeiro sugerido é um tipo), junta-se logo o mais barato de cada supermercado (tocar
# na lista ajusta); se é geral («frango», «pão»: o primeiro é uma secção), abre-se a escolha do primeiro tipo
: juntar >i {
  = t @ 5 = n _tx_len t = ini 0 = j 0
  = s ? && && > n 1 ~ tem_sep t mesmo _an_ler $"sugq" t _ar_json _an_ler $"sug" 0
  = x ? s pri s.tipos 0 = ix 0
  Se && x ~ x.k { = x seg x = ix 1 }
  Se && x x.k {
    = x0 pri s.tipos = geral ~ x0.k
    abre_tipo ix
    Se ~ geral _an_gravar $"auto" $"1"
    = n 0 ! @ 5 + @ 5 1 ! 11 + @ 11 1 _an_gravar $"sug" 0 }
  Se == _tx_acha t $"https://" 0 0 { pede_receita t = n 0 ! @ 5 + @ 5 1 ! 11 + @ 11 1 }
  W <= j n {
    = s ? == j n 1 sep t j n
    ? s { pedaco t ini j = ini + j s = j ini } = j + j 1 }
  Se > n 0 { ! @ 5 + @ 5 1 ! 11 + @ 11 1 _an_gravar $"sug" 0 }
  0 }
: escolhe i>i v {
  = k / v 100 = j % v 100
  = c item_aberto
  Se c {
    ? == j 99 faz texto`\{"o":"p","id":{ pjs txt c.id },"c":"{ crut cadeia k }","p":null\}` {
      = r _ar_json _an_ler texto`p:{ crut cadeia k }`
      = p ? r idx r.produtos j 0
      Se p faz texto`\{"o":"p","id":{ pjs txt c.id },"c":"{ crut cadeia k }","p":\{"id":{ pjs txt p.id },"nome":{ pjs txt p.nome },"url":{ pjs txt p.url }\}\}`
      0 } }
  0 }
: clique i>i t {
  = v arg t
  Se eacao t $"aba" { ! 1 v _an_gravar $"aberto" 0 _an_rolar 0 Se && == v 2 _an_ler $"chave" { _an_buscar $"/api/casa" $"lido_casa" _an_buscar $"/api/saude" $"lido_saude" } }
  Se eacao t $"glocal" gravar_lojas -1 -1
  Se eacao t $"cad" gravar_lojas v -1
  Se eacao t $"sparl" gravar_lojas -1 v
  Se eacao t $"juntar" juntar
  Se eacao t $"tirars" { = sb _an_ler $"subst" Se sb { faz texto`\{"o":"x","id":{ pjs sb }\}` _an_gravar $"subst" 0 } fecha_tipo }
  Se eacao t $"riscar" { = c idx itens v Se c faz texto`\{"o":"r","id":{ pjs txt c.id },"f":{ N ~ int c.f }\}` }
  # tocar numa coisa da lista: se tem tipo, abre a escolha com os filtros dela (o tamanho, a marca, o corte) e o
  # «Juntar» passa a guardar por cima; sem tipo, a procura simples
  Se eacao t $"abre" { = c idx itens v Se c { ? && c.e c.e.k {
        = k txt c.e.k = sid txt c.id
        fecha_tipo
        _an_gravar $"subst" sid _an_gravar $"tk" k
        Se c.e.m _an_gravar $"fm" txt c.e.m
        Se c.e.emb { _an_gravar $"fe" txt c.e.emb _an_gravar $"fes" texto`|{ crut txt c.e.emb }|` _an_gravar $"fer" txt c.e.emb }
        Se c.e.w { _an_gravar $"fw" txt c.e.w _an_gravar $"fwr" txt c.e.w }
        Se > int c.q 1 _an_gravar $"tq" texto`{ N int c.q }`
        _an_buscar texto`/api/tipo?k={ crut _tx_uri k }` $"lido_tipo" 0 }
      { _an_gravar $"aberto" txt c.id procura txt c.t 0 } } }
  Se eacao t $"fecha" { _an_gravar $"aberto" 0 _an_gravar $"subst" 0 fecha_tipo }
  Se eacao t $"limpar" faz $`{"o":"l"}`
  Se eacao t $"tirar" { = c item_aberto Se c { faz texto`\{"o":"x","id":{ pjs txt c.id }\}` _an_gravar $"aberto" 0 } }
  Se eacao t $"mais" { = c item_aberto Se c faz texto`\{"o":"q","id":{ pjs txt c.id },"q":{ N Mn 99 + int c.q 1 }\}` }
  Se eacao t $"menos" { = c item_aberto Se c faz texto`\{"o":"q","id":{ pjs txt c.id },"q":{ N Mx 1 - int c.q 1 }\}` }
  Se eacao t $"esc" escolhe v
  Se eacao t $"entrar" Se _tx_len @ 6 entrar @ 6
  Se eacao t $"registar" registar
  Se eacao t $"loja" { _an_gravar $"loja" ? < v 4 cadeia v 0 ! 1 0 _an_rolar 0 }
  Se eacao t $"tipo" abre_tipo v
  Se eacao t $"cam" caminho v
  Se eacao t $"vsecs" { _an_gravar $"sugsec" 0 _an_gravar $"vsecs" $"1" }
  Se eacao t $"seca" { _an_gravar $"vsecs" 0 _an_gravar $"sugsec" texto`{ N v }` _an_gravar $"sug" 0 _an_buscar texto`/api/seccao?s={ N v }` $"lido_seccao" }
  Se eacao t $"talao" talao v
  Se eacao t $"sec" { ? _an_ler texto`sec:{ N v }` _an_gravar texto`sec:{ N v }` 0 _an_gravar texto`sec:{ N v }` $"1" }
  Se eacao t $"cpg" gravar_cp
  Se eacao t $"rcf" { _an_gravar $"receita" 0 _an_gravar $"rcerr" 0 }
  Se eacao t $"rco" { = kk texto`rco{ N v }` ? _an_ler kk _an_gravar kk 0 _an_gravar kk $"1" }
  Se eacao t $"rct" pede_receita_txt
  Se eacao t $"rcj" rcjunta
  Se eacao t $"ajusta" { = c item_aberto Se && c c.e {
      = k txt c.e.k = sid txt c.id
      _an_gravar $"aberto" 0 fecha_tipo
      _an_gravar $"subst" sid _an_gravar $"tk" k
      _an_buscar texto`/api/tipo?k={ crut _tx_uri k }` $"lido_tipo" } }
  Se eacao t $"nhv" { = c item_aberto Se c { = ep _ar_get c.p cadeia v
      faz texto`\{"o":"n","id":{ pjs txt c.id },"c":"{ crut cadeia v }"{ Se && ep ep.nh `,"f":0` }\}`
      aviso texto`{ ? && ep ep.nh `↺ Afinal havia no ` `✗ Fica em falta 3 dias no ` }{ crut nomecad v }.` } }
  Se eacao t $"natal" { _an_gravar $"natal" $"1" _an_gravar $"nt" 0 pede_natal }
  Se eacao t $"ntf" _an_gravar $"natal" 0
  Se eacao t $"ntm" { _an_gravar $"ntm" texto`{ N v }` _an_gravar $"nt" 0 pede_natal }
  Se eacao t $"ntt" { _an_gravar $"ntt" texto`{ N v }` _an_gravar $"nt" 0 pede_natal }
  Se eacao t $"nto" { = kk texto`nto{ N v }` ? _an_ler kk _an_gravar kk 0 _an_gravar kk $"1" }
  Se eacao t $"ntc" _an_gravar texto`ntc{ N / v 10 }` texto`{ N + % v 10 1 }`
  Se eacao t $"ntj" ntjunta
  Se eacao t $"ntv" { = j _ar_json _an_ler $"nt" = p ? j idx j.partes v 0 = o ? p pri p.opcoes 0
      Se && o o.tipo { = k txt o.tipo _an_gravar $"natal" 0 fecha_tipo _an_gravar $"tk" k _an_buscar texto`/api/tipo?k={ crut _tx_uri k }` $"lido_tipo" } }
  Se eacao t $"simples" { ? _an_ler $"simples" _an_gravar $"simples" 0 _an_gravar $"simples" $"1" }
  Se eacao t $"carr" { ? _an_ler $"carrinho" _an_gravar $"carrinho" 0 _an_gravar $"carrinho" $"1" }
  Se eacao t $"qp" { = c idx itens v Se c faz texto`\{"o":"q","id":{ pjs txt c.id },"q":{ N Mn 99 + int c.q 1 }\}` }
  Se eacao t $"qm" { = c idx itens v Se c faz texto`\{"o":"q","id":{ pjs txt c.id },"q":{ N Mx 1 - int c.q 1 }\}` }
  Se eacao t $"tirai" { = c idx itens v Se c faz texto`\{"o":"x","id":{ pjs txt c.id }\}` }
  Se eacao t $"cost" { = j _ar_json _an_ler $"costume" = x ? j idx j.coisas v 0 Se x faz texto`\{"o":"j","id":"{ novoid }","t":{ pjs txt x.t },"q":1\}` }
  Se eacao t $"fe" filtro 0 v
  Se eacao t $"fm" filtro 1 v
  Se eacao t $"pes" { = h _tx_abre 100 `POST /api/casa/pessoas{ P 10 }\{"n":{ ? v N v `null` }\}` _tx_fecha h _an_buscar h $"lido_casa" }
  Se eacao t $"ord" { ? v _an_gravar $"ord" $"1" _an_gravar $"ord" 0 }
  Se eacao t $"opc" { = ab _an_ler $"opc" ? && ab == _tx_int ab v _an_gravar $"opc" 0 _an_gravar $"opc" texto`{ N v }` }
  # escolher outra opção: a lista fica aberta (vê-se a barra azul mudar) e um aviso diz o que ficou
  Se eacao t $"esco" { = tp _ar_json _an_ler $"tp" = x ? tp idx tp.produtos % v 1000 0 Se x { _an_gravar texto`esc{ N / v 1000 }` txt x.id aviso texto`✓ No { crut nomecad / v 1000 }: { crut txt x.nome }` } }
  Se eacao t $"escx" { _an_gravar texto`esc{ N v }` 0 aviso texto`↺ No { crut nomecad v }: o mais barato outra vez` }
  Se eacao t $"fc" { = tp _ar_json _an_ler $"tp" ? == v 99 { _an_gravar $"fc" 0 _an_gravar $"fcr" 0 0 } { = x ? tp idx tp.palavras v 0 Se x { _an_gravar $"fc" txt x.w _an_gravar $"fcr" txt ? x.r x.r x.w } 0 } }
  Se eacao t $"fp" { = tp _ar_json _an_ler $"tp" ? == v 99 { _an_gravar $"fp" 0 _an_gravar $"fpr" 0 0 } { = x ? tp idx tp.palavras v 0 Se x { _an_gravar $"fp" txt x.w _an_gravar $"fpr" txt ? x.r x.r x.w } 0 } }
  Se eacao t $"fa" { = tp _ar_json _an_ler $"tp" ? == v 99 { _an_gravar $"fa" 0 _an_gravar $"far" 0 0 } { = x ? tp idx tp.palavras v 0 Se x { _an_gravar $"fa" txt x.w _an_gravar $"far" txt ? x.r x.r x.w } 0 } }
  Se eacao t $"fw" { = tp _ar_json _an_ler $"tp" ? == v 99 { _an_gravar $"fw" 0 _an_gravar $"fwr" 0 0 } { = x ? tp idx tp.palavras v 0 Se x { _an_gravar $"fw" txt x.w _an_gravar $"fwr" txt ? x.r x.r x.w } 0 } }
  Se eacao t $"tmais" tq_muda 1
  Se eacao t $"tmenos" tq_muda -1
  Se eacao t $"juntat" juntat
  Se eacao t $"fechat" fecha_tipo
  desenha
  _me_solta t }
: escreve i>i t {
  = nome _tx_campo t 0 9
  = v _tx_campo t 1 9
  Se mesmo nome $"junta" { fixa @ 5 v 400 agenda }
  Se mesmo nome $"codigo" fixa @ 6 v 40
  Se mesmo nome $"local" _an_gravar $"localtxt" v
  Se mesmo nome $"cpz" _an_gravar $"cptxt" v
  Se mesmo nome $"rctx" _an_gravar $"rctxt" v
  _me_solta t }
: main >i {
  _me_lb
  ! 5 _tx_novo 400 ! 6 _tx_novo 40
  _an_gravar $"aberto" 0
  _an_ouvir $"click" $"clique"
  _an_ouvir $"input" $"escreve"
  ? _an_ler $"chave" depois_da_chave registar
  ! 7 _an_relogio 15000 $"tique"
  desenha
  0 }
